    "item.cafe_keys.desc": "They were under the mat. Of course.",
    "item.cafe_keys.name": "Café keys",
    "item.letter.desc": "A sealed envelope, \"For Jindra\". It weighs about twenty grams.",
    "item.letter.name": "Lida's letter",
    "item.lost_umbrella.desc": "Someone may come back for it.",
    "item.lost_umbrella.name": "Monogrammed umbrella",
    "item.old_coin.desc": "Czechoslovak crowns from 1978. No longer money.",
    "item.old_coin.name": "Old coins",
    "item.recipe_book.desc": "Greasy pages and notes in the margins.",
    "item.recipe_book.name": "Lida's recipe book",
    "item.rn333_ticket.desc": "A return, 14 November 1979. The return half unused.",
    "item.rn333_ticket.name": "Rn 333 ticket",
    "item.timetable_1979.desc": "Next to the last line, in pencil: \"two minutes\".",
    "item.timetable_1979.name": "1979 timetable",
    "journal.caption.anwar": "A quiet guy with a laptop. Nice smile.",
    "journal.caption.arc.filip.1": "Filip brought half his year to the socket table.",
    "journal.caption.arc.filip.2": "Filip, very quiet, over a cold coffee.",
    "journal.caption.arc.filip.3": "Filip before the resit. Fingers crossed, all of us.",
    "journal.caption.arc.filip.4": "Filip got a B. The café cheered.",
    "journal.caption.arc.guest_333.1": "Coins from 1979 on the saucer.",
    "journal.caption.arc.guest_333.2": "\"Still lit.\" He looked at the window, not at me.",
    "journal.caption.arc.guest_333.3": "\"I left once.\" The tea went cold in his hands.",
    "journal.caption.arc.guest_333.4": "The last 3:33. The clocks started again.",
    "journal.caption.arc.hana.1": "Hana laughed tonight: a baby girl called Lida.",
    "journal.caption.arc.hana.2": "Hana asleep by the window. I let her be.",
    "journal.caption.arc.hana.3": "Hana and her letter from Dresden.",
    "journal.caption.arc.hana.4": "Hana decided. She looked lighter.",
    "journal.caption.arc.lori.1": "Lori came in from the platform, guitar and all.",
    "journal.caption.arc.lori.2": "Lori on the little stage. Almost a real one.",
    "journal.caption.arc.lori.3": "Lori's Friday. The whole street listened.",
    "journal.caption.arc.mirek.1": "Mirek let me pour his coffee. Like he used to let her.",
    "journal.caption.arc.mirek.2": "Mirek squinting at the menu board. \"It's the letters, not my eyes.\"",
    "journal.caption.arc.mirek.3": "Mirek came on foot tonight. He looked younger for it.",
    "journal.caption.arc.mirek.4": "Twenty grams, and a whole life. Mirek finally told me.",
    "journal.caption.arc.mirek.5": "Mirek, deciding. I didn't rush him.",
    "journal.caption.arc.radek.1": "Radek's warning came by text: the express is late. We were ready.",
    "journal.caption.arc.radek.2": "Radek's last shift. He sat down for once.",
    "journal.caption.arc.radek.3": "Radek and the snowdrifts of '85.",
    "journal.caption.arc.vera.1": "Vera and her crossword, recruiting the whole café.",
    "journal.caption.arc.vera.2": "Vera inspected the table. It passed.",
    "journal.caption.arc.vera.3": "Vera and grandma's kulajda. She closed her eyes on the first spoon.",
    "journal.caption.arc.vera.4": "Vera's friends took over the corner. Loudly.",
    "journal.caption.beautiful_latte": "A {pattern} for {name}.",
    "journal.caption.cat_level": "The cat stayed. I think it lives here now.",
    "journal.caption.first_snow": "The first snow, through grandma's window.",
    "journal.caption.full_house": "Every chair taken. Grandma would have loved it.",
    "journal.caption.garlands_up": "Grandma's garlands, up again.",
    "journal.caption.guest_333": "3:33. The clock stopped, and he was there again.",
    "journal.caption.like_home": "It felt like home tonight.",
    "journal.caption.mikulas": "An angel, a devil and three hot chocolates.",
    "journal.caption.moment.m_advent_candle": "One more candle on the wreath.",
    "journal.caption.moment.m_blackout_candles": "The power went out. The candles didn't.",
    "journal.caption.moment.m_busker": "A song under the awning, a tea in the rain.",
    "journal.caption.moment.m_coffee_for_helper": "A coffee for the crew, for once.",
    "journal.caption.moment.m_lost_traveller": "A lost traveller, found. With three minutes to spare.",
    "journal.caption.moment.m_sleeping_guest": "Someone asleep under grandma's blanket.",
    "journal.caption.moment.m_tired_parent": "Warm milk, and a little one asleep.",
    "journal.caption.perfect_serve": "{name} said it was exactly right.",
    "journal.caption.quiet_night": "A quiet night. Rain on the window.",
    "journal.caption.recipe_discovered": "My own recipe: {recipe}.",
    "journal.caption.record_loved": "{name} hummed along to {record}.",
    "journal.caption.rozpis_happy": "Everyone got the nights they wanted.",
    "journal.caption.scene.filip_cake": "A cake for Filip, with one wonky candle.",
    "journal.caption.scene.final_night": "The thirtieth night.",
    "journal.caption.scene.guest333_first": "3:33. A man in an old coat ordered tea.",
    "journal.caption.scene.hana_asleep": "Hana, finally asleep. The soup could wait.",
    "journal.caption.scene.lori_evening": "Lori's evening. Every chair, every window.",
    "journal.caption.scene.lori_platform": "Lori playing in the rain on platform two.",
    "journal.caption.scene.mirek_first": "Mirek, the very first regular.",
    "journal.caption.scene.mirek_letter": "Mirek and the letter, at last.",
    "journal.caption.scene.opening": "The first night. The keys were still cold.",
    "journal.caption.scene.radek_last_shift": "The last whistle of Radek's career.",
    "journal.caption.scene.vera_recipe": "Vera dictated, I wrote it down: kulajda.",
