    "event.staff_quarrel.result.let_be": "The air in the kitchen is thick.",
    "event.staff_quarrel.result.talk": "They breathed out. The knife stayed in the drawer.",
    "event.staff_quarrel.text": "\"That's my knife!\" — \"And this is my shift!\"",
    "event.staff_quarrel.title": "Kitchen quarrel",
    "event.staff_romance.text": "They laugh at the same joke longer than anyone else.",
    "event.staff_romance.title": "Two in love",
    "event.staff_sick.text": "A call at 21:40: \"Sorry, I can't make it tonight.\"",
    "event.staff_sick.title": "Someone's sick",
    "event.staff_walkout.text": "An apron on the hook, a slammed door. Someone has had enough.",
    "event.staff_walkout.title": "Walked out",
    "event.station_cat.choice.feed": "Feed him (−10 CZK)",
    "event.station_cat.choice.shoo": "Shoo him away",
    "event.station_cat.result.feed": "The cat meowed. Probably \"thanks\".",
    "event.station_cat.result.shoo": "The cat left with offended dignity.",
    "event.station_cat.text": "Ginger, cheeky, with a torn ear. Eyeing the cream.",
    "event.station_cat.title": "The station cat",
    "event.storm.text": "The station lamps go out. Only your window is lit. Guests stay longer.",
    "event.storm.title": "Thunderstorm",
    "event.storm_blackout.text": "Only your window is lit. Everyone who's awake follows it.",
    "event.storm_blackout.title": "The whole district in the dark",
    "event.strange_order.choice.black_coffee": "Black coffee",
    "event.strange_order.choice.dont_know": "\"I don't know. Will you tell me?\"",
    "event.strange_order.choice.tea_two_sugars": "Tea with lemon, two sugars",
    "event.strange_order.result.black_coffee": "\"No, no. That was Mirek's.\"",
    "event.strange_order.result.dont_know": "The guest talks for half an hour. Not a word about tea.",
    "event.strange_order.result.tea_two_sugars": "\"Exactly.\" The guest smiles, as if remembering something.",
    "event.strange_order.text": "\"Give me what Lida used to drink.\"",
    "event.strange_order.title": "A strange order",
    "event.student_party.text": "Loud, cheerful and very sticky.",
    "event.student_party.title": "Students after a party",
    "event.supplier_late.text": "The supply drone is stuck in the fog. Milk will come. Sometime after two.",
    "event.supplier_late.title": "Delivery's late",
    "event.taxi_break.text": "Cars lined up outside. Coffee, fast, and off they go. Speed earns tips.",
    "event.taxi_break.title": "Taxi break",
    "experiment.cat_sniffs": "The cat sniffs it, thinks about it, and walks away.",
    "experiment.close.extra": "Almost — one thing too many.",
    "experiment.close.missing": "Almost — it wants something {family}.",
    "experiment.close.swap": "So close — swap the {family} one.",
    "experiment.discovered": "Discovered! {recipe}",
    "experiment.known": "You know this one: {recipe}.",
    "experiment.nothing.1": "It's… drinkable. Kuba drank it anyway.",
    "experiment.nothing.2": "Interesting. In the way a puddle is interesting.",
    "experiment.nothing.3": "That's a flavour. Not a good one, but a flavour.",
    "experiment.nothing.4": "Grandma would have said \"brave\". Grandma was being kind.",
    "experiment.nothing.5": "Into the sink it goes. Nobody saw.",
    "experiment.nothing.6": "Not a recipe yet. Maybe a story for later.",
    "furniture.armchair.desc": "With a lamp beside it, it makes a quiet corner.",
    "furniture.armchair.name": "Armchair",
    "furniture.bar_counter.desc": "Per tile. Lida's was a single piece of oak.",
    "furniture.bar_counter.name": "Bar counter",
    "furniture.bookshelf.desc": "Old books, crosswords and one recipe book.",
    "furniture.bookshelf.name": "Bookshelf",
    "furniture.brass_bell.desc": "Ding. The sound of a coffee being ready, since 1979.",
    "furniture.brass_bell.name": "Brass espresso bell",
    "furniture.cat_bed.desc": "A round cushion by the radiator. Someone will claim it.",
    "furniture.cat_bed.name": "Cat bed",
    "furniture.chair.desc": "Plain and honest, from someone's grandad's pub.",
    "furniture.chair.name": "Chair",
    "furniture.coat_rack.desc": "Wet coats have somewhere to go. Guests sit more comfortably.",
    "furniture.coat_rack.name": "Coat rack",
    "furniture.coffee_machine.desc": "Hisses as if offended. Bites.",
    "furniture.coffee_machine.name": "Rapid coffee machine",
    "furniture.counter_corner.desc": "So the counter can turn a corner.",
    "furniture.counter_corner.name": "Corner counter",
    "furniture.dish_rack.desc": "More room for clean dishes.",
    "furniture.dish_rack.name": "Dish rack",
    "furniture.door.desc": "With the bell Lida never let anyone replace.",
    "furniture.door.name": "Door",
    "furniture.drone_dock.desc": "Supplies fly in even through the fog. No more late deliveries.",
    "furniture.drone_dock.name": "Drone dock",
    "furniture.enamel_sign.desc": "\"Bufet\" in white on bottle green. Rescued from an old platform.",
    "furniture.enamel_sign.name": "Enamel station sign",
    "furniture.espresso_grinder.desc": "A freshly ground scent that lures people in from the platform.",
    "furniture.espresso_grinder.name": "Coffee grinder",
    "furniture.fairy_lights.desc": "A string of tiny warm lights. Paid for by a jar of tips.",
    "furniture.fairy_lights.name": "Fairy lights",
    "furniture.floor_carpet.desc": "Per tile. Cosy, but dirt shows.",
    "furniture.floor_carpet.name": "Carpet",
    "furniture.floor_lamp.desc": "A warm amber pool of light.",
    "furniture.floor_lamp.name": "Floor lamp",
    "furniture.floor_tile.desc": "Per tile. Easy to mop.",
    "furniture.floor_tile.name": "Tiled floor",
    "furniture.floor_wood.desc": "Per tile. Creaks where it should.",
    "furniture.floor_wood.name": "Wooden floor",
    "furniture.fridge.desc": "Hums louder than the radio. Open sandwiches and honey cake.",
    "furniture.fridge.name": "Fridge",
    "furniture.grandma_photo.desc": "Lida laughing at someone outside the frame. Never for sale.",
    "furniture.grandma_photo.name": "Grandma's photo",
    "furniture.jukebox.desc": "Plays by itself when someone is sad.",
    "furniture.jukebox.name": "Jukebox",
    "furniture.lace_tablecloth.desc": "A small table under one of Lida's lace tablecloths.",
    "furniture.lace_tablecloth.name": "Table with grandma's lace",
    "furniture.lamp_brass.desc": "Curved brass and warm glass, in the Art Nouveau style.",
    "furniture.lamp_brass.name": "Brass pendant lamp",
    "furniture.led_strip.desc": "A slim column of warm indigo light.",
    "furniture.led_strip.name": "LED strip lamp",
    "furniture.menu_holo_board.desc": "Glows violet into the rain. The font can be enlarged.",
    "furniture.menu_holo_board.name": "Holo menu board",
    "furniture.mosaic_rug.desc": "A rug with a sage-and-gold Secession pattern.",
    "furniture.mosaic_rug.name": "Mosaic rug",
    "furniture.napkin_wall.desc": "Thank-you napkins pinned in a frame. Every one a small night.",
    "furniture.napkin_wall.name": "Napkin wall",
    "furniture.oven.desc": "Keeps the kolaches warm.",
    "furniture.oven.name": "Oven",
    "furniture.pendant_lamp.desc": "Hangs over a table and stays out of the way.",
    "furniture.pendant_lamp.name": "Pendant lamp",
    "furniture.plant_small.desc": "A green dot in the night.",
    "furniture.plant_small.name": "Small plant",
    "furniture.plant_tall.desc": "Grows faster than the debt. Almost.",
    "furniture.plant_tall.name": "Tall monstera",
    "furniture.radio.desc": "An old valve radio. Whoever fixes it may hear more than music.",
    "furniture.radio.name": "Lida's radio",
    "furniture.record_shelf.desc": "A shelf for sleeves and stories. Music lovers linger by it.",
    "furniture.record_shelf.name": "Record shelf",
    "furniture.register.desc": "Takes cards, phones and good old coins. Not the Czechoslovak ones.",
    "furniture.register.name": "Register",
    "furniture.rug.desc": "Muffles footsteps and arguments.",
    "furniture.rug.name": "Rug",
    "furniture.sink.desc": "Cups won't wash themselves without it. Sadly.",
    "furniture.sink.name": "Sink",
    "furniture.sofa.desc": "Soft as the end of a shift. Guests stay longer.",
    "furniture.sofa.name": "Sofa",
    "furniture.stage_corner.desc": "A rug, a microphone and courage. Unlocks open-mic nights.",
    "furniture.stage_corner.name": "Little stage",
    "furniture.stool.desc": "For those who have four minutes.",
    "furniture.stool.name": "Bar stool",
    "furniture.stove.desc": "Soups, toast and everything that warms you up.",
    "furniture.stove.name": "Stove",
    "furniture.table_round.desc": "For two and one secret.",
    "furniture.table_round.name": "Round table",
    "furniture.table_socket.desc": "Students would sell their souls for it. And buy one coffee.",
    "furniture.table_socket.name": "Table with a socket",
    "furniture.table_square.desc": "For a group off the shift or out of the concert.",
    "furniture.table_square.name": "Large table",
    "furniture.trash_bin.desc": "Fewer napkins on the floor.",
    "furniture.trash_bin.name": "Bin",
    "furniture.wall.desc": "Holds up the roof and the photos.",
    "furniture.wall.name": "Wall",
    "furniture.window.desc": "From inside you see the rain. From outside, the light.",
    "furniture.window.name": "Window",
    "furniture.window_seat.desc": "A view of the platform and the rain. Someone sits here at 3:33.",
    "furniture.window_seat.name": "Window seat",
    "guest.clubbers.desc": "Wet jackets, loud laughter, want everything now. Mostly Fridays and Saturdays.",
    "guest.clubbers.name": "Concert crowd",
    "guest.clubbers.one": "Concertgoer",
    "guest.drone_operators.desc": "They watch the delivery drones over wet roofs. They don't put the controller down even for coffee.",
    "guest.drone_operators.name": "Drone operators",
    "guest.drone_operators.one": "Drone operator",
    "guest.insomniacs.desc": "Tea, a kolach and a crossword. They become regulars fastest of all.",
    "guest.insomniacs.name": "Insomniacs",
    "guest.insomniacs.one": "Night owl",
    "guest.night_wanderer.desc": "Nobody knows where they came from. They sit under the lamp and tip generously.",
    "guest.night_wanderer.name": "Night wanderer",
    "guest.night_wanderer.one": "Night wanderer",
    "guest.nurses.desc": "Short breaks, long gratitude. Their reviews count for more.",
    "guest.nurses.name": "Nurses",
    "guest.nurses.one": "Nurse",
    "guest.patrol.desc": "Two officers, two coffees, one \"everything all right?\".",
    "guest.patrol.name": "Night patrol",
    "guest.patrol.one": "Patrol officer",
    "guest.shift_workers.desc": "Shift change at the logistics depot. They come in groups, eat a lot and check their shifts in Shiftella.",
    "guest.shift_workers.name": "Shift workers",
    "guest.shift_workers.one": "Shift worker",
    "guest.students.desc": "Stay long, pay little, want a socket.",
    "guest.students.name": "Students",
    "guest.students.one": "Student",
    "guest.taxi_drivers.desc": "The last taxi drivers with their hands on a wheel. Quick coffee and off again.",
    "guest.taxi_drivers.name": "Taxi drivers",
    "guest.taxi_drivers.one": "Taxi driver",
    "guest.train_crew.desc": "Their schedule lives in Shiftella; their hunger lives for soup.",
    "guest.train_crew.name": "Train crew",
    "guest.train_crew.one": "Train conductor",
    "guest.travelers.desc": "Arriving, leaving or waiting for a connection. Their suitcases take up room.",
    "guest.travelers.name": "Travellers",
    "guest.travelers.one": "Traveller",
    "guest.truckers.desc": "Their trucks drive themselves now. They still need soup.",
    "guest.truckers.name": "Truckers",
    "guest.truckers.one": "Trucker",
    "hall_mood.calm": "Calm",
    "hall_mood.dreamy": "Dreamy",
    "hall_mood.lively": "Lively",
    "hall_mood.nostalgic": "Nostalgic",
    "hall_mood.tender": "Tender",
