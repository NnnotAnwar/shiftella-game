    "difficulty.classic.desc": "Payments matter. Miss two and the café closes — an ending to the story, not a defeat.",
    "difficulty.classic.name": "Classic",
    "difficulty.cozy.desc": "No game over. A missed payment just grumbles. More money, more patient guests. Default.",
    "difficulty.cozy.name": "Cozy",
    "ending.extra.answer.title": "The Answer",
    "ending.last_train.summary": "Café Nocturne closes. A last night with the regulars and the morning train to Beroun.",
    "ending.last_train.title": "Last Train",
    "ending.last_train.variant.closed": "The café closed. Holešovice at night isn't a place for big goodbyes.",
    "ending.last_train.variant.farewell": "The regulars helped you pack and talked you into opening something of your own.",
    "ending.last_train.variant.sold": "Sold to NONSTOP 24. The window is always lit — and nobody waits in it.",
    "ending.light.summary": "The café is saved and stayed itself. Tomorrow at ten, the light in the window goes on again.",
    "ending.light.title": "Light in the Window",
    "ending.light.variant.full": "A full café at six in the morning. The regulars are your new family.",
    "ending.light.variant.quiet": "The light is on. For now, there's nobody to wait for.",
    "event.big_tip.text": "Under the cup, a banknote and a napkin: \"Thank you for being open.\"",
    "event.big_tip.title": "A generous stranger",
    "event.broken_dishes.text": "Crash. Everyone looks towards the kitchen.",
    "event.broken_dishes.title": "Broken dishes",
    "event.cat_stays.text": "The third night in a row. The cat lay down on the radiator and declared the café his. He works here now, too.",
    "event.cat_stays.title": "The cat stays",
    "event.clock_333.text": "3:33. The second hand freezes and the radio hisses for a minute.",
    "event.clock_333.title": "The clock stopped",
    "event.coffee_machine.choice.call_service": "Call the service (−400 CZK)",
    "event.coffee_machine.choice.fix_ourselves": "Fix it ourselves (20 min)",
    "event.coffee_machine.result.call_service": "The technician came by drone. The machine is good as new.",
    "event.coffee_machine.result.fix_ourselves": "A screwdriver, some patience, and it's running again.",
    "event.coffee_machine.text": "It hisses as if offended. Coffee flows at half speed.",
    "event.coffee_machine.title": "The coffee machine sulks",
    "event.concert_crowd.text": "The concert at the culture house is over. Twelve wet jackets — and all of them hungry.",
    "event.concert_crowd.title": "Concert crowd",
    "event.depot_shift.text": "Hi-vis vests and phones open on Shiftella: \"Who took my Wednesday?\" Everyone's hungry.",
    "event.depot_shift.title": "Depot shift change",
    "event.dine_and_dash.text": "An empty table and a half-eaten soup.",
    "event.dine_and_dash.title": "Dine and dash",
    "event.downpour.text": "The sky has burst. Half the station is hiding in your café.",
    "event.downpour.title": "Downpour",
    "event.drone_lost.choice.charge_it": "Charge it and send it on (−20 CZK)",
    "event.drone_lost.choice.return_it": "Report it to its owner",
    "event.drone_lost.result.charge_it": "The drone flew off with a wave of its rotor. The town is talking about it.",
    "event.drone_lost.result.return_it": "The owner said thanks and let you keep the lemons. Perfect for tea.",
    "event.drone_lost.text": "A delivery drone has landed on the doorstep with a box of lemons. It blinks and looks guilty.",
    "event.drone_lost.title": "Lost drone",
    "event.first_snow.text": "Silence. The guests whisper, as if afraid to scare it away.",
    "event.first_snow.title": "First snow",
    "event.fog.text": "Milk rises off the Vltava. You can see the café window. Nothing else.",
    "event.fog.title": "Fog off the river",
    "event.forgotten_item.choice.keep": "Keep it",
    "event.forgotten_item.choice.lost_and_found": "Lost and found",
    "event.forgotten_item.result.keep": "The umbrella hangs on the coat rack. Waiting.",
    "event.forgotten_item.result.lost_and_found": "The next night a lady came back for it. She was touched.",
    "event.forgotten_item.text": "An old umbrella with a monogram, left on a chair.",
    "event.forgotten_item.title": "Forgotten item",
    "event.fridge_fail.text": "It hums louder than the radio. Then it goes silent. Some of the stock is lost.",
    "event.fridge_fail.title": "The fridge groans",
    "event.health_inspection.fine": "A 2,000 CZK fine and reputation −10. The inspector leaves without a word.",
    "event.health_inspection.pass": "The inspector leaves satisfied. Reputation +5.",
    "event.health_inspection.text": "Stern glasses, a tablet. \"Don't mind me.\"",
    "event.health_inspection.title": "Health inspection",
    "event.health_inspection.warning": "A warning: \"Next time I'd like to see it cleaner.\"",
    "event.holo_flicker.text": "The holo sign over the door flickers between \"CAFÉ NOCTURNE\" and \"WE'RE WAITING\". Passers-by stop to look.",
    "event.holo_flicker.title": "Flickering sign",
    "event.hospital_shift.text": "Scrubs under jackets. They need soup and five minutes of quiet.",
    "event.hospital_shift.title": "Hospital shift change",
    "event.late_train.text": "The express is stuck for two hours. Grumpy passengers with suitcases on the platform.",
    "event.late_train.title": "Late train",
    "event.lonely_night.text": "Nobody. Just rain, the fridge humming and the radio. Time for a big clean — and for talking.",
    "event.lonely_night.title": "An empty night",
    "event.lost_bus.text": "A tour coach took a wrong turn. The guide asks if you have thirty portions of soup.",
    "event.lost_bus.title": "Lost coach",
    "event.mirek_accident.text": "Mirek's taxi ended up in the railings. Nobody was badly hurt. Mirek won't be coming back.",
    "event.mirek_accident.title": "Accident by the station",
    "event.night_blogger.text": "Films the cup from three angles before tasting. Their review counts three times.",
    "event.night_blogger.title": "Night streamer",
    "event.open_mic.text": "Someone tunes a guitar and the room falls quiet.",
    "event.open_mic.title": "Open-mic night",
    "event.phantom_horn.text": "A long horn. The departure board is empty.",
    "event.phantom_horn.title": "A horn without a train",
    "event.police_patrol.text": "Two officers, two coffees, one \"everything all right?\". A few quiet nights ahead.",
    "event.police_patrol.title": "Night patrol",
    "event.power_outage.choice.candles": "Light candles (−150 CZK)",
    "event.power_outage.choice.close_kitchen": "Close the kitchen",
    "event.power_outage.result.candles": "Candles lit. The guests like it — \"cosy\".",
    "event.power_outage.result.close_kitchen": "Kitchen closed. Cold food only.",
    "event.power_outage.text": "Click — and darkness. Only the station neon through the window. The coffee machine and stove are dead.",
    "event.power_outage.title": "Power cut",
    "event.rain.text": "Raindrops on the glass, the holo sign blurs. People come in to wait it out.",
    "event.rain.title": "Rain",
    "event.roof_leak.choice.bucket": "Put a bucket under it",
    "event.roof_leak.choice.roofer": "Call a roofer (−900 CZK)",
    "event.roof_leak.result.bucket": "The bucket plinks along with the rain.",
    "event.roof_leak.result.roofer": "Roof fixed. That spot won't drip again.",
    "event.roof_leak.text": "Drip. Drip. Right next to the counter.",
    "event.roof_leak.title": "Leaking roof",
    "event.staff_birthday.choice.cake": "Buy a cake (−150 CZK)",
    "event.staff_birthday.choice.sing": "Just sing",
    "event.staff_birthday.result.cake": "Cake, candles, off-key singing. The team holds together.",
    "event.staff_birthday.result.sing": "Happy birthday! At least they sang in tune. Almost.",
    "event.staff_birthday.text": "Someone brought a kolach with a candle in it.",
    "event.staff_birthday.title": "Birthday",
    "event.staff_inspired.text": "\"Hey, what if we put some… on the toast?\"",
    "event.staff_inspired.title": "Inspiration",
    "event.staff_quarrel.choice.let_be": "Let them sort it out",
    "event.staff_quarrel.choice.talk": "Talk to them",
    "event.staff_quarrel.result.let_be": "The air in the kitchen is thick.",
    "event.staff_quarrel.result.talk": "They breathed out. The knife stayed in the drawer.",
    "event.staff_quarrel.text": "\"That's my knife!\" — \"And this is my shift!\"",
    "event.staff_quarrel.title": "Kitchen quarrel",
    "event.staff_romance.text": "They laugh at the same joke longer than anyone else.",
    "event.staff_romance.title": "Two in love",
    "event.staff_sick.text": "A call at 21:40: \"Sorry, I can't make it tonight.\"",
    "event.staff_sick.title": "Someone's sick",
    "event.staff_walkout.text": "An apron on the hook, a slammed door. Someone has had enough.",
    "event.staff_walkout.title": "Walked out",
    "event.station_cat.choice.feed": "Feed him (−10 CZK)",
    "event.station_cat.choice.shoo": "Shoo him away",
    "event.station_cat.result.feed": "The cat meowed. Probably \"thanks\".",
    "event.station_cat.result.shoo": "The cat left with offended dignity.",
    "event.station_cat.text": "Ginger, cheeky, with a torn ear. Eyeing the cream.",
    "event.station_cat.title": "The station cat",
    "event.storm.text": "The station lamps go out. Only your window is lit. Guests stay longer.",
    "event.storm.title": "Thunderstorm",
    "event.storm_blackout.text": "Only your window is lit. Everyone who's awake follows it.",
    "event.storm_blackout.title": "The whole district in the dark",
    "event.strange_order.choice.black_coffee": "Black coffee",
    "event.strange_order.choice.dont_know": "\"I don't know. Will you tell me?\"",
    "event.strange_order.choice.tea_two_sugars": "Tea with lemon, two sugars",
    "event.strange_order.result.black_coffee": "\"No, no. That was Mirek's.\"",
    "event.strange_order.result.dont_know": "The guest talks for half an hour. Not a word about tea.",
    "event.strange_order.result.tea_two_sugars": "\"Exactly.\" The guest smiles, as if remembering something.",
    "event.strange_order.text": "\"Give me what Lida used to drink.\"",
    "event.strange_order.title": "A strange order",
    "event.student_party.text": "Loud, cheerful and very sticky.",
    "event.student_party.title": "Students after a party",
    "event.supplier_late.text": "The supply drone is stuck in the fog. Milk will come. Sometime after two.",
    "event.supplier_late.title": "Delivery's late",
    "event.taxi_break.text": "Cars lined up outside. Coffee, fast, and off they go. Speed earns tips.",
    "event.taxi_break.title": "Taxi break",
    "furniture.armchair.desc": "With a lamp beside it, it makes a quiet corner.",
    "furniture.armchair.name": "Armchair",
    "furniture.bar_counter.desc": "Per tile. Lida's was a single piece of oak.",
    "furniture.bar_counter.name": "Bar counter",
    "furniture.bookshelf.desc": "Old books, crosswords and one recipe book.",
    "furniture.bookshelf.name": "Bookshelf",
    "furniture.chair.desc": "Plain and honest, from someone's grandad's pub.",
    "furniture.chair.name": "Chair",
    "furniture.coat_rack.desc": "Wet coats have somewhere to go. Guests sit more comfortably.",
    "furniture.coat_rack.name": "Coat rack",
    "furniture.coffee_machine.desc": "Hisses as if offended. Bites.",
    "furniture.coffee_machine.name": "Rapid coffee machine",
    "furniture.counter_corner.desc": "So the counter can turn a corner.",
    "furniture.counter_corner.name": "Corner counter",
    "furniture.dish_rack.desc": "More room for clean dishes.",
    "furniture.dish_rack.name": "Dish rack",
    "furniture.door.desc": "With the bell Lida never let anyone replace.",
    "furniture.door.name": "Door",
    "furniture.drone_dock.desc": "Supplies fly in even through the fog. No more late deliveries.",
    "furniture.drone_dock.name": "Drone dock",
    "furniture.espresso_grinder.desc": "A freshly ground scent that lures people in from the platform.",
    "furniture.espresso_grinder.name": "Coffee grinder",
    "furniture.floor_carpet.desc": "Per tile. Cosy, but dirt shows.",
    "furniture.floor_carpet.name": "Carpet",
    "furniture.floor_lamp.desc": "A warm amber pool of light.",
    "furniture.floor_lamp.name": "Floor lamp",
    "furniture.floor_tile.desc": "Per tile. Easy to mop.",
    "furniture.floor_tile.name": "Tiled floor",
    "furniture.floor_wood.desc": "Per tile. Creaks where it should.",
    "furniture.floor_wood.name": "Wooden floor",
    "furniture.fridge.desc": "Hums louder than the radio. Open sandwiches and honey cake.",
    "furniture.fridge.name": "Fridge",
    "furniture.grandma_photo.desc": "Lida laughing at someone outside the frame. Never for sale.",
    "furniture.grandma_photo.name": "Grandma's photo",
    "furniture.jukebox.desc": "Plays by itself when someone is sad.",
    "furniture.jukebox.name": "Jukebox",
    "furniture.menu_holo_board.desc": "Glows violet into the rain. The font can be enlarged.",
    "furniture.menu_holo_board.name": "Holo menu board",
    "furniture.oven.desc": "Keeps the kolaches warm.",
    "furniture.oven.name": "Oven",
    "furniture.pendant_lamp.desc": "Hangs over a table and stays out of the way.",
    "furniture.pendant_lamp.name": "Pendant lamp",
    "furniture.plant_small.desc": "A green dot in the night.",
    "furniture.plant_small.name": "Small plant",
    "furniture.plant_tall.desc": "Grows faster than the debt. Almost.",
    "furniture.plant_tall.name": "Tall monstera",
    "furniture.radio.desc": "An old valve radio. Whoever fixes it may hear more than music.",
    "furniture.radio.name": "Lida's radio",
    "furniture.register.desc": "Takes cards, phones and good old coins. Not the Czechoslovak ones.",
    "furniture.register.name": "Register",
    "furniture.rug.desc": "Muffles footsteps and arguments.",
    "furniture.rug.name": "Rug",
    "furniture.sink.desc": "Cups won't wash themselves without it. Sadly.",
    "furniture.sink.name": "Sink",
    "furniture.sofa.desc": "Soft as the end of a shift. Guests stay longer.",
    "furniture.sofa.name": "Sofa",
    "furniture.stage_corner.desc": "A rug, a microphone and courage. Unlocks open-mic nights.",
    "furniture.stage_corner.name": "Little stage",
    "furniture.stool.desc": "For those who have four minutes.",
    "furniture.stool.name": "Bar stool",
    "furniture.stove.desc": "Soups, toast and everything that warms you up.",
    "furniture.stove.name": "Stove",
    "furniture.table_round.desc": "For two and one secret.",
    "furniture.table_round.name": "Round table",
    "furniture.table_socket.desc": "Students would sell their souls for it. And buy one coffee.",
    "furniture.table_socket.name": "Table with a socket",
    "furniture.table_square.desc": "For a group off the shift or out of the concert.",
    "furniture.table_square.name": "Large table",
    "furniture.trash_bin.desc": "Fewer napkins on the floor.",
    "furniture.trash_bin.name": "Bin",
    "furniture.wall.desc": "Holds up the roof and the photos.",
    "furniture.wall.name": "Wall",
    "furniture.window.desc": "From inside you see the rain. From outside, the light.",
    "furniture.window.name": "Window",
    "furniture.window_seat.desc": "A view of the platform and the rain. Someone sits here at 3:33.",
    "furniture.window_seat.name": "Window seat",
    "guest.clubbers.desc": "Wet jackets, loud laughter, want everything now. Mostly Fridays and Saturdays.",
    "guest.clubbers.name": "Concert crowd",
    "guest.drone_operators.desc": "They watch the delivery drones over wet roofs. They don't put the controller down even for coffee.",
    "guest.drone_operators.name": "Drone operators",
    "guest.insomniacs.desc": "Tea, a kolach and a crossword. They become regulars fastest of all.",
    "guest.insomniacs.name": "Insomniacs",
    "guest.night_wanderer.desc": "Nobody knows where they came from. They sit under the lamp and tip generously.",
    "guest.night_wanderer.name": "Night wanderer",
    "guest.nurses.desc": "Short breaks, long gratitude. Their reviews count for more.",
    "guest.nurses.name": "Nurses",
    "guest.patrol.desc": "Two officers, two coffees, one \"everything all right?\".",
    "guest.patrol.name": "Night patrol",
    "guest.shift_workers.desc": "Shift change at the logistics depot. They come in groups, eat a lot and check their shifts in Shiftella.",
    "guest.shift_workers.name": "Shift workers",
    "guest.students.desc": "Stay long, pay little, want a socket.",
    "guest.students.name": "Students",
    "guest.taxi_drivers.desc": "The last taxi drivers with their hands on a wheel. Quick coffee and off again.",
    "guest.taxi_drivers.name": "Taxi drivers",
    "guest.train_crew.desc": "Their schedule lives in Shiftella; their hunger lives for soup.",
    "guest.train_crew.name": "Train crew",
    "guest.travelers.desc": "Arriving, leaving or waiting for a connection. Their suitcases take up room.",
    "guest.travelers.name": "Travellers",
    "guest.truckers.desc": "Their trucks drive themselves now. They still need soup.",
    "guest.truckers.name": "Truckers",
    "item.cafe_keys.desc": "They were under the mat. Of course.",
    "item.cafe_keys.name": "Café keys",
    "item.letter.desc": "A sealed envelope, \"For Jindra\". It weighs about twenty grams.",
    "item.letter.name": "Lida's letter",
    "item.lost_umbrella.desc": "Someone may come back for it.",
    "item.lost_umbrella.name": "Monogrammed umbrella",
    "item.old_coin.desc": "Czechoslovak crowns from 1978. No longer money.",
    "item.old_coin.name": "Old coins",
    "item.recipe_book.desc": "Greasy pages and notes in the margins.",
    "item.recipe_book.name": "Lida's recipe book",
    "item.rn333_ticket.desc": "A return, 14 November 1979. The return half unused.",
    "item.rn333_ticket.name": "Rn 333 ticket",
    "item.timetable_1979.desc": "Next to the last line, in pencil: \"two minutes\".",
    "item.timetable_1979.name": "1979 timetable",
    "mainmenu.continue_none": "No saved game yet",
    "mainmenu.lang.greeting": "Good evening, come on in.",
    "mainmenu.newgame.hint": "How should the nights feel? Difficulty applies to the whole story.",
    "mainmenu.newgame.recommended": "Recommended",
    "mainmenu.newgame.start": "Step off at Holešovice",
    "mainmenu.newgame.title": "A new story",
    "mainmenu.sandbox.dice": "Roll the dice",
