    "event.forgotten_item.result.lost_and_found": "The next night a lady came back for it. She was touched.",
    "event.forgotten_item.text": "An old umbrella with a monogram, left on a chair.",
    "event.forgotten_item.title": "Forgotten item",
    "event.fridge_fail.text": "It hums louder than the radio. Then it goes silent. Some of the stock is lost.",
    "event.fridge_fail.title": "The fridge groans",
    "event.health_inspection.fine": "A 2,000 CZK fine and reputation −10. The inspector leaves without a word.",
