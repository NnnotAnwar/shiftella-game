    "signature.sub": "Grandma always had one of her own. Make ours.",
    "signature.suggest.1": "Holešovice Night",
    "signature.suggest.10": "Station Cat",
    "signature.suggest.11": "Platform 3",
    "signature.suggest.12": "Night Train to Cheb",
    "signature.suggest.2": "Lida's Cup",
    "signature.suggest.3": "Rain on the Tracks",
    "signature.suggest.4": "Last Tram",
    "signature.suggest.5": "Warm Lamp",
    "signature.suggest.6": "Grandma's Secret",
    "signature.suggest.7": "Quiet Hour",
    "signature.suggest.8": "Velvet Fog",
    "signature.suggest.9": "Morning Shift",
    "signature.tastes": "Tastes",
    "signature.title": "Our own drink",
    "signature.tweak": "You can still tweak it tonight.",
    "signature.wish.filip": "One «{drink}» — if it's not too pricey.",
    "signature.wish.hana": "«{drink}». Before my phone goes again.",
    "signature.wish.house_special": "«{drink}», please — the one on the board.",
    "signature.wish.lori": "The «{drink}» everyone talks about. For the voice.",
    "signature.wish.mirek": "Let me try that «{drink}» of yours, Karolina. People talk.",
    "signature.wish.radek": "«{drink}». I've earned it tonight.",
    "signature.wish.vera": "Show me this «{drink}» of yours. Lida would want to know.",
    "staff.barista.bio": "Bára dropped out of university in Prague and hasn't told her parents. Her coffee is better than her thesis was.",
    "staff.barista.dislikes": "Silence, washing up",
    "staff.barista.likes": "Music in the hall, chatting with guests",
    "staff.barista.pref.exam": "Exam on Friday. I can't miss it.",
    "staff.barista.pref.late": "Late shifts, please. I'm a different person after midnight.",
    "staff.barista.pref.sunday": "Sunday lunch with my parents. They think I'm still at uni.",
    "staff.barista.role": "Night barista",
    "staff.cashier.bio": "Ivana works nights while her daughter sleeps at the neighbour's. One phone call can upend a whole shift.",
    "staff.cashier.dislikes": "Lateness, chaos",
    "staff.cashier.likes": "Precision, being praised",
    "staff.cashier.pref.early": "Home by half past two — my daughter wakes at night.",
    "staff.cashier.pref.hours": "Four nights at least. I need the hours.",
    "staff.cashier.role": "Register & floor",
    "staff.cook.bio": "Mr Holub cooked for twenty years in the glassworks canteen. He knew Lida and grumbles that \"it was different in her day\".",
    "staff.cook.dislikes": "Rushing, people touching his things",
    "staff.cook.likes": "An orderly kitchen, his own knife",
    "staff.cook.pref.back": "Not two nights in a row. My back.",
    "staff.cook.pref.full": "Full nights. Half a night is half a soup.",
    "staff.cook.role": "Cook",
    "staff.porter.bio": "Kuba used to haul crates at a warehouse. He's kind and drops everything. Secretly, he's learning to bake.",
    "staff.porter.dislikes": "Loud arguments",
    "staff.porter.likes": "Animals (cats!), food",
    "staff.porter.pref.cook": "Mr Holub lets me watch him bake.",
    "staff.porter.role": "Helper & cleaning",
    "staff.quiet_one.bio": "Ema hears the horns of trains that aren't in the timetable. She's the only one who notices the clock stopping at 3:33.",
    "staff.quiet_one.dislikes": "Crowds, harsh light",
    "staff.quiet_one.likes": "Rain, the quiet hours between two and four",
    "staff.quiet_one.pref.tuesday": "Lectures on Tuesdays.",
    "staff.quiet_one.pref.weekend": "Not weekends, if possible. Crowds.",
    "staff.quiet_one.role": "All-rounder",
    "staff.server.bio": "Natália came from Košice for a week and stayed. She carries four plates at once and remembers every name.",
    "staff.server.dislikes": "Sticky floors",
    "staff.server.likes": "Clean tables, rainy nights",
    "staff.server.pref.bara": "With Bára, if I can. She makes the nights go fast.",
    "staff.server.pref.max": "Five nights, no more. I've got a life to visit.",
    "staff.server.role": "Server",
    "staff.sound_tech.bio": "Oleh was a sound engineer in Lviv. He's been here \"temporarily\" for two years now. He can fix an old radio.",
    "staff.sound_tech.dislikes": "Cheap coffee",
    "staff.sound_tech.likes": "Old records, the radio",
    "staff.sound_tech.pref.late": "Late, please. I sound better after midnight. So does the coffee.",
    "staff.sound_tech.pref.thursday": "Thursday's band rehearsal — and the video call home.",
    "staff.sound_tech.role": "Bar & floor",
    "storm.act.blankets": "Blankets for all",
    "storm.act.blankets.tip": "Grandma's blankets from under the counter: warmer guests, a cozier hall.",
    "storm.act.on_way": "On your way…",
    "storm.act.soup": "A pot of soup",
    "storm.act.soup.tip": "A pot on the stove and a bowl for everyone who stayed.",
    "storm.cancel.stay": "Everyone inside stays till morning.",
    "storm.cancel.text": "Praha-Holešovice: due to the snowstorm, all night trains are cancelled until 06:00.",
    "storm.cancel.title": "Trains cancelled",
    "storm.cared.blankets": "Grandma's blankets came out of the cupboard. Everyone's warm.",
    "storm.cared.soup": "The big pot is on: a bowl of soup for everyone.",
    "storm.chip.stranded.few": "{n} guests stay the night",
    "storm.chip.stranded.many": "{n} guests stay the night",
    "storm.chip.stranded.one": "{n} guest stays the night",
    "storm.chip.title": "Snowed in",
    "storm.done.blankets": "All tucked in",
    "storm.done.soup": "Soup for everyone",
    "storm.forecast.text": "Heavy snow all night. The station is worried about the line.",
    "storm.forecast.title": "A snowstorm is coming",
    "storm.morning.cared": "The first trains are running. Everyone says thank you on the way out.",
    "storm.morning.plain": "The first trains are running again.",
    "storm.morning.title": "The snow has stopped",
    "storm.talk.intro": "Three in the morning. Snow against the windows, and nobody's going anywhere.",
    "storm.talk.snow.1": "So. Nobody's going anywhere tonight.",
    "storm.talk.snow.2": "My phone says the first train is at six. It also says it's sunny.",
    "storm.talk.snow.3": "Nobody's waiting for me at home anyway. At least it's warm here.",
    "storm.talk.snow.4": "It's always warm here. Grandma's rule.",
    "storm.talk.snow.5": "{a} has a point. Three cheers for the snow.",
    "storm.talk.snow.6": "To the snow. And to the café that never closes.",
    "storm.talk.trains.1": "Děčín will have to wait till morning.",
    "storm.talk.trains.2": "Frýdlant too. Someone there is keeping dinner warm. Breakfast now, I suppose.",
    "storm.talk.trains.3": "I live five minutes from here. I just didn't feel like going home.",
    "storm.talk.trains.4": "Five minutes? And still here. {c} knows a good place.",
    "storm.talk.trains.5": "Nobody's alone here tonight. More tea?",
    "storm.talk.trains.6": "Yes, please. And tell us about this place — it feels so old.",
    "storm.talk.trains.7": "Look. The snow's covered the tracks. Like a blanket.",
    "story.act.1.title": "Act I — The Keys",
    "story.act.2.title": "Act II — The Regulars",
    "story.act.3.title": "Act III — The Offer",
    "story.act.4.title": "Act IV — The Last Train",
    "story.birthday.log": "{name}: a birthday after all.",
    "story.birthday.opt.candle": "A candle in a slice of cake",
    "story.birthday.opt.record": "Put a record on",
    "story.birthday.opt.sing": "Wish a happy birthday from the counter",
    "story.birthday.react.candle": "Oh… Nobody's done that in years. Thank you.",
    "story.birthday.react.record": "Nice tune. Thanks.",
    "story.birthday.react.sing": "You heard that? …Thank you. Really.",
    "story.birthday.text": "A birthday tonight. Nobody to share it with — just a quiet cup.",
    "story.cabbie.log": "{name}: twelve hours at the wheel, then a rest.",
    "story.cabbie.opt.corner": "The quiet corner and a refill",
    "story.cabbie.opt.sandwich": "A sandwich on the house",
    "story.cabbie.opt.word": "Ask how the night went",
    "story.cabbie.react.corner": "Quiet. Nobody saying \"faster\". Lovely.",
    "story.cabbie.react.sandwich": "First real food since noon. You're a treasure.",
    "story.cabbie.react.word": "Three drunks, one proposal, a goose. A normal night.",
    "story.cabbie.text": "Twelve hours at the wheel. The hands still hold an invisible one.",
    "story.call.log": "{name}: the call comes through at last.",
    "story.call.opt.charger": "Lend the charger",
    "story.call.opt.tea": "A cup of tea, on the house",
    "story.call.opt.window": "The window seat — better signal",
    "story.call.react.charger": "Oh, thank you. If it rings now, it's your doing.",
    "story.call.react.tea": "Thanks. It helps to hold something warm.",
    "story.call.react.window": "Two bars. Two whole bars! Thank you.",
    "story.call.text": "Phone face up on the table, 4 % battery. Waiting for a call that doesn't come.",
    "story.cat_lady.log": "{name}: ham for the station cat, milk from the café.",
    "story.cat_lady.opt.saucer": "A saucer of milk by the door",
    "story.cat_lady.opt.window": "The seat by the window — the cat comes there",
    "story.cat_lady.opt.word": "Ask about the cat",
    "story.cat_lady.react.saucer": "Oh, she'll love you for this. So will I.",
    "story.cat_lady.react.window": "There she is! Hello, my sweet.",
    "story.cat_lady.react.word": "She's been coming for years. Smarter than the trains.",
    "story.cat_lady.text": "Bits of ham saved in a napkin — for the station cat.",
    "story.cello.log": "{name}: a cello, a long concert, a warm corner.",
    "story.cello.opt.coffee": "A coffee, on the house",
    "story.cello.opt.corner": "Make room for the cello in the corner",
    "story.cello.opt.play": "Ask for one short piece",
    "story.cello.react.coffee": "Thank you. My hands are still playing.",
    "story.cello.react.corner": "It has its own seat now. It'll be unbearable.",
    "story.cello.react.play": "Just one. Something for the night.",
    "story.cello.text": "A cello case leaning on the chair. Back from a concert, far too awake to sleep.",
    "story.chess.log": "{name}: one quick game of chess.",
    "story.chess.opt.play": "Play one quick game",
    "story.chess.opt.window": "Set the board up by the window",
    "story.chess.react.play": "Check. …Ah, you let me win. Again tomorrow?",
    "story.chess.react.window": "Thank you. The night can watch the game.",
    "story.chess.text": "A pocket chess set, the pieces in place. Waiting for an opponent.",
    "story.conductor.log": "{name}: forty years on the rails, one last night shift.",
    "story.conductor.opt.cake": "A slice of cake, on the house",
    "story.conductor.opt.toast": "Raise a cup to forty years",
    "story.conductor.opt.word": "Ask about the old trains",
    "story.conductor.react.cake": "Forty years, and the first cake. Thank you.",
    "story.conductor.react.toast": "To the rails! And to whoever keeps this light on.",
    "story.conductor.react.word": "Steam was before my time. But the old Rn 333… everyone talked about that one.",
    "story.conductor.text": "The last shift before retirement. Forty years on the rails.",
    "story.couple.log": "{name}: two at one table, talking again.",
    "story.couple.opt.ask": "Ask if everything's all right",
    "story.couple.opt.candle": "Light the candle on their table",
    "story.couple.opt.spoons": "One dessert, two spoons",
    "story.couple.react.ask": "Yes. Yes, fine. Thank you.",
    "story.couple.react.candle": "Huh. Like our first evening.",
    "story.couple.react.spoons": "…You take the first bite. No, you.",
    "story.couple.text": "Two at one table, not a word between them. Two cups going cold.",
    "story.exam.log": "{name}: the state exam at nine, and courage to go with it.",
    "story.exam.opt.luck": "Wish them luck",
    "story.exam.opt.mug": "Grandma's lucky mug",
    "story.exam.opt.quiz": "Quiz them from the notes",
    "story.exam.react.luck": "Thanks. Luck is exactly what I need.",
    "story.exam.react.mug": "Lucky mug, lucky exam. That's science.",
    "story.exam.react.quiz": "That one I know! I actually know this!",
    "story.exam.text": "State exam at nine. Notes everywhere, the coffee long gone cold.",
    "story.grandchild.log": "{name}: a brand-new grandchild, shown to the whole café.",
    "story.grandchild.opt.cocoa": "A cocoa to celebrate",
    "story.grandchild.opt.look": "Look at the photo properly",
    "story.grandchild.opt.nod": "Smile and nod",
    "story.grandchild.react.cocoa": "To little Jonáš! Nine days old.",
    "story.grandchild.react.look": "See those ears? Exactly my ears.",
    "story.grandchild.react.nod": "Isn't he lovely? Nine days old.",
    "story.grandchild.text": "A photo on the phone, shown to anyone nearby: a brand-new grandchild.",
    "story.hint.app": "Shiftella has shift swaps, time off, announcements and the morning digest.",
    "story.hint.armchair": "An armchair with a floor lamp beside it makes a quiet corner.",
    "story.hint.build": "In Build ({key.build}) you can add tables, lamps and plants. Money is taken right away; Ctrl+Z undoes.",
    "story.hint.candles": "Without power, only cold food can be sold. Candles cheer the guests up.",
    "story.hint.downpour": "Downpour! More guests are coming in — put someone on cleaning.",
    "story.hint.duties": "Helpers only do the duties you give them ({key.duties}). The guests with wishes are yours.",
    "story.hint.farewell": "The last nights. Every regular comes to close their story.",
    "story.hint.first_order": "A guest with a ! is waiting — say hello, take the order and make it yourself. For now, the staff is you.",
    "story.hint.hire": "You can hire during the day. Open Crew ({key.crew}) and pick a candidate.",
    "story.hint.inspection": "The inspection checks dirt. Under 30 % earns praise, over 60 % a fine.",
    "story.hint.lori_night": "Lori is here. Tonight she plays for everyone.",
    "story.hint.morning": "At six the café closes. In the morning you'll see the night's summary.",
    "story.hint.new_staff": "More people are applying for night shifts. Take a look at the candidates.",
    "story.hint.payment": "The 90,000 CZK debt is paid on nights 7, 14, 21, 28 and 30. The overview is in the Shiftella app.",
    "story.hint.priorities": "In Priorities (P) you decide who does what first. 1 is most important.",
    "story.hint.regulars": "Regulars have their own hours and favourites. Serve them quickly and they'll open up.",
    "story.hint.rush": "Rush! Give Bar and Serving top priority.",
    "story.hint.schedule": "The shift schedule lives in the Shiftella app ({key.app}). Click a cell to change the draft, then Publish.",
    "story.hint.special": "New special: the Night Train. For those travelling on.",
    "story.hint.window_light": "The lamp in the window must be on at 3:33 too.",
    "story.homecoming.log": "{name}: home again, after years away.",
    "story.homecoming.opt.record": "Put on an old Czech song",
    "story.homecoming.opt.soup": "A bowl of soup — it tastes like home",
    "story.homecoming.opt.welcome": "Say \"welcome home\"",
    "story.homecoming.react.record": "My grandad used to sing this.",
    "story.homecoming.react.soup": "Oh. Oh, that's exactly it. That's home.",
    "story.homecoming.react.welcome": "Home. Yes. The word sounds new again.",
    "story.homecoming.text": "Back in Prague after years away. Looking at everything as if it might vanish.",
    "story.interview.log": "{name}: an interview at eight, rehearsed at the counter.",
    "story.interview.opt.coffee": "A strong coffee, no charge",
    "story.interview.opt.luck": "Wish them luck",
    "story.interview.opt.rehearse": "Play the interviewer for a minute",
    "story.interview.react.coffee": "Strong enough to answer for me. Perfect.",
    "story.interview.react.luck": "Thanks. I'll take all of it.",
    "story.interview.react.rehearse": "\"Where do I see myself in five years?\" Here, honestly.",
    "story.interview.text": "Job interview at eight. Whispering answers to the window.",
    "story.last_train.log": "{name}: no train till dawn, but a warm place to wait.",
    "story.last_train.opt.app": "Find the first morning train in the app",
    "story.last_train.opt.armchair": "The armchair by the radiator — rest till morning",
    "story.last_train.opt.cake": "A slice of cake",
    "story.last_train.react.app": "5:41, platform 2. Three alarms it is. Thank you!",
    "story.last_train.react.armchair": "Oh, that's… a very good armchair.",
    "story.last_train.react.cake": "Thanks. Waiting is easier with cake.",
    "story.last_train.text": "The last train to Děčín has gone. The next one leaves at dawn.",
    "story.letter.log": "{name}: a letter by hand, finished at last.",
    "story.letter.opt.lamp": "Bring a lamp closer",
    "story.letter.opt.paper": "Grandma's good writing paper",
    "story.letter.opt.tea": "A cup of tea, on the house",
    "story.letter.react.lamp": "Better. Now I can see what I'm trying to say.",
    "story.letter.react.paper": "Proper paper. Now I have to write it properly.",
    "story.letter.react.tea": "Thank you. Letters need tea.",
    "story.letter.text": "Writing a letter by hand. Crossing out, starting again.",
    "story.line.04_mirek": "There's always a strange silence here around three. Lida said it was nothing.",
    "story.line.06_filip": "Good evening… is there Wi-Fi? Or at least a socket?",
    "story.line.07_cook": "In Lida's day the payments were made on Sundays too. In the morning. With swearing.",
    "story.line.11_ema": "Do you hear that? A train. There's none on the board.",
    "story.line.16_kuba": "A cat would like it here. If there were one. Just saying.",
    "story.line.18_filip": "Don't ask. Please.",
    "story.line.22_vera": "Lida would have been proud. Don't tell her… well, don't tell anyone.",
    "story.line.22_vera_sold": "So now it just shines here. It doesn't wait.",
    "story.line.29_radek": "You sleep terribly in retirement. So here I am.",
    "story.lost_tourist.log": "{name}: Holešovice by night, and now the right way.",
    "story.lost_tourist.opt.map": "Draw the way on a napkin",
    "story.lost_tourist.opt.point": "Point the way",
    "story.lost_tourist.opt.taxi": "Call a taxi through the app",
    "story.lost_tourist.react.map": "A napkin map! Better than the real one.",
    "story.lost_tourist.react.point": "Left, then right… then left? Thank you!",
    "story.lost_tourist.react.taxi": "Three minutes? You're magic. Děkuji!",
    "story.lost_tourist.text": "A paper map upside down. Looking for a hostel that isn't where the map says.",
    "story.new_parent.log": "{name}: a baby at home, a quiet half hour here.",
    "story.new_parent.opt.cake": "A slice of cake",
    "story.new_parent.opt.easier": "Say it gets easier",
    "story.new_parent.opt.warm": "Something warm without caffeine",
    "story.new_parent.react.cake": "Sugar. Yes. Sugar is good.",
    "story.new_parent.react.easier": "Really? Promise? …Thank you.",
    "story.new_parent.react.warm": "You're right. Coffee would be a terrible idea.",
    "story.new_parent.text": "A newborn at home, finally asleep. No strength left for sleep of one's own.",
    "story.night.01.hint": "The key is under the mat. Light the window and make the first coffee.",
    "story.night.01.title": "Arrival",
    "story.night.02.hint": "Hire someone and build your first schedule.",
    "story.night.02.title": "The first colleague",
    "story.night.03.hint": "At two, someone arrives who has no time to wait.",
    "story.night.03.title": "Rain and a nurse",
    "story.night.04.hint": "Keep the window lit. All night.",
    "story.night.04.title": "3:33",
    "story.night.05.hint": "After midnight, someone who knew Lida will come. Keep the tables clean.",
    "story.night.05.title": "The crossword lady",
    "story.night.06.hint": "Saturday. Around eleven, the concert at the culture house ends.",
    "story.night.06.title": "After the concert",
    "story.night.07.hint": "At six in the morning, 15,000 CZK is due. Count carefully.",
    "story.night.07.title": "The first payment",
    "story.night.08.hint": "New people are applying. And Mirek is parking oddly tonight.",
    "story.night.08.title": "The kerb",
    "story.night.09.hint": "At one, the dispatcher stops by. He has four minutes.",
    "story.night.09.title": "The last dispatcher",
    "story.night.10.hint": "Have candles ready. Just in case.",
    "story.night.10.title": "Darkness",
    "story.night.11.hint": "It's raining. Someone is playing on the platform.",
    "story.night.11.title": "A song on the platform",
    "story.night.12.hint": "An armchair and a lamp might come in handy tonight.",
    "story.night.12.title": "The quiet corner",
    "story.night.13.hint": "The health inspector comes around half past eleven. Make it shine.",
    "story.night.13.title": "Inspection",
    "story.night.14.hint": "The second payment. And Vera is bringing something tonight.",
    "story.night.14.title": "The recipe book",
    "story.night.15.hint": "Fog. At 3:33, someone will ask you something.",
    "story.night.15.title": "The question",
    "story.night.16.hint": "Nobody will come. Time for cleaning — and for the people who work here.",
    "story.night.16.title": "An empty night",
    "story.night.17.hint": "A visitor from the NONSTOP 24 chain arrives. Listen.",
    "story.night.17.title": "NONSTOP 24",
    "story.night.18.hint": "Filip hasn't opened his laptop tonight.",
    "story.night.18.title": "The resit",
    "story.night.19.hint": "It's going to pour. Twice the guests — and twice the mess.",
    "story.night.19.title": "Downpour",
    "story.night.20.hint": "Mirek will be late tonight. Stay near the door.",
    "story.night.20.title": "A hand's breadth",
    "story.night.21.hint": "Another payment at six. Someone wants a holiday.",
    "story.night.21.title": "The third payment",
    "story.night.22.hint": "Tonight decides whose sign hangs over the door.",
    "story.night.22.title": "The decision",
    "story.night.23.hint": "Radek is working his last shift.",
    "story.night.23.title": "The timetable",
    "story.night.24.hint": "It's raining. If Lori has a stage, tonight is hers.",
    "story.night.24.title": "Lori's evening",
    "story.night.25.hint": "A storm is coming. Keep the window lit.",
    "story.night.25.title": "The storm",
    "story.night.26.hint": "Hana has made up her mind.",
    "story.night.26.title": "Dresden",
    "story.night.27.hint": "It's snowing. Vera wants to tell a story.",
    "story.night.27.title": "First snow",
    "story.night.28.hint": "The fourth payment. And Mirek has a question.",
    "story.night.28.title": "The letter",
    "story.night.29.hint": "Every regular comes tonight to close their story.",
    "story.night.29.title": "Farewells",
    "story.night.30.hint": "The last night. 30,000 CZK at six. At 3:33, keep the window lit.",
    "story.night.30.title": "The last train",
    "story.nurse_loss.log": "{name}: a hard night, and a quiet place after it.",
    "story.nurse_loss.opt.cake": "A slice of cake",
    "story.nurse_loss.opt.quiet": "Bring tea, and let them be",
    "story.nurse_loss.opt.record": "Something soft on the jukebox",
    "story.nurse_loss.react.cake": "Thank you. Maybe later.",
    "story.nurse_loss.react.quiet": "…Thank you. For not asking.",
    "story.nurse_loss.react.record": "That's nice. I can breathe a little.",
    "story.nurse_loss.text": "After a hard shift — a patient didn't make it tonight. Staring into the cup.",
    "story.pay_cheque.log": "{name}: a first pay cheque, celebrated at the counter.",
    "story.pay_cheque.opt.medovnik": "Grandma's medovník, to celebrate",
    "story.pay_cheque.opt.record": "Put on something cheerful",
    "story.pay_cheque.opt.word": "Say congratulations",
    "story.pay_cheque.react.medovnik": "For me? This is the best day of the month already.",
    "story.pay_cheque.react.record": "Ha! Now it's a real celebration.",
    "story.pay_cheque.react.word": "Thank you! It's not much, but it's mine.",
    "story.pay_cheque.text": "The very first pay cheque. Reading the payslip again and again.",
    "story.ring.log": "{name}: a hard evening, softened a little.",
    "story.ring.opt.ask": "Ask how things are",
    "story.ring.opt.cocoa": "Hot chocolate, no questions",
    "story.ring.opt.record": "Something gentle on the jukebox",
    "story.ring.react.ask": "It'll be fine. Not tonight, but it will.",
    "story.ring.react.cocoa": "No questions. Thank you. That's exactly right.",
    "story.ring.react.record": "This song… it's all right. It's a good one.",
    "story.ring.text": "Turning a ring over and over. Not on the finger any more.",
    "story.sketch.log": "{name}: a sketch of the café, with the lamps lit.",
    "story.sketch.opt.lamp": "Switch on the lamp above the table",
    "story.sketch.opt.peek": "Peek at the drawing",
    "story.sketch.opt.pose": "Stand still behind the counter",
    "story.sketch.react.lamp": "Oh, the light! Now the shadows are right.",
    "story.sketch.react.peek": "It's not finished! …Fine. A little peek.",
    "story.sketch.react.pose": "Perfect, don't move! …Done. You look like the café.",
    "story.sketch.text": "Drawing the café in a small sketchbook. The counter, the lamps… and you.",
    "story.soaked.log": "{name}: in from the weather, dry again.",
    "story.soaked.opt.radiator": "A seat by the radiator",
    "story.soaked.opt.tea": "A cup of tea, on the house",
    "story.soaked.opt.towel": "A dry towel",
    "story.soaked.react.radiator": "Oh, warm… I'm never leaving.",
    "story.soaked.react.tea": "Thank you. Hot tea, wet socks. Halfway there.",
    "story.soaked.react.towel": "A towel! You're a saint.",
    "story.soaked.text": "Soaked to the skin. Dripping quietly on grandma's floor.",
    "story.toast": "A little story",
    "story.wedding.log": "{name}: a wedding tomorrow, and a toast tonight.",
    "story.wedding.opt.medovnik": "Medovník for luck",
    "story.wedding.opt.record": "Put on a love song",
    "story.wedding.opt.toast": "A toast with tea",
    "story.wedding.react.medovnik": "For luck. I'll take every crumb of luck there is.",
    "story.wedding.react.record": "Too soon! …Okay, one more time.",
    "story.wedding.react.toast": "To tomorrow! Oh no, it's already tomorrow.",
    "story.wedding.text": "Getting married tomorrow. Can't sleep a wink.",
