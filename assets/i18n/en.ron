    "difficulty.classic.desc": "Payments matter. Miss two and the café closes — an ending to the story, not a defeat.",
    "difficulty.classic.name": "Classic",
    "difficulty.cozy.desc": "No game over. A missed payment just grumbles. More money, more patient guests. Default.",
    "difficulty.cozy.name": "Cozy",
    "difficulty.relaxed.desc": "Like Cozy, without money pressure: the debt's instalments are covered, none can be missed.",
    "difficulty.relaxed.name": "Carefree",
    "duty.bar.desc": "Makes plain drinks the menu way. Your recipes stay yours.",
    "duty.bar.name": "Bar",
    "duty.dishes.desc": "Clears tables, washes up and puts left tips in the jar.",
    "duty.dishes.name": "Dishes",
    "duty.floor.desc": "Mops, empties buckets and does the cleaning on the checklists.",
    "duty.floor.name": "Floor",
    "duty.kitchen.desc": "Makes plain food the menu way. Your recipes stay yours.",
    "duty.kitchen.name": "Kitchen",
    "duty.register.desc": "Takes plain orders and payments. Wishes and regulars stay with you.",
    "duty.register.name": "Register",
    "duty.serving.desc": "Carries what helpers made. You always carry your own.",
    "duty.serving.name": "Serving",
    "ending.extra.answer.title": "The Answer",
    "ending.last_train.summary": "Café Nocturne closes. A last night with the regulars and the morning train to Beroun.",
    "ending.last_train.title": "Last Train",
    "ending.last_train.variant.closed": "The café closed. Holešovice at night isn't a place for big goodbyes.",
    "ending.last_train.variant.farewell": "The regulars helped you pack and talked you into opening something of your own.",
    "ending.last_train.variant.sold": "Sold to NONSTOP 24. The window is always lit — and nobody waits in it.",
    "ending.light.summary": "The café is saved and stayed itself. Tomorrow at ten, the light in the window goes on again.",
    "ending.light.title": "Light in the Window",
    "ending.light.variant.full": "A full café at six in the morning. The regulars are your new family.",
    "ending.light.variant.quiet": "The light is on. For now, there's nobody to wait for.",
