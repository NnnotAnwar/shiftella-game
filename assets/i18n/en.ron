    "minigame.flourish.hit": "Lida's flourish!",
    "minigame.flourish.miss": "Next time",
    "minigame.flourish.prompt": "Lida's flourish: tap as the ring meets the rim",
    "minigame.garnish.chives": "Chives",
    "minigame.garnish.cinnamon": "Cinnamon",
    "minigame.garnish.cocoa": "Cocoa",
    "minigame.garnish.dill": "Dill",
    "minigame.garnish.onion": "Onion",
    "minigame.garnish.paprika": "Paprika",
