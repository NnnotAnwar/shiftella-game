    "guest.insomniacs.one": "Night owl",
    "guest.insomniacs.role.f": "Night owl",
    "guest.insomniacs.role.m": "Night owl",
    "guest.night_wanderer.desc": "Nobody knows where they came from. They sit under the lamp and tip generously.",
