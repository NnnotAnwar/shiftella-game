    "event.health_inspection.text": "Stern glasses, a tablet. \"Don't mind me.\"",
    "event.health_inspection.title": "Health inspection",
    "event.health_inspection.warning": "A warning: \"Next time I'd like to see it cleaner.\"",
    "event.holo_flicker.text": "The holo sign over the door flickers between \"CAFÉ NOCTURNE\" and \"WE'RE WAITING\". Passers-by stop to look.",
    "event.holo_flicker.title": "Flickering sign",
    "event.hospital_shift.text": "Scrubs under jackets. They need soup and five minutes of quiet.",
