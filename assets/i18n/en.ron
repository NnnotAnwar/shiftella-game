    "minigame.guide.got_it": "Got it",
    "minigame.guide.how": "How to play",
    "minigame.guide.keys": "Keys:",
    "minigame.guide.latte_art.keys": "hold Space — the jug follows the line; tap ←/→ on the marks.",
    "minigame.guide.latte_art.mouse": "hold and drag along the line; let go to lift the jug.",
    "minigame.guide.latte_art.stars": "Three stars: the whole line covered, hardly anything off it.",
    "minigame.guide.latte_art.what": "Pour the pattern: lead the jug along the faint line from the dot to its end.",
    "minigame.guide.milk_froth.keys": "hold Space; release and press again for more foam.",
    "minigame.guide.milk_froth.mouse": "hold the button; press again to pull in more foam.",
    "minigame.guide.milk_froth.stars": "Three stars: the needle in the band and the foam right at the line.",
    "minigame.guide.milk_froth.what": "Steam the milk: the needle climbs, the foam rises. Let go with the needle in the amber band and the foam at the line.",
    "minigame.guide.mouse": "Mouse:",
    "minigame.guide.mulled_spice.keys": "←/→ choose, Space drops; ↑/↓ the flame.",
    "minigame.guide.mulled_spice.mouse": "click a spice; drag the flame knob.",
    "minigame.guide.mulled_spice.stars": "Three stars: only the card's spices and a few seconds in the band.",
    "minigame.guide.mulled_spice.what": "Drop in the card's spices (the others bob back out) and keep the wine warm, not boiling — in the amber band.",
    "minigame.guide.new": "Something new",
    "minigame.guide.new_step": "New:",
    "minigame.guide.plate.keys": "Tab next piece, arrows move, Space drops / garnishes.",
    "minigame.guide.plate.mouse": "drag the pieces onto the plate, click the dots.",
    "minigame.guide.plate.stars": "Three stars: every piece right on its spot and every dot.",
    "minigame.guide.plate.what": "Lida's way shows for a moment. Set the pieces on their spots, pick a garnish and dot it on.",
    "minigame.guide.pour_over.keys": "hold Space and tap ←/→ on the ticks.",
    "minigame.guide.pour_over.mouse": "hold the button and circle the cursor with the light.",
    "minigame.guide.pour_over.stars": "Three stars: calm circles in time, inside the rings.",
    "minigame.guide.pour_over.what": "Pour in slow circles with the guide light, in time with the ticks, between the rings.",
    "minigame.guide.read": "The game waits — read, then Got it",
    "minigame.guide.soup_stir.keys": "hold Space (the ladle circles by itself); ↑ adds.",
    "minigame.guide.soup_stir.mouse": "hold and circle in the pot; click the glowing ingredient.",
    "minigame.guide.soup_stir.stars": "Three stars: a calm pace and each add right when the pot glows.",
    "minigame.guide.soup_stir.what": "Stir slowly round with the light while the soup cooks. When the pot glows, add the next ingredient.",
    "minigame.guide.stars_any": "Nothing can go wrong: one star always, more for care.",
    "minigame.guide.step": "Here also:",
    "minigame.guide.step.flourish": "Practised recipe: at the end a golden ring closes in — tap when it meets the rim. A bonus, never required.",
    "minigame.guide.step.latte_art.choose": "First pick the pattern (←/→ and Space, or click).",
    "minigame.guide.step.milk_froth.chili": "At the end a pinch of chili — let it go over the cup.",
    "minigame.guide.step.milk_froth.vanilla": "Raf: a vanilla drop first — let it go while it swings over the jug.",
    "minigame.guide.step.plate.choice": "Choose the garnish (any is right; Tab cycles), then dot it on.",
    "minigame.guide.step.pour_over.dust": "Night train: at the end dust it with cocoa when the light passes the top.",
    "minigame.guide.step.pour_over.slow": "Espresso tonic: pour slowly over the ice — slower circles.",
    "minigame.guide.step.pour_over.stir": "Turek: pour straight onto the grounds, stir three times on the tick, then let it settle.",
    "minigame.guide.step.soup_stir.swirl": "Kulajda: a cream swirl at the end, when the pot glows.",
    "minigame.guide.step.tea_steep.honey": "A spoonful of honey swings — let it go over the middle.",
    "minigame.guide.step.tea_steep.milk": "Last, warm milk: hold until the bar reaches the amber mark.",
    "minigame.guide.step.tea_steep.spices": "Masala chai: add the spices to the pan in the card's order (it changes).",
    "minigame.guide.tea_steep.keys": "Space lifts / drops; ↑/↓ dunk the bag.",
    "minigame.guide.tea_steep.mouse": "click to lift; drag the bag to steep faster.",
    "minigame.guide.tea_steep.stars": "Three stars: the strength inside the scale's box and the add-ons spot on.",
    "minigame.guide.tea_steep.what": "Let the tea steep until it matches the swatch, then lift the bag. Then the add-ons the recipe wants.",
    "minigame.key.space": "Space",
