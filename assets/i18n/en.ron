    "mainmenu.subtitle": "Café Nocturne — a night café by the station",
    "menu.black_coffee.desc": "Strong enough to stand a spoon in.",
    "menu.black_coffee.name": "Black, Lida-style",
    "menu.bryndzove_pirohy.desc": "With bacon and sour cream. Natália won't hear a word against them.",
    "menu.bryndzove_pirohy.name": "Bryndza pierogi",
    "menu.cappuccino.desc": "Milk foam and five minutes of peace.",
    "menu.cappuccino.name": "Cappuccino",
    "menu.chai.desc": "Cinnamon, cardamom and a scent that lasts till morning.",
    "menu.chai.name": "Spiced chai",
    "menu.chlebicek.desc": "Ham, egg, gherkin. Works even without electricity.",
    "menu.chlebicek.name": "Open sandwich",
    "menu.garlic_soup.desc": "With cheese and croutons. Chases off the cold and the night shift.",
    "menu.garlic_soup.name": "Garlic soup",
    "menu.grandma_kulajda.desc": "Dill, mushrooms, a poached egg — and the secret ingredient from Lida's book.",
    "menu.grandma_kulajda.name": "Grandma's kulajda",
    "menu.hot_chocolate.desc": "Thick as the night. Sometimes paid for with a song.",
    "menu.hot_chocolate.name": "Hot chocolate",
    "menu.kolac.desc": "Quark and poppy seed, still warm from the oven.",
    "menu.kolac.name": "Kolach",
    "menu.lemon_tea.desc": "Two sugars, if you're the gentleman by the window.",
    "menu.lemon_tea.name": "Tea with lemon",
    "menu.medovnik.desc": "Twelve layers and patience.",
    "menu.medovnik.name": "Honey cake",
    "menu.night_train.desc": "A double espresso, garlic toast and a kolach for the road. For those travelling on.",
    "menu.night_train.name": "The Night Train",
    "menu.oat_flat_white.desc": "For drone pilots and anyone who thinks the cow is asleep.",
    "menu.oat_flat_white.name": "Oat flat white",
    "menu.svarak.desc": "Cloves, orange and warm hands.",
    "menu.svarak.name": "Mulled wine",
    "menu.topinka.desc": "Czech garlic toast, fried in lard the proper way. A Mirek classic.",
    "menu.topinka.name": "Topinka",
    "menu.varenyky.desc": "With potato and fried onion, the way Oleh's mum makes them.",
    "menu.varenyky.name": "Varenyky",
