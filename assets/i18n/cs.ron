    "signature.price": "{price} v menu",
    "signature.prompt": "Babiččin lístek v šuplíku",
    "signature.prompt_body": "«Každá pořádná kavárna má svůj nápoj. — L.» Kniha receptů ({key.book}) → Náš nápoj.",
