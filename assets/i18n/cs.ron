    "recipe.r_black.desc": "Pomalý pour-over, nic navíc. Poctivé kafe pro poctivé hodiny.",
    "recipe.r_black.lore": "Lij pomalu. Kdo chodí v noci, nikam nespěchá, i když tvrdí opak.",
    "recipe.r_black.name": "Černá, jak ji dělala Lída",
    "recipe.r_borscht.desc": "Řepná polévka, temně rubínová, s lžící smetany.",
    "recipe.r_borscht.lore": "Celé tajemství je v barvě. Řepu přidat včas, jinak zhnědne a urazí se.",
    "recipe.r_borscht.name": "Boršč se smetanou",
    "recipe.r_borscht.teach": "Boršč mojí mámy. Řepa jde dovnitř ve správnou chvíli — řeknu ti kdy.",
    "recipe.r_buchty.desc": "Měkké pečené buchty plněné švestkovými povidly, cukr navrch.",
    "recipe.r_buchty.lore": "Kluk tajně peče. Ať si myslí, že si toho nikdo nevšiml.",
    "recipe.r_buchty.name": "Kubovy buchty s povidly",
    "recipe.r_buchty.teach": "Ukázal mi to pan Holub. Neříkej mu, že to ukazuju tobě — začal by se nadýmat pýchou.",
    "recipe.r_cappuccino.desc": "Espresso pod měkkou čepicí mléčné pěny.",
    "recipe.r_cappuccino.lore": "Mléko zazpívá, když je hotové. Poslouchej, nekoukej.",
    "recipe.r_cappuccino.name": "Cappuccino",
    "recipe.r_chai.desc": "Černý čaj s teplým mlékem a kořením.",
    "recipe.r_chai.lore": "Skořice a hřebíček, od každého špetka, a mléko až když čaj ztmavne.",
    "recipe.r_chai.name": "Chai",
    "recipe.r_chlebicek.desc": "Obložený chlebíček s bramborovým salátem, šunkou a plátkem vajíčka.",
    "recipe.r_chlebicek.lore": "Udělej ho hezký. Chlebíček je malá oslava na talíři.",
    "recipe.r_chlebicek.name": "Chlebíček",
    "recipe.r_espresso_tonic.desc": "Espresso pomalu nalité na tonik s ledem. Hořké, jasné, studené.",
    "recipe.r_espresso_tonic.lore": "Filip mu říká palivo na zkoušky. Já tomu říkám studený nápoj s názorem.",
    "recipe.r_espresso_tonic.name": "Nádražní espresso tonic",
    "recipe.r_espresso_tonic.teach": "Lij to pomalu na led, jinak to všude šumí. Věř mi. Zažil jsem to.",
    "recipe.r_garlic_soup.desc": "Česneková polévka s bramborem a krutony. Spraví skoro všechno.",
    "recipe.r_garlic_soup.lore": "Česnečka léčí rýmu, kocovinu i malá zlomená srdce. Na velká je kulajda.",
    "recipe.r_garlic_soup.name": "Česnečka",
    "recipe.r_hot_chocolate.desc": "Hustá čokoláda s napěněným mlékem.",
    "recipe.r_hot_chocolate.lore": "Pro každého, komu je zima, nebo je mu osm, nebo obojí.",
    "recipe.r_hot_chocolate.name": "Horká čokoláda",
    "recipe.r_kolac.desc": "Kulatý koláček s tvarohem a švestkovými povidly.",
    "recipe.r_kolac.lore": "Povidla doprostřed, drobenku navrch a vždycky o jeden víc, než si myslíš, že budeš potřebovat.",
    "recipe.r_kolac.name": "Koláč",
    "recipe.r_kulajda.desc": "Krémová polévka z hub a kopru s bramborem — Lídin recept.",
    "recipe.r_kulajda.lore": "Kopr až úplně na konec. A Věře neříkej, kolik smetany.",
    "recipe.r_kulajda.name": "Babiččina kulajda",
    "recipe.r_lemon_tea.desc": "Černý čaj, plátek citronu, louhovaný tak akorát.",
    "recipe.r_lemon_tea.lore": "Sáček vytáhni dřív, než zhořkne. S lidmi je to stejné.",
    "recipe.r_lemon_tea.name": "Čaj s citronem",
    "recipe.r_linden_tea.desc": "Čaj z lipového květu, zlatý a jemný, s medem.",
    "recipe.r_linden_tea.lore": "Lípa na spaní a pro zpěváky. Med, vždycky med.",
    "recipe.r_linden_tea.name": "Lipový čaj s medem",
    "recipe.r_lori_encore.desc": "Horká čokoláda se špetkou chilli.",
    "recipe.r_lori_encore.lore": "Špetka ohně pro zpěvačku. Ne lžíce. Špetka.",
    "recipe.r_lori_encore.name": "Přídavek pro Lori",
    "recipe.r_lori_encore.teach": "Jen špetku chilli, zlato. Zahřeje hlas zevnitř.",
    "recipe.r_medovnik.desc": "Vrstvený medový dort se smetanovým krémem, podávaný studený.",
    "recipe.r_medovnik.lore": "Medovník si musí přes noc odpočinout. My taky.",
    "recipe.r_medovnik.name": "Medovník",
    "recipe.r_moon_latte.desc": "Ovesné mléko zbarvené do modra soumraku motýlím hrachem, nahoře srpek.",
    "recipe.r_moon_latte.lore": "Tenhle není můj. Je tvůj. Zapiš si ho, ať ho jednou někdo najde.",
    "recipe.r_moon_latte.name": "Měsíční latte",
    "recipe.r_night_train.desc": "Silný pour-over s kakaem a kořením — specialita podniku.",
    "recipe.r_night_train.lore": "Dost silný na poslední vlak, dost jemný na ten první.",
    "recipe.r_night_train.name": "Noční vlak",
    "recipe.r_oat_flat_white.desc": "Sametové ovesné mléko na dvojitém espressu, nahoře malý obrázek.",
    "recipe.r_oat_flat_white.lore": "Mladí ho chtějí s ovsem. Budiž. Nakresli jim srdíčko a vrátí se.",
    "recipe.r_oat_flat_white.name": "Ovesný flat white",
    "recipe.r_pirohy.desc": "Bramborové taštičky s ovčím sýrem a trochou slaniny.",
    "recipe.r_pirohy.lore": "Pro slovenské řidiče. Na jeden talíř se jim přestane stýskat po domově.",
    "recipe.r_pirohy.name": "Bryndzové pirohy",
    "recipe.r_raf.desc": "Espresso našlehané se smetanou a vanilkou do něčeho jako obláček.",
    "recipe.r_raf.lore": "Olehův. Sladký, jemný a trochu mu stýská po domově.",
    "recipe.r_raf.name": "Raf (po kyjevsku)",
    "recipe.r_raf.teach": "V Kyjevě napěňujeme kafe rovnou se smetanou. Pozor na kapku vanilky — teď!",
    "recipe.r_rn333_tea.desc": "Černý čaj s citronem a přesně dvěma cukry.",
    "recipe.r_rn333_tea.lore": "Dva cukry. Vždycky si dával dva.",
    "recipe.r_rn333_tea.name": "Čaj, dva cukry",
    "recipe.r_signature.desc": "Náš vlastní nápoj.",
    "recipe.r_signature.lore": "Napsaný křídou na tabuli.",
    "recipe.r_signature.name": "Nápoj kavárny",
    "recipe.r_svarak.desc": "Svařené červené víno s kořením a trochou cukru. Nikdy nevařené.",
    "recipe.r_svarak.lore": "Ohřej, nikdy nevař. Víno, které se vaří, to vzdalo.",
    "recipe.r_svarak.name": "Svařák",
    "recipe.r_tatra_tea.desc": "Horské bylinky, med a citron, jako na chatě v Tatrách.",
    "recipe.r_tatra_tea.lore": "Natáliin. Voní jako hory po dešti.",
    "recipe.r_tatra_tea.name": "Tatranský bylinkový čaj",
    "recipe.r_tatra_tea.teach": "Babička je sbírala nad Ždiarem. Nejdřív med, citron až nakonec.",
    "recipe.r_topinka.desc": "Smažený chleba potřený česnekem, snídaně od stanoviště taxíků.",
    "recipe.r_topinka.lore": "Řidičům dvakrát přetřít česnekem, třikrát každému, kdo vypadá smutně.",
    "recipe.r_topinka.name": "Topinka",
    "recipe.r_turek.desc": "Káva zalitá v hrnku s cukrem, sedlina se nechá usadit.",
    "recipe.r_turek.lore": "Mirkův. Nech ho usadit. On to tak vždycky dělal.",
    "recipe.r_turek.name": "Turek po taxikářsku",
    "recipe.r_turek.teach": "Zamíchat třikrát a pak dát ruce pryč. Ať si sedlina sedne jako unavený řidič.",
    "recipe.r_uzvar.desc": "Teplý nápoj ze sušeného ovoce a medu, jako Vánoce ve Lvově.",
    "recipe.r_uzvar.lore": "Z balíku. Sušené hrušky a švestky a něčí láska, všechno v jednom hrnci.",
    "recipe.r_uzvar.name": "Uzvar",
    "recipe.r_varenyky.desc": "Taštičky s bramborem a houbami, smetanou a křupavou cibulkou.",
    "recipe.r_varenyky.lore": "Naučila mě je jedna cestující ze Lvova, jedné zasněžené noci. Okraje mačkej, jako že to myslíš vážně.",
    "recipe.r_varenyky.name": "Vareniky s bramborem a houbami",
    "recipe.r_vera_kolac.desc": "Mák a tvaroh, prohřátý skrz naskrz, jak Věra trvá.",
    "recipe.r_vera_kolac.lore": "Věřin je lepší. Nikdy jí neříkej, že jsem to napsala.",
    "recipe.r_vera_kolac.name": "Věřin ohřátý makový koláč",
    "recipe.r_vera_kolac.teach": "Ohřej ho, děvče. Studený koláč je smutný koláč. Nejdřív mák, pak tvaroh.",
