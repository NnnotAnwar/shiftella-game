    "journal.caption.anwar": "Tichý kluk s notebookem. Hezký úsměv.",
    "journal.caption.arc.filip.1": "Filip přivedl k zásuvce půlku ročníku.",
    "journal.caption.arc.filip.2": "Filip, hodně potichu, nad studeným kafem.",
    "journal.caption.arc.filip.3": "Filip před opravkou. Držíme palce, všichni.",
    "journal.caption.arc.filip.4": "Filip má za dvě. Kavárna jásala.",
    "journal.caption.arc.guest_333.1": "Mince z roku 1979 na podšálku.",
    "journal.caption.arc.guest_333.2": "„Pořád svítí.“ Díval se na okno, ne na mě.",
    "journal.caption.arc.guest_333.3": "„Jednou jsem odjel.“ Čaj mu v rukou vystydl.",
    "journal.caption.arc.guest_333.4": "Poslední 3:33. Hodiny se zase rozešly.",
    "journal.caption.arc.hana.1": "Hana se dnes smála: holčička jménem Lída.",
    "journal.caption.arc.hana.2": "Hana usnula u okna. Nechala jsem ji být.",
    "journal.caption.arc.hana.3": "Hana a její dopis z Drážďan.",
    "journal.caption.arc.hana.4": "Hana se rozhodla. Vypadala lehčí.",
    "journal.caption.arc.lori.1": "Lori přišla z nástupiště, i s kytarou.",
    "journal.caption.arc.lori.2": "Lori na malém pódiu. Skoro skutečném.",
    "journal.caption.arc.lori.3": "Lořin pátek. Poslouchala celá ulice.",
    "journal.caption.arc.mirek.1": "Mirek mě nechal nalít mu kafe. Jako dřív nechával ji.",
    "journal.caption.arc.mirek.2": "Mirek mžourá na tabuli s menu. „To jsou ta písmenka, ne moje oči.“",
    "journal.caption.arc.mirek.3": "Mirek dnes přišel pěšky. Vypadal o to mladší.",
    "journal.caption.arc.mirek.4": "Dvacet gramů a celý život. Mirek mi to konečně řekl.",
    "journal.caption.arc.mirek.5": "Mirek se rozhoduje. Nepospíchala jsem na něj.",
    "journal.caption.arc.radek.1": "Radkovo varování přišlo zprávou: expres má zpoždění. Byli jsme připravení.",
    "journal.caption.arc.radek.2": "Radkova poslední směna. Pro jednou si sedl.",
    "journal.caption.arc.radek.3": "Radek a závěje z pětaosmdesátého.",
    "journal.caption.arc.vera.1": "Věra a její křížovka, verbuje celou kavárnu.",
    "journal.caption.arc.vera.2": "Věra zkontrolovala stůl. Prošel.",
    "journal.caption.arc.vera.3": "Věra a babiččina kulajda. U první lžíce zavřela oči.",
    "journal.caption.arc.vera.4": "Věřiny kamarádky obsadily roh. Nahlas.",
