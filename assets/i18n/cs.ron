    "event.lost_bus.text": "Zájezdový autobus odbočil špatně. Průvodkyně se ptá, jestli máte třicet porcí polévky.",
    "event.lost_bus.title": "Zabloudilý autobus",
    "event.mirek_accident.text": "Mirkovo taxi skončilo v zábradlí. Nikomu se nic vážného nestalo. Mirek už nepřijde.",
    "event.mirek_accident.title": "Nehoda u nádraží",
    "event.night_blogger.text": "Natáčí šálek ze tří stran, než ochutná. Jeho recenze se počítá třikrát.",
    "event.night_blogger.title": "Noční streamer",
    "event.open_mic.text": "Někdo ladí kytaru a sál ztichne.",
    "event.open_mic.title": "Večer u mikrofonu",
    "event.phantom_horn.text": "Dlouhé zahoukání. Tabule je prázdná.",
    "event.phantom_horn.title": "Houkání bez vlaku",
    "event.police_patrol.text": "Dva policisté, dvě kávy, jedno „všechno v pořádku?\". Pár nocí bude klid.",
    "event.police_patrol.title": "Noční hlídka",
    "event.power_outage.choice.candles": "Zapálit svíčky (−150 Kč)",
    "event.power_outage.choice.close_kitchen": "Zavřít kuchyň",
    "event.power_outage.result.candles": "Svíčky hoří. Hostům se to líbí — „útulné\".",
    "event.power_outage.result.close_kitchen": "Kuchyň zavřená. Prodáváme jen studené.",
    "event.power_outage.text": "Cvak — a tma. Jen neon nádraží přes okno. Kávovar i sporák stojí.",
    "event.power_outage.title": "Vypadl proud",
    "event.rain.text": "Okna v kapkách, holo nápis se rozpíjí. Lidé se chodí schovat.",
    "event.rain.title": "Déšť",
    "event.roof_leak.choice.bucket": "Postavit kbelík",
    "event.roof_leak.choice.roofer": "Zavolat pokrývače (−900 Kč)",
    "event.roof_leak.result.bucket": "Kbelík cinká do rytmu deště.",
    "event.roof_leak.result.roofer": "Střecha opravena. Tohle místo už nekape.",
    "event.roof_leak.text": "Kap. Kap. Přímo vedle pultu.",
    "event.roof_leak.title": "Teče střecha",
    "event.staff_birthday.choice.cake": "Koupit dort (−150 Kč)",
    "event.staff_birthday.choice.sing": "Jen zazpívat",
    "event.staff_birthday.result.cake": "Dort, svíčky, falešný zpěv. Tým drží pohromadě.",
    "event.staff_birthday.result.sing": "Všechno nejlepší! Aspoň zazpívali čistě. Skoro.",
    "event.staff_birthday.text": "Někdo přinesl koláč se svíčkou.",
    "event.staff_birthday.title": "Narozeniny",
    "event.staff_inspired.text": "„Hele, co kdybychom do topinky dali…\"",
    "event.staff_inspired.title": "Inspirace",
    "event.staff_quarrel.choice.let_be": "Nechat je, ať si to vyříkají",
    "event.staff_quarrel.choice.talk": "Promluvit s nimi",
    "event.staff_quarrel.result.let_be": "V kuchyni je dusno.",
    "event.staff_quarrel.result.talk": "Vydechli. Nůž zůstal v šuplíku.",
    "event.staff_quarrel.text": "„To je můj nůž!\" — „A tohle je moje směna!\"",
    "event.staff_quarrel.title": "Hádka v kuchyni",
    "event.staff_romance.text": "Smějí se jednomu vtipu déle než všichni ostatní.",
    "event.staff_romance.title": "Zamilovali se",
    "event.staff_sick.text": "Telefon ve 21:40: „Promiňte, dneska to nezvládnu.\"",
    "event.staff_sick.title": "Někdo onemocněl",
    "event.staff_walkout.text": "Zástěra na háčku, bouchnutí dveří. Někdo má dost.",
    "event.staff_walkout.title": "Odešel ze směny",
    "event.station_cat.choice.feed": "Nakrmit (−10 Kč)",
    "event.station_cat.choice.shoo": "Odehnat",
    "event.station_cat.result.feed": "Kocour zamňoukal. Asi „díky\".",
    "event.station_cat.result.shoo": "Kocour odešel s uraženou důstojností.",
    "event.station_cat.text": "Zrzavý, drzý, s natrženým uchem. Dívá se na smetanu.",
    "event.station_cat.title": "Nádražní kocour",
    "event.storm.text": "Na nádraží zhasínají lampy. Svítí jen tvoje okno. Hosté zůstávají déle.",
    "event.storm.title": "Bouřka",
    "event.storm_blackout.text": "Svítí jen tvoje okno. Kdo nespí, jde za ním.",
    "event.storm_blackout.title": "Celá čtvrť ve tmě",
    "event.strange_order.choice.black_coffee": "Černou kávu",
    "event.strange_order.choice.dont_know": "„Nevím. Povíte mi?\"",
    "event.strange_order.choice.tea_two_sugars": "Čaj s citronem, dva cukry",
    "event.strange_order.result.black_coffee": "„Ne, ne. Tu pil Mirek.\"",
    "event.strange_order.result.dont_know": "Host vypráví půl hodiny. O čaji ani slovo.",
    "event.strange_order.result.tea_two_sugars": "„Přesně tak.\" Host se usměje, jako by si na něco vzpomněl.",
    "event.strange_order.text": "„Dejte mi to, co pila Lida.\"",
    "event.strange_order.title": "Zvláštní objednávka",
    "event.student_party.text": "Nahlas, vesele a hodně lepkavě.",
    "event.student_party.title": "Studenti po párty",
    "event.supplier_late.text": "Zásobovací dron uvízl v mlze. Mléko bude. Někdy po druhé.",
    "event.supplier_late.title": "Dodávka mešká",
    "event.taxi_break.text": "Auta stojí v řadě před vchodem. Kafe, rychle, a zase jedou. Za rychlost dýško.",
    "event.taxi_break.title": "Taxikáři na pauze",
    "experiment.cat_sniffs": "The cat sniffs it, thinks about it, and walks away.",
    "experiment.close.extra": "Almost — one thing too many.",
    "experiment.close.missing": "Almost — it wants something {family}.",
    "experiment.close.swap": "So close — swap the {family} one.",
    "experiment.discovered": "Discovered! {recipe}",
    "experiment.known": "You know this one: {recipe}.",
    "experiment.nothing.1": "It's… drinkable. Kuba drank it anyway.",
    "experiment.nothing.2": "Interesting. In the way a puddle is interesting.",
    "experiment.nothing.3": "That's a flavour. Not a good one, but a flavour.",
    "experiment.nothing.4": "Grandma would have said \"brave\". Grandma was being kind.",
    "experiment.nothing.5": "Into the sink it goes. Nobody saw.",
    "experiment.nothing.6": "Not a recipe yet. Maybe a story for later.",
    "furniture.armchair.desc": "S lampou vedle tvoří tichý kout.",
    "furniture.armchair.name": "Křeslo",
    "furniture.bar_counter.desc": "Za dlaždici. Lidin byl z jednoho kusu dubu.",
    "furniture.bar_counter.name": "Barový pult",
    "furniture.bookshelf.desc": "Staré knihy, křížovky a jedna kuchařka.",
    "furniture.bookshelf.name": "Knihovna",
    "furniture.brass_bell.desc": "Ding. The sound of a coffee being ready, since 1979.",
    "furniture.brass_bell.name": "Brass espresso bell",
    "furniture.cat_bed.desc": "A round cushion by the radiator. Someone will claim it.",
    "furniture.cat_bed.name": "Cat bed",
    "furniture.chair.desc": "Obyčejná, poctivá, z hospody po dědovi někoho.",
    "furniture.chair.name": "Židle",
    "furniture.coat_rack.desc": "Mokré kabáty mají kam jít. Hosté sedí pohodlněji.",
    "furniture.coat_rack.name": "Věšák",
    "furniture.coffee_machine.desc": "Syčí, jako by se urazil. Kouše.",
    "furniture.coffee_machine.name": "Kávovar Rapid",
    "furniture.counter_corner.desc": "Aby pult mohl zahnout za roh.",
    "furniture.counter_corner.name": "Rohový pult",
    "furniture.dish_rack.desc": "Víc místa na čisté nádobí.",
    "furniture.dish_rack.name": "Odkapávač",
    "furniture.door.desc": "Se zvonkem, který Lida nikdy nedala vyměnit.",
    "furniture.door.name": "Dveře",
    "furniture.drone_dock.desc": "Zásoby přiletí i v mlze. Dodavatelé se už nezpozdí.",
    "furniture.drone_dock.name": "Dok pro drony",
    "furniture.enamel_sign.desc": "\"Bufet\" in white on bottle green. Rescued from an old platform.",
    "furniture.enamel_sign.name": "Enamel station sign",
    "furniture.espresso_grinder.desc": "Čerstvě namletá vůně, která láká z nástupiště.",
    "furniture.espresso_grinder.name": "Mlýnek na kávu",
    "furniture.fairy_lights.desc": "A string of tiny warm lights. Paid for by a jar of tips.",
    "furniture.fairy_lights.name": "Fairy lights",
    "furniture.floor_carpet.desc": "Za dlaždici. Útulné, ale špína je na něm vidět.",
    "furniture.floor_carpet.name": "Koberec na podlahu",
    "furniture.floor_lamp.desc": "Teplá jantarová louže světla.",
    "furniture.floor_lamp.name": "Stojací lampa",
    "furniture.floor_tile.desc": "Za dlaždici. Snadno se myje.",
    "furniture.floor_tile.name": "Dlažba",
    "furniture.floor_wood.desc": "Za dlaždici. Vrže tam, kde má.",
    "furniture.floor_wood.name": "Dřevěná podlaha",
    "furniture.fridge.desc": "Bručí hlasitěji než rádio. Chlebíčky a medovník.",
    "furniture.fridge.name": "Lednice",
    "furniture.grandma_photo.desc": "Lida se směje někomu mimo záběr. Nikdy neprodávat.",
    "furniture.grandma_photo.name": "Fotka babičky",
    "furniture.jukebox.desc": "Hraje sám, když někdo smutní.",
    "furniture.jukebox.name": "Jukebox",
    "furniture.lace_tablecloth.desc": "A small table under one of Lida's lace tablecloths.",
    "furniture.lace_tablecloth.name": "Table with grandma's lace",
    "furniture.lamp_brass.desc": "Curved brass and warm glass, in the Art Nouveau style.",
    "furniture.lamp_brass.name": "Brass pendant lamp",
    "furniture.led_strip.desc": "A slim column of warm indigo light.",
    "furniture.led_strip.name": "LED strip lamp",
    "furniture.menu_holo_board.desc": "Svítí fialově do deště. Písmo jde zvětšit.",
    "furniture.menu_holo_board.name": "Holo tabule s menu",
    "furniture.mosaic_rug.desc": "A rug with a sage-and-gold Secession pattern.",
    "furniture.mosaic_rug.name": "Mosaic rug",
    "furniture.napkin_wall.desc": "Thank-you napkins pinned in a frame. Every one a small night.",
    "furniture.napkin_wall.name": "Napkin wall",
    "furniture.oven.desc": "Koláče jsou z ní pořád teplé.",
    "furniture.oven.name": "Trouba",
    "furniture.pendant_lamp.desc": "Visí nad stolem a nepřekáží.",
    "furniture.pendant_lamp.name": "Závěsná lampa",
    "furniture.plant_small.desc": "Zelená tečka v noci.",
    "furniture.plant_small.name": "Malá květina",
    "furniture.plant_tall.desc": "Roste rychleji než dluh. Skoro.",
    "furniture.plant_tall.name": "Velká monstera",
    "furniture.radio.desc": "Staré lampové rádio. Kdo ho opraví, možná uslyší víc než hudbu.",
    "furniture.radio.name": "Lidino rádio",
    "furniture.record_shelf.desc": "A shelf for sleeves and stories. Music lovers linger by it.",
    "furniture.record_shelf.name": "Record shelf",
    "furniture.register.desc": "Bere karty, telefony i staré dobré mince. Ty československé ne.",
    "furniture.register.name": "Pokladna",
    "furniture.rug.desc": "Tlumí kroky i hádky.",
    "furniture.rug.name": "Koberec",
    "furniture.sink.desc": "Bez něj se hrnky nemyjí samy. Bohužel.",
    "furniture.sink.name": "Dřez",
    "furniture.sofa.desc": "Měkká jako konec směny. Hosté zůstanou déle.",
    "furniture.sofa.name": "Pohovka",
    "furniture.stage_corner.desc": "Koberec, mikrofon a odvaha. Otevírá večery u mikrofonu.",
    "furniture.stage_corner.name": "Malé pódium",
    "furniture.stool.desc": "Pro ty, kdo mají čtyři minuty.",
    "furniture.stool.name": "Barová stolička",
    "furniture.stove.desc": "Polévky, topinky a všechno, co hřeje.",
    "furniture.stove.name": "Sporák",
    "furniture.table_round.desc": "Pro dva a jedno tajemství.",
    "furniture.table_round.name": "Kulatý stolek",
    "furniture.table_socket.desc": "Studenti za něj prodají duši. A koupí jednu kávu.",
    "furniture.table_socket.name": "Stolek se zásuvkou",
    "furniture.table_square.desc": "Pro partu ze směny nebo koncertu.",
    "furniture.table_square.name": "Velký stůl",
    "furniture.trash_bin.desc": "Méně papírků na podlaze.",
    "furniture.trash_bin.name": "Koš",
    "furniture.wall.desc": "Drží střechu a fotky.",
    "furniture.wall.name": "Zeď",
    "furniture.window.desc": "Ven je vidět déšť. Dovnitř je vidět světlo.",
    "furniture.window.name": "Okno",
    "furniture.window_seat.desc": "Výhled na nástupiště a déšť. Někdo tu sedává ve 3:33.",
    "furniture.window_seat.name": "Lavice u okna",
    "guest.clubbers.desc": "Mokré bundy, hlasitý smích, chtějí všechno hned. Hlavně v pátek a v sobotu.",
    "guest.clubbers.name": "Lidé z koncertu",
    "guest.drone_operators.desc": "Hlídají rozvážkové drony nad mokrými střechami. Ovladač nepustí ani u kávy.",
    "guest.drone_operators.name": "Dronaři",
    "guest.insomniacs.desc": "Čaj, koláč a křížovka. Nejrychleji se z nich stávají štamgasti.",
    "guest.insomniacs.name": "Nespavci",
    "guest.night_wanderer.desc": "Nikdo neví, odkud přišel. Sedá si pod lampu a nechává štědré dýško.",
    "guest.night_wanderer.name": "Noční poutník",
    "guest.nurses.desc": "Pauza je krátká, vděčnost dlouhá. Jejich recenze váží víc.",
    "guest.nurses.name": "Zdravotníci",
    "guest.patrol.desc": "Dva policisté, dvě kávy, jedno „všechno v pořádku?\".",
    "guest.patrol.name": "Noční hlídka",
    "guest.shift_workers.desc": "Střídání v logistickém depu. Chodí ve skupinách, jedí hodně a směny mají v Shiftelle.",
    "guest.shift_workers.name": "Lidé ze směny",
    "guest.students.desc": "Sedí dlouho, platí málo, chtějí zásuvku.",
    "guest.students.name": "Studenti",
    "guest.taxi_drivers.desc": "Poslední taxikáři s volantem v ruce. Rychle kafe a zase jedou.",
    "guest.taxi_drivers.name": "Taxikáři",
    "guest.train_crew.desc": "Mají rozpis v Shiftelle a hlad po polévce.",
    "guest.train_crew.name": "Železničáři",
    "guest.travelers.desc": "Přijeli, odjíždějí, nebo čekají na přípoj. Kufry zabírají místo.",
    "guest.travelers.name": "Cestující",
    "guest.truckers.desc": "Jejich náklaďáky už řídí samy. Oni stejně potřebují polévku.",
    "guest.truckers.name": "Řidiči kamionů",
