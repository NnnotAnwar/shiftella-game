    "furniture.window_seat.desc": "Výhled na nástupiště a déšť. Někdo tu sedává ve 3:33.",
    "furniture.window_seat.name": "Lavice u okna",
    "guest.clubbers.desc": "Mokré bundy, hlasitý smích, chtějí všechno hned. Hlavně v pátek a v sobotu.",
    "guest.clubbers.name": "Lidé z koncertu",
    "guest.drone_operators.desc": "Hlídají rozvážkové drony nad mokrými střechami. Ovladač nepustí ani u kávy.",
    "guest.drone_operators.name": "Dronaři",
    "guest.insomniacs.desc": "Čaj, koláč a křížovka. Nejrychleji se z nich stávají štamgasti.",
    "guest.insomniacs.name": "Nespavci",
    "guest.night_wanderer.desc": "Nikdo neví, odkud přišel. Sedá si pod lampu a nechává štědré dýško.",
    "guest.night_wanderer.name": "Noční poutník",
    "guest.nurses.desc": "Pauza je krátká, vděčnost dlouhá. Jejich recenze váží víc.",
    "guest.nurses.name": "Zdravotníci",
    "guest.patrol.desc": "Dva policisté, dvě kávy, jedno „všechno v pořádku?\".",
    "guest.patrol.name": "Noční hlídka",
    "guest.shift_workers.desc": "Střídání v logistickém depu. Chodí ve skupinách, jedí hodně a směny mají v Shiftelle.",
    "guest.shift_workers.name": "Lidé ze směny",
    "guest.students.desc": "Sedí dlouho, platí málo, chtějí zásuvku.",
    "guest.students.name": "Studenti",
    "guest.taxi_drivers.desc": "Poslední taxikáři s volantem v ruce. Rychle kafe a zase jedou.",
    "guest.taxi_drivers.name": "Taxikáři",
    "guest.train_crew.desc": "Mají rozpis v Shiftelle a hlad po polévce.",
    "guest.train_crew.name": "Železničáři",
    "guest.travelers.desc": "Přijeli, odjíždějí, nebo čekají na přípoj. Kufry zabírají místo.",
    "guest.travelers.name": "Cestující",
    "guest.truckers.desc": "Jejich náklaďáky už řídí samy. Oni stejně potřebují polévku.",
    "guest.truckers.name": "Řidiči kamionů",
    "item.cafe_keys.desc": "Byly pod rohožkou. Samozřejmě.",
