    "signature.style.tea_steep": "Louhovaná",
    "signature.sub": "Babička měla vždycky jeden svůj. Vymysli ten náš.",
    "signature.suggest.1": "Holešovická noc",
    "signature.suggest.10": "Nádražní kočka",
    "signature.suggest.11": "Nástupiště 3",
    "signature.suggest.12": "Noční vlak do Chebu",
    "signature.suggest.2": "Lídin čaj",
    "signature.suggest.3": "Déšť na kolejích",
    "signature.suggest.4": "Poslední tramvaj",
    "signature.suggest.5": "Teplá lampa",
    "signature.suggest.6": "Babiččino tajemství",
    "signature.suggest.7": "Tichá hodinka",
    "signature.suggest.8": "Sametová mlha",
    "signature.suggest.9": "Ranní směna",
    "signature.tastes": "Chutná",
    "signature.title": "Náš vlastní nápoj",
    "signature.tweak": "Dnes ho ještě můžeš doladit.",
    "signature.wish.filip": "Jeden «{drink}» — jestli to není moc drahé.",
    "signature.wish.hana": "«{drink}». Než mi zase zazvoní telefon.",
    "signature.wish.house_special": "«{drink}», prosím — to z tabule.",
    "signature.wish.lori": "Ten «{drink}», co se o něm mluví. Na hlas.",
    "signature.wish.mirek": "Dej mi ten váš «{drink}», Karolíno. Ať vím, o čem se mluví.",
    "signature.wish.radek": "«{drink}». Dneska si ho zasloužím.",
    "signature.wish.vera": "Ukaž, co je ten tvůj «{drink}». Lída by chtěla vědět.",
    "staff.barista.bio": "Bára utekla z vysoké v Praze a rodičům to neřekla. Kávu dělá líp než diplomovou práci.",
    "staff.barista.dislikes": "Ticho, mytí nádobí",
    "staff.barista.likes": "Hudbu v sále, povídání s hosty",
    "staff.barista.pref.exam": "V pátek zkouška. Nemůžu ji vynechat.",
    "staff.barista.pref.late": "Pozdní směny, prosím. Po půlnoci jsem jiný člověk.",
    "staff.barista.pref.sunday": "Nedělní oběd u našich. Myslí si, že pořád studuju.",
    "staff.barista.role": "Noční baristka",
    "staff.cashier.bio": "Ivana pracuje v noci, zatímco dcera spí u sousedky. Jeden telefonát může rozbít celou směnu.",
    "staff.cashier.dislikes": "Zpoždění, chaos",
    "staff.cashier.likes": "Přesnost, když ji někdo pochválí",
    "staff.cashier.pref.early": "Doma do půl třetí — dcera se v noci budí.",
    "staff.cashier.pref.hours": "Aspoň čtyři noci. Potřebuju ty hodiny.",
    "staff.cashier.role": "Pokladní a sál",
    "staff.cook.bio": "Pan Holub vařil dvacet let v závodní jídelně sklárny. Lidu znal a bručí, že „za ní to bylo jinak\".",
    "staff.cook.dislikes": "Spěch, když mu někdo sahá na věci",
    "staff.cook.likes": "Pořádek v kuchyni, vlastní nůž",
    "staff.cook.pref.back": "Ne dvě noci za sebou. Moje záda.",
    "staff.cook.pref.full": "Celé noci. Půl noci je půl polívky.",
    "staff.cook.role": "Kuchař",
    "staff.porter.bio": "Kuba dřív tahal bedny ve skladu. Je hodný a všechno mu padá z rukou. Potajmu se učí péct.",
    "staff.porter.dislikes": "Hlasité hádky",
    "staff.porter.likes": "Zvířata (kočky!), jídlo",
    "staff.porter.pref.cook": "Pan Holub mě nechává koukat, jak peče.",
    "staff.porter.role": "Pomocník a úklid",
    "staff.quiet_one.bio": "Ema slyší houkání vlaků, které nejsou v jízdním řádu. Jako jediná si všimne, že ve 3:33 stojí hodiny.",
    "staff.quiet_one.dislikes": "Dav, ostré světlo",
    "staff.quiet_one.likes": "Déšť, tiché hodiny mezi druhou a čtvrtou",
    "staff.quiet_one.pref.tuesday": "V úterý mám přednášky.",
    "staff.quiet_one.pref.weekend": "Jestli to jde, víkendy ne. Davy.",
    "staff.quiet_one.role": "Všeuměl",
    "staff.server.bio": "Natália přijela z Košic na týden a zůstala. Nosí čtyři talíře najednou a pamatuje si každé jméno.",
    "staff.server.dislikes": "Ulepené podlahy",
    "staff.server.likes": "Čisté stoly, deštivé noci",
    "staff.server.pref.bara": "S Bárou, jestli to jde. S ní noci utečou.",
    "staff.server.pref.max": "Pět nocí, víc ne. Mám ještě život, který občas navštěvuju.",
    "staff.server.role": "Obsluha",
    "staff.sound_tech.bio": "Oleh byl zvukař ve Lvově. „Dočasně\" tu pracuje už druhý rok. Umí opravit staré rádio.",
    "staff.sound_tech.dislikes": "Levnou kávu",
    "staff.sound_tech.likes": "Staré desky, rádio",
    "staff.sound_tech.pref.late": "Pozdě, prosím. Po půlnoci zním líp. Kafe taky.",
    "staff.sound_tech.pref.thursday": "Ve čtvrtek zkouška kapely — a videohovor domů.",
    "staff.sound_tech.role": "Bar a sál",
    "storm.act.blankets": "Deky pro všechny",
    "storm.act.blankets.tip": "Babiččiny deky zpod pultu: hostům tepleji, v sále útulněji.",
    "storm.act.on_way": "Už jdeš…",
    "storm.act.soup": "Hrnec polévky",
    "storm.act.soup.tip": "Hrnec na sporák a talíř pro každého, kdo zůstal.",
    "storm.cancel.stay": "Kdo je uvnitř, zůstává do rána.",
    "storm.cancel.text": "Praha-Holešovice: kvůli sněhové bouři jsou všechny noční vlaky do 6:00 zrušeny.",
    "storm.cancel.title": "Vlaky zrušeny",
    "storm.cared.blankets": "Babiččiny deky vyšly ze skříně. Všem je teplo.",
    "storm.cared.soup": "Velký hrnec je na sporáku: talíř polévky pro každého.",
    "storm.chip.stranded.few": "{n} hosté zůstávají do rána",
    "storm.chip.stranded.many": "{n} hostů zůstává do rána",
    "storm.chip.stranded.one": "{n} host zůstává do rána",
    "storm.chip.title": "Zasněženo",
    "storm.done.blankets": "Všichni zachumlaní",
    "storm.done.soup": "Polévka pro všechny",
    "storm.forecast.text": "Celou noc má hustě sněžit. Na nádraží se bojí o trať.",
    "storm.forecast.title": "Blíží se sněhová bouře",
    "storm.morning.cared": "Jedou první vlaky. Všichni cestou ven děkují.",
    "storm.morning.plain": "První vlaky už zase jedou.",
    "storm.morning.title": "Přestalo sněžit",
    "storm.talk.intro": "Tři ráno. Sníh na oknech a nikdo nikam nejde.",
    "storm.talk.snow.1": "Tak. Dneska nikdo nikam nepojede.",
    "storm.talk.snow.2": "Telefon tvrdí, že první vlak jede v šest. Taky tvrdí, že je slunečno.",
    "storm.talk.snow.3": "Doma na mě stejně nikdo nečeká. Tady je aspoň teplo.",
    "storm.talk.snow.4": "Tady je vždycky teplo. Babiččino pravidlo.",
    "storm.talk.snow.5": "{a} má pravdu. Ať žije sníh.",
    "storm.talk.snow.6": "Na sníh. A na kavárnu, co nezavírá.",
    "storm.talk.trains.1": "Děčín si počká do rána.",
    "storm.talk.trains.2": "Frýdlant taky. Někdo tam drží večeři v teple. Teď už spíš snídani.",
    "storm.talk.trains.3": "Bydlím pět minut odsud. Jen se mi nechtělo domů.",
    "storm.talk.trains.4": "Pět minut? A pořád tady. {c} ví, kde je dobře.",
    "storm.talk.trains.5": "Dnes tu nikdo není sám. Ještě čaj?",
    "storm.talk.trains.6": "Ano, prosím. A povídejte o tomhle místě — působí tak staře.",
    "storm.talk.trains.7": "Podívejte. Sníh zakryl koleje. Jako deka.",
    "story.act.1.title": "Dějství I — Klíče",
    "story.act.2.title": "Dějství II — Štamgasti",
    "story.act.3.title": "Dějství III — Nabídka",
    "story.act.4.title": "Dějství IV — Poslední vlak",
