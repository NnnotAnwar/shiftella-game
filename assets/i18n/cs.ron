    "walk.backstep.back": "Zpátky dovnitř",
    "walk.backstep.chip": "Na chvilku ven",
    "walk.backstep.chip_tip": "Nadechnout se na zadním schodu (jednou za noc). Kavárna počká — nikomu to nevadí.",
    "walk.from.friend": "Terka",
    "walk.from.mum": "Máma",
    "walk.from.neighbour": "paní Marta",
    "walk.home": "Doma.",
    "walk.line.bakery.1": "Pekárna na rohu právě vytahuje roletu. Teplé světlo, teplý chleba.",
    "walk.line.bakery.1.festive": "Perníková srdce ve výloze a pekařka si brouká koledu.",
    "walk.line.bakery.1.rain": "Déšť bubnuje na markýzu pekárny. Uvnitř to voní kváskem a kmínem.",
    "walk.line.bakery.2": "„Pro tvoje noční sovy,“ říká pekařka a balí koláč do papíru.",
    "walk.line.bakery.2.cold": "Papírový sáček ti celou cestu domů hřeje studené ruce.",
    "walk.line.embankment.1": "Vltava má barvu čaje s mlékem. Kolem kotvících lodí pluje labuť.",
    "walk.line.embankment.1.fog": "Na vodě leží mlha. Druhý břeh je jen řada světýlek.",
    "walk.line.embankment.1.rain": "Déšť kreslí na řece kroužky. Lodě tiše ťukají o molo.",
    "walk.line.embankment.1.snow": "Sníh na zábradlí. Tvoje stopy jsou na nábřeží první.",
    "walk.line.embankment.2": "Nebe nad Letnou broskvově zrůžoví. Někde zazvoní tramvaj.",
    "walk.line.embankment.2.festive": "Světýlka na lodích, na jedné palubě stromeček. I řeka slaví.",
    "walk.line.embankment.2.frost": "Jinovatka na lavičkách. Dech ti visí ve vzduchu jako malý mráček.",
    "walk.line.park.1": "Stromovka ještě spí. Jen kosi a běžec ve žluté čepici.",
    "walk.line.park.1.frost": "Tráva je bílá jinovatkou a křupe pod botami.",
    "walk.line.park.1.rain": "Mokré listí na cestě a v každé louži kousek nebe.",
    "walk.line.park.1.snow": "Park je bílý a tichý. Nějaký pes skáče sněhem a má ohromnou radost.",
    "walk.line.park.2": "Na lavičce u rybníka chvilka jen tak dýchat.",
    "walk.line.park.2.fog": "Staré stromy vystupují z mlhy jeden po druhém jako opozdilí hosté.",
    "walk.line.tram.1": "První tramvaj vyjíždí z rozbřesku, skoro prázdná a teple osvětlená.",
    "walk.line.tram.1.festive": "Někdo pověsil na madlo v tramvaji hvězdu z flitrů.",
    "walk.line.tram.1.rain": "Déšť na oknech tramvaje. Do zamlženého skla nakreslíš malé srdíčko.",
    "walk.line.tram.1.snow": "Tramvaj prořízne čerstvým sněhem dvě tmavé čáry.",
    "walk.line.tram.2": "Vedle tebe si sedne sestřička po noční. Povídáte si až k její zastávce.",
    "walk.msg.marta_geraniums": "Zalila jsem Lidiny muškáty na balkoně. Pořád kvetou, tvrdohlavé. Jako ty.",
    "walk.msg.marta_lida_dance": "Víš, že tvoje babička jednou tancovala na tom pultu? Silvestr třiaosmdesát. Mámě neříkej, že to máš ode mě.",
    "walk.msg.marta_snow": "První sníh na střeše nádraží. Lida vždycky říkala, že noční kavárna hřeje nejvíc, když sněží.",
    "walk.msg.marta_soup": "Nechala jsem ti u dveří hrnec polévky. Hrnec vrať, až budeš moct, nespěchá to.",
    "walk.msg.marta_window": "Zase jsem večer viděla světlo v Lidině okně. Trochu jsem si poplakala — ale tak hezky.",
    "walk.msg.mum_christmas": "Vánoce u nás, nebo přijdeme všichni do kavárny? Brácha hlasuje pro kavárnu.",
    "walk.msg.mum_dad": "Táta tě pozdravuje. Chce přijet ochutnat tu slavnou kávu. Varuju tě: bude chtít tři cukry.",
    "walk.msg.mum_eat": "Jedla jsi? Něco pořádného, ne croissant ve čtyři ráno.",
    "walk.msg.mum_first_week": "Jak první týden? Babička by byla štěstím bez sebe. A jez i něco jiného než koláče.",
    "walk.msg.mum_sleep": "Napiš mi, až budeš doma. Já vím, já vím. Stejně napiš.",
    "walk.msg.mum_whatever_you_choose": "Ať se s kavárnou rozhodneš jakkoli, jsme na tebe pyšní. Nemusíš to nést sama.",
    "walk.msg.terka_light": "Ať se stane cokoli — nenechala jsi to světlo zhasnout. To se počítá.",
    "walk.msg.terka_meme": "Posílám ti fotku kočky v malinké pláštěnce. To je všechno. To je ta zpráva.",
    "walk.msg.terka_proud": "O půlnoci jsem šla kolem tvojí kavárny. Svítí jako lucerna. Jsem na tebe pyšná, šéfová.",
    "walk.msg.terka_song": "V rádiu hrála písnička, co zní přesně jako tvoje kavárna ve tři ráno. Posílám ti ji.",
    "walk.msg.terka_tired": "Do telefonu jsi zněla unaveně. Zítra se vyspi, přinesu ti polévku a nebudu chytračit.",
    "walk.msg.terka_visit": "V sobotu přijdu s knížkou a zůstanu až do vlaků. Schováš mi místo v rohu?",
    "walk.place": "Praha-Holešovice",
    "walk.route.bakery": "Přes pekárnu",
    "walk.route.bakery.hint": "Kolem pekárny, co otvírá v šest. Koláč na pult: první čtyři hodiny útulněji.",
    "walk.route.bakery.tonight": "Koláč z ranní pekárny čeká na pultu. Kavárna voní máslem a povidly.",
    "walk.route.embankment": "Nábřeží",
    "walk.route.embankment.hint": "Podél Vltavy. Čistá hlava: rychlá káva ti dnes v noci půjde o kousek líp.",
    "walk.route.embankment.tonight": "Pořád v sobě máš kus řeky — rychlá káva ti dnes jde klidně od ruky.",
    "walk.route.park": "Stromovka",
    "walk.route.park.hint": "Přes park. Klidný sál v prvních hodinách, hosté o trochu trpělivější.",
    "walk.route.park.tonight": "Ještě cítíš mokrou trávu ze Stromovky. Sál začíná noc v klidu.",
    "walk.route.tram": "Tramvají",
    "walk.route.tram.arrived": "Sestřička z tramvaje je tady — mává ode dveří.",
    "walk.route.tram.hint": "První tramvají. Někdo, koho tam potkáš, se večer zastaví.",
    "walk.route.tram.tonight": "Sestřička z ranní tramvaje říkala, že se možná zastaví. Drž jí místo v teple.",
    "walk.skip": "Přeskočit",
    "walk.title": "Kudy domů?",
    "walk.usual": "jako vždy",
    "wish.bitter_mood": "Hořké. Jako moje nálada. Bez cukru.",
    "wish.childhood": "Něco z dětství.",
    "wish.club_oven": "Něco studeného — v klubu bylo jako v peci.",
    "wish.earned_it": "Něco sladkého. Zasloužím si to.",
    "wish.engaged": "Právě jsme se zasnoubili! Něco extra!",
    "wish.exam_at_eight": "Palivo. V osm mám zkoušku.",
    "wish.filip.cheapest": "Nejlevnější kafe, které se ještě počítá jako kafe?",
    "wish.filip.house_special": "Ten váš nápoj z tabule — jestli to není moc drahé.",
    "wish.filip.passed": "Udělal jsem to! Něco fajnového — zvu se.",
    "wish.fog_outside": "Něco teplého. V té mlze není vidět ani nádraží.",
    "wish.for_my_friend": "Něco hezkého — kamarádka má narozeniny.",
    "wish.goes_with_snow": "Něco, co se hodí ke sněhu.",
    "wish.guest_333.two_sugars": "Čaj. S citronem. Dva cukry.",
    "wish.guest_anwar.oat": "Ovesný flat white, prosím. A možná heslo na wi-fi.",
    "wish.hana.blanket": "Po směně, Karolino. Něco, co je jako deka.",
    "wish.hana.house_special": "To z tabule. Než mi zase zazvoní telefon.",
    "wish.hana.like_home": "„Dneska nikam nespěchám. Něco teplého a jemného, prosím.“",
    "wish.hana.twelve_minutes": "Mám dvanáct minut. Něco horkého a rychle.",
    "wish.hands_cold": "Cokoli teplého do dlaní. Mám zmrzlé ruce.",
    "wish.headache": "Něco svěžího, prosím. Bolí mě hlava.",
    "wish.house_special": "Tu specialitu z tabule, prosím.",
    "wish.kind_coffee": "Probuďte mě jemně — kafe, ale laskavé.",
    "wish.like_grandma_made": "Něco, co dělávala moje babička? Byla ze Lvova.",
    "wish.long_day": "Něco teplého, ne moc sladkého — byl to dlouhý den.",
    "wish.lori.house_special": "Tu specialitu, co se o ní mluví. Na hlas.",
    "wish.lori.my_voice": "Něco pro můj hlas. Med, třeba?",
    "wish.lori.one_song": "Jedna horká čokoláda, zaplacená jednou písničkou?",
    "wish.mirek.house_special": "Dej mi tu vaši specialitu, Karolíno.",
    "wish.mirek.like_home": "„Je tu teplo jako dřív u Lidy. Dej mi něco, u čeho se dá posedět.“",
    "wish.mirek.like_lida": "Černou, Karolino. Jak ji lila Lída.",
    "wish.mirek.tired_eyes": "Něco na unavené oči, co? Ne že by ty moje byly unavené.",
    "wish.mirek.walked": "Dneska jsem šel pěšky. Něco na zahřátí pro starého chlapa.",
    "wish.not_coffee": "Cokoli, jen ne kafe. Už jich mám v sobě šest.",
    "wish.on_the_side": "Jen něco malého k tomu.",
    "wish.one_hand": "Něco, co se dá pít jednou rukou — druhou řídím dron.",
    "wish.patrol": "Silné, s sebou. Zatím klidná noc — ať to tak zůstane.",
    "wish.radek.house_special": "Specialitu domu. Dneska si ji zasloužím.",
    "wish.radek.last_shift": "Poslední směna, Karolino. Ať stojí za to.",
    "wish.radek.no_rush": "Dneska nikam nespěchám. Něco pomalého.",
    "wish.radek.to_go": "S sebou. Ten v 01:12 se sám neodbaví.",
    "wish.skipped_dinner": "Něco sytého. Dneska bez večeře. A bez oběda.",
    "wish.sleepy_not_awake": "Něco jemného. Snažím se usnout, ne probrat.",
    "wish.slow_sip": "Něco na pomalé upíjení, zatímco venku prší.",
    "wish.soaked": "Něco kořeněného — ten déšť mi zalezl až do kostí.",
    "wish.surprise_me": "Překvapte mě. Něco, co si nikdy neobjednávám.",
    "wish.taste_of_home": "Něco, co chutná jako domov. Klidně cizí.",
    "wish.three_am": "Jsou tři ráno. Nevím, co chci.",
    "wish.train_soon": "Cokoli nejrychlejšího — vlak mi jede za deset minut.",
    "wish.vera.house_special": "Ukaž, co jsi vymyslela. Lída by chtěla vědět.",
    "wish.vera.lidas_kolac": "Babiččin koláč byl lepší, Karolino. Ukaž mi ten svůj.",
    "wish.vera.like_home": "„Takhle to tu vypadalo, když byla Lida mladá. Něco sladkého k tomu, děvče.“",
    "wish.vera.properly": "Čaj. Pořádně udělaný, prosím — žádné máchání sáčku.",
    "wish.vera.she_would_make": "Udělej mi něco, co by udělala Lída.",
    "wish.wake_me": "Něco silného. Mám před sebou ještě čtyři hodiny za volantem.",
