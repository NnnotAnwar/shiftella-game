    "build.before_after.back_room": "zadní místnost",
    "build.before_after.cozier": "útulnější kavárna",
    "build_wish.barista_machine.ask": "Když přijede vlak, jeden kávovar nestíhá. Se dvěma bychom tu frontu zvládli.",
    "build_wish.barista_machine.reason": "druhý kávovar",
    "build_wish.barista_machine.thanks": "Dva kávovary! Teď ať si ten vlak přijede. Díky!",
    "build_wish.cook_oven.ask": "Kdybychom měli troubu, koláče by šly na stůl ještě teplé. Takhle je jen ohřívám.",
    "build_wish.cook_oven.reason": "troubu",
    "build_wish.cook_oven.thanks": "Trouba! Cítíš to? Tak voní pořádná kuchyně. Díky!",
    "build_wish.crew_coats.ask": "Karolino, nešel by věšák? Bundy nám zatím visí na lednici.",
    "build_wish.crew_coats.reason": "věšák na kabáty",
    "build_wish.crew_coats.thanks": "Věšák! Konečně nemám šálu v mléce.",
    "build_wish.filip_socket.ask": "Promiňte… nemáte tu někde zásuvku? Notebook mi umírá a zkouška ne.",
    "build_wish.filip_socket.reason": "stůl se zásuvkou",
    "build_wish.filip_socket.thanks": "Zásuvka! U stolu! Tohle je nejlepší kavárna ve městě. Vážně.",
    "build_wish.hana_quiet.ask": "Kdyby tu bylo jedno křeslo s lampou, kde se dá na deset minut zmizet…",
    "build_wish.hana_quiet.reason": "tichý kout",
    "build_wish.hana_quiet.thanks": "Křeslo. A lampa. Ty jsi mi to fakt postavila… Děkuju.",
    "build_wish.insomniacs_rug.ask": "Ve tři ráno tu táhne od podlahy. Koberec by to spravil.",
    "build_wish.insomniacs_rug.reason": "koberec",
    "build_wish.insomniacs_rug.thanks": "Koberec. Nohy v teple, hlava v klidu. Možná dneska i usnu.",
    "build_wish.lori_stage.ask": "Kdyby tu byl kousek místa a trochu světla… zahrála bych vám. Jen tak, za čaj.",
    "build_wish.lori_stage.reason": "malé pódium",
    "build_wish.lori_stage.thanks": "Pódium… pro mě? Tak to musím hrát líp než kdy dřív.",
    "build_wish.mirek_radio.ask": "Lida mívala na pultu rádio. Hrálo potichu, celou noc. Chybí mi to.",
    "build_wish.mirek_radio.reason": "staré rádio",
    "build_wish.mirek_radio.thanks": "Rádio! Přesně takhle to tu znělo, když jsem byl mladej.",
    "build_wish.nurses_sofa.ask": "Po dvanáctce se člověk chce do něčeho zabořit. Třeba do gauče.",
    "build_wish.nurses_sofa.reason": "gauč",
    "build_wish.nurses_sofa.thanks": "Gauč… Pět minut. Jenom pět minut a jsem zase člověk.",
    "build_wish.radek_board.ask": "Tabule s odjezdy na zdi by se hodila. Lidi by se míň ptali a víc pili.",
    "build_wish.radek_board.reason": "tabule s odjezdy",
    "build_wish.radek_board.thanks": "Tabule visí, vlaky jedou. Pořádek. Takhle se mi to líbí.",
    "build_wish.students_sockets.ask": "U Filipova stolu je plno. Nešel by ještě jeden se zásuvkou?",
    "build_wish.students_sockets.reason": "víc zásuvek",
    "build_wish.students_sockets.thanks": "Dvě zásuvky! Tak tady dneska dopíšeme celou seminárku.",
    "build_wish.vera_window.ask": "Lida mi vždycky držela místo u okna. Odtamtud je vidět na koleje.",
    "build_wish.vera_window.reason": "místo u okna",
    "build_wish.vera_window.thanks": "Lavička u okna… Jako za Lidy. Tady se mi křížovka luští sama.",
