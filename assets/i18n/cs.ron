    "ui.guest.regular": "štamgast",
    "ui.guest.talk": "Promluvit si",
    "ui.guest.train": "vlak {time}",
    "ui.guest.unhappy": "Nespokojenost",
    "ui.guest.waiting": "čeká na obsluhu",
    "ui.guest.wants": "čeká na: {item}",
    "ui.help.app.body": "Rozpis směn (klik změní koncept, Zveřejnit ho pošle všem), žádosti o výměnu a volno, zprávy od @shiftella_bot, nástěnka, checklisty, noční přehled a podklady pro mzdy.",
    "ui.help.app.title": "Shiftella (T)",
    "ui.help.build.body": "Vyber kus a klikni do kavárny. R otočí, X bourá, Ctrl+Z vrátí, pravé tlačítko nebo Esc zruší. Lampy, rostliny a koberce zlepší náladu.",
    "ui.help.build.title": "Stavba (B)",
    "ui.help.crew.body": "Najímej uchazeče, sleduj potřeby, dovednosti a vztahy. Propustit jde jedním kliknutím — a vrátit tlačítkem Zpět.",
    "ui.help.crew.title": "Personál (C)",
    "ui.help.events.body": "Zprávy vyskakují vpravo dole; volby počkají na pauze a po chvíli se rozhodnou samy. Deník (L) nebo klik na řádek nahoře ukáže, co se stalo.",
    "ui.help.events.title": "Události a deník",
    "ui.help.money.body": "Tržby a spropitné přicházejí v noci, mzdy a nákupy odcházejí. Splátky dluhu vidíš v denním plánu. Čistá, rychlá a útulná kavárna má lepší pověst.",
    "ui.help.money.title": "Peníze, dluh, pověst",
    "ui.help.night.body": "Mezerník je pauza, 1/2/3 rychlost, WASD a kolečko kamera, Home celá kavárna. Najetím na hosta uvidíš jeho přání; štamgasti občas chtějí promluvit.",
    "ui.help.night.title": "Noc a hosté",
    "ui.help.priorities.body": "Řádky jsou lidé, sloupce práce. 1 je nejdůležitější, prázdné znamená nikdy. Klik zvýší, pravé tlačítko nebo kolečko sníží.",
    "ui.help.priorities.title": "Priority (P)",
    "ui.help.rhythm.body": "Ve dne plánuješ (hodiny stojí). V noci od 22:00 do 06:00 kavárna běží. Ráno shrnutí a automatické uložení. Enter začne noc.",
    "ui.help.rhythm.title": "Den a noc",
    "ui.help.tip": "Jak hrát (F1)",
