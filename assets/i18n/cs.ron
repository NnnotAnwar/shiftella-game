    "taste.bitter": "Hořké",
    "taste.cold": "Studené",
    "taste.comforting": "Konejšivé",
    "taste.fancy": "Fajnové",
    "taste.filling": "Sytné",
    "taste.fresh": "Svěží",
    "taste.mild": "Jemné",
    "taste.quick": "Rychlé",
    "taste.spiced": "Kořeněné",
    "taste.strong": "Silné",
    "taste.sweet": "Sladké",
    "taste.warm": "Teplé",
    "thanks.filip.1": "Prošel jsem! Zčásti je to vina tvého kafe. — F.",
    "thanks.g01": "Díky za teplé ruce.",
    "thanks.g02": "Nejlepší kafe odsud až do Adamova.",
    "thanks.g03": "Vlak stihnutý! Díky vám.",
    "thanks.g04": "Přišla jsem smutná. Odcházím míň smutná.",
    "thanks.g05": "Z vašeho okna byl déšť hezčí.",
    "thanks.g06": "Pamatovala jste si, že piju bez cukru. To si nikdo nepamatuje.",
    "thanks.g07": "Zítra ve stejnou dobu?",
    "thanks.g08": "Za polévku. A za ticho.",
    "thanks.g09": "Dobrá noc po špatném dni.",
    "thanks.g10": "Moje směna měla dvanáct hodin. Díky tomuhle jen jedenáct.",
    "thanks.g11": "Pozdravujte kocoura!",
    "thanks.g12": "Díky, že jste se neptala. A za koláč.",
    "thanks.g13": "Pět hvězdiček. Šest, kdyby fungovala wi-fi.",
    "thanks.g14": "Dnes jsem tu požádal o ruku. Řekla ano!",
    "thanks.g15": "Příští zastávka: domov. Díky za tuhle.",
    "thanks.g16": "To nejlepší, co jsem letos ochutnal, bylo ve tři ráno.",
    "thanks.g17": "Nakreslil jsem to, když jsem čekal. Nechte si to.",
    "thanks.g18": "U vás se cizí lidé cítí jako štamgasti.",
    "thanks.g19": "Řeknu babičce o vašem čaji.",
    "thanks.g20": "V suchu, v teple a déle, než jsem chtěl.",
    "thanks.g21": "Hudba byla dokonalá. Kdo ji vybírá?",
    "thanks.g22": "Ten hrnek byl přesně tak velké objetí, jak bylo potřeba.",
    "thanks.g23": "Odbory nočních řidičů děkují.",
    "thanks.g24": "Svítil měsíc. A vaše lampa taky.",
    "thanks.g25": "Dýško a tajemství: tohle je moje nejoblíbenější místo.",
    "thanks.g26": "Kocour mi ukradl ubrousek. Tohle je už druhý.",
    "thanks.g27": "Z nočního oddělení, s unavenou láskou.",
    "thanks.g28": "Vrátím se, až napadne sníh.",
    "thanks.g29": "Díky za světlo v okně. Pomáhá, víte.",
    "thanks.g30": "Zůstaňte otevření. Prosím.",
    "thanks.guest_333.1": "Děkuji.",
    "thanks.hana.1": "Zachránila jsi mi noční směnu. Zase. — H.",
    "thanks.hana.2": "Dvanáct minut klidu. Děkuju. — H.",
    "thanks.lori.1": "Za tu teplou písničku, o které nevíš, žes ji zpívala. — L.",
    "thanks.mirek.1": "Za kafe. A za to, že ses neptala. — M.",
    "thanks.mirek.2": "Byla by pyšná. Nedělej z toho vědu. — M.",
    "thanks.radek.1": "Vlaky dnes jezdily na čas. Ty taky. — R.",
    "thanks.vera.1": "Přijatelné. Velmi přijatelné. — V. S.",
    "thanks.vera.2": "Čaj byl pořádný. Nikomu neříkej, že jsem to řekla. — V.",
    "theme.art_nouveau.desc": "Mozaikový pás v šalvějové a zlaté, mosazné lampy a oblé lišty jako ve staré secesní kavárně.",
    "theme.art_nouveau.name": "Pražská secese",
    "theme.grandma_original.desc": "Vybledlá tapeta s růžovými proužky, medově zbarvené dřevo, krajky a jantarové lampy. Přesně jak to Lída nechala.",
    "theme.grandma_original.missed": "Lídina tapeta… tys ji změnila. No. Teď je to tvoje kavárna.",
    "theme.grandma_original.name": "Babiččin originál",
    "theme.nocturne_2039.desc": "Indigové holografické akcenty, teplé LED pásky a špetka fialové ze Shiftelly.",
    "theme.nocturne_2039.name": "Nocturne 2039",
    "theme.station_retro.desc": "Krémová a lahvově zelená barva, smaltované cedule a tabule s jízdním řádem — nádražní bufet z roku 1979.",
    "theme.station_retro.name": "Nádražní retro",
    "theme.winter_lights.desc": "Bílozlatá světýlka, červené stuhy a smrček. Nejútulnější v adventu.",
    "theme.winter_lights.name": "Zimní světla",
    "train.announce.arrival": "Vážení cestující, vlak {train} ze stanice {from} do stanice {to}, pravidelný příjezd {time}, přijíždí k nástupišti {platform}.",
    "train.announce.delay": "Vážení cestující, vlak {train} ze stanice {from} do stanice {to}, pravidelný příjezd {time}, nástupiště {platform}, má zpoždění. Děkujeme za trpělivost.",
    "train.en_471.name": "EN 471 — noční expres Cheb → Frýdlant",
    "train.nex_9002.name": "Nex 9002 — samořízený nákladní",
    "train.nex_9047.name": "Nex 9047 — samořízený nákladní",
    "train.os_2141.name": "Os 2141 — osobní z Adamova",
    "train.r_815.name": "R 815 — rychlík Frýdlant → Beroun",
    "train.rn_333.name": "Rn 333 — v jízdním řádu od roku 1979 není",
    "trait.anxious.desc": "Bojí se chyby, a když je fronta, dělá je. U pokladny je ale pečlivý.",
    "trait.anxious.name": "Úzkostný",
    "trait.calm.desc": "Výpadek proudu? Tak zapálíme svíčky. Špatné zprávy na něj platí jen napůl.",
    "trait.calm.name": "Klidas",
    "trait.chatterbox.desc": "Ví všechno o všech hostech. Hosté ho milují, jen práce jde pomaleji, když je klid.",
    "trait.chatterbox.name": "Upovídaný",
    "trait.clumsy.desc": "Ruce dělají něco jiného, než měly v plánu. Občas cinkne nádobí.",
    "trait.clumsy.name": "Nešika",
    "trait.early_bird.desc": "Do půlnoci je k nezastavení, po druhé hodině jako v mlze.",
    "trait.early_bird.name": "Skřivan",
    "trait.grumpy.desc": "Bručí, ale řemeslo umí. Trpěliví hosté mají jeho „pravý charakter\" rádi.",
    "trait.grumpy.name": "Bručoun",
    "trait.hard_worker.desc": "Neodejde, dokud to nedodělá. Při frontě vynechá pauzu — a pak je k smrti unavený.",
    "trait.hard_worker.name": "Dříč",
    "trait.kind.desc": "Utěší hosta i kolegu. Vedle něj mají všichni o trochu lepší náladu.",
    "trait.kind.name": "Dobrák",
    "trait.lazy.desc": "Pauza je posvátná. Pracuje pomaleji, ale taky se tolik neunaví.",
    "trait.lazy.name": "Lenoch",
    "trait.light_sleeper.desc": "Slyší, co ostatní ne. Všimne si hosta ve 3:33 a občas tuší, co přijde.",
    "trait.light_sleeper.name": "Lehký spánek",
    "trait.loner.desc": "Nejlíp pracuje, když ho nikdo neruší. V davu kolegů mu klesá nálada.",
    "trait.loner.name": "Samotář",
    "trait.music_lover.desc": "Pracuje do rytmu. S hudbou kvete, v tichu vadne — a rádio si pustí sám.",
    "trait.music_lover.name": "Muzikant",
    "trait.neat.desc": "Nepřejde kolem skvrny. Uklízí rychleji a sám od sebe.",
    "trait.neat.name": "Pořádkumilovný",
    "trait.night_owl.desc": "V noci ožívá, ve dne spí jako dřevo. Po půlnoci se unaví mnohem pomaleji.",
    "trait.night_owl.name": "Sova",
    "trait.perfectionist.desc": "Pomalu, ale dokonale. Lepší dýška — a špatná nálada ze špíny.",
    "trait.perfectionist.name": "Perfekcionista",
    "trait.romantic.desc": "Zamilovává se do kolegů i do deště. Za deštivé noci je mu líp.",
    "trait.romantic.name": "Romantik",
    "tutorial.app.body": "Otevři Shiftellu ({key.app}). V rozpisu klikni na buňku a změň směnu, pak Zveřejnit — noc se řídí zveřejněným rozpisem. Najdeš tam i žádosti, zprávy a nástěnka.",
    "tutorial.app.title": "Rozpis v aplikaci Shiftella",
    "tutorial.atmosphere": "Když svítí lampy, je tu nějak tepleji.",
    "tutorial.book": "Babiččiny recepty jsou všechny tady — a kartička na lipový čaj, jejím písmem. ({key.book})",
    "tutorial.build.body": "Stavba ({key.build}): vyber kus, klikni do kavárny. R otočí, X bourá, Ctrl+Z vrátí. Lampy, rostliny a koberec hosty potěší.",
    "tutorial.build.title": "Zútulni sál (nepovinné)",
    "tutorial.cat": "Nádražní kocour. Hlídá tyhle dveře déle než já.",
    "tutorial.checklist_close": "Poslední objednávky byly v 5:15 — čas pořádně zavřít: nádobí a lednici hned, pokladnu a kávovar, až bude prázdno ({key.app}). Po poctivém zavření je zítřejší otevření dvakrát rychlejší.",
    "tutorial.checklist_open": "Zbytek otevíracích rituálů mám v Shiftelle ({key.app}) — fajfky na lampě, lednici, pokladně. Do 22:00 je zavřeno, stihnu to v klidu; všechno do 22:30 a kavárna je připravená.",
    "tutorial.clear_table": "Šálky samy ke dřezu nedojdou.",
    "tutorial.closing": "Dveře jsou zavřené. Vzkaz pro zítřejší já, zhasnout okno — a pak „Zavřít“ ({key.doors}).",
    "tutorial.crew.body": "Otevři Personál ({key.crew}). Dole jsou uchazeči — baristka nebo barista se hodí hned první noc. Jedno kliknutí na Najmout.",
    "tutorial.crew.title": "Najmi první posilu",
    "tutorial.duties": "Kuba vezme nádobí. Já hosty.",
    "tutorial.enjoy.body": "To je všechno. {key.help} nebo „?“ v liště otevře přehled Jak hrát. Ať okno svítí až do rána.",
    "tutorial.enjoy.title": "Hezkou noc",
    "tutorial.equipment": "I zbytek kuchyně má své drobné práce: hrnec polévky na sporák, mléko z lednice. Co svítí, to můžu použít. Každý klik mi přidá práci do fronty — vidím ji nad hlavou a vlevo dole ({key.queue}).",
    "tutorial.events.body": "Vpravo dole se objeví zprávy a malé příhody. Některé mají tlačítka — vyber, nebo počkej a noc rozhodne za tebe. Na pauze počkají.",
    "tutorial.events.title": "Události",
    "tutorial.experiment": "Lípa a med, píše se na kartičce. Do přihrádek spíže, pak Zkusit.",
    "tutorial.fairness": "Kroužky ukazují, jak se kdo cítí s týdnem. Nikdo nemusí být na hraně.",
    "tutorial.garlands": "Nejdřív okna, pak pult, pak dveře. Jako každý rok, Karolinko.",
    "tutorial.greet": "To je Mirek. Babiččin nejstarší štamgast. Zamávat neuškodí.",
    "tutorial.guests.body": "Najeď myší na hosta: uvidíš, co si přeje a jak dlouho vydrží čekat. Štamgasti mají svůj příběh — klikni na ně, a když mají co říct, objeví se Promluvit si.",
    "tutorial.guests.title": "Hosté",
    "tutorial.journal": "Babička měla za pokladnou krabici fotek. Budu si jednu vést taky. ({key.journal})",
    "tutorial.jukebox": "Babiččiny desky. Tři ještě hrají.",
    "tutorial.light_window": "Nejdřív světlo v okně, Karolinko. Vždycky nejdřív.",
    "tutorial.machine": "Starý kávovar se musí chvilku probouzet. Drž, dokud nezavrní.",
    "tutorial.moment": "U okna něco září…",
    "tutorial.money.body": "Vpravo nahoře: pokladna, hvězdičky pověsti a dluh. Ráno přijde shrnutí noci a ve dne vidíš, kdy je další splátka.",
    "tutorial.money.title": "Peníze a pověst",
    "tutorial.mop": "Zablácené stopy u dveří. Jedno pořádné přejetí.",
    "tutorial.pick_recipe": "„Černou, jak ji lila Lída.“ Myslím, že vím kterou.",
    "tutorial.pour_over": "Pomalé kruhy, do rytmu deště. A když se to nepovede — přeskoč, i tak bude dobrá.",
    "tutorial.priorities.body": "Priority (P): řádky jsou lidé, sloupce práce. 1 = dělá to nejdřív, prázdné = vůbec. Klik zvýší, pravé tlačítko sníží. Každému jednu jasnou jedničku.",
    "tutorial.priorities.title": "Kdo co dělá",
    "tutorial.quick_brew": "Běžná objednávka. Můžu nechat pracovat kávovar a dělat něco jiného.",
    "tutorial.rail": "Lístek s prázdným kroužkem — nikdo ho nemá. Ten je můj.",
    "tutorial.rozpis": "Chce dělat s kuchařem. Beru na vědomí.",
    "tutorial.speed": "Je klid. Můžu nechat hodiny běžet trochu rychleji.",
    "tutorial.staff.body": "Lidé berou práci podle priorit. V Personálu ({key.crew}) vidíš jejich potřeby — energii, hlad, náladu. Unavení si sami dají pauzu.",
    "tutorial.staff.title": "Tým pracuje sám",
    "tutorial.start.body": "Až budeš chtít, klikni na Začít noc (nebo Enter). Rozsviť okno a uvař první kávu.",
    "tutorial.start.title": "Otevři dveře",
    "tutorial.take_order": "Čeká na mě. Podívám se, co by si dal.",
    "tutorial.time.body": "{Key.pause} pozastaví, {key.speed1}/{key.speed2}/{key.speed3} mění rychlost. Pruh pod hodinami ukazuje večer od 21:30 do 06:30 — světlé konce jsou příprava a zavírání (dveře zavřené), trojúhelníčky jsou vlaky — přivezou malý nával.",
    "tutorial.time.title": "Čas plyne po svém",
    "tutorial.tip_coin": "Na Mirkově stole se něco blyští. Nakonec tu nechal minci.",
    "tutorial.usual": "Mirek mi teď věří. „To obvyklé?“ — jedno ťuknutí.",
    "tutorial.wash": "Šálky se kupí. Podrž, a umyjí se.",
    "tutorial.welcome.body": "Den je na plánování: lidé, rozpis, nábytek. Noc od 22:00 do 06:00 kavárna běží sama — ty jen dohlížíš. Pár tipů a pak už je to tvoje.",
    "tutorial.welcome.title": "Vítej v Café Nocturne",
    "tutorial.welcome_sandbox.body": "Pár karet ukáže, jak to tu chodí: den na plánování, noc od 22:00 do 06:00 na provoz. Kdykoli můžeš průvodce přeskočit.",
    "tutorial.welcome_sandbox.title": "Krátká prohlídka?",
