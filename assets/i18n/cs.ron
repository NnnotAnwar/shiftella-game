    "story.new_parent.react.easier": "Fakt? Slibujete? …Děkuju.",
    "story.new_parent.react.warm": "Máte pravdu. Káva by byla hrozný nápad.",
    "story.new_parent.text": "Doma miminko, konečně spí. Na vlastní spánek už nezbývá sil.",
    "story.night.01.hint": "Klíč je pod rohožkou. Rozsviť okno a uvař první kávu.",
    "story.night.01.title": "Příjezd",
    "story.night.02.hint": "Najmi někoho a sestav první rozpis.",
    "story.night.02.title": "První kolega",
    "story.night.03.hint": "Ve dvě přijde někdo, kdo nemá čas čekat.",
    "story.night.03.title": "Déšť a sestra",
    "story.night.04.hint": "Nech v okně svítit. Celou noc.",
    "story.night.04.title": "3:33",
    "story.night.05.hint": "Po půlnoci přijde někdo, kdo Lidu znal. Ať jsou stoly čisté.",
    "story.night.05.title": "Paní s křížovkou",
    "story.night.06.hint": "Sobota. Kolem jedenácté skončí koncert v kulturáku.",
    "story.night.06.title": "Po koncertě",
    "story.night.07.hint": "V šest ráno odchází 15 000 Kč. Počítej.",
    "story.night.07.title": "První splátka",
    "story.night.08.hint": "Hlásí se noví lidé. A Mirek dnes parkuje nějak divně.",
    "story.night.08.title": "Obrubník",
    "story.night.09.hint": "V jednu se zastaví výpravčí. Má čtyři minuty.",
    "story.night.09.title": "Poslední výpravčí",
    "story.night.10.hint": "Připrav svíčky. Jen tak, pro jistotu.",
    "story.night.10.title": "Tma",
    "story.night.11.hint": "Prší. Na nástupišti někdo hraje.",
    "story.night.11.title": "Píseň na nástupišti",
    "story.night.12.hint": "Křeslo a lampa by se dnes mohly hodit.",
    "story.night.12.title": "Tichý kout",
    "story.night.13.hint": "Hygiena přijde kolem půl dvanácté. Ať se leskne.",
    "story.night.13.title": "Inspekce",
    "story.night.14.hint": "Druhá splátka. A Vera dnes něco nese.",
    "story.night.14.title": "Kuchařka",
    "story.night.15.hint": "Mlha. Ve 3:33 se tě někdo na něco zeptá.",
    "story.night.15.title": "Otázka",
    "story.night.16.hint": "Nikdo nepřijde. Čas na úklid a na lidi, kteří tu pracují.",
    "story.night.16.title": "Prázdná noc",
    "story.night.17.hint": "Přijede návštěva ze sítě NONSTOP 24. Poslouchej.",
    "story.night.17.title": "NONSTOP 24",
    "story.night.18.hint": "Filip dnes neotevřel notebook.",
    "story.night.18.title": "Opravák",
    "story.night.19.hint": "Bude lít. Hostů bude dvakrát tolik — a špíny taky.",
    "story.night.19.title": "Liják",
    "story.night.20.hint": "Mirek dnes přijede pozdě. Buď u dveří.",
    "story.night.20.title": "Na dlaň",
    "story.night.21.hint": "Další splátka v šest. Někdo chce dovolenou.",
    "story.night.21.title": "Třetí splátka",
    "story.night.22.hint": "Dnes se rozhodne, čí bude nápis nad dveřmi.",
    "story.night.22.title": "Rozhodnutí",
    "story.night.23.hint": "Radek má poslední službu.",
    "story.night.23.title": "Jízdní řád",
    "story.night.24.hint": "Prší. Pokud má Lori pódium, dnes je její večer.",
    "story.night.24.title": "Večer pro Lori",
    "story.night.25.hint": "Přijde bouřka. Ať okno svítí.",
    "story.night.25.title": "Bouřka",
    "story.night.26.hint": "Hana se rozhodla.",
    "story.night.26.title": "Drážďany",
    "story.night.27.hint": "Sněží. Vera chce vyprávět.",
    "story.night.27.title": "První sníh",
    "story.night.28.hint": "Čtvrtá splátka. A Mirek má otázku.",
    "story.night.28.title": "Dopis",
    "story.night.29.hint": "Každý štamgast dnes přijde uzavřít svůj příběh.",
    "story.night.29.title": "Loučení",
    "story.night.30.hint": "Poslední noc. 30 000 Kč v šest. Ve 3:33 ať okno svítí.",
    "story.night.30.title": "Poslední vlak",
    "story.nurse_loss.log": "{name}: těžká noc a po ní tiché místo.",
    "story.nurse_loss.opt.cake": "Kousek dortu",
    "story.nurse_loss.opt.quiet": "Přinést čaj a nechat v klidu",
    "story.nurse_loss.opt.record": "Něco tichého z jukeboxu",
    "story.nurse_loss.react.cake": "Děkuju. Možná později.",
    "story.nurse_loss.react.quiet": "…Děkuju. Že se neptáte.",
    "story.nurse_loss.react.record": "To je hezké. Trochu se mi uleví.",
    "story.nurse_loss.text": "Po těžké službě — dnes v noci pacient nepřežil. Dívá se do hrnku.",
    "story.pay_cheque.log": "{name}: první výplata, oslavená u pultu.",
    "story.pay_cheque.opt.medovnik": "Babiččin medovník na oslavu",
    "story.pay_cheque.opt.record": "Pustit něco veselého",
    "story.pay_cheque.opt.word": "Pogratulovat",
    "story.pay_cheque.react.medovnik": "Pro mě? Tohle je už teď nejlepší den v měsíci.",
    "story.pay_cheque.react.record": "Ha! Teď je to opravdová oslava.",
    "story.pay_cheque.react.word": "Děkuju! Není to moc, ale je to moje.",
    "story.pay_cheque.text": "Úplně první výplata. Čte si výplatní pásku pořád dokola.",
    "story.ring.log": "{name}: těžký večer, aspoň trochu měkčí.",
    "story.ring.opt.ask": "Zeptat se, jak se daří",
    "story.ring.opt.cocoa": "Horkou čokoládu, bez otázek",
    "story.ring.opt.record": "Něco jemného z jukeboxu",
    "story.ring.react.ask": "Bude to dobré. Dnes ne, ale bude.",
    "story.ring.react.cocoa": "Bez otázek. Děkuju. Přesně tak.",
    "story.ring.react.record": "Tahle písnička… To je dobrý. Je hezká.",
    "story.ring.text": "Otáčí v prstech prstýnek. Už ne na prstě.",
    "story.sketch.log": "{name}: skica kavárny s rozsvícenými lampami.",
    "story.sketch.opt.lamp": "Rozsvítit lampu nad stolem",
    "story.sketch.opt.peek": "Nakouknout do kresby",
    "story.sketch.opt.pose": "Chvíli nehybně stát za pultem",
    "story.sketch.react.lamp": "Ó, to světlo! Teď sedí stíny.",
    "story.sketch.react.peek": "Ještě to není hotové! …No dobře. Jen kouknout.",
    "story.sketch.react.pose": "Skvělé, nehýbat! …Hotovo. Vypadáte jako ta kavárna.",
    "story.sketch.text": "Kreslí kavárnu do malého skicáku. Pult, lampy… a tebe.",
    "story.soaked.log": "{name}: zpátky z nečasu a zase v suchu.",
    "story.soaked.opt.radiator": "Místo u topení",
    "story.soaked.opt.tea": "Čaj na účet podniku",
    "story.soaked.opt.towel": "Suchý ručník",
    "story.soaked.react.radiator": "Ach, teplo… Odsud už neodejdu.",
    "story.soaked.react.tea": "Děkuju. Horký čaj, mokré ponožky. Napůl vyhráno.",
    "story.soaked.react.towel": "Ručník! Jste svatá.",
    "story.soaked.text": "Mokro až na kůži. Tiše to kape na babiččinu podlahu.",
    "story.toast": "Malý příběh",
    "story.wedding.log": "{name}: zítra svatba, dnes přípitek.",
    "story.wedding.opt.medovnik": "Medovník pro štěstí",
    "story.wedding.opt.record": "Pustit zamilovanou písničku",
    "story.wedding.opt.toast": "Připít si čajem",
    "story.wedding.react.medovnik": "Pro štěstí. Beru každý drobek štěstí.",
    "story.wedding.react.record": "Moc brzo! …Dobře, ještě jednou.",
    "story.wedding.react.toast": "Na zítřek! Ach ne, už je zítra.",
