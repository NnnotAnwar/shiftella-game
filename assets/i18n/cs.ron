    "journal.title": "Journal",
    "karolina.mug.1": "The rain sounds different from behind the counter.",
    "karolina.mug.10": "Quiet hands, warm cup. That's the whole plan.",
    "karolina.mug.11": "The holo sign flickers. I flicker back.",
    "karolina.mug.12": "One sip for me, one for the night shift everywhere.",
    "karolina.mug.2": "Grandma drank hers standing up. I think I get it now.",
    "karolina.mug.3": "Five minutes. The café can hold its breath for five minutes.",
    "karolina.mug.4": "There's a chip in this mug exactly where my thumb goes.",
    "karolina.mug.5": "Someone's train is leaving. Mine isn't.",
    "karolina.mug.6": "Steam on the window, steam from the cup. Fair trade.",
    "karolina.mug.7": "I used to drink coffee to stay awake. Now it's to stay here.",
    "karolina.mug.8": "The machine hums like it knows me now.",
    "karolina.mug.9": "Lida, you never told me how good the third cup at four a.m. tastes.",
    "mainmenu.continue_none": "Zatím žádná uložená hra",
    "mainmenu.lang.greeting": "Dobrý večer, vítejte u nás.",
    "mainmenu.newgame.hint": "Jak mají noci plynout? Obtížnost platí pro celý příběh.",
    "mainmenu.newgame.recommended": "Doporučeno",
    "mainmenu.newgame.start": "Vystoupit v Holešovicích",
    "mainmenu.newgame.title": "Nový příběh",
    "mainmenu.sandbox.dice": "Hodit kostkou",
    "mainmenu.settings.auto_advance": "Automaticky pokračovat",
    "mainmenu.settings.pause_hint": "Vypnuto: noc plyne dál, události počkají v liště.",
    "mainmenu.settings.saved_auto": "Ukládá se samo",
    "mainmenu.settings.section.display": "Obraz",
    "mainmenu.settings.section.language": "Jazyk",
    "mainmenu.settings.section.sound": "Zvuk",
    "mainmenu.settings.section.story": "Příběh",
    "mainmenu.settings.text_speed": "Rychlost textu",
    "mainmenu.settings.text_speed.fast": "Rychle",
    "mainmenu.settings.text_speed.instant": "Hned",
    "mainmenu.settings.text_speed.normal": "Běžně",
    "mainmenu.settings.text_speed.slow": "Pomalu",
    "mainmenu.subtitle": "Café Nocturne — noční kavárna u nádraží",
    "menu.black_coffee.desc": "Silná, až v ní stojí lžička.",
    "menu.black_coffee.name": "Černá jako u Lidy",
    "menu.bryndzove_pirohy.desc": "Se slaninkou a smetanou. Natália na ně nedá dopustit.",
    "menu.bryndzove_pirohy.name": "Bryndzové pirohy",
    "menu.cappuccino.desc": "Mléčná pěna a pět minut klidu.",
    "menu.cappuccino.name": "Cappuccino",
    "menu.chai.desc": "Skořice, kardamom a vůně, která drží až do rána.",
    "menu.chai.name": "Kořeněný chai",
    "menu.chlebicek.desc": "Šunka, vajíčko, okurka. Funguje i bez proudu.",
    "menu.chlebicek.name": "Chlebíček",
    "menu.garlic_soup.desc": "Se sýrem a krutony. Zažene zimu i noční směnu.",
    "menu.garlic_soup.name": "Česnečka",
    "menu.grandma_kulajda.desc": "Kopr, houby, ztracené vejce — a tajná přísada z Lidiny kuchařky.",
    "menu.grandma_kulajda.name": "Babiččina kulajda",
    "menu.hot_chocolate.desc": "Hustá jako noc. Někdy se platí písničkou.",
    "menu.hot_chocolate.name": "Horká čokoláda",
    "menu.kolac.desc": "Tvaroh a mák, ještě teplý z trouby.",
    "menu.kolac.name": "Koláč",
    "menu.lemon_tea.desc": "Dva cukry, pokud jste ten pán u okna.",
    "menu.lemon_tea.name": "Čaj s citronem",
    "menu.medovnik.desc": "Dvanáct plátů a trpělivost.",
    "menu.medovnik.name": "Medovník",
    "menu.night_train.desc": "Dvojité espresso, topinka a koláč na cestu. Pro ty, kdo jedou dál.",
    "menu.night_train.name": "Noční vlak",
    "menu.oat_flat_white.desc": "Pro dronaře a všechny, kdo si myslí, že kráva spí.",
    "menu.oat_flat_white.name": "Ovesné flat white",
    "menu.svarak.desc": "Hřebíček, pomeranč a zahřáté ruce.",
    "menu.svarak.name": "Svařák",
    "menu.topinka.desc": "Na sádle, jak má být. Mirkova klasika.",
    "menu.topinka.name": "Topinka s česnekem",
    "menu.varenyky.desc": "S bramborem a smaženou cibulkou, podle Olehovy mámy.",
    "menu.varenyky.name": "Vareniky",
    "moment.m_advent_candle.opt.light": "Light the candle",
    "moment.m_advent_candle.result.light": "One more small flame. The counter glows a little warmer.",
    "moment.m_advent_candle.text": "Grandma's wreath on the counter, the next candle waiting.",
    "moment.m_advent_candle.title": "The Advent wreath",
    "moment.m_blackout_candles.expired": "Someone found the candles and lit them for you.",
    "moment.m_blackout_candles.opt.candles": "Light the candles",
    "moment.m_blackout_candles.opt.torch": "The old torch will do",
    "moment.m_blackout_candles.result.candles": "Table by table, the café comes back — smaller, warmer, gold.",
    "moment.m_blackout_candles.result.torch": "One beam of light and a lot of patient faces.",
    "moment.m_blackout_candles.text": "The hall goes dark. Grandma's candles are in the drawer under the till, where they always were.",
    "moment.m_blackout_candles.title": "The lights went out",
    "moment.m_bulb_flicker.opt.spare_bulb": "Grandma's spare bulb",
    "moment.m_bulb_flicker.result.spare_bulb": "There's a box of spares in the drawer, labelled in her hand. She kept spares for sixty years.",
    "moment.m_bulb_flicker.text": "The light in the window stutters once, twice.",
    "moment.m_bulb_flicker.title": "The window lamp flickers",
    "moment.m_busker.opt.ask_in": "Ask them in to play",
    "moment.m_busker.opt.coin": "A coin in the case",
    "moment.m_busker.opt.tea": "Bring them a tea",
    "moment.m_busker.result.ask_in": "They shake off the rain and play by the stage. The hall comes alive.",
    "moment.m_busker.result.coin": "The coin clinks. The song goes on.",
    "moment.m_busker.result.tea": "They nod a thank-you and play one more song, just for the window.",
    "moment.m_busker.text": "Someone is playing under the station awning, a guitar case open, rain on the strings.",
    "moment.m_busker.title": "A busker in the rain",
    "moment.m_cat_name.opt.kofi": "Kofi",
    "moment.m_cat_name.opt.lidka": "Lidka",
    "moment.m_cat_name.opt.vlak": "Vlak",
    "moment.m_cat_name.result.kofi": "Kofi. It sniffs your cup as if to confirm.",
    "moment.m_cat_name.result.lidka": "Lidka. It curls up in grandma's chair, as if it always knew.",
    "moment.m_cat_name.result.vlak": "Vlak, like the trains it watches. It doesn't look up. That means yes.",
    "moment.m_cat_name.text": "The cat lives here now. Everyone agrees. It's time it had a name.",
    "moment.m_cat_name.title": "The cat needs a name",
    "moment.m_coffee_for_helper.opt.break": "Send them on a break",
    "moment.m_coffee_for_helper.opt.coffee": "Make them a coffee",
    "moment.m_coffee_for_helper.result.break": "Ten minutes on the back step. They come back humming.",
    "moment.m_coffee_for_helper.result.coffee": "\"For me? You didn't have to.\" They hold the cup with both hands.",
    "moment.m_coffee_for_helper.text": "Your helper is moving slower, rubbing their eyes when they think nobody sees.",
    "moment.m_coffee_for_helper.title": "A tired helper",
    "moment.m_dead_phone.opt.charger": "Lend the counter charger",
    "moment.m_dead_phone.opt.socket": "Point to the socket table",
    "moment.m_dead_phone.result.charger": "Two per cent, five per cent, saved.",
    "moment.m_dead_phone.result.socket": "They move tables, relieved.",
    "moment.m_dead_phone.text": "A guest stares at a black screen. Their ticket, their map, their whole night is on it.",
    "moment.m_dead_phone.title": "A dead phone",
    "moment.m_delay_board.opt.board": "Put the station board on the café screen",
    "moment.m_delay_board.opt.refills": "Free refills for the waiting",
    "moment.m_delay_board.result.board": "Now everyone can see the minutes tick down. Fewer anxious glances at the door.",
    "moment.m_delay_board.result.refills": "Nobody minds waiting quite so much.",
    "moment.m_delay_board.text": "The station board blinks DELAYED. A café full of people who meant to be somewhere else.",
    "moment.m_delay_board.title": "The trains are late",
    "moment.m_drone_wrong_address.collected": "The parcel's owner came by, thanked you and left a tip.",
    "moment.m_drone_wrong_address.expired": "The drone found its own way. Somebody waved it off.",
    "moment.m_drone_wrong_address.opt.keep": "Keep the parcel for pickup",
    "moment.m_drone_wrong_address.opt.reroute": "Re-route it in the Shiftella app",
    "moment.m_drone_wrong_address.parcel": "The parcel's owner came by and left a jar of butterfly pea flowers. \"For the trouble.\"",
    "moment.m_drone_wrong_address.result.keep": "The parcel waits behind the counter. Someone will come for it.",
    "moment.m_drone_wrong_address.result.reroute": "It beeps twice — a thank-you, probably — and hums off over the roofs.",
    "moment.m_drone_wrong_address.text": "A delivery drone taps the window, blinking \"address not found\". It has a small parcel.",
    "moment.m_drone_wrong_address.thanks": "A message from the drone's owner: \"Thanks for the re-route!\" and 50 Kč.",
    "moment.m_drone_wrong_address.title": "A lost delivery drone",
    "moment.m_first_snow.expired": "The snow kept falling. Nobody minded.",
    "moment.m_first_snow.opt.call_all": "Call everyone to look",
    "moment.m_first_snow.opt.candle": "A candle in the window",
    "moment.m_first_snow.result.call_all": "Guests, crew, even the cat — everyone at the window, saying nothing at all.",
    "moment.m_first_snow.result.candle": "A small flame against the snow. People outside slow down to look.",
    "moment.m_first_snow.text": "The first snow of the year is falling past grandma's window, slow and silent.",
    "moment.m_first_snow.title": "It's snowing",
    "moment.m_fogged_window.opt.wipe": "Wipe the glass",
    "moment.m_fogged_window.result.wipe": "Just in time — the train's light sweeps through the whole room.",
    "moment.m_fogged_window.text": "A train is coming. You can hear it, but you can't see it through the fogged glass.",
    "moment.m_fogged_window.title": "The glass has fogged up",
    "moment.m_forgotten_item.expired": "It went into the lost & found box. Its owner came back for it.",
    "moment.m_forgotten_item.opt.lost_found": "The lost & found box",
    "moment.m_forgotten_item.opt.run": "Run after them",
    "moment.m_forgotten_item.result.lost_found": "Into the box. They came back for it before dawn.",
    "moment.m_forgotten_item.result.run": "You catch them at the crossing. They laugh, and press a coin into your hand.",
    "moment.m_forgotten_item.text": "An umbrella hangs from an empty chair. Its owner is just crossing the street.",
    "moment.m_forgotten_item.title": "Something left behind",
    "moment.m_hang_garlands.expired": "The crew will hang them in the morning.",
    "moment.m_hang_garlands.opt.hang": "Hang them up",
    "moment.m_hang_garlands.result.hang": "Windows, counter, door. The café looks like it remembered something.",
    "moment.m_hang_garlands.text": "Grandma's Christmas box is on the counter: garlands, tiny lights and a note — \"windows first\".",
    "moment.m_hang_garlands.title": "A box marked \"Vánoce — L.\"",
    "moment.m_leak_bucket.expired": "Someone put a bucket under it.",
    "moment.m_leak_bucket.opt.bucket": "Put a bucket under it",
    "moment.m_leak_bucket.opt.roofer": "Call a roofer",
    "moment.m_leak_bucket.result.bucket": "The plinks turn into a little tune.",
    "moment.m_leak_bucket.result.roofer": "A roofer climbs up in the rain. The plinking stops for good.",
    "moment.m_leak_bucket.text": "Plink. Plink. A drop lands right where people walk.",
    "moment.m_leak_bucket.title": "The roof is leaking",
    "moment.m_leak_empty.opt.empty": "Empty it",
    "moment.m_leak_empty.result.empty": "Emptied, back in place. The tune starts over.",
    "moment.m_leak_empty.text": "The bucket under the leak is nearly overflowing.",
    "moment.m_leak_empty.title": "The bucket is full",
    "moment.m_lost_traveller.opt.app": "Check the Shiftella app",
    "moment.m_lost_traveller.opt.napkin_map": "Draw a map on a napkin",
    "moment.m_lost_traveller.result.app": "The right train, the right platform, three minutes to spare. They leave a tip and a grin.",
    "moment.m_lost_traveller.result.napkin_map": "A napkin map with a little star on the platform. They keep it.",
    "moment.m_lost_traveller.text": "A traveller stands in the doorway with a suitcase and a crumpled ticket, looking for the right platform.",
    "moment.m_lost_traveller.title": "A lost traveller",
    "moment.m_mikulas.opt.applause": "Just applause",
    "moment.m_mikulas.opt.cocoa": "Hot chocolate on the house",
    "moment.m_mikulas.opt.kolac": "A koláč for each",
    "moment.m_mikulas.result.applause": "The whole café claps. The devil takes a bow.",
    "moment.m_mikulas.result.cocoa": "The devil recites the poem, the angel forgets the words, Mikuláš drinks the most.",
    "moment.m_mikulas.result.kolac": "Three koláče, three bows, one very sticky devil.",
    "moment.m_mikulas.text": "Three students in costume burst in from the snow: \"A poem for something warm?\"",
    "moment.m_mikulas.title": "Mikuláš, an angel and a devil",
    "moment.m_parcel_lviv.expired": "Oleh opened it in the morning and shared everything.",
    "moment.m_parcel_lviv.opt.morning": "Save it for the morning",
    "moment.m_parcel_lviv.opt.open": "Open it with Oleh",
    "moment.m_parcel_lviv.result.morning": "It waits on the shelf until the morning. Oleh keeps glancing at it.",
    "moment.m_parcel_lviv.result.open": "Dried fruit, beetroot, a jar of honey and a note he reads twice. \"She says to feed you too.\"",
    "moment.m_parcel_lviv.text": "A parcel for Oleh, tied with string, smelling of dried pears. His mother's handwriting on top.",
    "moment.m_parcel_lviv.title": "A parcel from Lviv",
    "moment.m_radio_tuning.opt.jazz": "Night jazz",
    "moment.m_radio_tuning.opt.static": "Static…",
    "moment.m_radio_tuning.opt.waltz": "An old waltz",
    "moment.m_radio_tuning.result.jazz": "A piano, somewhere far away, playing just for the night shift.",
    "moment.m_radio_tuning.result.static": "Rain through the speaker, and for a second a voice: \"…osobní vlak Rn 333, nástupiště dvě…\" Then nothing.",
    "moment.m_radio_tuning.result.waltz": "Grandma's waltz, thin and silver through the old speaker.",
    "moment.m_radio_tuning.text": "The old radio crackles between stations. The dial is warm under your fingers.",
    "moment.m_radio_tuning.title": "Grandma's radio",
    "moment.m_record_request.opt.later": "Maybe later",
    "moment.m_record_request.opt.put_on": "Put it on",
    "moment.m_record_request.result.later": "\"Later, then. I'm not going anywhere.\"",
    "moment.m_record_request.result.put_on": "The needle drops. Someone at the window table starts tapping along.",
    "moment.m_record_request.text": "\"Karolina, have you got something a bit… you know. Like the old days?\"",
    "moment.m_record_request.title": "A record request",
    "moment.m_sleeping_guest.opt.blanket": "Cover them with a blanket",
    "moment.m_sleeping_guest.opt.let_sleep": "Let them sleep",
    "moment.m_sleeping_guest.opt.water": "A glass of water, gently",
    "moment.m_sleeping_guest.result.blanket": "Grandma's checked blanket. They don't wake, but they smile.",
    "moment.m_sleeping_guest.result.let_sleep": "The rain does the rest.",
    "moment.m_sleeping_guest.result.water": "They wake slowly, drink, and leave lighter than they came.",
    "moment.m_sleeping_guest.text": "A guest has dozed off over an empty cup, head on their arm.",
    "moment.m_sleeping_guest.title": "Someone fell asleep",
    "moment.m_station_cat.expired": "Someone left a saucer by the door.",
    "moment.m_station_cat.opt.ham": "A bit of ham",
    "moment.m_station_cat.opt.milk": "A saucer of milk",
    "moment.m_station_cat.opt.scratch": "Scratch its ears",
    "moment.m_station_cat.result.ham": "The ham is gone before it lands. The cat stays a little longer.",
    "moment.m_station_cat.result.milk": "Lap, lap, lap. A slow blink — that's a thank-you in cat.",
    "moment.m_station_cat.result.scratch": "If it knows you, it leans in. If it doesn't, it leaves with great dignity.",
    "moment.m_station_cat.text": "The station cat sits by the door, wet and dignified, pretending not to look at you.",
    "moment.m_station_cat.title": "Someone with whiskers",
    "moment.m_stuffy_window.opt.leave": "Leave it",
    "moment.m_stuffy_window.opt.open": "Open the window",
    "moment.m_stuffy_window.result.leave": "Cosy, if a little sticky.",
    "moment.m_stuffy_window.result.open": "Cool air and the smell of rain. Someone orders something cold.",
    "moment.m_stuffy_window.text": "So many people, so much steam. The windows are crying.",
    "moment.m_stuffy_window.title": "It's stuffy in here",
    "moment.m_tired_parent.opt.blanket": "A blanket for the little one",
    "moment.m_tired_parent.opt.warm_milk": "Warm milk, on the house",
    "moment.m_tired_parent.result.blanket": "Tucked in like a small parcel. The parent finally sits back.",
    "moment.m_tired_parent.result.warm_milk": "The little one drinks half and falls asleep. The parent mouths \"thank you\".",
    "moment.m_tired_parent.text": "A parent off the train, a sleepy child on their lap, both too tired to order.",
    "moment.m_tired_parent.title": "A tired parent",
    "moment.m_umbrellas.opt.newspapers": "Newspapers on the floor",
    "moment.m_umbrellas.opt.stand": "Put out the umbrella stand",
    "moment.m_umbrellas.result.newspapers": "Yesterday's news, today's doormat. Vera approves.",
    "moment.m_umbrellas.result.stand": "Umbrellas in a row, dripping politely.",
    "moment.m_umbrellas.text": "A downpour, and every guest brings half of it in with them.",
    "moment.m_umbrellas.title": "Wet umbrellas everywhere",
    "note.note_01.text": "Světlo v okně nezhasínat do šesti. Není to pověra. Je to slib.",
    "note.note_01.where": "Pod pokladnou",
    "note.note_02.text": "Mirek: černou, topinku. Hana: cappuccino, rychle! Vera: čaj, koláč, a nehádat se. Pán u okna: čaj s citronem, dva cukry. Nebrat od něj peníze.",
    "note.note_02.where": "Ve skříňce za pultem, když je všude čisto",
    "note.note_03.text": "Když zhasne světlo, lidi mluví pravdu. Svíčky drž v suchu.",
    "note.note_03.where": "V pojistkové skříni",
    "note.note_04.text": "Těm, kdo léčí, nalévej bez fronty.",
    "note.note_04.where": "Pod polštářem křesla",
    "note.note_05.text": "Kulajda: kopr, houby, ztracené vejce a lžička octa z láhve, kterou mi dal J. Vera ví víc, než říká.",
    "note.note_05.where": "V kuchařce, kterou měla Vera",
    "note.note_06.text": "Platí vždycky mincemi, které už nejsou. Neberu od něj peníze.",
    "note.note_06.where": "Mezi mincemi z okenního stolu",
    "note.note_07.text": "M. se na mě dívá, jako by byl vinen. Odpustila jsem mu dávno — ať je to cokoli.",
    "note.note_07.where": "Na zadní straně starého účtu",
    "note.note_08.text": "3:33. Na nástupiště jsem přišla o dvě minuty pozdě. Celý život o dvě minuty.",
    "note.note_08.where": "Ve starém jízdním řádu od Radka",
    "note.note_09.text": "Jestli zase přijde, řekni mu, že jsem čekala. Ne kvůli sobě. Kvůli světlu.",
    "note.note_09.where": "Uvnitř opraveného rádia",
    "note.note_10.text": "Kavárna nejsou zdi. Jsou to ti, kdo chodí. Neprodávej je.",
    "note.note_10.where": "Za fotkou na zdi, když má kavárna dobré jméno",
    "pref.kind.avoid_with": "Not with {name} this week",
    "pref.kind.day_off": "{day} off",
    "pref.kind.max_nights": "At most {n} nights",
    "pref.kind.min_nights": "At least {n} nights",
    "pref.kind.no_back_to_back": "Not two in a row",
    "pref.kind.shift_pref": "{shift} shifts",
    "pref.kind.weekend_off": "Weekend off",
    "pref.kind.works_with": "Likes working with {name}",
    "pref.quote.day_off": "Could I have that day off? Every week, if possible.",
    "pref.quote.early": "Early shift, please — I'm useless after three.",
    "pref.quote.late": "Night owl — late shift, please.",
    "pref.quote.max_nights": "A few nights a week is plenty for me.",
    "pref.quote.min_nights": "I need the hours.",
    "pref.quote.no_back_to_back": "Not two nights in a row, please.",
    "pref.quote.partner": "If we could work the same nights…",
    "pref.quote.weekend_off": "Weekends are for my family.",
    "react.filip.good": "That's good. Like, actually good.",
    "react.filip.not_quite": "Interesting… I'll drink it anyway, I'm a student.",
    "react.filip.okay": "Thanks! Caffeine is caffeine.",
    "react.filip.perfect": "Okay, this is unreal. I'm writing my thesis about it.",
    "react.good.1": "Mm. Lovely.",
    "react.good.2": "That hits the spot.",
    "react.good.3": "Thank you, really.",
    "react.good.4": "Oh, that's nice. Warm all the way down.",
    "react.good.5": "Just what the night needed.",
    "react.guest_333.good": "…",
    "react.guest_333.not_quite": "…",
    "react.guest_333.okay": "…",
    "react.guest_333.perfect": "…",
    "react.hana.good": "Hot and quick. You're a hero.",
    "react.hana.not_quite": "Not quite, but it's warm. That's what counts at three.",
    "react.hana.okay": "Thanks — that'll get me to the next round.",
    "react.hana.perfect": "Oh, that's exactly it. You saved my night.",
    "react.lori.good": "Mm. My voice thanks you.",
    "react.lori.not_quite": "Not quite my key — but lovely of you to try.",
    "react.lori.okay": "That's sweet of you. Thank you.",
    "react.lori.perfect": "Oh, I could sing about this one.",
    "react.mirek.good": "Good. Strong enough to keep a taxi awake.",
    "react.mirek.not_quite": "Hm. Lida would've laughed. Drinkable, though.",
    "react.mirek.okay": "It's coffee. I've had worse. From robots.",
    "react.mirek.perfect": "…Almost like hers, Karolina. Almost.",
    "react.not_quite.1": "Not quite it — but thank you for trying.",
    "react.not_quite.2": "Hm. Different. I like that you tried.",
    "react.not_quite.3": "Not what I meant, but it's warm. That counts.",
    "react.not_quite.4": "Funny — I'd never have picked this. Thanks.",
    "react.not_quite.5": "It's fine, honestly. You've got your hands full.",
    "react.okay.1": "Nice, thanks.",
    "react.okay.2": "Not what I pictured, but nice.",
    "react.okay.3": "Warm. Good.",
    "react.okay.4": "That'll do me fine.",
    "react.okay.5": "Thanks — it's good.",
    "react.perfect.1": "Oh. That's exactly it.",
    "react.perfect.2": "How did you know?",
    "react.perfect.3": "I'm coming back tomorrow just for this.",
    "react.perfect.4": "That's the one. Thank you.",
    "react.perfect.5": "You read my mind. Or my face.",
    "react.radek.good": "Good one. The trains will run better for it.",
    "react.radek.not_quite": "Not my usual, but I won't report you.",
    "react.radek.okay": "Does the job. Like a timetable.",
    "react.radek.perfect": "Ha. Right on time, and just right.",
    "react.vera.good": "Properly done. I'll allow it.",
    "react.vera.not_quite": "Hm. We'll keep practising, you and I.",
    "react.vera.okay": "Acceptable. Your grandmother had steadier hands.",
    "react.vera.perfect": "Well. Lida would have grumbled, but she'd have drunk it.",
    "recipe.r_black.desc": "A slow pour-over, nothing added. Honest coffee for honest hours.",
    "recipe.r_black.lore": "Pour slowly. Nobody who comes at night is in a hurry, even when they say they are.",
    "recipe.r_black.name": "Black, like Lida made it",
    "recipe.r_borscht.desc": "Beetroot soup, deep ruby, with a spoon of smetana.",
    "recipe.r_borscht.lore": "The colour is the whole secret. Beetroot in on time, or it goes brown and sulks.",
    "recipe.r_borscht.name": "Borscht with smetana",
    "recipe.r_borscht.teach": "My mother's borscht. Beetroot goes in at the right moment — I'll tell you when.",
    "recipe.r_buchty.desc": "Soft baked buns filled with plum povidla, sugar on top.",
    "recipe.r_buchty.lore": "The boy has been baking secretly. Let him think nobody noticed.",
    "recipe.r_buchty.name": "Kuba's buchty with povidla",
    "recipe.r_buchty.teach": "Mr Holub showed me. Don't tell him I'm showing you — he'll get all proud.",
    "recipe.r_cappuccino.desc": "Espresso under a soft cap of milk foam.",
    "recipe.r_cappuccino.lore": "Milk sings when it's ready. Listen, don't look.",
    "recipe.r_cappuccino.name": "Cappuccino",
    "recipe.r_chai.desc": "Black tea with warm milk and spice.",
    "recipe.r_chai.lore": "Cinnamon and clove, a pinch of each, and milk only when the tea is dark.",
    "recipe.r_chai.name": "Chai",
    "recipe.r_chlebicek.desc": "An open sandwich with potato salad, ham and a slice of egg.",
    "recipe.r_chlebicek.lore": "Make it pretty. A chlebíček is a small party on a plate.",
    "recipe.r_chlebicek.name": "Chlebíček",
    "recipe.r_espresso_tonic.desc": "Espresso poured slowly over tonic and ice. Bitter, bright, cold.",
    "recipe.r_espresso_tonic.lore": "Filip calls it exam fuel. I call it a cold drink with opinions.",
    "recipe.r_espresso_tonic.name": "Platform espresso tonic",
    "recipe.r_espresso_tonic.teach": "Pour it slowly over the ice, or it fizzes everywhere. Trust me. I've been there.",
    "recipe.r_garlic_soup.desc": "Garlic soup with potato and croutons. It fixes most things.",
    "recipe.r_garlic_soup.lore": "Česnečka cures colds, hangovers and small heartbreaks. Big ones need kulajda.",
    "recipe.r_garlic_soup.name": "Česnečka",
    "recipe.r_hot_chocolate.desc": "Thick cocoa with steamed milk.",
    "recipe.r_hot_chocolate.lore": "For anyone who's cold, or eight, or both.",
    "recipe.r_hot_chocolate.name": "Hot chocolate",
    "recipe.r_kolac.desc": "A round little cake with tvaroh and plum jam.",
    "recipe.r_kolac.lore": "Jam in the middle, crumble on top, and always one more than you think you'll need.",
    "recipe.r_kolac.name": "Koláč",
    "recipe.r_kulajda.desc": "Creamy mushroom and dill soup with potato — Lida's own.",
    "recipe.r_kulajda.lore": "Dill at the very end. And don't tell Vera how much cream.",
    "recipe.r_kulajda.name": "Grandma's kulajda",
    "recipe.r_lemon_tea.desc": "Black tea, a slice of lemon, steeped just long enough.",
    "recipe.r_lemon_tea.lore": "Lift the bag before it turns bitter. People are the same.",
    "recipe.r_lemon_tea.name": "Tea with lemon",
    "recipe.r_linden_tea.desc": "Lime-blossom tea, golden and gentle, with honey.",
    "recipe.r_linden_tea.lore": "Linden for sleep and for singers. Honey, always honey.",
    "recipe.r_linden_tea.name": "Linden tea with honey",
    "recipe.r_lori_encore.desc": "Hot chocolate with a pinch of chili.",
    "recipe.r_lori_encore.lore": "A pinch of fire for the singer. Not a spoon. A pinch.",
    "recipe.r_lori_encore.name": "Lori's encore",
    "recipe.r_lori_encore.teach": "Just a pinch of chili, love. It warms the voice from the inside.",
    "recipe.r_medovnik.desc": "Layered honey cake with cream, served cold.",
    "recipe.r_medovnik.lore": "Honey cake needs a night to rest. So do we.",
    "recipe.r_medovnik.name": "Medovník",
    "recipe.r_moon_latte.desc": "Oat milk turned dusk-blue with butterfly pea, a crescent on top.",
    "recipe.r_moon_latte.lore": "Not mine, this one. Yours. Write it down so someone finds it one day.",
    "recipe.r_moon_latte.name": "Moonlight latte",
    "recipe.r_night_train.desc": "A strong pour-over with cocoa and spice — the café's own.",
    "recipe.r_night_train.lore": "Strong enough for the last train, soft enough for the first one.",
    "recipe.r_night_train.name": "Night Train",
    "recipe.r_oat_flat_white.desc": "Velvety oat milk over a double espresso, with a little art on top.",
    "recipe.r_oat_flat_white.lore": "The young ones like it with oats. Fine. Draw them a heart and they'll come back.",
    "recipe.r_oat_flat_white.name": "Oat flat white",
    "recipe.r_pirohy.desc": "Potato pockets with sheep's cheese and a little bacon.",
    "recipe.r_pirohy.lore": "For the Slovak drivers. They stop missing home for exactly one plate.",
    "recipe.r_pirohy.name": "Bryndzové pirohy",
    "recipe.r_raf.desc": "Espresso whisked with cream and vanilla into something like a cloud.",
    "recipe.r_raf.lore": "Oleh's. Sweet, soft, and a little homesick.",
    "recipe.r_raf.name": "Raf coffee (Kyiv-style)",
    "recipe.r_raf.teach": "In Kyiv we steam the coffee with the cream. Watch for the vanilla drop — there!",
    "recipe.r_rn333_tea.desc": "Black tea with lemon and exactly two sugars.",
    "recipe.r_rn333_tea.lore": "Two sugars. He always took two.",
    "recipe.r_rn333_tea.name": "Tea, two sugars",
    "recipe.r_svarak.desc": "Mulled red wine with spice and a little sugar. Never boiled.",
    "recipe.r_svarak.lore": "Warm it, never boil it. Wine that boils has given up.",
    "recipe.r_svarak.name": "Svařák",
    "recipe.r_tatra_tea.desc": "Mountain herbs, honey and lemon, like a hut in the Tatras.",
    "recipe.r_tatra_tea.lore": "Natália's. It smells like a mountain after rain.",
    "recipe.r_tatra_tea.name": "Tatra herb tea",
    "recipe.r_tatra_tea.teach": "My granny picked these above Ždiar. Honey first, lemon at the end.",
    "recipe.r_topinka.desc": "Fried bread rubbed with garlic, the taxi-rank breakfast.",
    "recipe.r_topinka.lore": "Two rubs of garlic for drivers, three for anyone who looks sad.",
    "recipe.r_topinka.name": "Topinka",
    "recipe.r_turek.desc": "Coffee boiled in the cup with sugar, grounds left to settle.",
    "recipe.r_turek.lore": "Mirek's. Let it settle. He always did.",
    "recipe.r_turek.name": "Turek, taxi-rank style",
    "recipe.r_turek.teach": "Stir three times, then hands off. Let the grounds sit down, like a tired driver.",
    "recipe.r_uzvar.desc": "A warm drink of dried fruit and honey, like Christmas in Lviv.",
    "recipe.r_uzvar.lore": "From the parcel. Dried pears and plums and someone's love, all in one pot.",
    "recipe.r_uzvar.name": "Uzvar",
    "recipe.r_varenyky.desc": "Dumplings with potato and mushroom, smetana and crispy onion.",
    "recipe.r_varenyky.lore": "A traveller from Lviv taught me these, one snowy night. Pinch the edges like you mean it.",
    "recipe.r_varenyky.name": "Varenyky with potato & mushroom",
    "recipe.r_vera_kolac.desc": "Poppy seed and tvaroh, warmed through, the way Vera insists.",
    "recipe.r_vera_kolac.lore": "Vera's is better. Never tell her I wrote that.",
    "recipe.r_vera_kolac.name": "Vera's poppy-seed koláč, warmed",
    "recipe.r_vera_kolac.teach": "Warm it, child. A cold koláč is a sad koláč. Poppy seed first, then the tvaroh.",
    "record.house.artist": "Whatever suits the night",
    "record.house.title": "House playlist",
    "record.rec_bossa_rain.artist": "Lina Morais & friends",
    "record.rec_bossa_rain.disliked.mirek": "Too much samba for a Czech night, eh?",
    "record.rec_bossa_rain.liked.lori": "Oh, that chord. Turn it up a little, would you?",
    "record.rec_bossa_rain.title": "Bossa for a Rainy Platform",
    "record.rec_cafe_waltz.artist": "a handwritten label: \"Pro J.\"",
    "record.rec_cafe_waltz.hint": "Grandma kept one record apart.",
    "record.rec_cafe_waltz.liked.guest_333": "He hums along, very quietly.",
    "record.rec_cafe_waltz.liked.mirek": "…I haven't heard that in a long time, Karolina.",
    "record.rec_cafe_waltz.liked.vera": "She played this every New Year's Eve. Every single one.",
    "record.rec_cafe_waltz.source": "Found in an empty sleeve in the storeroom. The label says \"Pro J.\" in grandma's hand.",
    "record.rec_cafe_waltz.title": "Lida's Waltz",
    "record.rec_folk_lullaby.artist": "bandura, cimbalom & accordion",
    "record.rec_folk_lullaby.hint": "Someone from far away might bring one.",
    "record.rec_folk_lullaby.liked.hana": "My mum sang that. I'd forgotten.",
    "record.rec_folk_lullaby.liked.vera": "Hm. Lida used to hum this one. Badly.",
    "record.rec_folk_lullaby.source": "Oleh brought it from Lviv: \"My grandmother's. It should play somewhere.\"",
    "record.rec_folk_lullaby.title": "Kolyskova — Carpathian Lullabies",
    "record.rec_piano_trio.artist": "Vltava Night Trio",
    "record.rec_piano_trio.liked.guest_anwar": "…this one's nice to work to.",
    "record.rec_piano_trio.liked.radek": "Now that's music for a dispatcher. Everything on time.",
    "record.rec_piano_trio.title": "Last Tram Trio",
    "record.rec_prague_swing.artist": "The Tram Twelve Band — clarinet & brushes",
    "record.rec_prague_swing.liked.mirek": "Ha! We danced to this at the depot party. 1987, I think.",
    "record.rec_prague_swing.liked.radek": "Swing! The trams used to run on this rhythm.",
    "record.rec_prague_swing.title": "Holešovice Swing, 1938",
    "record.rec_synth_2039.artist": "SLEEPER CAR",
    "record.rec_synth_2039.disliked.vera": "That's not music, that's a fridge.",
    "record.rec_synth_2039.hint": "A record that hasn't been made yet.",
    "record.rec_synth_2039.liked.filip": "Wait — is that my track? In here? I'm going to cry.",
    "record.rec_synth_2039.liked.guest_anwar": "That's a good loop.",
    "record.rec_synth_2039.source": "Filip cut it himself, in his room, at four in the morning.",
    "record.rec_synth_2039.title": "Holešovice 2039",
    "regular.filip.bio": "Filip Kadlec, 22, student průmyslovky. Celou noc u zásuvky s notebookem, každou hodinu černou. Platí málo, zůstává dlouho.",
    "regular.filip.line.0a": "Je tu někde zásuvka? Prosím. Mám dvě procenta.",
    "regular.filip.line.0b": "Ještě jednu černou. Entropie roste.",
    "regular.filip.line.1a": "Kluci z ročníku se ptali, kde se dá učit v noci. Řekl jsem jim to. Promiňte.",
    "regular.filip.line.2a": "…",
    "regular.filip.line.3a": "Opravný termín v pátek. Držte mi palce.",
    "regular.filip.line.4a": "Za dvě! Za dvě!",
    "regular.filip.name": "Filip",
    "regular.guest_333.bio": "Přichází přesně ve 3:33, odchází ve 3:50. Čaj s citronem, dva cukry. Platí mincemi, které už nejsou penězi.",
    "regular.guest_333.line.0a": "…",
    "regular.guest_333.line.1a": "Vy si je nechte. Já je už nepotřebuju.",
    "regular.guest_333.line.2a": "Pořád svítí. To je dobře.",
    "regular.guest_333.line.3a": "Jednou jsem jel. Vrátit se jsem nestihl.",
    "regular.guest_333.line.4a": "Dnes zastaví. Cítím to.",
    "regular.guest_333.name": "Pán v šedém kabátě",
    "regular.guest_anwar.ambient.busy": "Dneska je tu živo. Budu potichu.",
    "regular.guest_anwar.ambient.coffee": "Dobré flat white. Neříkejte ovsu, že to není mléko.",
    "regular.guest_anwar.ambient.fog": "Koleje nejsou vidět. Jen světlo z vašeho okna.",
    "regular.guest_anwar.ambient.late": "Dvě ráno je ta nejupřímnější hodina.",
    "regular.guest_anwar.ambient.midnight": "Půlnoc? Kurzoru je to jedno.",
    "regular.guest_anwar.ambient.quiet": "Klidná noc. Ta nejlepší.",
    "regular.guest_anwar.ambient.rain": "Mám rád, když za mě mluví déšť.",
    "regular.guest_anwar.ambient.train": "Každý vlak zní, jako by jel někam, kde je líp.",
    "regular.guest_anwar.bio": "Tichý host, kolem třicítky. Sedne si k zásuvce, pracuje na notebooku, objedná ovesné flat white a kolem druhé odchází.",
    "regular.guest_anwar.name": "Anwar",
    "regular.hana.bio": "Hana Janoušková, 38, noční sestra z okresní nemocnice. Pauza ve dvě, polévka po směně. Spěchá vždycky.",
    "regular.hana.line.0a": "Cappuccino, prosím. Rychle, mám šest minut.",
    "regular.hana.line.0b": "…",
    "regular.hana.line.1a": "Dnes tři příjmy a jeden porod. Holčička. Jmenuje se Lida, věřili byste?",
    "regular.hana.line.2a": "Jen na chvilku zavřu oči…",
    "regular.hana.line.3a": "Z Drážďan zase psali. Platí dvakrát tolik. A tady… tady znám každého.",
    "regular.hana.line.4a": "Rozhodla jsem se. Už opravdu.",
    "regular.hana.name": "Hana",
    "regular.lori.bio": "Loreta „Lori\" Benešová, 27, pouliční muzikantka. Hraje na nástupišti v dešti. Platí písničkou.",
    "regular.lori.line.0a": "Prší. Nástupiště v Holešovicích má nejlepší akustiku v Praze.",
    "regular.lori.line.1a": "Jedna pro paní s křížovkou. Ta se mračí nejhezčeji.",
    "regular.lori.line.2a": "Pódium! Opravdové! No, skoro.",
    "regular.lori.line.3a": "V pátek hraju. Řekni to všem.",
    "regular.lori.name": "Lori",
    "regular.mirek.bio": "Miroslav Dvořák, 80. Poslední taxikář v Holešovicích, který ještě řídí sám. Každou noc černou a topinku. Platí přesně, dýško nedává.",
    "regular.mirek.line.0a": "Tady to bývalo plné až do rána. Za Lidy.",
    "regular.mirek.line.0b": "Roboti jezdí líp. Ale nevědí, kde se prodává nejlepší topinka.",
    "regular.mirek.line.1a": "Nalej mi jako Lidě. Ona to věděla… no, nic.",
    "regular.mirek.line.2a": "Ta tabule má malé písmo. Za to moje oči nemůžou.",
    "regular.mirek.line.3a": "Dnes jsem přišel pěšky. Je to hezčí, než jsem myslel.",
    "regular.mirek.line.4a": "Dvacet gramů. A celý život.",
    "regular.mirek.line.5a": "Ještě pár nocí. Pak už to musím rozhodnout.",
    "regular.mirek.name": "Mirek",
    "regular.radek.bio": "Radek Macek, 52, výpravčí. Dvakrát za noc „na pět minut\", v jednu a v půl páté. Káva s sebou, hned.",
    "regular.radek.line.0a": "Tři minuty. Vlak nepočká. Teda, on by počkal, ale počítač ne.",
    "regular.radek.line.1a": "Dám vědět, kdyby měl rychlík zpoždění. Kvůli vašim zásobám.",
    "regular.radek.line.2a": "Poslední služba. Zvláštní pocit.",
    "regular.radek.line.3a": "Víte, jak se v osmdesátém pátém zasekl rychlík v závějích? Sedněte si.",
    "regular.radek.name": "Radek",
    "regular.vera.bio": "Vera Soukupová, 83, vdova a Lidina spolužačka i soupeřka. Od půl jedné do tří luští křížovky. Na špinavý stůl je přísná.",
    "regular.vera.line.0a": "Lida by takhle neudělala.",
    "regular.vera.line.0b": "Osm písmen, „ten, kdo čeká\". Hm.",
    "regular.vera.line.1a": "Pojďte sem, mladí. „Noční pták, pět písmen.\" Ne, Mirek to není.",
    "regular.vera.line.2a": "Ten stůl je čistý. Lida by byla… no, spokojená.",
    "regular.vera.line.3a": "Ještě talíř kulajdy. Pro vzpomínku.",
    "regular.vera.line.4a": "Zítra přivedu kamarádky. Připrav se.",
    "regular.vera.name": "Paní Vera",
    "ritual.filip": "Filip looks for a socket.",
    "ritual.guest_333": "The 3:33 guest looks at the window.",
    "ritual.hana": "Hana rubs her eyes.",
    "ritual.lori": "Lori shakes the rain off her raincoat.",
    "ritual.mirek": "Mirek taps the counter twice.",
    "ritual.radek": "Radek checks his watch at the door.",
    "ritual.vera": "Vera straightens the sugar bowl.",
    "rozpis.autofill": "Auto-fill",
    "rozpis.autofill_missed": "{name}'s \"{pref}\" didn't fit {day}.",
    "rozpis.autofill_result": "Auto-fill kept {kept} of {total} wishes.",
    "rozpis.busier": "You'll be busier — more hands-on work.",
    "rozpis.clear": "Clear",
    "rozpis.coverage": "{suggested} suggested, {on} on",
    "rozpis.honoured": "Honoured",
    "rozpis.need": "Needs it",
    "rozpis.ring.fine": "Fine",
    "rozpis.ring.happy": "Happy",
    "rozpis.ring.stretched": "Stretched",
    "rozpis.ring.tired": "Tired",
    "rozpis.shift.early": "Early",
    "rozpis.shift.full": "Full",
    "rozpis.shift.late": "Late",
    "rozpis.tonight": "Tonight",
    "rozpis.violated": "Not this week",
    "rozpis.week.1": "Rain, but cosy",
    "rozpis.week.2": "Cloudy",
    "rozpis.week.3": "Mostly sunny",
    "rozpis.week.4": "Sunny",
    "rozpis.wellbeing": "Wellbeing {n}",
    "rozpis.wish": "Would like it",
    "sandbox.character.calm.desc": "2–4 události za noc, občas větší. Po špatné noci přijde klidná.",
    "sandbox.character.calm.name": "Klidné",
    "sandbox.character.changeable.desc": "3–5 událostí za noc. Jednou klid, jednou fofr.",
    "sandbox.character.changeable.name": "Proměnlivé",
    "sandbox.character.chaotic.desc": "5–8 událostí za noc, bez oddechu. Pro otrlé noční ptáky.",
    "sandbox.character.chaotic.name": "Chaotické",
    "sandbox.character.quiet.desc": "1–3 události za noc, skoro žádné velké. Na odpočinek.",
    "sandbox.character.quiet.name": "Tiché",
    "sandbox.character.stormy.desc": "4–6 událostí za noc, potíže chodí ve dvojicích.",
    "sandbox.character.stormy.name": "Bouřlivé",
    "sandbox.institution.college": "Vysoká škola a koleje",
    "sandbox.institution.culture_house": "Kulturní dům",
    "sandbox.institution.depot": "Logistické depo",
    "sandbox.institution.drone_hub": "Dronový uzel",
    "sandbox.institution.highway": "Dálniční odpočívadlo",
    "sandbox.institution.hospital": "Nemocnice",
    "sandbox.institution.police": "Policie a hasiči",
    "sandbox.institution.taxi_rank": "Stanoviště taxi",
    "scene.act2.01": "Týden. Hrnky ti v rukou přestaly cinkat.",
    "scene.act2.02": "Město si začíná povídat: okno u nádraží zase svítí.",
    "scene.act2.03": "Tvůj rozpis viděli další uchazeči. Noční směny chtějí tři noví lidé.",
    "scene.act2.04": "Kdo proboha chce noční směny?",
    "scene.act2.05": "Ti, co nemůžou spát. Ti, co šetří. Ti, co před něčím utíkají. To obvyklé.",
    "scene.act4_storm.01": "Od Frýdlantu přes kopce přichází bouřka.",
    "scene.act4_storm.02": "Ve 22:30 zhasnou světla na nádraží, pak lampy v ulicích, pak celé Holešovice.",
    "scene.act4_storm.03": "Svítí jen jedno okno. Babiččina lampa běží na baterku starší než ty.",
    "scene.act4_storm.04": "Takže proto, babi.",
    "scene.act4_storm.05": "Dveře se otevírají a zavírají. Přichází každý, kdo nespí.",
    "scene.answer.01": "Svítá. Muž v šedém kabátě pořád sedí u okna. Před ním leží otevřený babiččin dopis.",
    "scene.answer.02": "Čte ho dvakrát. Podruhé se mu pohybují rty.",
    "scene.answer.03": "„Počkám. Světlo v okně bude svítit.\"",
    "scene.answer.04": "Takže čekala.",
    "scene.answer.05": "Šedesát let jsem si myslel, že nikdo. Šedesát let jsem se chodil přesvědčit.",
    "scene.answer.06": "Děkuju, Mirku. Líp pozdě než v dešti.",
    "scene.answer.07": "Odpusť mi.",
    "scene.answer.08": "Už se stalo. Ona dřív — přečti si to dole.",
    "scene.answer.09": "Děkuju, že jste ho nechali svítit.",
    "scene.answer.10": "Vyjde na nástupiště. Vlak ho odveze beze zvuku.",
    "scene.answer.11": "Na vteřinu ukáže tabule: Rn 333 — ODJEL. Pak už neukazuje nic.",
    "scene.answer.12": "Toho rána Mirek poprvé za šedesát let prospí až do poledne.",
    "scene.anwar_talk_24.01": "Je skoro hotová. Ta hra.",
    "scene.anwar_talk_24.02": "Víte, psal jsem ji tady. Déšť, lampu v okně, vlaky. Díky za tu atmosféru.",
    "scene.anwar_talk_24.03": "Nic zvláštního jsme nedělali.",
    "scene.anwar_talk_24.04": "Právě to jsem potřeboval.",
    "scene.anwar_talk_24.05": "Zaklapne notebook, nechá u šálku přesně odpočítané peníze a zapne si kabát.",
    "scene.anwar_talk_24.06": "Poslední vlak. Dobrou noc — a ať to světlo svítí.",
    "scene.anwar_talk_9.01": "Muž u zásuvky zvedne oči od notebooku, jako by ho překvapilo, že si ho někdo všiml.",
    "scene.anwar_talk_9.02": "Promiňte, trochu jsem se zamotal. Dělám malou hru. O noční kavárně v dešti.",
    "scene.anwar_talk_9.03": "Nic v ní nevybuchuje. Lidi přijdou, vypijí něco teplého a jdou dál.",
    "scene.anwar_talk_9.04": "Pořád přemýšlím, jestli by vůbec někdo hrál něco tak tichého.",
    "scene.anwar_talk_9.05": "Někdo přesně tohle potřebuje.",
    "scene.anwar_talk_9.06": "Možná. …Tak ještě jedno flat white. Na průzkum.",
    "scene.ending_last_train.01": "Nový nápis přijede vlakem v 5:20 z Frýdlantu: NONSTOP 24, písmeny, která nikdy nespí.",
    "scene.ending_last_train.02": "Dluh vyrovnán, smlouva podepsaná. Gratuluji, pane vedoucí — nebo paní vedoucí? To je jedno. Od teď máme otevřeno nonstop.",
    "scene.ending_last_train.03": "Lampa z okna musí pryč, aby se tam vešla reklamní obrazovka. Už na ni nikdo nebude muset čekat. Prostě bude svítit pořád.",
    "scene.ending_last_train.04": "Je mi líto. Čísla nevyšla. Nájem dnes ráno končí.",
    "scene.ending_last_train.05": "Poslední noc v Café Nocturne. Žádný konec hry. Jen konec jedné dlouhé směny.",
    "scene.ending_last_train.06": "Ale oni přijdou. Jeden po druhém, před svítáním, bez pozvání.",
    "scene.ending_last_train.07": "Dej sem tu krabici. Balíš hrnky špatně. Lida je balila taky špatně.",
    "scene.ending_last_train.08": "Doprovodím tě na vlak. Pěšky. Jana mi vzala klíče.",
    "scene.ending_last_train.09": "Otevři si něco svého. Kdekoli. Najdu to — kávu najdu vždycky.",
    "scene.ending_last_train.10": "Napíšu o tobě písničku. Smutnou, ale s dobrým refrénem.",
    "scene.ending_last_train.11": "Pošlu ti adresu, až budu mít vlastní byt. Se zásuvkou u stolu. Na tvou počest.",
    "scene.ending_last_train.12": "Vlak v 6:12 do Berouna. Kontroloval jsem to. Jede načas. Jasně že jede, už ho neřídím já.",
    "scene.ending_last_train.13": "Štamgasti přijdou na poslední kafe. Pár slov, pár podání rukou. Holešovice v noci nejsou na velká loučení.",
    "scene.ending_last_train.14": "Vezmeš si babiččinu kuchařku, fotku ze zdi a klíč, který ležel pod rohožkou.",
    "scene.ending_last_train.15": "Promiň, babi. Nechala jsem ho svítit, dokud to šlo.",
    "scene.ending_last_train.16": "Tomu, kdo drží světlo: světlo není budova. Vezmi si ho s sebou.",
    "scene.ending_last_train.17": "Vlak v 6:12 odjíždí do Berouna. Za oknem se zmenšuje nádraží, pak město, pak mlha.",
    "scene.ending_last_train.18": "Někde na trati — Frýdlant, Ejpovice, Děčín — jsou města, která v noci nespí. A lidé, kteří by přišli, kdyby někde svítilo okno.",
    "scene.ending_last_train.19": "Třicet nocí. Dost na to, aby se to člověk naučil.",
    "scene.ending_light.01": "06:00. Třicátá noc skončila.",
    "scene.ending_light.02": "Poslední splátka přišla v 5:59. Devadesát tisíc. Já… připravím novou nájemní smlouvu.",
    "scene.ending_light.03": "Všechno nepřišlo včas. Ale město mi o téhle kavárně napsalo čtyřicet dva zpráv. Čtyřicet dva. Nájem prodloužím — pod podmínkou, že je zastavíte.",
    "scene.ending_light.04": "A to světlo v okně… nechte ho. Hodí se k nádraží.",
    "scene.ending_light.05": "Teď mě vozí Jana. Pomalu. Řídí jako její máma.",
    "scene.ending_light.06": "Drážďanům jsem řekla ne. Ve dvě jsem zpátky — nechte mi křeslo volné.",
    "scene.ending_light.07": "Přivedla jsem tři kamarádky. Stěžují si ještě víc než já. Zamilujete si je.",
    "scene.ending_light.08": "Příští semestr zase beru ten stůl v rohu. Rezervace. Pod zásuvkou.",
    "scene.ending_light.09": "Důchodci potřebují místo, kde vyprávět historky. Byli jste varováni.",
    "scene.ending_light.10": "Pátky. Moje kytara. Vaše čokoláda. Platí?",
    "scene.ending_light.11": "Lida by řekla, že je to všechno špatně. A pak by si sedla a zůstala.",
    "scene.ending_light.12": "Někdo postaví na čaj. Někdo jiný začne mýt hrnky, aniž by ho kdo žádal. V šest ráno je kavárna plná a nikomu se nechce domů.",
    "scene.ending_light.13": "V kavárně je ticho. Pár hrnků, pár židlí. Světlo svítí — a zatím není na koho čekat. Ale noc je dlouhá a čtvrť malá.",
    "scene.ending_light.14": "Dojdeš k oknu. Venku se Holešovice probouzejí: první samořízená tramvaj, dron s rohlíky, liška na cestě domů.",
    "scene.ending_light.15": "Kavárna nejsou zdi. Jsou to ti, kdo chodí. Neprodávej je.",
    "scene.ending_light.16": "Neprodám, babi.",
    "scene.ending_light.17": "Přesně v šest zhasneš světlo v okně. Poprvé jako ten, komu to tu patří. A zítra v deset večer ho zase rozsvítíš.",
    "scene.filip_cake.01": "Udělal jsem to! Termodynamika za dvě. Přinesl jsem dort. Je trochu zmačkaný, jel jsem dronobusem.",
    "scene.filip_cake.02": "Díky, že jste mě nikdy nevyhodili od toho stolu se zásuvkou. Půlka mého studia se odehrála na něm.",
    "scene.filip_exam.01": "Filip dnes ani neotevřel notebook. Zírá do vystydlé kávy.",
    "scene.filip_exam.02": "Rupnul jsem. Termodynamika, třetí pokus. Táta říká, ať jdu radši do depa k dronům jako normální člověk.",
    "scene.filip_exam.03": "Poslat k němu někoho laskavého, ať si přisedne",
    "scene.filip_exam.04": "Přinést mu čerstvou kávu na účet podniku",
    "scene.filip_exam.05": "Nezasahovat",
    "scene.filip_exam.06": "…Ještě jeden pokus. Fajn. Ale jestli zase rupnu, napíšu kavárnu do omluvenky.",
    "scene.final_night.01": "Třicátá noc. Poslední splátka je splatná v šest.",
    "scene.final_night.02": "Rozpis na dnešek: všichni. Nikdo nechtěl výměnu směny. Nikdo nechtěl volno.",
    "scene.final_night.03": "Tak ať svítí.",
    "scene.franchise_decision.01": "Tak co? Smlouvu máte ve schránce Shiftelly. Jedno ťuknutí.",
    "scene.franchise_decision.02": "Na zdi babiččina fotka. V okně lampa. Venku spí město — kromě lidí, kteří chodí sem.",
    "scene.franchise_decision.03": "Podepsat. Dluh zmizí, kavárna bude NONSTOP 24.",
    "scene.franchise_decision.04": "Odmítnout. Café Nocturne zůstane Café Nocturne.",
    "scene.franchise_decision.05": "Výborně! Zítra přijede tým s novým nápisem. To osvětlení si zamilujete.",
    "scene.franchise_decision.06": "…Určitě.",
    "scene.franchise_decision.07": "Škoda. Sentiment je drahý, víte.",
    "scene.franchise_decision.08": "Káva taky. A zvládáme to.",
    "scene.franchise_visit.01": "Den sedmnáct. Kde obvykle parkuje Mirek, zastaví stříbrné auto bez řidiče.",
    "scene.franchise_visit.02": "Petr Šindelář, NONSTOP 24. Krásný podnik. Hrozná otevírací doba.",
    "scene.franchise_visit.03": "Nabídka: zaplatíme celý dluh. Vy zůstanete jako vedoucí. Otevřeno 24/7, naše menu, náš nápis. Všechno moderní.",
    "scene.franchise_visit.04": "A světlo v okně?",
    "scene.franchise_visit.05": "U nás světla nezhasínají nikdy! O to přece jde.",
    "scene.franchise_visit.06": "Rozmyslete si to do dvaadvacáté noci. Naše nabídky na rozdíl od našich prodejen nejsou otevřené věčně.",
    "scene.franchise_visit.07": "Kalendář: „NONSTOP 24 — rozhodnutí\" přidáno k noci 22.",
    "scene.guest333_first.01": "03:33. Vteřinová ručička na nástěnných hodinách se zastaví.",
    "scene.guest333_first.02": "Rádio tiše zašumí, jako by ho někdo daleko ladil.",
    "scene.guest333_first.03": "U okna sedí muž v šedém kabátě. Dveře nikdo neslyšel.",
    "scene.guest333_first.04": "Čaj s citronem, prosím. Dva cukry.",
    "scene.guest333_first.05": "Pije pomalu a dívá se na nástupiště. Pak je pryč — a na stole leží tři mince, které nejsou penězi déle, než žiješ.",
    "scene.guest333_first.06": "Československé koruny. Rok 1978.",
    "scene.guest333_first.07": "Hodiny zase tikají. 03:34.",
    "scene.guest333_question.01": "Hodiny zase stojí. Muž v šedém kabátě poprvé zvedne oči od nástupiště.",
    "scene.guest333_question.02": "Ještě čeká?",
    "scene.guest333_question.03": "„Ano. Světlo pořád svítí.\"",
    "scene.guest333_question.04": "„Nevím.\"",
    "scene.guest333_question.05": "„Odešla. Letos na podzim.\"",
    "scene.guest333_question.06": "Dobře. Tak budu chodit dál.",
    "scene.guest333_question.07": "Nikdo neví. To je na čekání to nejhorší.",
    "scene.guest333_question.08": "…Odešla. A světlo pořád svítí.",
    "scene.guest333_question.09": "Pak ho za ni někdo drží.",
    "scene.guest333_ticket.01": "Dnes nenechal mince. Na stole leží jízdenka: Rn 333, Praha-Holešovice 3:33, 14. listopadu 1979. Zpáteční.",
    "scene.guest333_ticket.02": "Zpáteční polovina nikdy nebyla použitá.",
    "scene.hana_asleep.01": "02:20. Hana usnula nad cappuccinem, pořád v nemocničním.",
    "scene.hana_asleep.02": "Displej telefonu se rozsvítí: „Pauza končí 02:30.\" A znovu: „Nabídka z kliniky v Drážďanech — prosíme o odpověď.\"",
    "scene.hana_asleep.03": "Opatrně ji vzbudit — pauza jí končí",
    "scene.hana_asleep.04": "Přikrýt ji dekou a nechat ji spát ještě deset minut",
    "scene.hana_asleep.05": "Přesadit ji do křesla pod lampou, do tichého koutu",
    "scene.hana_asleep.06": "Díky… Jinak bych prospala celé oddělení.",
    "scene.hana_asleep.07": "Takhle jsem se nevyspala měsíc. …Neříkej to vrchní sestře.",
    "scene.hana_decision.01": "Rozhodla jsem se. Kvůli Drážďanům.",
    "scene.hana_decision.02": "Zůstávám. Drážďany platí líp. Praha má křeslo pod lampou, kde mě někdo nechá spát.",
    "scene.hana_decision.03": "Jedu. Je to dobrá práce. …Díky za všechna kafe. Byli jste vždycky rychlí.",
    "scene.last_333.01": "Poprvé za šedesát let zastaví ve 3:33 vlak. Okna má teplá a prázdná.",
    "scene.last_333.02": "To je můj. Ještě čaj, prosím, než pojedu. Dva cukry.",
    "scene.last_333.03": "Položit vedle šálku Lidin dopis",
    "scene.last_333.04": "Nechat dopis v kapse",
    "scene.last_333.05": "Jindro.",
    "scene.last_333.06": "Mirku. Zestárls.",
    "scene.last_333.07": "Ty ne.",
    "scene.last_333.08": "Mirek položí dopis na stůl. Oběma rukama, jako by byl těžký.",
    "scene.last_333.09": "Dopis zatím neotevře. Jen na něj položí dlaň.",
    "scene.last_333.10": "Počkám do rána. Rád bych viděl, jak vypadá město, když svítí.",
    "scene.last_333.11": "Ani dnes nic. To nevadí. Jsem zvyklý.",
    "scene.last_333.12": "Vlak ho odveze beze zvuku.",
    "scene.lori_evening.01": "Déšť na oknech. Všechny židle obsazené. Lori na malém pódiu ladí kytaru.",
    "scene.lori_evening.02": "Tahle je pro kavárnu, která mě pustila dovnitř z deště.",
    "scene.lori_evening.03": "Tři písničky si nikdo nic neobjedná. Pak si všichni objednají všechno.",
    "scene.lori_platform.01": "Na prázdném nástupišti pod kapajícím přístřeškem někdo hraje na kytaru. Rozladěnou, ale zpívá krásně.",
    "scene.lori_platform.02": "Neboj, nehraju pro vlaky. Ty dýška nedávají.",
    "scene.lori_platform.03": "Nemáte… horkou čokoládu? Zaplatit nemůžu. Ale můžu zahrát.",
    "scene.lori_platform.04": "Pojď dál, je tu teplo",
    "scene.lori_platform.05": "Promiň, dnes ne",
    "scene.lori_platform.06": "Písnička za čokoládu. Poctivý obchod.",
    "scene.lori_platform.07": "Jasně. Chápu. Hezkou noc.",
    "scene.mirek_confession.01": "Musím ti něco říct. Nosím to šedesát let. Váží to asi dvacet gramů.",
    "scene.mirek_confession.02": "Z náprsní kapsy vytáhne obálku. Zažloutlou. Zalepenou. Lidiným písmem: „Jindrovi.\"",
    "scene.mirek_confession.03": "Listopad devětasedmdesát. Jindra odjížděl nočním, tím Rn 333. Pohádali se. Ona napsala tohle a poprosila mě, ať mu to doběhnu dát na nástupiště.",
    "scene.mirek_confession.04": "Bylo mi dvacet a byl jsem do ní blázen. Stál jsem v dešti, díval se, jak vlak odjíždí. A nechal jsem si to.",
    "scene.mirek_confession.05": "Už se nevrátil. Ona nikdy nepřestala čekat. A já sem chodil každou noc na kafe a neřekl ani slovo.",
    "scene.mirek_confession.06": "Každou noc. Šedesát let.",
    "scene.mirek_confession.07": "Černou, jako dělala Lida. Jo. Každou noc.",
    "scene.mirek_curb.01": "Venku zaskřípe plech. Mirkovo staré auto políbilo obrubník u vchodu.",
    "scene.mirek_curb.02": "Obrubník se pohnul. V noci je přesouvají, víš. Radnice.",
    "scene.mirek_curb.03": "Dlouho mžourá na tabuli s menu. Moc dlouho.",
    "scene.mirek_curb.04": "Ta písmenka na tabuli se od Lidiných časů nějak zmenšila.",
    "scene.mirek_curb.05": "Zvětšit písmo na tabuli (−300 Kč)",
    "scene.mirek_curb.06": "Přečíst mu menu nahlas",
    "scene.mirek_curb.07": "Nic neříkat",
    "scene.mirek_curb.08": "Černou. Jako vždycky. Aspoň něco se nemění.",
    "scene.mirek_first.01": "Zvonek u dveří. Starý pán v čepici otřepe déšť z ramen. Podle klíčů taxikář.",
    "scene.mirek_first.02": "Tak zase svítí. Myslel jsem, že už vidím přízraky.",
    "scene.mirek_first.03": "Černou. Jako dělala Lida — aby v ní stála lžička.",
    "scene.mirek_first.04": "Zkusím to. Jsem její vnučka.",
    "scene.mirek_first.05": "…Máš její oči. Pane Bože. No. Tak kafe. A topinku, jestli sporák ještě žije.",
    "scene.mirek_first.06": "Přijmi objednávku, uvař kávu u kávovaru a vyber peníze u pokladny.",
    "scene.mirek_letter.01": "Řekni mi, co s ním. Měl jsem šedesát let a pořád to nevím.",
    "scene.mirek_letter.02": "„Dejte mi ho. Schovám ho.\"",
    "scene.mirek_letter.03": "„Nechte si ho. Je to vaše břemeno.\"",
    "scene.mirek_letter.04": "„Spalte ho. Ať má pokoj.\"",
    "scene.mirek_letter.05": "„Dejte mu ho sám. Třicátou noc, ve 3:33.\"",
    "scene.mirek_letter.06": "Sám? …Když mu ho dám sám — uvidí mě?",
    "scene.mirek_letter.07": "Vidí každého, kdo čeká.",
    "scene.mirek_letter.08": "Obálka se v kamnech zkroutí. Mirek se dívá, dokud z ní nic nezbude.",
    "scene.mirek_letter.09": "Světlo. Nic jiného to nikdy nebylo.",
    "scene.mirek_pedestrian.01": "Brzdy. Výkřik. Mirkovo auto zastaví na dlaň od sestřičky, která přecházela k nemocnici.",
    "scene.mirek_pedestrian.02": "Nikomu se nic nestalo. Mirek sedí u baru s roztřesenýma rukama a na kávu nesáhne.",
    "scene.mirek_pedestrian.03": "Neviděl jsem ji. Ta světla, ten déšť… Já ji neviděl.",
    "scene.mirek_pedestrian.04": "Nekoukej tak na mě. Taxík je všechno, co mi zbylo. Zbytek města si vzali roboti.",
    "scene.mirek_pedestrian.05": "Požádat ho o klíče od auta",
    "scene.mirek_pedestrian.06": "Zavolat jeho dceři Janě",
    "scene.mirek_pedestrian.07": "Mlčet",
    "scene.mirek_pedestrian.08": "…Lida by udělala totéž. Jen by nejdřív křičela.",
    "scene.mirek_pedestrian.09": "Tati? Už jedu. Ať tě ani nenapadne sednout za volant.",
    "scene.mirek_pedestrian.10": "Vlastní dcera. Jako na kluka ze školy.",
    "scene.mirek_pedestrian.11": "Mirek dopije, zaplatí přesně a odjede. Zadní světla se rozmažou v dešti.",
    "scene.opening.01": "Praha-Holešovice, podzim 2039. Velké město, které v noci ztichne na jedno nádraží, jednu řeku a spoustu mlhy.",
    "scene.opening.02": "Vážení cestující, osobní vlak Os 2141 z Adamova přijel k prvnímu nástupišti. Děkujeme, že cestujete v noci.",
    "scene.opening.03": "Vlak se tiše rozjede do tmy sám od sebe — strojvedoucího už léta nepotřebuje. Na nástupišti zůstane jeden kufr a jeden člověk: ty.",
    "scene.opening.04": "Naposledy, co si pamatuju, mi ten pult sahal po nos.",
    "scene.opening.05": "Vedle nádraží jedno tmavé okno. Nad ním holografický nápis s prasklým písmenem: CAFÉ NOCTURNE — kavárna u nádraží.",
    "scene.opening.06": "V kapse máš dopis od notáře. A ještě jeden, psaný rukou. Na obálce: „Tomu, kdo bude držet světlo.\"",
    "scene.opening.07": "Jestli tohle čteš, kávovar mě přežil. Chovej se k němu hezky. Kouše.",
    "scene.opening.08": "Klíč je pod rohožkou. Samozřejmě. V Holešovicích rohožky nikdo nekrade.",
    "scene.opening.09": "Nebudu ti lhát: jsou tu dluhy. Devadesát tisíc. Majitel budovy ti dá třicet nocí.",
    "scene.opening.10": "Otvírá se v deset večer, zavírá v šest ráno. A světlo v okně svítí až do šesti. Vždycky.",
    "scene.opening.11": "Proč, to ti do dopisu nenapíšu. Přijdeš na to. Tvoje Lida.",
    "scene.opening.12": "Prach. Židle na stolech. Na zdi fotka babičky — směje se někomu mimo záběr.",
    "scene.opening.13": "Tak jo, babi. Třicet nocí.",
    "scene.opening.14": "Rozsvítíš lampu v okně. Kdesi za kolejemi se zastaví liška a dívá se.",
    "scene.payment_1.01": "Ráno. První splátka odchází s vlakem v 6:12 do Berouna.",
    "scene.payment_1.02": "Platba přišla. Upřímně? Nečekal jsem to.",
    "scene.payment_1.03": "Platba nepřišla celá. Nebudu dělat scény. Zatím.",
    "scene.payment_1.04": "A ještě něco: nájem končí po třicáté noci. Prodloužím ho, jen když bude dluh splacený. Nic osobního. Aritmetika.",
    "scene.payment_1.05": "Tak budeme počítat.",
    "scene.payment_2.01": "Druhá splátka je tady. Začínám si zvykat. To je nebezpečné.",
    "scene.payment_2.02": "Zase chybí peníze. Kavárna je ale nějak plná. To nechápu.",
    "scene.payment_2.03": "Polovina cesty k třicáté noci.",
    "scene.payment_3.01": "Třetí splátka. Víte, že mi o vás píšou lidi? Normálně mi lidi píšou jen kvůli plísni.",
    "scene.payment_3.02": "Třetí splátka zase nesedí. Ale aspoň mi píšou, že máte dobrou polévku.",
    "scene.payment_4.01": "Čtvrtá splátka. Zbývá poslední — třicet tisíc. Držím vám palce. Neříkejte to nikomu.",
    "scene.payment_4.02": "Čtvrtá splátka chybí. Zbývá poslední noc. Ukažte mi zázrak, nebo aspoň kalkulačku.",
    "scene.radek_last_shift.01": "Poslední služba. Od zítřka se nádraží řídí samo.",
    "scene.radek_last_shift.02": "Něco jsem ti přinesl. Starý jízdní řád z dopravní kanceláře. Rok 1979. Měl jsem ho dát do skartovačky.",
    "scene.radek_last_shift.03": "Podívej na poslední řádek. Někdo k němu tužkou připsal: „dvě minuty\".",
    "scene.radek_news.01": "Černou s sebou. Mám čtyři minuty.",
    "scene.radek_news.02": "Nádraží převádějí na automat. Za dva týdny jsem poslední noční výpravčí v Holešovicích — pak už jen počítač a mlha.",
    "scene.radek_news.03": "Zvláštní. Na starém jízdním řádu na zdi pořád visí Rn 333. Příjezd 3:33. Zrušený v devětasedmdesátém a nikdo ho nikdy nesundal.",
    "scene.radek_news.04": "Rn 333?",
    "scene.radek_news.05": "Dneska noční vlak odnikud nikam. Zeptej se pamětníků. Nebo radši ne.",
    "scene.vera_first.01": "Tak ty jsi ta vnučka. Lidina.",
    "scene.vera_first.02": "Čaj s citronem. A otři ten stůl. Lida by ho takhle nikdy nenechala.",
    "scene.vera_first.03": "Dělám, co můžu.",
    "scene.vera_first.04": "Každý dělá, co může. Lida mohla víc.",
    "scene.vera_first.05": "Otevře křížovku a už nevzhlédne. Ale zůstane až do tří.",
    "scene.vera_jindrich.01": "První sníh. Lida ho milovala. Sedni si, povím ti o Jindrovi.",
    "scene.vera_jindrich.02": "Opravoval rádia. Vysoký, plachý, tancoval příšerně. Vybrala si ho před půlkou města. I před Mirkem.",
    "scene.vera_jindrich.03": "Tu noc, co odjížděl za prací do Ostravy, se pohádali. Kvůli hlouposti — peníze a pýcha. Řekla, že mu napíše.",
    "scene.vera_jindrich.04": "On čekal na dopis, který nepřišel. Ona čekala na muže, který se nevrátil. A já se dívala na oba a byla jsem moc pyšná, abych něco řekla.",
    "scene.vera_jindrich.05": "Proto jsem sem chodila a stěžovala si na stoly. Někdo jí musel dělat společnost.",
    "scene.vera_recipe.01": "Tady. Lidina kuchařka. Dala mi ji „schovat před mastnotou\". V roce 1994.",
    "scene.vera_recipe.02": "Její kulajda. Kopr, houby, ztracené vejce a ještě něco, co mi nikdy neřekla. Možná to tam napsala.",
    "scene.vera_recipe.03": "Vím víc, než říkám, dítě. Ale dnes ne.",
    "scene.vera_tears.01": "…To je ona. Přesně její.",
    "scene.vera_tears.02": "Hádaly jsme se o všechno. O kluky, o zkoušky, kdo má hezčí vlasy. Vždycky jsem prohrála. Nevadilo mi to tolik, kolik jsem tvrdila.",
    "scene.vera_tears.03": "Vera tiše pláče do polévky. Pak si řekne o další chleba.",
    "season.advent.name": "Advent",
    "season.advent.toast": "Advent. Grandma would be getting out the box by now.",
    "season.first_snow.name": "First snow",
    "season.first_snow.toast": "Snow on the roofs of Holešovice.",
    "season.frost.name": "Frost",
    "season.frost.toast": "Frost in the window corners this morning.",
    "season.late_autumn.name": "Late autumn",
    "season.late_autumn.toast": "Wet leaves on the doorstep. Autumn has settled in.",
    "season.spring.name": "Spring",
    "season.spring.toast": "Spring rain, and petals stuck to the window.",
    "season.summer.name": "Summer",
    "season.summer.toast": "Warm nights. The windows stay open.",
    "staff.barista.bio": "Bára utekla z vysoké v Praze a rodičům to neřekla. Kávu dělá líp než diplomovou práci.",
    "staff.barista.dislikes": "Ticho, mytí nádobí",
    "staff.barista.likes": "Hudbu v sále, povídání s hosty",
    "staff.barista.pref.exam": "Exam on Friday. I can't miss it.",
    "staff.barista.pref.late": "Late shifts, please. I'm a different person after midnight.",
    "staff.barista.pref.sunday": "Sunday lunch with my parents. They think I'm still at uni.",
    "staff.barista.role": "Noční baristka",
    "staff.cashier.bio": "Ivana pracuje v noci, zatímco dcera spí u sousedky. Jeden telefonát může rozbít celou směnu.",
    "staff.cashier.dislikes": "Zpoždění, chaos",
    "staff.cashier.likes": "Přesnost, když ji někdo pochválí",
    "staff.cashier.pref.early": "Home by half past two — my daughter wakes at night.",
    "staff.cashier.pref.hours": "Four nights at least. I need the hours.",
    "staff.cashier.role": "Pokladní a sál",
    "staff.cook.bio": "Pan Holub vařil dvacet let v závodní jídelně sklárny. Lidu znal a bručí, že „za ní to bylo jinak\".",
    "staff.cook.dislikes": "Spěch, když mu někdo sahá na věci",
    "staff.cook.likes": "Pořádek v kuchyni, vlastní nůž",
    "staff.cook.pref.back": "Not two nights in a row. My back.",
    "staff.cook.pref.full": "Full nights. Half a night is half a soup.",
    "staff.cook.role": "Kuchař",
    "staff.porter.bio": "Kuba dřív tahal bedny ve skladu. Je hodný a všechno mu padá z rukou. Potajmu se učí péct.",
    "staff.porter.dislikes": "Hlasité hádky",
    "staff.porter.likes": "Zvířata (kočky!), jídlo",
    "staff.porter.pref.cook": "Mr Holub lets me watch him bake.",
    "staff.porter.role": "Pomocník a úklid",
    "staff.quiet_one.bio": "Ema slyší houkání vlaků, které nejsou v jízdním řádu. Jako jediná si všimne, že ve 3:33 stojí hodiny.",
    "staff.quiet_one.dislikes": "Dav, ostré světlo",
    "staff.quiet_one.likes": "Déšť, tiché hodiny mezi druhou a čtvrtou",
    "staff.quiet_one.pref.tuesday": "Lectures on Tuesdays.",
    "staff.quiet_one.pref.weekend": "Not weekends, if possible. Crowds.",
    "staff.quiet_one.role": "Všeuměl",
    "staff.server.bio": "Natália přijela z Košic na týden a zůstala. Nosí čtyři talíře najednou a pamatuje si každé jméno.",
    "staff.server.dislikes": "Ulepené podlahy",
    "staff.server.likes": "Čisté stoly, deštivé noci",
    "staff.server.pref.bara": "With Bára, if I can. She makes the nights go fast.",
    "staff.server.pref.max": "Five nights, no more. I've got a life to visit.",
    "staff.server.role": "Obsluha",
    "staff.sound_tech.bio": "Oleh byl zvukař ve Lvově. „Dočasně\" tu pracuje už druhý rok. Umí opravit staré rádio.",
    "staff.sound_tech.dislikes": "Levnou kávu",
    "staff.sound_tech.likes": "Staré desky, rádio",
    "staff.sound_tech.pref.late": "Late, please. I sound better after midnight. So does the coffee.",
    "staff.sound_tech.pref.thursday": "Thursday's band rehearsal — and the video call home.",
    "staff.sound_tech.role": "Bar a sál",
    "story.act.1.title": "Dějství I — Klíče",
    "story.act.2.title": "Dějství II — Štamgasti",
    "story.act.3.title": "Dějství III — Nabídka",
    "story.act.4.title": "Dějství IV — Poslední vlak",
    "story.hint.app": "V Shiftelle najdeš výměny směn, volno, oznámení a ranní přehled.",
    "story.hint.armchair": "Křeslo a stojací lampa vedle sebe tvoří tichý kout.",
    "story.hint.build": "Ve Stavbě (B) přidáš stoly, lampy a rostliny. Peníze se strhnou hned, Ctrl+Z vrací.",
    "story.hint.candles": "Bez proudu jdou prodávat jen studená jídla. Svíčky hostům zvednou náladu.",
    "story.hint.downpour": "Liják! Hostů přibývá — postav někoho na úklid.",
    "story.hint.duties": "Helpers only do the duties you give them (P). The guests with wishes are yours.",
    "story.hint.farewell": "Poslední noci. Každý štamgast přijde uzavřít svůj příběh.",
    "story.hint.first_order": "Klikni na hosta u pultu a pak na kávovar. Personál zatím jsi ty.",
    "story.hint.hire": "Ve dne můžeš najímat. Otevři Personál (C) a vyber kandidáta.",
    "story.hint.inspection": "Hygiena kontroluje špínu. Pod 30 % je pochvala, nad 60 % pokuta.",
    "story.hint.lori_night": "Lori je tady. Dnes hraje pro všechny.",
    "story.hint.morning": "V šest se kavárna zavírá. Ráno uvidíš souhrn noci.",
    "story.hint.new_staff": "Na noční směny se hlásí další lidé. Mrkni na kandidáty.",
    "story.hint.payment": "Dluh 90 000 Kč splácíš v nocích 7, 14, 21, 28 a 30. Přehled najdeš v aplikaci Shiftella.",
    "story.hint.priorities": "V Prioritách (P) určíš, kdo co dělá přednostně. 1 je nejdůležitější.",
    "story.hint.regulars": "Štamgasti mají své časy a oblíbená jídla. Když je obsloužíš rychle, otevřou se ti.",
    "story.hint.rush": "Nával! Dej Baru a Obsluze nejvyšší prioritu.",
    "story.hint.schedule": "Rozpis směn najdeš v aplikaci Shiftella (T). Kliknutím na buňku změníš koncept, pak ho zveřejni.",
    "story.hint.special": "Nová specialita: Noční vlak. Pro ty, kdo jedou dál.",
    "story.hint.window_light": "Lampa v okně musí svítit i ve 3:33.",
    "story.line.04_mirek": "Ve tři je tu vždycky divné ticho. Lida říkala, že to nic.",
    "story.line.06_filip": "Dobrý večer… je tu Wi-Fi? Nebo aspoň zásuvka?",
    "story.line.07_cook": "Za Lidy se splátky taky platily v neděli. Ráno. S nadávkami.",
    "story.line.11_ema": "Slyšíte to? Vlak. Na tabuli žádný není.",
    "story.line.16_kuba": "Kocour by se tu líbil. Kdyby nějaký byl. Jen říkám.",
    "story.line.18_filip": "Neptejte se. Prosím.",
    "story.line.22_vera": "Lida by byla pyšná. Neříkej jí… no, neříkej to nikomu.",
    "story.line.22_vera_sold": "Tak tady už jen svítí. Nečeká.",
    "story.line.29_radek": "Na důchodu se spí hrozně. Tak jsem tady.",
    "story.night.01.hint": "Klíč je pod rohožkou. Rozsviť okno a uvař první kávu.",
    "story.night.01.title": "Příjezd",
    "story.night.02.hint": "Najmi někoho a sestav první rozpis.",
    "story.night.02.title": "První kolega",
    "story.night.03.hint": "Ve dvě přijde někdo, kdo nemá čas čekat.",
    "story.night.03.title": "Déšť a sestra",
    "story.night.04.hint": "Nech v okně svítit. Celou noc.",
    "story.night.04.title": "3:33",
    "story.night.05.hint": "Po půlnoci přijde někdo, kdo Lidu znal. Ať jsou stoly čisté.",
    "story.night.05.title": "Paní s křížovkou",
    "story.night.06.hint": "Sobota. Kolem jedenácté skončí koncert v kulturáku.",
    "story.night.06.title": "Po koncertě",
    "story.night.07.hint": "V šest ráno odchází 15 000 Kč. Počítej.",
    "story.night.07.title": "První splátka",
    "story.night.08.hint": "Hlásí se noví lidé. A Mirek dnes parkuje nějak divně.",
    "story.night.08.title": "Obrubník",
    "story.night.09.hint": "V jednu se zastaví výpravčí. Má čtyři minuty.",
    "story.night.09.title": "Poslední výpravčí",
    "story.night.10.hint": "Připrav svíčky. Jen tak, pro jistotu.",
    "story.night.10.title": "Tma",
    "story.night.11.hint": "Prší. Na nástupišti někdo hraje.",
    "story.night.11.title": "Píseň na nástupišti",
    "story.night.12.hint": "Křeslo a lampa by se dnes mohly hodit.",
    "story.night.12.title": "Tichý kout",
    "story.night.13.hint": "Hygiena přijde kolem půl dvanácté. Ať se leskne.",
    "story.night.13.title": "Inspekce",
    "story.night.14.hint": "Druhá splátka. A Vera dnes něco nese.",
    "story.night.14.title": "Kuchařka",
    "story.night.15.hint": "Mlha. Ve 3:33 se tě někdo na něco zeptá.",
    "story.night.15.title": "Otázka",
    "story.night.16.hint": "Nikdo nepřijde. Čas na úklid a na lidi, kteří tu pracují.",
    "story.night.16.title": "Prázdná noc",
    "story.night.17.hint": "Přijede návštěva ze sítě NONSTOP 24. Poslouchej.",
    "story.night.17.title": "NONSTOP 24",
    "story.night.18.hint": "Filip dnes neotevřel notebook.",
    "story.night.18.title": "Opravák",
    "story.night.19.hint": "Bude lít. Hostů bude dvakrát tolik — a špíny taky.",
    "story.night.19.title": "Liják",
    "story.night.20.hint": "Mirek dnes přijede pozdě. Buď u dveří.",
    "story.night.20.title": "Na dlaň",
    "story.night.21.hint": "Další splátka v šest. Někdo chce dovolenou.",
    "story.night.21.title": "Třetí splátka",
    "story.night.22.hint": "Dnes se rozhodne, čí bude nápis nad dveřmi.",
    "story.night.22.title": "Rozhodnutí",
    "story.night.23.hint": "Radek má poslední službu.",
    "story.night.23.title": "Jízdní řád",
    "story.night.24.hint": "Prší. Pokud má Lori pódium, dnes je její večer.",
    "story.night.24.title": "Večer pro Lori",
    "story.night.25.hint": "Přijde bouřka. Ať okno svítí.",
    "story.night.25.title": "Bouřka",
    "story.night.26.hint": "Hana se rozhodla.",
    "story.night.26.title": "Drážďany",
    "story.night.27.hint": "Sněží. Vera chce vyprávět.",
    "story.night.27.title": "První sníh",
    "story.night.28.hint": "Čtvrtá splátka. A Mirek má otázku.",
    "story.night.28.title": "Dopis",
    "story.night.29.hint": "Každý štamgast dnes přijde uzavřít svůj příběh.",
    "story.night.29.title": "Loučení",
    "story.night.30.hint": "Poslední noc. 30 000 Kč v šest. Ve 3:33 ať okno svítí.",
    "story.night.30.title": "Poslední vlak",
    "taste.bitter": "Bitter",
    "taste.cold": "Cold",
    "taste.comforting": "Comforting",
    "taste.fancy": "Fancy",
    "taste.filling": "Filling",
    "taste.fresh": "Fresh",
    "taste.mild": "Mild",
    "taste.quick": "Quick",
    "taste.spiced": "Spiced",
    "taste.strong": "Strong",
    "taste.sweet": "Sweet",
    "taste.warm": "Warm",
    "thanks.filip.1": "Passed! Partly your coffee's fault. — F.",
    "thanks.g01": "Thank you for the warm hands.",
    "thanks.g02": "Best coffee between here and Adamov.",
    "thanks.g03": "Caught my train! Thanks to you.",
    "thanks.g04": "I came in sad. I'm leaving less sad.",
    "thanks.g05": "The rain was nicer from your window.",
    "thanks.g06": "You remembered I take it without sugar. Nobody remembers.",
    "thanks.g07": "Same time tomorrow?",
    "thanks.g08": "For the soup. And the quiet.",
    "thanks.g09": "A good night after a bad day.",
    "thanks.g10": "My shift was twelve hours. This made it eleven.",
    "thanks.g11": "Say hi to the cat!",
    "thanks.g12": "Thank you for not asking. And for the koláč.",
    "thanks.g13": "Five stars. Six if the Wi-Fi worked.",
    "thanks.g14": "I proposed here tonight. She said yes!",
    "thanks.g15": "Next stop: home. Thank you for this one.",
    "thanks.g16": "The best thing I tasted this year was at 3 a.m.",
    "thanks.g17": "Drew this while waiting. Keep it.",
    "thanks.g18": "You make strangers feel like regulars.",
    "thanks.g19": "I'll tell my grandmother about your tea.",
    "thanks.g20": "Stayed dry, stayed warm, stayed longer than I meant to.",
    "thanks.g21": "The music was perfect. Who picks it?",
    "thanks.g22": "That cup was exactly the right size of hug.",
    "thanks.g23": "Night drivers' union says thanks.",
    "thanks.g24": "The moon was out. So was your lamp.",
    "thanks.g25": "A tip, and a secret: this is my favourite place.",
    "thanks.g26": "The cat stole my napkin. This is the second one.",
    "thanks.g27": "From the night ward, with tired love.",
    "thanks.g28": "I'll be back when the snow comes.",
    "thanks.g29": "Thank you for the window light. It helps, you know.",
    "thanks.g30": "Stay open. Please.",
    "thanks.guest_333.1": "Děkuji.",
    "thanks.hana.1": "You saved my night shift. Again. — H.",
    "thanks.hana.2": "Twelve minutes of peace. Thank you. — H.",
    "thanks.lori.1": "For the warm song you didn't know you sang. — L.",
    "thanks.mirek.1": "For the coffee. And for not asking. — M.",
    "thanks.mirek.2": "She'd be proud. Don't make a fuss. — M.",
    "thanks.radek.1": "The trains ran on time tonight. So did you. — R.",
    "thanks.vera.1": "Acceptable. Very acceptable. — V. S.",
    "thanks.vera.2": "The tea was proper. Tell nobody I said so. — V.",
    "theme.art_nouveau.desc": "A sage-and-gold mosaic band, brass lamps and curved trims, like an old Secession café.",
    "theme.art_nouveau.name": "Prague Art Nouveau",
    "theme.grandma_original.desc": "Faded rose-stripe wallpaper, honey-coloured wood, lace and amber lamps. Exactly as Lida left it.",
    "theme.grandma_original.missed": "Lida's wallpaper… you changed it. Well. It's your café now.",
    "theme.grandma_original.name": "Grandma's original",
    "theme.nocturne_2039.desc": "Indigo holo accents, warm LED strips and a touch of Shiftella violet.",
    "theme.nocturne_2039.name": "Nocturne 2039",
    "theme.station_retro.desc": "Cream and bottle-green paint, enamel signs and a timetable board — the 1979 railway buffet.",
    "theme.station_retro.name": "Station Retro",
    "theme.winter_lights.desc": "White-gold fairy lights, red ribbons and spruce. Cosiest in Advent.",
    "theme.winter_lights.name": "Winter Lights",
    "train.announce.arrival": "Vážení cestující, vlak {train} ze stanice {from} do stanice {to}, pravidelný příjezd {time}, přijíždí k nástupišti {platform}.",
    "train.announce.delay": "Vážení cestující, vlak {train} ze stanice {from} do stanice {to}, pravidelný příjezd {time}, nástupiště {platform}, má zpoždění. Děkujeme za trpělivost.",
    "train.en_471.name": "EN 471 — noční expres Cheb → Frýdlant",
    "train.nex_9002.name": "Nex 9002 — samořízený nákladní",
    "train.os_2141.name": "Os 2141 — osobní z Adamova",
    "train.r_815.name": "R 815 — rychlík Frýdlant → Beroun",
    "train.rn_333.name": "Rn 333 — v jízdním řádu od roku 1979 není",
    "trait.anxious.desc": "Bojí se chyby, a když je fronta, dělá je. U pokladny je ale pečlivý.",
    "trait.anxious.name": "Úzkostný",
    "trait.calm.desc": "Výpadek proudu? Tak zapálíme svíčky. Špatné zprávy na něj platí jen napůl.",
    "trait.calm.name": "Klidas",
    "trait.chatterbox.desc": "Ví všechno o všech hostech. Hosté ho milují, jen práce jde pomaleji, když je klid.",
    "trait.chatterbox.name": "Upovídaný",
    "trait.clumsy.desc": "Ruce dělají něco jiného, než měly v plánu. Občas cinkne nádobí.",
    "trait.clumsy.name": "Nešika",
    "trait.early_bird.desc": "Do půlnoci je k nezastavení, po druhé hodině jako v mlze.",
    "trait.early_bird.name": "Skřivan",
    "trait.grumpy.desc": "Bručí, ale řemeslo umí. Trpěliví hosté mají jeho „pravý charakter\" rádi.",
    "trait.grumpy.name": "Bručoun",
    "trait.hard_worker.desc": "Neodejde, dokud to nedodělá. Při frontě vynechá pauzu — a pak je k smrti unavený.",
    "trait.hard_worker.name": "Dříč",
    "trait.kind.desc": "Utěší hosta i kolegu. Vedle něj mají všichni o trochu lepší náladu.",
    "trait.kind.name": "Dobrák",
    "trait.lazy.desc": "Pauza je posvátná. Pracuje pomaleji, ale taky se tolik neunaví.",
    "trait.lazy.name": "Lenoch",
    "trait.light_sleeper.desc": "Slyší, co ostatní ne. Všimne si hosta ve 3:33 a občas tuší, co přijde.",
    "trait.light_sleeper.name": "Lehký spánek",
    "trait.loner.desc": "Nejlíp pracuje, když ho nikdo neruší. V davu kolegů mu klesá nálada.",
    "trait.loner.name": "Samotář",
    "trait.music_lover.desc": "Pracuje do rytmu. S hudbou kvete, v tichu vadne — a rádio si pustí sám.",
    "trait.music_lover.name": "Muzikant",
    "trait.neat.desc": "Nepřejde kolem skvrny. Uklízí rychleji a sám od sebe.",
    "trait.neat.name": "Pořádkumilovný",
    "trait.night_owl.desc": "V noci ožívá, ve dne spí jako dřevo. Po půlnoci se unaví mnohem pomaleji.",
    "trait.night_owl.name": "Sova",
    "trait.perfectionist.desc": "Pomalu, ale dokonale. Lepší dýška — a špatná nálada ze špíny.",
    "trait.perfectionist.name": "Perfekcionista",
    "trait.romantic.desc": "Zamilovává se do kolegů i do deště. Za deštivé noci je mu líp.",
    "trait.romantic.name": "Romantik",
    "tutorial.app.body": "Otevři Shiftellu (T). V rozpisu klikni na buňku a změň směnu, pak Zveřejnit — noc se řídí zveřejněným rozpisem. Najdeš tam i žádosti, zprávy a nástěnka.",
    "tutorial.app.title": "Rozpis v aplikaci Shiftella",
    "tutorial.atmosphere": "It feels warmer in here when the lamps are on.",
    "tutorial.book": "Grandma's recipes are all in here — and a card for linden tea, in her handwriting. (K)",
    "tutorial.build.body": "Stavba (B): vyber kus, klikni do kavárny. R otočí, X bourá, Ctrl+Z vrátí. Lampy, rostliny a koberec hosty potěší.",
    "tutorial.build.title": "Zútulni sál (nepovinné)",
    "tutorial.cat": "The station cat. It's been watching this door longer than I have.",
    "tutorial.clear_table": "Cups won't carry themselves to the sink.",
    "tutorial.closing": "A note for tomorrow's me, then lights off at six.",
    "tutorial.crew.body": "Otevři Personál (C). Dole jsou uchazeči — baristka nebo barista se hodí hned první noc. Jedno kliknutí na Najmout.",
    "tutorial.crew.title": "Najmi první posilu",
    "tutorial.duties": "Kuba takes the dishes. I take the guests.",
    "tutorial.enjoy.body": "To je všechno. F1 nebo „?“ v liště otevře přehled Jak hrát. Ať okno svítí až do rána.",
    "tutorial.enjoy.title": "Hezkou noc",
    "tutorial.events.body": "Vpravo dole se objeví zprávy a malé příhody. Některé mají tlačítka — vyber, nebo počkej a noc rozhodne za tebe. Na pauze počkají.",
    "tutorial.events.title": "Události",
    "tutorial.experiment": "Linden and honey, her card says. Into the pantry slots, then Try.",
    "tutorial.fairness": "The rings show how everyone feels about the week. Nobody needs to be stretched.",
    "tutorial.garlands": "Windows first, then the counter, then the door. Like every year, Karolinko.",
    "tutorial.greet": "That's Mirek. Grandma's oldest regular. A wave wouldn't hurt.",
    "tutorial.guests.body": "Najeď myší na hosta: uvidíš, co si přeje a jak dlouho vydrží čekat. Štamgasti mají svůj příběh — klikni na ně, a když mají co říct, objeví se Promluvit si.",
    "tutorial.guests.title": "Hosté",
    "tutorial.journal": "Grandma kept a box of photos behind the till. I'll keep one too. (J)",
    "tutorial.jukebox": "Grandma's records. Three still play.",
    "tutorial.light_window": "The light in the window first, Karolinko. Always first.",
    "tutorial.machine": "The old machine needs a minute to wake up. Hold it until it hums.",
    "tutorial.moment": "Something's glowing by the window…",
    "tutorial.money.body": "Vpravo nahoře: pokladna, hvězdičky pověsti a dluh. Ráno přijde shrnutí noci a ve dne vidíš, kdy je další splátka.",
    "tutorial.money.title": "Peníze a pověst",
    "tutorial.mop": "Muddy footprints by the door. One good swipe.",
    "tutorial.pick_recipe": "\"Black, the way Lida poured it.\" I think I know which one.",
    "tutorial.pour_over": "Slow circles, in time with the rain. And if it goes wrong — skip, it'll still be good.",
    "tutorial.priorities.body": "Priority (P): řádky jsou lidé, sloupce práce. 1 = dělá to nejdřív, prázdné = vůbec. Klik zvýší, pravé tlačítko sníží. Každému jednu jasnou jedničku.",
    "tutorial.priorities.title": "Kdo co dělá",
    "tutorial.quick_brew": "A plain order. I can let the machine work and do something else.",
    "tutorial.rail": "A ticket with an empty ring — nobody has it. That one's mine.",
    "tutorial.rozpis": "He wants to work with the cook. Noted.",
    "tutorial.speed": "It's quiet. I could let the clock run a little faster.",
    "tutorial.staff.body": "Lidé berou práci podle priorit. V Personálu (C) vidíš jejich potřeby — energii, hlad, náladu. Unavení si sami dají pauzu.",
    "tutorial.staff.title": "Tým pracuje sám",
    "tutorial.start.body": "Až budeš chtít, klikni na Začít noc (nebo Enter). Rozsviť okno a uvař první kávu.",
    "tutorial.start.title": "Otevři dveře",
    "tutorial.take_order": "He's waiting for me. Let's see what he'd like.",
    "tutorial.time.body": "Mezerník pozastaví, 1/2/3 mění rychlost. Pruh pod hodinami ukazuje noc do 06:00, trojúhelníčky jsou vlaky — přivezou malý nával.",
    "tutorial.time.title": "Čas plyne po svém",
    "tutorial.tip_coin": "Something glints on Mirek's table. He left a coin after all.",
    "tutorial.usual": "Mirek trusts me now. \"The usual?\" — one tap.",
    "tutorial.wash": "The cups are stacking up. Hold, and they'll wash.",
    "tutorial.welcome.body": "Den je na plánování: lidé, rozpis, nábytek. Noc od 22:00 do 06:00 kavárna běží sama — ty jen dohlížíš. Pár tipů a pak už je to tvoje.",
    "tutorial.welcome.title": "Vítej v Café Nocturne",
    "tutorial.welcome_sandbox.body": "Pár karet ukáže, jak to tu chodí: den na plánování, noc od 22:00 do 06:00 na provoz. Kdykoli můžeš průvodce přeskočit.",
    "tutorial.welcome_sandbox.title": "Krátká prohlídka?",
