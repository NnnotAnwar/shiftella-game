    "menu.chai.desc": "Škorica, kardamón a vôňa, ktorá vydrží do rána.",
    "menu.chai.name": "Korenistý chai",
    "menu.chlebicek.desc": "Šunka, vajíčko, uhorka. Funguje aj bez prúdu.",
    "menu.chlebicek.name": "Obložený chlebík",
    "menu.garlic_soup.desc": "So syrom a krutónmi. Zaženie zimu aj nočnú zmenu.",
