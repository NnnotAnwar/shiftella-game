    "menu.black_coffee.desc": "Silná, až v nej stojí lyžička.",
    "menu.black_coffee.name": "Čierna ako u Lídy",
    "menu.bryndzove_pirohy.desc": "So slaninkou a smotanou. Natália na ne nedá dopustiť.",
    "menu.bryndzove_pirohy.name": "Bryndzové pirohy",
    "menu.cappuccino.desc": "Mliečna pena a päť minút pokoja.",
    "menu.cappuccino.name": "Cappuccino",
    "menu.chai.desc": "Škorica, kardamón a vôňa, ktorá vydrží do rána.",
    "menu.chai.name": "Korenistý chai",
    "menu.chlebicek.desc": "Šunka, vajíčko, uhorka. Funguje aj bez prúdu.",
    "menu.chlebicek.name": "Obložený chlebík",
    "menu.garlic_soup.desc": "So syrom a krutónmi. Zaženie zimu aj nočnú zmenu.",
    "menu.garlic_soup.name": "Cesnaková polievka",
    "menu.grandma_kulajda.desc": "Kôpor, huby, stratené vajce — a tajná prísada z Lídinej kuchárskej knihy.",
    "menu.grandma_kulajda.name": "Babkina kulajda",
    "menu.hot_chocolate.desc": "Hustá ako noc. Niekedy sa platí pesničkou.",
    "menu.hot_chocolate.name": "Horúca čokoláda",
    "menu.kolac.desc": "Tvaroh a mak, ešte teplý z rúry.",
    "menu.kolac.name": "Koláčik",
    "menu.lemon_tea.desc": "Dva cukry, ak ste ten pán pri okne.",
    "menu.lemon_tea.name": "Čaj s citrónom",
    "menu.medovnik.desc": "Dvanásť plátov a trpezlivosť.",
    "menu.medovnik.name": "Medovník",
    "menu.night_train.desc": "Dvojité espresso, hrianka a koláčik na cestu. Pre tých, čo idú ďalej.",
    "menu.night_train.name": "Nočný vlak",
    "menu.oat_flat_white.desc": "Pre dronárov a všetkých, čo si myslia, že krava spí.",
    "menu.oat_flat_white.name": "Ovsené flat white",
    "menu.svarak.desc": "Klinček, pomaranč a zahriate ruky.",
    "menu.svarak.name": "Varené víno",
    "menu.topinka.desc": "Na masti, ako sa patrí. Mirkova klasika.",
    "menu.topinka.name": "Hrianka s cesnakom",
    "menu.varenyky.desc": "So zemiakmi a opraženou cibuľkou, podľa Olehovej mamy.",
    "menu.varenyky.name": "Vareniky",
    "note.note_01.text": "Svetlo v okne nezhasínať do šiestej. Nie je to povera. Je to sľub.",
    "note.note_01.where": "Pod pokladňou",
    "note.note_02.text": "Mirek: čiernu, hrianku. Hana: cappuccino, rýchlo! Věra: čaj, koláčik, a nehádať sa. Pán pri okne: čaj s citrónom, dva cukry. Nebrať od neho peniaze.",
    "note.note_02.where": "V skrinke za pultom, keď je všade čisto",
    "note.note_03.text": "Keď zhasne svetlo, ľudia hovoria pravdu. Sviečky drž v suchu.",
    "note.note_03.where": "V poistkovej skrini",
    "note.note_04.text": "Tým, čo liečia, nalievaj bez radu.",
    "note.note_04.where": "Pod vankúšom kresla",
    "note.note_05.text": "Kulajda: kôpor, huby, stratené vajce a lyžička octu z fľaše, ktorú mi dal J. Věra vie viac, než hovorí.",
    "note.note_05.where": "V kuchárskej knihe, ktorú mala Věra",
    "note.note_06.text": "Platí vždy mincami, ktoré už nie sú. Neberiem od neho peniaze.",
    "note.note_06.where": "Medzi mincami z okenného stola",
    "note.note_07.text": "M. sa na mňa pozerá, akoby bol vinný. Odpustila som mu dávno — nech je to čokoľvek.",
    "note.note_07.where": "Na zadnej strane starého účtu",
    "note.note_08.text": "3:33. Na nástupište som prišla o dve minúty neskoro. Celý život o dve minúty.",
    "note.note_08.where": "V starom cestovnom poriadku od Radka",
    "note.note_09.text": "Ak zase príde, povedz mu, že som čakala. Nie kvôli sebe. Kvôli svetlu.",
    "note.note_09.where": "Vnútri opraveného rádia",
    "note.note_10.text": "Kaviareň nie sú steny. Sú to tí, čo chodia. Nepredávaj ich.",
    "note.note_10.where": "Za fotkou na stene, keď má kaviareň dobré meno",
    "regular.filip.bio": "Filip Kadlec, 22, študent priemyslovky. Celú noc pri zásuvke s notebookom, každú hodinu čiernu. Platí málo, zostáva dlho.",
    "regular.filip.line.0a": "Je tu niekde zásuvka? Prosím. Mám dve percentá.",
    "regular.filip.line.0b": "Ešte jednu čiernu. Entropia rastie.",
    "regular.filip.line.1a": "Chalani z ročníka sa pýtali, kde sa dá učiť v noci. Povedal som im to. Prepáčte.",
    "regular.filip.line.2a": "…",
    "regular.filip.line.3a": "Opravný termín v piatok. Držte mi palce.",
    "regular.filip.line.4a": "Za dva! Za dva!",
    "regular.filip.name": "Filip",
    "regular.guest_333.bio": "Prichádza presne o 3:33, odchádza o 3:50. Čaj s citrónom, dva cukry. Platí mincami, ktoré už nie sú peniazmi.",
    "regular.guest_333.line.0a": "…",
    "regular.guest_333.line.1a": "Vy si ich nechajte. Ja ich už nepotrebujem.",
    "regular.guest_333.line.2a": "Stále svieti. To je dobre.",
    "regular.guest_333.line.3a": "Raz som odišiel. Vrátiť som sa nestihol.",
    "regular.guest_333.line.4a": "Dnes zastaví. Cítim to.",
    "regular.guest_333.name": "Pán v sivom kabáte",
    "regular.guest_anwar.ambient.busy": "Dnes je tu živo. Budem potichu.",
    "regular.guest_anwar.ambient.coffee": "Dobré flat white. Nehovorte ovsu, že to nie je mlieko.",
    "regular.guest_anwar.ambient.fog": "Koľaje nie je vidieť. Len svetlo z vášho okna.",
    "regular.guest_anwar.ambient.late": "Druhá ráno je tá najúprimnejšia hodina.",
    "regular.guest_anwar.ambient.midnight": "Polnoc? Kurzoru je to jedno.",
    "regular.guest_anwar.ambient.quiet": "Pokojná noc. Tá najlepšia.",
    "regular.guest_anwar.ambient.rain": "Mám rád, keď za mňa hovorí dážď.",
    "regular.guest_anwar.ambient.train": "Každý vlak znie, akoby šiel niekam, kde je lepšie.",
    "regular.guest_anwar.bio": "Tichý hosť, okolo tridsiatky. Sadne si k zásuvke, pracuje na notebooku, objedná ovsené flat white a okolo druhej odchádza.",
    "regular.guest_anwar.name": "Anwar",
    "regular.hana.bio": "Hana Janoušková, 38, nočná sestra z okresnej nemocnice. Prestávka o druhej, polievka po zmene. Vždy sa ponáhľa.",
    "regular.hana.line.0a": "Cappuccino, prosím. Rýchlo, mám šesť minút.",
    "regular.hana.line.0b": "…",
    "regular.hana.line.1a": "Dnes tri príjmy a jeden pôrod. Dievčatko. Volá sa Lída, verili by ste?",
    "regular.hana.line.2a": "Len na chvíľku zavriem oči…",
    "regular.hana.line.3a": "Z Drážďan zase písali. Platia dvakrát toľko. A tu… tu poznám každého.",
    "regular.hana.line.4a": "Rozhodla som sa. Už naozaj.",
    "regular.hana.name": "Hana",
    "regular.lori.bio": "Loreta „Lori\" Benešová, 27, pouličná muzikantka. Hrá na nástupišti v daždi. Platí pesničkou.",
    "regular.lori.line.0a": "Prší. Akustika nástupišťa je najlepšia v Mlhove.",
    "regular.lori.line.1a": "Jedna pre pani s krížovkou. Tá sa mračí najkrajšie.",
    "regular.lori.line.2a": "Pódium! Skutočné! No, skoro.",
    "regular.lori.line.3a": "V piatok hrám. Povedz to všetkým.",
    "regular.lori.name": "Lori",
    "regular.mirek.bio": "Miroslav Dvořák, 80. Posledný taxikár v Mlhove, ktorý ešte šoféruje sám. Každú noc čiernu a hrianku. Platí presne, prepitné nedáva.",
    "regular.mirek.line.0a": "Tu to bývalo plné až do rána. Za Lídy.",
    "regular.mirek.line.0b": "Roboty jazdia lepšie. Ale nevedia, kde predávajú najlepšiu hrianku.",
    "regular.mirek.line.1a": "Nalej mi ako Líde. Ona to vedela… nič.",
    "regular.mirek.line.2a": "Tá tabuľa má malé písmo. Za to moje oči nemôžu.",
    "regular.mirek.line.3a": "Dnes som prišiel pešo. Je to krajšie, ako som myslel.",
    "regular.mirek.line.4a": "Dvadsať gramov. A celý život.",
    "regular.mirek.line.5a": "Ešte pár nocí. Potom to už musím rozhodnúť.",
    "regular.mirek.name": "Mirek",
    "regular.radek.bio": "Radek Macek, 52, výpravca. Dvakrát za noc „na päť minút\", o jednej a o pol piatej. Káva so sebou, hneď.",
    "regular.radek.line.0a": "Tri minúty. Vlak nepočká. Teda, on by počkal, ale počítač nie.",
    "regular.radek.line.1a": "Dám vedieť, keby mal rýchlik meškanie. Kvôli vašim zásobám.",
    "regular.radek.line.2a": "Posledná služba. Zvláštny pocit.",
    "regular.radek.line.3a": "Viete, ako sa v osemdesiatom piatom zasekol rýchlik v závejoch? Sadnite si.",
    "regular.radek.name": "Radek",
    "regular.vera.bio": "Věra Soukupová, 83, vdova, Lídina spolužiačka aj súperka. Od pol jednej do tretej lúšti krížovky. Na špinavý stôl je prísna.",
    "regular.vera.line.0a": "Lída by to takto neurobila.",
    "regular.vera.line.0b": "Osem písmen, „ten, kto čaká\". Hm.",
    "regular.vera.line.1a": "Poďte sem, mladí. „Nočný vták, päť písmen.\" Nie, Mirek to nie je.",
    "regular.vera.line.2a": "Ten stôl je čistý. Lída by bola… no, spokojná.",
    "regular.vera.line.3a": "Ešte tanier kulajdy. Pre spomienku.",
    "regular.vera.line.4a": "Zajtra privediem kamarátky. Priprav sa.",
    "regular.vera.name": "Pani Věra",
    "sandbox.character.calm.desc": "2–4 udalosti za noc, občas väčšia. Po zlej noci príde pokojná.",
    "sandbox.character.calm.name": "Pokojné",
    "sandbox.character.changeable.desc": "3–5 udalostí za noc. Raz pokoj, raz fofr.",
    "sandbox.character.changeable.name": "Premenlivé",
    "sandbox.character.chaotic.desc": "5–8 udalostí za noc, bez oddychu. Pre otrlé nočné vtáky.",
    "sandbox.character.chaotic.name": "Chaotické",
    "sandbox.character.quiet.desc": "1–3 udalosti za noc, skoro žiadne veľké. Na oddych.",
    "sandbox.character.quiet.name": "Tiché",
    "sandbox.character.stormy.desc": "4–6 udalostí za noc, problémy chodia v pároch.",
    "sandbox.character.stormy.name": "Búrlivé",
    "sandbox.institution.college": "Vysoká škola a internáty",
    "sandbox.institution.culture_house": "Kultúrny dom",
    "sandbox.institution.depot": "Logistické depo",
    "sandbox.institution.drone_hub": "Dronový uzol",
    "sandbox.institution.highway": "Diaľničné odpočívadlo",
    "sandbox.institution.hospital": "Nemocnica",
    "sandbox.institution.police": "Polícia a hasiči",
    "sandbox.institution.taxi_rank": "Stanovisko taxi",
    "scene.act2.01": "Týždeň. Šálky ti v rukách prestali cinkať.",
    "scene.act2.02": "Mesto si začína hovoriť: okno pri stanici zase svieti.",
    "scene.act2.03": "Tvoj rozpis videli ďalší uchádzači. Nočné smeny chcú traja noví ľudia.",
    "scene.act2.04": "Kto preboha chce nočné smeny?",
    "scene.act2.05": "Tí, čo nemôžu spať. Tí, čo šetria. Tí, čo pred niečím utekajú. To obvyklé.",
    "scene.act4_storm.01": "Od Frýdlantu cez kopce prichádza búrka.",
    "scene.act4_storm.02": "O 22:30 zhasnú svetlá na stanici, potom lampy v uliciach, potom celé mesto.",
    "scene.act4_storm.03": "Svieti len jedno okno. Babkina lampa ide na batériu staršiu ako ty.",
    "scene.act4_storm.04": "Takže preto, babka.",
    "scene.act4_storm.05": "Dvere sa otvárajú a zatvárajú. Prichádza každý, kto nespí.",
    "scene.answer.01": "Svitá. Muž v sivom kabáte stále sedí pri okne. Pred ním leží otvorený babkin list.",
    "scene.answer.02": "Číta ho dvakrát. Druhý raz sa mu hýbu pery.",
    "scene.answer.03": "„Počkám. Svetlo v okne bude svietiť.\"",
    "scene.answer.04": "Takže čakala.",
    "scene.answer.05": "Šesťdesiat rokov som si myslel, že nikto. Šesťdesiat rokov som sa chodil presvedčiť.",
    "scene.answer.06": "Ďakujem, Mirko. Lepšie neskoro ako v daždi.",
    "scene.answer.07": "Odpusť mi.",
    "scene.answer.08": "Už sa stalo. Ona skôr — prečítaj si to dole.",
    "scene.answer.09": "Ďakujem, že ste ho nechali svietiť.",
    "scene.answer.10": "Vyjde na nástupište. Vlak ho odvezie bez zvuku.",
    "scene.answer.11": "Na sekundu ukáže tabuľa: Rn 333 — ODJEL. Potom už neukazuje nič.",
    "scene.answer.12": "V to ráno Mirek prvý raz za šesťdesiat rokov prespí až do obeda.",
    "scene.anwar_talk_24.01": "Je skoro hotová. Tá hra.",
    "scene.anwar_talk_24.02": "Viete, písal som ju tu. Dážď, lampu v okne, vlaky. Vďaka za tú atmosféru.",
    "scene.anwar_talk_24.03": "Nič zvláštne sme nerobili.",
    "scene.anwar_talk_24.04": "Práve to som potreboval.",
    "scene.anwar_talk_24.05": "Zaklapne notebook, nechá pri šálke presne odpočítané peniaze a zapne si kabát.",
    "scene.anwar_talk_24.06": "Posledný vlak. Dobrú noc — a nech to svetlo svieti.",
    "scene.anwar_talk_9.01": "Muž pri zásuvke zdvihne oči od notebooku, akoby ho prekvapilo, že si ho niekto všimol.",
    "scene.anwar_talk_9.02": "Prepáčte, trochu som sa zamotal. Robím malú hru. O nočnej kaviarni v daždi.",
    "scene.anwar_talk_9.03": "Nič v nej nevybuchuje. Ľudia prídu, vypijú niečo teplé a idú ďalej.",
    "scene.anwar_talk_9.04": "Stále rozmýšľam, či by vôbec niekto hral niečo také tiché.",
    "scene.anwar_talk_9.05": "Niekto presne toto potrebuje.",
    "scene.anwar_talk_9.06": "Možno. …Tak ešte jedno flat white. Na prieskum.",
    "scene.ending_last_train.01": "Nový nápis príde vlakom o 5:20 z Frýdlantu: NONSTOP 24, písmenami, ktoré nikdy nespia.",
    "scene.ending_last_train.02": "Dlh vyrovnaný, zmluva podpísaná. Gratulujem, vedenie! Odteraz máme otvorené nonstop.",
    "scene.ending_last_train.03": "Lampa z okna musí preč, aby sa tam zmestila reklamná obrazovka. Už na ňu nikto nebude musieť čakať. Proste bude svietiť stále.",
    "scene.ending_last_train.04": "Je mi ľúto. Čísla nevyšli. Nájom dnes ráno končí.",
    "scene.ending_last_train.05": "Posledná noc U Výhybky. Žiadny koniec hry. Len koniec jednej dlhej zmeny.",
    "scene.ending_last_train.06": "Ale oni prídu. Jeden po druhom, pred svitaním, bez pozvania.",
    "scene.ending_last_train.07": "Daj sem tú škatuľu. Bališ šálky zle. Lída ich balila tiež zle.",
    "scene.ending_last_train.08": "Odprevadím ťa na vlak. Pešo. Jana mi zobrala kľúče.",
    "scene.ending_last_train.09": "Otvor si niečo svoje. Kdekoľvek. Nájdem to — kávu nájdem vždy.",
    "scene.ending_last_train.10": "Napíšem o tebe pesničku. Smutnú, ale s dobrým refrénom.",
    "scene.ending_last_train.11": "Pošlem ti adresu, keď budem mať vlastný byt. So zásuvkou pri stole. Na tvoju počesť.",
    "scene.ending_last_train.12": "Vlak o 6:12 do Berouna. Kontroloval som to. Ide načas. Jasné, že ide, už ho neriadim ja.",
    "scene.ending_last_train.13": "Štamgasti prídu na poslednú kávu. Pár slov, pár podaní rúk. Mlhov nie je mesto veľkých lúčení.",
    "scene.ending_last_train.14": "Vezmeš si babkinu kuchársku knihu, fotku zo steny a kľúč, ktorý ležal pod rohožkou.",
    "scene.ending_last_train.15": "Prepáč, babka. Svietilo to, kým sa dalo.",
    "scene.ending_last_train.16": "Tomu, kto drží svetlo: svetlo nie je budova. Vezmi si ho so sebou.",
    "scene.ending_last_train.17": "Vlak o 6:12 odchádza do Berouna. Za oknom sa zmenšuje stanica, potom mesto, potom hmla.",
    "scene.ending_last_train.18": "Niekde na trati — Frýdlant, Ejpovice, Děčín — sú mestá, ktoré v noci nespia. A ľudia, ktorí by prišli, keby niekde svietilo okno.",
    "scene.ending_last_train.19": "Tridsať nocí. Dosť na to, aby sa to človek naučil.",
    "scene.ending_light.01": "06:00. Tridsiata noc sa skončila.",
    "scene.ending_light.02": "Posledná splátka prišla o 5:59. Deväťdesiat tisíc. Ja… pripravím novú nájomnú zmluvu.",
    "scene.ending_light.03": "Nie všetko prišlo načas. Ale mesto mi o tejto kaviarni napísalo štyridsaťdva správ. Štyridsaťdva. Nájom predĺžim — pod podmienkou, že ich zastavíte.",
    "scene.ending_light.04": "A to svetlo v okne… nechajte ho. Hodí sa k stanici.",
    "scene.ending_light.05": "Teraz ma vozí Jana. Pomaly. Šoféruje ako jej mama.",
    "scene.ending_light.06": "Drážďanom som povedala nie. O druhej som späť — nechajte mi kreslo voľné.",
    "scene.ending_light.07": "Priviedla som tri kamarátky. Sťažujú sa ešte viac ako ja. Zamilujete si ich.",
    "scene.ending_light.08": "Budúci semester zase beriem ten stôl v rohu. Rezervácia. Pod zásuvkou.",
    "scene.ending_light.09": "Dôchodcovia potrebujú miesto, kde rozprávať historky. Boli ste varovaní.",
    "scene.ending_light.10": "Piatky. Moja gitara. Vaša čokoláda. Platí?",
    "scene.ending_light.11": "Lída by povedala, že je to celé zle. A potom by si sadla a zostala.",
    "scene.ending_light.12": "Niekto postaví na čaj. Niekto iný začne umývať šálky bez toho, aby ho niekto žiadal. O šiestej ráno je kaviareň plná a nikomu sa nechce domov.",
    "scene.ending_light.13": "V kaviarni je ticho. Pár šálok, pár stoličiek. Svetlo svieti — a zatiaľ nie je na koho čakať. Ale noc je dlhá a mesto malé.",
    "scene.ending_light.14": "Prídeš k oknu. Vonku sa Mlhov prebúdza: prvá samoriadená električka, dron s chlebom, líška na ceste domov.",
    "scene.ending_light.15": "Kaviareň nie sú steny. Sú to tí, čo chodia. Nepredávaj ich.",
    "scene.ending_light.16": "Nepredám, babka.",
    "scene.ending_light.17": "Presne o šiestej zhasneš svetlo v okne. Prvý raz ako ten, komu to tu patrí. A zajtra o desiatej večer ho zase rozsvietiš.",
    "scene.filip_cake.01": "Spravil som to! Termodynamika za dva. Priniesol som tortu. Je trochu pomačkaná, išiel som dronobusom.",
    "scene.filip_cake.02": "Vďaka, že ste ma nikdy nevyhodili od toho stola so zásuvkou. Polovica môjho štúdia sa odohrala na ňom.",
    "scene.filip_exam.01": "Filip dnes ani neotvoril notebook. Pozerá do vychladnutej kávy.",
    "scene.filip_exam.02": "Neprešiel som. Termodynamika, tretí pokus. Otec hovorí, nech idem radšej do depa k dronom ako normálny človek.",
    "scene.filip_exam.03": "Poslať k nemu niekoho láskavého, nech si prisadne",
    "scene.filip_exam.04": "Priniesť mu čerstvú kávu na účet podniku",
    "scene.filip_exam.05": "Nezasahovať",
    "scene.filip_exam.06": "…Ešte jeden pokus. Fajn. Ale ak zase neprejdem, napíšem kaviareň do ospravedlnenky.",
    "scene.final_night.01": "Tridsiata noc. Posledná splátka je splatná o šiestej.",
    "scene.final_night.02": "Rozpis na dnes: všetci. Nikto nechcel výmenu zmeny. Nikto nechcel voľno.",
    "scene.final_night.03": "Tak nech svieti.",
    "scene.franchise_decision.01": "Tak čo? Zmluvu máte v schránke Shiftelly. Jedno ťuknutie.",
    "scene.franchise_decision.02": "Na stene babkina fotka. V okne lampa. Vonku spí mesto — okrem ľudí, ktorí chodia sem.",
    "scene.franchise_decision.03": "Podpísať. Dlh zmizne, kaviareň bude NONSTOP 24.",
    "scene.franchise_decision.04": "Odmietnuť. U Výhybky zostane U Výhybky.",
    "scene.franchise_decision.05": "Výborne! Zajtra príde tím s novým nápisom. To osvetlenie si zamilujete.",
    "scene.franchise_decision.06": "…Určite.",
    "scene.franchise_decision.07": "Škoda. Sentiment je drahý, viete.",
    "scene.franchise_decision.08": "Káva tiež. A zvládame to.",
    "scene.franchise_visit.01": "Deň sedemnásť. Kde zvyčajne parkuje Mirek, zastaví strieborné auto bez vodiča.",
    "scene.franchise_visit.02": "Petr Šindelář, NONSTOP 24. Krásny podnik. Hrozná otváracia doba.",
    "scene.franchise_visit.03": "Ponuka: zaplatíme celý dlh. Vy zostanete ako vedúci. Otvorené 24/7, naše menu, náš nápis. Všetko moderné.",
    "scene.franchise_visit.04": "A svetlo v okne?",
    "scene.franchise_visit.05": "U nás svetlá nezhasínajú nikdy! O to predsa ide.",
    "scene.franchise_visit.06": "Rozmyslite si to do dvadsiatej druhej noci. Naše ponuky na rozdiel od našich predajní nie sú otvorené večne.",
    "scene.franchise_visit.07": "Kalendár: „NONSTOP 24 — rozhodnutie\" pridané k noci 22.",
    "scene.guest333_first.01": "03:33. Sekundová ručička na nástenných hodinách sa zastaví.",
    "scene.guest333_first.02": "Rádio potichu zašumí, akoby ho niekto ďaleko ladil.",
    "scene.guest333_first.03": "Pri okne sedí muž v sivom kabáte. Dvere nikto nepočul.",
    "scene.guest333_first.04": "Čaj s citrónom, prosím. Dva cukry.",
    "scene.guest333_first.05": "Pije pomaly a pozerá na nástupište. Potom je preč — a na stole ležia tri mince, ktoré nie sú peniazmi dlhšie, ako žiješ.",
    "scene.guest333_first.06": "Československé koruny. Rok 1978.",
    "scene.guest333_first.07": "Hodiny opäť tikajú. 03:34.",
    "scene.guest333_question.01": "Hodiny zase stoja. Muž v sivom kabáte prvý raz zdvihne oči od nástupišťa.",
    "scene.guest333_question.02": "Ešte čaká?",
    "scene.guest333_question.03": "„Áno. Svetlo stále svieti.\"",
    "scene.guest333_question.04": "„Neviem.\"",
    "scene.guest333_question.05": "„Odišla. Túto jeseň.\"",
    "scene.guest333_question.06": "Dobre. Tak budem chodiť ďalej.",
    "scene.guest333_question.07": "Nikto nevie. To je na čakaní to najhoršie.",
    "scene.guest333_question.08": "…Odišla. A svetlo stále svieti.",
    "scene.guest333_question.09": "Tak ho niekto drží namiesto nej.",
    "scene.guest333_ticket.01": "Dnes nenechal mince. Na stole leží cestovný lístok: Rn 333, Mlhov 3:33, 14. novembra 1979. Spiatočný.",
    "scene.guest333_ticket.02": "Spiatočná polovica nikdy nebola použitá.",
    "scene.hana_asleep.01": "02:20. Hana zaspala nad cappuccinom, stále v nemocničnom.",
    "scene.hana_asleep.02": "Displej telefónu sa rozsvieti: „Prestávka končí 02:30.\" A znova: „Ponuka z kliniky v Drážďanoch — prosíme o odpoveď.\"",
    "scene.hana_asleep.03": "Opatrne ju zobudiť — prestávka jej končí",
    "scene.hana_asleep.04": "Prikryť ju dekou a nechať ju spať ešte desať minút",
    "scene.hana_asleep.05": "Presadiť ju do kresla pod lampou, do tichého kúta",
    "scene.hana_asleep.06": "Vďaka… Inak by som prespala celé oddelenie.",
    "scene.hana_asleep.07": "Takto som sa nevyspala mesiac. …Nehovor to hlavnej sestre.",
    "scene.hana_decision.01": "Rozhodla som sa. Kvôli Drážďanom.",
    "scene.hana_decision.02": "Zostávam. Drážďany platia lepšie. Mlhov má kreslo pod lampou, kde ma niekto nechá spať.",
    "scene.hana_decision.03": "Idem. Je to dobrá práca. …Vďaka za všetky kávy. Boli ste vždy rýchli.",
    "scene.last_333.01": "Prvý raz za šesťdesiat rokov zastaví o 3:33 vlak. Okná má teplé a prázdne.",
    "scene.last_333.02": "To je môj. Ešte čaj, prosím, kým pôjdem. Dva cukry.",
    "scene.last_333.03": "Položiť vedľa šálky Lídin list",
    "scene.last_333.04": "Nechať list vo vrecku",
    "scene.last_333.05": "Jindřich.",
    "scene.last_333.06": "Mirko. Zostarol si.",
    "scene.last_333.07": "Ty nie.",
    "scene.last_333.08": "Mirek položí list na stôl. Oboma rukami, akoby bol ťažký.",
    "scene.last_333.09": "List zatiaľ neotvorí. Len naň položí dlaň.",
    "scene.last_333.10": "Počkám do rána. Rád by som videl, ako vyzerá mesto, keď svieti.",
    "scene.last_333.11": "Ani dnes nič. To nevadí. Som zvyknutý.",
    "scene.last_333.12": "Vlak ho odvezie bez zvuku.",
    "scene.lori_evening.01": "Dážď na oknách. Všetky stoličky obsadené. Lori na malom pódiu ladí gitaru.",
    "scene.lori_evening.02": "Táto je pre kaviareň, ktorá ma pustila dnu z dažďa.",
    "scene.lori_evening.03": "Tri pesničky si nikto nič neobjedná. Potom si všetci objednajú všetko.",
    "scene.lori_platform.01": "Na prázdnom nástupišti pod kvapkajúcim prístreškom niekto hrá na gitare. Rozladenej, ale spieva krásne.",
    "scene.lori_platform.02": "Neboj sa, nehrám pre vlaky. Tie prepitné nedávajú.",
    "scene.lori_platform.03": "Nemáte… horúcu čokoládu? Zaplatiť nemôžem. Ale môžem zahrať.",
    "scene.lori_platform.04": "Poď ďalej, je tu teplo",
    "scene.lori_platform.05": "Prepáč, dnes nie",
    "scene.lori_platform.06": "Pesnička za čokoládu. Poctivý obchod.",
    "scene.lori_platform.07": "Jasné. Chápem. Pekná noc.",
    "scene.mirek_confession.01": "Musím ti niečo povedať. Nosím to šesťdesiat rokov. Váži to asi dvadsať gramov.",
    "scene.mirek_confession.02": "Z náprsného vrecka vytiahne obálku. Zažltnutú. Zalepenú. Lídiným písmom: „Jindřichovi.\"",
    "scene.mirek_confession.03": "November sedemdesiatdeväť. Jindřich odchádzal nočným, tým Rn 333. Pohádali sa. Ona napísala toto a poprosila ma, aby som mu to dobehol dať na nástupište.",
    "scene.mirek_confession.04": "Mal som dvadsať a bol som do nej blázon. Stál som v daždi a pozeral, ako vlak odchádza. A nechal som si to.",
    "scene.mirek_confession.05": "Už sa nevrátil. Ona nikdy neprestala čakať. A ja som sem chodil každú noc na kávu a nepovedal ani slovo.",
    "scene.mirek_confession.06": "Každú noc. Šesťdesiat rokov.",
    "scene.mirek_confession.07": "Čiernu, ako robila Lída. Áno. Každú noc.",
    "scene.mirek_curb.01": "Vonku zaškrípe plech. Mirkovo staré auto pobozkalo obrubník pri vchode.",
    "scene.mirek_curb.02": "Obrubník sa pohol. V noci ich presúvajú, vieš. Radnica.",
    "scene.mirek_curb.03": "Dlho žmúri na tabuľu s menu. Priveľmi dlho.",
    "scene.mirek_curb.04": "Tie písmenká na tabuli sa od Lídiných čias nejako zmenšili.",
    "scene.mirek_curb.05": "Zväčšiť písmo na tabuli (−300 Kč)",
    "scene.mirek_curb.06": "Prečítať mu menu nahlas",
    "scene.mirek_curb.07": "Nič nehovoriť",
    "scene.mirek_curb.08": "Čiernu. Ako vždy. Aspoň niečo sa nemení.",
    "scene.mirek_first.01": "Zvonček pri dverách. Starý pán v čiapke otrasie dážď z pliec. Podľa kľúčov taxikár.",
    "scene.mirek_first.02": "Tak zase svieti. Myslel som, že už vidím strašidlá.",
    "scene.mirek_first.03": "Čiernu. Ako robila Lída — aby v nej stála lyžička.",
    "scene.mirek_first.04": "Skúsim to. Som jej vnúča.",
    "scene.mirek_first.05": "…Máš jej oči. Pane Bože. Nuž. Tak kávu. A hrianku, ak sporák ešte žije.",
    "scene.mirek_first.06": "Prijmi objednávku, uvar kávu na kávovare a vyber peniaze pri pokladni.",
    "scene.mirek_letter.01": "Povedz mi, čo s ním. Mal som šesťdesiat rokov a stále to neviem.",
    "scene.mirek_letter.02": "„Dajte mi ho. Schovám ho.\"",
    "scene.mirek_letter.03": "„Nechajte si ho. Je to vaše bremeno.\"",
    "scene.mirek_letter.04": "„Spáľte ho. Nech má pokoj.\"",
    "scene.mirek_letter.05": "„Dajte mu ho sám. Tridsiatu noc, o 3:33.\"",
    "scene.mirek_letter.06": "Sám? …Keď mu ho dám sám — uvidí ma?",
    "scene.mirek_letter.07": "Vidí každého, kto čaká.",
    "scene.mirek_letter.08": "Obálka sa v peci skrúti. Mirek sa pozerá, kým z nej nič nezostane.",
    "scene.mirek_letter.09": "Svetlo. Nič iné to nikdy nebolo.",
    "scene.mirek_pedestrian.01": "Brzdy. Výkrik. Mirkovo auto zastaví na dlaň od sestričky, ktorá prechádzala k nemocnici.",
    "scene.mirek_pedestrian.02": "Nikomu sa nič nestalo. Mirek sedí pri bare s roztrasenými rukami a na kávu nesiahne.",
    "scene.mirek_pedestrian.03": "Nevidel som ju. Tie svetlá, ten dážď… Ja som ju nevidel.",
    "scene.mirek_pedestrian.04": "Nepozeraj tak na mňa. Taxík je všetko, čo mi zostalo. Zvyšok mesta si zobrali roboty.",
    "scene.mirek_pedestrian.05": "Požiadať ho o kľúče od auta",
    "scene.mirek_pedestrian.06": "Zavolať jeho dcére Jane",
    "scene.mirek_pedestrian.07": "Mlčať",
    "scene.mirek_pedestrian.08": "…Lída by urobila to isté. Len by najprv kričala.",
    "scene.mirek_pedestrian.09": "Oci? Už idem. Nech ťa ani nenapadne sadnúť za volant.",
    "scene.mirek_pedestrian.10": "Vlastná dcéra. Ako na chlapca zo školy.",
    "scene.mirek_pedestrian.11": "Mirek dopije, zaplatí presne a odíde. Zadné svetlá sa rozmažú v daždi.",
    "scene.opening.01": "Mlhov nad Šeřavou, jeseň 2039. Deväťtisíc ľudí, jedna rieka a poriadne veľa hmly.",
    "scene.opening.02": "Vážení cestujúci, osobný vlak Os 2141 z Adamova prišiel k prvému nástupišťu. Ďakujeme, že cestujete v noci.",
    "scene.opening.03": "Vlak sa potichu rozbehne do tmy sám — rušňovodiča už roky nepotrebuje. Na nástupišti zostane jeden kufor a jeden človek: ty.",
    "scene.opening.04": "Naposledy, čo si pamätám, mi ten pult siahal po nos.",
    "scene.opening.05": "Vedľa stanice jedno tmavé okno. Nad ním holografický nápis s prasknutým písmenom: U VÝHYBKY.",
    "scene.opening.06": "Vo vrecku máš list od notára. A ešte jeden, písaný rukou. Na obálke: „Tomu, kto bude držať svetlo.\"",
    "scene.opening.07": "Ak toto čítaš, kávovar ma prežil. Správaj sa k nemu pekne. Hryzie.",
    "scene.opening.08": "Kľúč je pod rohožkou. Samozrejme. V Mlhove rohožky nikto nekradne.",
    "scene.opening.09": "Nebudem ti klamať: sú tu dlhy. Deväťdesiat tisíc. Majiteľ budovy ti dá tridsať nocí.",
    "scene.opening.10": "Otvára sa o desiatej večer, zatvára o šiestej ráno. A svetlo v okne svieti až do šiestej. Vždy.",
    "scene.opening.11": "Prečo, to ti do listu nenapíšem. Prídeš na to. Tvoja Lída.",
    "scene.opening.12": "Prach. Stoličky na stoloch. Na stene fotka babky — smeje sa na niekom mimo záberu.",
    "scene.opening.13": "Tak dobre, babka. Tridsať nocí.",
    "scene.opening.14": "Rozsvietiš lampu v okne. Kdesi za koľajami sa zastaví líška a pozerá.",
    "scene.payment_1.01": "Ráno. Prvá splátka odchádza s vlakom o 6:12 do Berouna.",
    "scene.payment_1.02": "Platba prišla. Úprimne? Nečakal som to.",
    "scene.payment_1.03": "Platba neprišla celá. Nebudem robiť scény. Zatiaľ.",
    "scene.payment_1.04": "A ešte niečo: nájom končí po tridsiatej noci. Predĺžim ho, len ak bude dlh splatený. Nič osobné. Aritmetika.",
    "scene.payment_1.05": "Tak budeme počítať.",
    "scene.payment_2.01": "Druhá splátka je tu. Začínam si zvykať. To je nebezpečné.",
    "scene.payment_2.02": "Zase chýbajú peniaze. Kaviareň je však nejako plná. To nechápem.",
    "scene.payment_2.03": "Polovica cesty k tridsiatej noci.",
    "scene.payment_3.01": "Tretia splátka. Viete, že mi o vás píšu ľudia? Normálne mi ľudia píšu len kvôli plesni.",
    "scene.payment_3.02": "Tretia splátka zase nesedí. Ale aspoň mi píšu, že máte dobrú polievku.",
    "scene.payment_4.01": "Štvrtá splátka. Zostáva posledná — tridsaťtisíc. Držím vám palce. Nehovorte to nikomu.",
    "scene.payment_4.02": "Štvrtá splátka chýba. Zostáva posledná noc. Ukážte mi zázrak, alebo aspoň kalkulačku.",
    "scene.radek_last_shift.01": "Posledná služba. Od zajtra sa stanica riadi sama.",
    "scene.radek_last_shift.02": "Niečo som ti priniesol. Starý cestovný poriadok z dopravnej kancelárie. Rok 1979. Mal som ho dať do skartovačky.",
    "scene.radek_last_shift.03": "Pozri na posledný riadok. Niekto k nemu ceruzkou pripísal: „dve minúty\".",
    "scene.radek_news.01": "Čiernu so sebou. Mám štyri minúty.",
    "scene.radek_news.02": "Stanicu prevádzajú na automat. O dva týždne som posledný výpravca v Mlhove — potom už len počítač a hmla.",
    "scene.radek_news.03": "Zvláštne. Na starom cestovnom poriadku na stene stále visí Rn 333. Príchod 3:33. Zrušený v sedemdesiatom deviatom a nikto ho nikdy nezvesil.",
    "scene.radek_news.04": "Rn 333?",
    "scene.radek_news.05": "Dnes nočný vlak odnikiaľ nikam. Spýtaj sa pamätníkov. Alebo radšej nie.",
    "scene.vera_first.01": "Tak ty si to vnúča. Lídino.",
    "scene.vera_first.02": "Čaj s citrónom. A utri ten stôl. Lída by ho takto nikdy nenechala.",
    "scene.vera_first.03": "Robím, čo môžem.",
    "scene.vera_first.04": "Každý robí, čo môže. Lída mohla viac.",
    "scene.vera_first.05": "Otvorí krížovku a už nezdvihne zrak. Ale zostane až do tretej.",
    "scene.vera_jindrich.01": "Prvý sneh. Lída ho milovala. Sadni si, porozprávam ti o Jindřichovi.",
    "scene.vera_jindrich.02": "Opravoval rádiá. Vysoký, plachý, tancoval príšerne. Vybrala si ho pred polovicou mesta. Aj pred Mirkom.",
    "scene.vera_jindrich.03": "Tú noc, čo odchádzal za prácou do Ostravy, sa pohádali. Pre hlúposť — peniaze a pýcha. Povedala, že mu napíše.",
    "scene.vera_jindrich.04": "On čakal na list, ktorý neprišiel. Ona čakala na muža, ktorý sa nevrátil. A ja som sa pozerala na oboch a bola som príliš pyšná, aby som niečo povedala.",
    "scene.vera_jindrich.05": "Preto som sem chodila a sťažovala sa na stoly. Niekto jej musel robiť spoločnosť.",
    "scene.vera_recipe.01": "Tu. Lídina kuchárska kniha. Dala mi ju „schovať pred mastnotou\". V roku 1994.",
    "scene.vera_recipe.02": "Jej kulajda. Kôpor, huby, stratené vajce a ešte niečo, čo mi nikdy nepovedala. Možno to tam napísala.",
    "scene.vera_recipe.03": "Viem viac, než hovorím, dieťa. Ale dnes nie.",
    "scene.vera_tears.01": "…To je ona. Presne jej.",
    "scene.vera_tears.02": "Hádali sme sa o všetko. O chlapcov, o skúšky, kto má krajšie vlasy. Vždy som prehrala. Nevadilo mi to toľko, koľko som tvrdila.",
    "scene.vera_tears.03": "Věra potichu plače do polievky. Potom si pýta ďalší chlieb.",
    "staff.barista.bio": "Bára odišla z vysokej v Prahe a rodičom to nepovedala. Kávu robí lepšie ako diplomovku.",
    "staff.barista.dislikes": "Ticho, umývanie riadu",
    "staff.barista.likes": "Hudbu v sále, rozhovory s hosťami",
    "staff.barista.role": "Nočná baristka",
    "staff.cashier.bio": "Ivana pracuje v noci, kým dcéra spí u susedy. Jeden telefonát môže rozbiť celú zmenu.",
    "staff.cashier.dislikes": "Meškanie, chaos",
    "staff.cashier.likes": "Presnosť, keď ju niekto pochváli",
    "staff.cashier.role": "Pokladníčka a sála",
    "staff.cook.bio": "Pán Holub varil dvadsať rokov v závodnej jedálni sklárne. Lídu poznal a hundre, že „za nej to bolo inak\".",
    "staff.cook.dislikes": "Zhon, keď mu niekto siaha na veci",
    "staff.cook.likes": "Poriadok v kuchyni, vlastný nôž",
    "staff.cook.role": "Kuchár",
    "staff.porter.bio": "Kuba predtým ťahal debny v sklade. Je dobrý a všetko mu padá z rúk. Potajomky sa učí piecť.",
    "staff.porter.dislikes": "Hlasné hádky",
    "staff.porter.likes": "Zvieratá (mačky!), jedlo",
    "staff.porter.role": "Pomocník a upratovanie",
    "staff.quiet_one.bio": "Ema počuje húkanie vlakov, ktoré nie sú v cestovnom poriadku. Ako jediná si všimne, že o 3:33 stoja hodiny.",
    "staff.quiet_one.dislikes": "Dav, ostré svetlo",
    "staff.quiet_one.likes": "Dážď, tiché hodiny medzi druhou a štvrtou",
    "staff.quiet_one.role": "Všeumelec",
    "staff.server.bio": "Natália prišla z Košíc na týždeň a zostala. Nosí štyri taniere naraz a pamätá si každé meno.",
    "staff.server.dislikes": "Ulepené podlahy",
    "staff.server.likes": "Čisté stoly, daždivé noci",
    "staff.server.role": "Obsluha",
    "staff.sound_tech.bio": "Oleh bol zvukár vo Ľvove. „Dočasne\" tu pracuje už druhý rok. Vie opraviť staré rádio.",
    "staff.sound_tech.dislikes": "Lacnú kávu",
    "staff.sound_tech.likes": "Staré platne, rádio",
    "staff.sound_tech.role": "Bar a sála",
    "story.act.1.title": "Dejstvo I — Kľúče",
    "story.act.2.title": "Dejstvo II — Štamgasti",
    "story.act.3.title": "Dejstvo III — Ponuka",
    "story.act.4.title": "Dejstvo IV — Posledný vlak",
    "story.hint.app": "V Shiftelle nájdeš výmeny zmien, voľno, oznámenia a ranný prehľad.",
    "story.hint.armchair": "Kreslo a stojacia lampa vedľa seba tvoria tichý kút.",
    "story.hint.build": "V Stavbe (B) pridáš stoly, lampy a rastliny. Peniaze sa strhnú hneď, Ctrl+Z vracia.",
    "story.hint.candles": "Bez prúdu sa dajú predávať len studené jedlá. Sviečky hosťom zdvihnú náladu.",
    "story.hint.downpour": "Lejak! Hostí pribúda — postav niekoho na upratovanie.",
    "story.hint.farewell": "Posledné noci. Každý štamgast príde uzavrieť svoj príbeh.",
    "story.hint.first_order": "Klikni na hosťa pri pulte a potom na kávovar. Personál si zatiaľ ty.",
    "story.hint.hire": "Cez deň môžeš zamestnávať. Otvor Personál (C) a vyber kandidáta.",
    "story.hint.inspection": "Hygiena kontroluje špinu. Pod 30 % je pochvala, nad 60 % pokuta.",
    "story.hint.lori_night": "Lori je tu. Dnes hrá pre všetkých.",
    "story.hint.morning": "O šiestej sa kaviareň zatvára. Ráno uvidíš súhrn noci.",
    "story.hint.new_staff": "Na nočné zmeny sa hlásia ďalší ľudia. Pozri sa na kandidátov.",
    "story.hint.payment": "Dlh 90 000 Kč splácaš v nociach 7, 14, 21, 28 a 30. Prehľad nájdeš v aplikácii Shiftella.",
    "story.hint.priorities": "V Prioritách (P) určíš, kto čo robí prednostne. 1 je najdôležitejšia.",
    "story.hint.regulars": "Štamgasti majú svoje časy a obľúbené jedlá. Keď ich obslúžiš rýchlo, otvoria sa ti.",
    "story.hint.rush": "Nával! Daj Baru a Obsluhe najvyššiu prioritu.",
    "story.hint.schedule": "Rozpis zmien nájdeš v aplikácii Shiftella (T). Ťahom nakresli zmenu, Shift + ťah je prestávka.",
    "story.hint.special": "Nová špecialita: Nočný vlak. Pre tých, čo idú ďalej.",
    "story.hint.window_light": "Lampa v okne musí svietiť aj o 3:33.",
    "story.line.04_mirek": "O tretej je tu vždy čudné ticho. Lída hovorila, že to nič.",
    "story.line.06_filip": "Dobrý večer… je tu Wi-Fi? Alebo aspoň zásuvka?",
    "story.line.07_cook": "Za Lídy sa splátky tiež platili v nedeľu. Ráno. S nadávkami.",
    "story.line.11_ema": "Počujete to? Vlak. Na tabuli žiadny nie je.",
    "story.line.16_kuba": "Kocúr by sa tu páčil. Keby nejaký bol. Len hovorím.",
    "story.line.18_filip": "Nepýtajte sa. Prosím.",
    "story.line.22_vera": "Lída by bola hrdá. Nehovor jej… no, nehovor to nikomu.",
    "story.line.22_vera_sold": "Tak tu už len svieti. Nečaká.",
    "story.line.29_radek": "Na dôchodku sa spí hrozne. Tak som tu.",
    "story.night.01.hint": "Kľúč je pod rohožkou. Rozsvieť okno a uvar prvú kávu.",
    "story.night.01.title": "Príchod",
    "story.night.02.hint": "Najmi niekoho a zostav prvý rozpis.",
    "story.night.02.title": "Prvý kolega",
    "story.night.03.hint": "O druhej príde niekto, kto nemá čas čakať.",
    "story.night.03.title": "Dážď a sestra",
    "story.night.04.hint": "Nechaj v okne svietiť. Celú noc.",
    "story.night.04.title": "3:33",
    "story.night.05.hint": "Po polnoci príde niekto, kto Lídu poznal. Nech sú stoly čisté.",
    "story.night.05.title": "Pani s krížovkou",
    "story.night.06.hint": "Sobota. Okolo jedenástej skončí koncert v kultúrnom dome.",
    "story.night.06.title": "Po koncerte",
    "story.night.07.hint": "O šiestej ráno odchádza 15 000 Kč. Počítaj.",
    "story.night.07.title": "Prvá splátka",
    "story.night.08.hint": "Hlásia sa noví ľudia. A Mirek dnes parkuje nejako čudne.",
    "story.night.08.title": "Obrubník",
    "story.night.09.hint": "O jednej sa zastaví výpravca. Má štyri minúty.",
    "story.night.09.title": "Posledný výpravca",
    "story.night.10.hint": "Priprav sviečky. Len tak, pre istotu.",
    "story.night.10.title": "Tma",
    "story.night.11.hint": "Prší. Na nástupišti niekto hrá.",
    "story.night.11.title": "Pieseň na nástupišti",
    "story.night.12.hint": "Kreslo a lampa by sa dnes mohli hodiť.",
    "story.night.12.title": "Tichý kút",
    "story.night.13.hint": "Hygiena príde okolo pol dvanástej. Nech sa blyští.",
    "story.night.13.title": "Inšpekcia",
    "story.night.14.hint": "Druhá splátka. A Věra dnes niečo nesie.",
    "story.night.14.title": "Kuchárska kniha",
    "story.night.15.hint": "Hmla. O 3:33 sa ťa niekto na niečo opýta.",
    "story.night.15.title": "Otázka",
    "story.night.16.hint": "Nikto nepríde. Čas na upratovanie a na ľudí, čo tu pracujú.",
    "story.night.16.title": "Prázdna noc",
    "story.night.17.hint": "Príde návšteva zo siete NONSTOP 24. Počúvaj.",
    "story.night.17.title": "NONSTOP 24",
    "story.night.18.hint": "Filip dnes neotvoril notebook.",
    "story.night.18.title": "Opravák",
    "story.night.19.hint": "Bude liať. Hostí bude dvakrát toľko — a špiny tiež.",
    "story.night.19.title": "Lejak",
    "story.night.20.hint": "Mirek dnes príde neskoro. Buď pri dverách.",
    "story.night.20.title": "Na dlaň",
    "story.night.21.hint": "Ďalšia splátka o šiestej. Niekto chce dovolenku.",
    "story.night.21.title": "Tretia splátka",
    "story.night.22.hint": "Dnes sa rozhodne, čí bude nápis nad dverami.",
    "story.night.22.title": "Rozhodnutie",
    "story.night.23.hint": "Radek má poslednú službu.",
    "story.night.23.title": "Cestovný poriadok",
    "story.night.24.hint": "Prší. Ak má Lori pódium, dnes je jej večer.",
    "story.night.24.title": "Večer pre Lori",
    "story.night.25.hint": "Príde búrka. Nech okno svieti.",
    "story.night.25.title": "Búrka",
    "story.night.26.hint": "Hana sa rozhodla.",
    "story.night.26.title": "Drážďany",
    "story.night.27.hint": "Sneží. Věra chce rozprávať.",
    "story.night.27.title": "Prvý sneh",
    "story.night.28.hint": "Štvrtá splátka. A Mirek má otázku.",
    "story.night.28.title": "List",
    "story.night.29.hint": "Každý štamgast dnes príde uzavrieť svoj príbeh.",
    "story.night.29.title": "Rozlúčky",
    "story.night.30.hint": "Posledná noc. 30 000 Kč o šiestej. O 3:33 nech okno svieti.",
    "story.night.30.title": "Posledný vlak",
    "train.announce.arrival": "Vážení cestujúci, vlak {train} zo stanice {from} do stanice {to} prichádza o {time} k nástupišťu {platform}.",
    "train.announce.delay": "Vážení cestujúci, vlak {train} zo stanice {from} do stanice {to}, s pravidelným príchodom o {time} k nástupišťu {platform}, mešká. Ďakujeme za trpezlivosť.",
    "train.en_471.name": "EN 471 — nočný expres Cheb → Frýdlant",
    "train.nex_9002.name": "Nex 9002 — samoriadený nákladný",
    "train.os_2141.name": "Os 2141 — osobný z Adamova",
    "train.r_815.name": "R 815 — rýchlik Frýdlant → Beroun",
    "train.rn_333.name": "Rn 333 — v cestovnom poriadku od roku 1979 nie je",
    "trait.anxious.desc": "Bojí sa chyby, a keď je rad, robí ich. Pri pokladni je však dôkladný.",
    "trait.anxious.name": "Úzkostlivý",
    "trait.calm.desc": "Výpadok prúdu? Tak zapálime sviečky. Zlé správy na neho platia len napoly.",
    "trait.calm.name": "Pokojný",
    "trait.chatterbox.desc": "Vie všetko o všetkých hosťoch. Hostia ho milujú, len práca ide pomalšie, keď je pokoj.",
    "trait.chatterbox.name": "Vravný",
    "trait.clumsy.desc": "Ruky robia niečo iné, než mali v pláne. Občas cinkne riad.",
    "trait.clumsy.name": "Nemotorný",
    "trait.early_bird.desc": "Do polnoci je k nezastaveniu, po druhej ako v hmle.",
    "trait.early_bird.name": "Škovránok",
    "trait.grumpy.desc": "Bručí, ale remeslo ovláda. Trpezliví hostia majú jeho „pravý charakter\" radi.",
    "trait.grumpy.name": "Bručko",
    "trait.hard_worker.desc": "Neodíde, kým to nedokončí. Pri rade vynechá prestávku — a potom je na smrť unavený.",
    "trait.hard_worker.name": "Drina",
    "trait.kind.desc": "Uteší hosťa aj kolegu. Vedľa neho majú všetci o trochu lepšiu náladu.",
    "trait.kind.name": "Dobrák",
    "trait.lazy.desc": "Prestávka je posvätná. Pracuje pomalšie, ale ani sa toľko neunaví.",
    "trait.lazy.name": "Lenivec",
    "trait.light_sleeper.desc": "Počuje, čo ostatní nie. Všimne si hosťa o 3:33 a občas tuší, čo príde.",
    "trait.light_sleeper.name": "Ľahký spánok",
    "trait.loner.desc": "Najlepšie pracuje, keď ho nikto neruší. V dave kolegov mu klesá nálada.",
    "trait.loner.name": "Samotár",
    "trait.music_lover.desc": "Pracuje do rytmu. S hudbou kvitne, v tichu vädne — a rádio si pustí sám.",
    "trait.music_lover.name": "Meloman",
    "trait.neat.desc": "Neprejde okolo škvrny. Upratuje rýchlejšie a sám od seba.",
    "trait.neat.name": "Poriadkumilovný",
    "trait.night_owl.desc": "V noci ožíva, cez deň spí ako zabitý. Po polnoci sa unaví oveľa pomalšie.",
    "trait.night_owl.name": "Sova",
    "trait.perfectionist.desc": "Pomaly, ale dokonale. Lepšie prepitné — a zlá nálada zo špiny.",
    "trait.perfectionist.name": "Perfekcionista",
    "trait.romantic.desc": "Zaľúbi sa do kolegov aj do dažďa. Za daždivej noci je mu lepšie.",
    "trait.romantic.name": "Romantik",
