    "guest.patrol.name": "Nočná hliadka",
    "guest.patrol.one": "Patrol officer",
    "guest.shift_workers.desc": "Striedanie v logistickom depe. Chodia v skupinách, jedia veľa a zmeny majú v Shiftelle.",
    "guest.shift_workers.name": "Ľudia zo zmeny",
    "guest.shift_workers.one": "Shift worker",
