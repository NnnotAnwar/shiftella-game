    "experiment.close.swap": "So close — swap the {family} one.",
    "experiment.discovered": "Discovered! {recipe}",
    "experiment.known": "You know this one: {recipe}.",
    "experiment.nothing.1": "It's… drinkable. Kuba drank it anyway.",
    "experiment.nothing.2": "Interesting. In the way a puddle is interesting.",
    "experiment.nothing.3": "That's a flavour. Not a good one, but a flavour.",
    "experiment.nothing.4": "Grandma would have said \"brave\". Grandma was being kind.",
    "experiment.nothing.5": "Into the sink it goes. Nobody saw.",
    "experiment.nothing.6": "Not a recipe yet. Maybe a story for later.",
    "furniture.armchair.desc": "S lampou vedľa tvorí tichý kút.",
    "furniture.armchair.name": "Kreslo",
    "furniture.bar_counter.desc": "Za dlaždicu. Lidin bol z jedného kusa duba.",
    "furniture.bar_counter.name": "Barový pult",
    "furniture.bookshelf.desc": "Staré knihy, krížovky a jedna kuchárska kniha.",
    "furniture.bookshelf.name": "Knižnica",
    "furniture.brass_bell.desc": "Ding. The sound of a coffee being ready, since 1979.",
    "furniture.brass_bell.name": "Brass espresso bell",
    "furniture.cat_bed.desc": "A round cushion by the radiator. Someone will claim it.",
    "furniture.cat_bed.name": "Cat bed",
    "furniture.chair.desc": "Obyčajná, poctivá, z krčmy po niečom dedovi.",
    "furniture.chair.name": "Stolička",
    "furniture.coat_rack.desc": "Mokré kabáty majú kam ísť. Hostia sedia pohodlnejšie.",
    "furniture.coat_rack.name": "Vešiak",
    "furniture.coffee_machine.desc": "Syčí, akoby sa urazil. Hryzie.",
    "furniture.coffee_machine.name": "Kávovar Rapid",
    "furniture.counter_corner.desc": "Aby pult mohol zabočiť za roh.",
    "furniture.counter_corner.name": "Rohový pult",
    "furniture.dish_rack.desc": "Viac miesta na čistý riad.",
    "furniture.dish_rack.name": "Odkvapkávač",
    "furniture.door.desc": "So zvončekom, ktorý Lida nikdy nedala vymeniť.",
    "furniture.door.name": "Dvere",
    "furniture.drone_dock.desc": "Zásoby priletia aj v hmle. Dodávatelia už nebudú meškať.",
    "furniture.drone_dock.name": "Dok pre drony",
    "furniture.enamel_sign.desc": "\"Bufet\" in white on bottle green. Rescued from an old platform.",
    "furniture.enamel_sign.name": "Enamel station sign",
    "furniture.espresso_grinder.desc": "Čerstvo zomletá vôňa, ktorá láka z nástupišťa.",
    "furniture.espresso_grinder.name": "Mlynček na kávu",
    "furniture.fairy_lights.desc": "A string of tiny warm lights. Paid for by a jar of tips.",
    "furniture.fairy_lights.name": "Fairy lights",
    "furniture.floor_carpet.desc": "Za dlaždicu. Útulné, ale špina je na ňom vidieť.",
    "furniture.floor_carpet.name": "Koberec na podlahu",
    "furniture.floor_lamp.desc": "Teplá jantárová kaluž svetla.",
    "furniture.floor_lamp.name": "Stojacia lampa",
    "furniture.floor_tile.desc": "Za dlaždicu. Ľahko sa umýva.",
    "furniture.floor_tile.name": "Dlažba",
    "furniture.floor_wood.desc": "Za dlaždicu. Vŕzga tam, kde má.",
    "furniture.floor_wood.name": "Drevená podlaha",
    "furniture.fridge.desc": "Hučí hlasnejšie ako rádio. Obložené chlebíky a medovník.",
    "furniture.fridge.name": "Chladnička",
    "furniture.grandma_photo.desc": "Lida sa smeje na niekom mimo záberu. Nikdy nepredávať.",
    "furniture.grandma_photo.name": "Fotka babky",
    "furniture.jukebox.desc": "Hrá sám, keď niekto smúti.",
    "furniture.jukebox.name": "Jukebox",
    "furniture.lace_tablecloth.desc": "A small table under one of Lida's lace tablecloths.",
    "furniture.lace_tablecloth.name": "Table with grandma's lace",
    "furniture.lamp_brass.desc": "Curved brass and warm glass, in the Art Nouveau style.",
    "furniture.lamp_brass.name": "Brass pendant lamp",
    "furniture.led_strip.desc": "A slim column of warm indigo light.",
    "furniture.led_strip.name": "LED strip lamp",
    "furniture.menu_holo_board.desc": "Svieti fialovo do dažďa. Písmo sa dá zväčšiť.",
    "furniture.menu_holo_board.name": "Holo tabuľa s menu",
    "furniture.mosaic_rug.desc": "A rug with a sage-and-gold Secession pattern.",
    "furniture.mosaic_rug.name": "Mosaic rug",
    "furniture.napkin_wall.desc": "Thank-you napkins pinned in a frame. Every one a small night.",
    "furniture.napkin_wall.name": "Napkin wall",
    "furniture.oven.desc": "Koláčiky sú z nej stále teplé.",
    "furniture.oven.name": "Rúra",
    "furniture.pendant_lamp.desc": "Visí nad stolom a neprekáža.",
    "furniture.pendant_lamp.name": "Závesná lampa",
    "furniture.plant_small.desc": "Zelená bodka v noci.",
    "furniture.plant_small.name": "Malá kvetina",
    "furniture.plant_tall.desc": "Rastie rýchlejšie ako dlh. Skoro.",
    "furniture.plant_tall.name": "Veľká monstera",
    "furniture.radio.desc": "Staré lampové rádio. Kto ho opraví, možno začuje viac ako hudbu.",
    "furniture.radio.name": "Lidino rádio",
    "furniture.record_shelf.desc": "A shelf for sleeves and stories. Music lovers linger by it.",
    "furniture.record_shelf.name": "Record shelf",
    "furniture.register.desc": "Berie karty, telefóny aj staré dobré mince. Tie československé nie.",
    "furniture.register.name": "Pokladňa",
    "furniture.rug.desc": "Tlmí kroky aj hádky.",
    "furniture.rug.name": "Koberec",
    "furniture.sink.desc": "Bez neho sa šálky neumývajú samy. Bohužiaľ.",
    "furniture.sink.name": "Drez",
    "furniture.sofa.desc": "Mäkká ako koniec zmeny. Hostia zostanú dlhšie.",
    "furniture.sofa.name": "Pohovka",
    "furniture.stage_corner.desc": "Koberec, mikrofón a odvaha. Otvára večery pri mikrofóne.",
    "furniture.stage_corner.name": "Malé pódium",
    "furniture.stool.desc": "Pre tých, čo majú štyri minúty.",
    "furniture.stool.name": "Barová stolička",
    "furniture.stove.desc": "Polievky, hrianky a všetko, čo hreje.",
    "furniture.stove.name": "Sporák",
    "furniture.table_round.desc": "Pre dvoch a jedno tajomstvo.",
    "furniture.table_round.name": "Okrúhly stolík",
    "furniture.table_socket.desc": "Študenti zaň predajú dušu. A kúpia jednu kávu.",
    "furniture.table_socket.name": "Stolík so zásuvkou",
    "furniture.table_square.desc": "Pre partiu zo zmeny alebo z koncertu.",
    "furniture.table_square.name": "Veľký stôl",
    "furniture.trash_bin.desc": "Menej papierikov na podlahe.",
    "furniture.trash_bin.name": "Kôš",
    "furniture.wall.desc": "Drží strechu a fotky.",
    "furniture.wall.name": "Stena",
    "furniture.window.desc": "Von je vidieť dážď. Dnu je vidieť svetlo.",
    "furniture.window.name": "Okno",
    "furniture.window_seat.desc": "Výhľad na nástupište a dážď. Niekto tu sedáva o 3:33.",
    "furniture.window_seat.name": "Lavica pri okne",
    "guest.clubbers.desc": "Mokré bundy, hlasný smiech, chcú všetko hneď. Hlavne v piatok a sobotu.",
    "guest.clubbers.name": "Ľudia z koncertu",
    "guest.clubbers.one": "Concertgoer",
    "guest.drone_operators.desc": "Strážia rozvozové drony nad mokrými strechami. Ovládač nepustia ani pri káve.",
    "guest.drone_operators.name": "Dronári",
    "guest.drone_operators.one": "Drone operator",
    "guest.insomniacs.desc": "Čaj, koláčik a krížovka. Najrýchlejšie sa z nich stávajú štamgasti.",
    "guest.insomniacs.name": "Nespavci",
    "guest.insomniacs.one": "Night owl",
    "guest.night_wanderer.desc": "Nikto nevie, odkiaľ prišiel. Sadá si pod lampu a necháva štedré prepitné.",
    "guest.night_wanderer.name": "Nočný pútnik",
    "guest.night_wanderer.one": "Night wanderer",
    "guest.nurses.desc": "Prestávka je krátka, vďačnosť dlhá. Ich recenzie vážia viac.",
    "guest.nurses.name": "Zdravotníci",
    "guest.nurses.one": "Nurse",
