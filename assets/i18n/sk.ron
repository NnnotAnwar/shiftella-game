    "furniture.floor_wood.name": "Drevená podlaha",
    "furniture.fridge.desc": "Hučí hlasnejšie ako rádio. Obložené chlebíky a medovník.",
    "furniture.fridge.name": "Chladnička",
    "furniture.grandma_photo.desc": "Lída sa smeje na niekom mimo záberu. Nikdy nepredávať.",
    "furniture.grandma_photo.name": "Fotka babky",
    "furniture.jukebox.desc": "Hrá sám, keď niekto smúti.",
    "furniture.jukebox.name": "Jukebox",
    "furniture.menu_holo_board.desc": "Svieti fialovo do dažďa. Písmo sa dá zväčšiť.",
    "furniture.menu_holo_board.name": "Holo tabuľa s menu",
    "furniture.oven.desc": "Koláčiky sú z nej stále teplé.",
    "furniture.oven.name": "Rúra",
    "furniture.pendant_lamp.desc": "Visí nad stolom a neprekáža.",
    "furniture.pendant_lamp.name": "Závesná lampa",
    "furniture.plant_small.desc": "Zelená bodka v noci.",
    "furniture.plant_small.name": "Malá kvetina",
    "furniture.plant_tall.desc": "Rastie rýchlejšie ako dlh. Skoro.",
    "furniture.plant_tall.name": "Veľká monstera",
    "furniture.radio.desc": "Staré lampové rádio. Kto ho opraví, možno začuje viac ako hudbu.",
    "furniture.radio.name": "Lídino rádio",
    "furniture.register.desc": "Berie karty, telefóny aj staré dobré mince. Tie československé nie.",
    "furniture.register.name": "Pokladňa",
    "furniture.rug.desc": "Tlmí kroky aj hádky.",
    "furniture.rug.name": "Koberec",
    "furniture.sink.desc": "Bez neho sa šálky neumývajú samy. Bohužiaľ.",
    "furniture.sink.name": "Drez",
    "furniture.sofa.desc": "Mäkká ako koniec zmeny. Hostia zostanú dlhšie.",
    "furniture.sofa.name": "Pohovka",
    "furniture.stage_corner.desc": "Koberec, mikrofón a odvaha. Otvára večery pri mikrofóne.",
    "furniture.stage_corner.name": "Malé pódium",
    "furniture.stool.desc": "Pre tých, čo majú štyri minúty.",
    "furniture.stool.name": "Barová stolička",
    "furniture.stove.desc": "Polievky, hrianky a všetko, čo hreje.",
    "furniture.stove.name": "Sporák",
    "furniture.table_round.desc": "Pre dvoch a jedno tajomstvo.",
    "furniture.table_round.name": "Okrúhly stolík",
    "furniture.table_socket.desc": "Študenti zaň predajú dušu. A kúpia jednu kávu.",
    "furniture.table_socket.name": "Stolík so zásuvkou",
    "furniture.table_square.desc": "Pre partiu zo zmeny alebo z koncertu.",
    "furniture.table_square.name": "Veľký stôl",
    "furniture.trash_bin.desc": "Menej papierikov na podlahe.",
    "furniture.trash_bin.name": "Kôš",
    "furniture.wall.desc": "Drží strechu a fotky.",
    "furniture.wall.name": "Stena",
    "furniture.window.desc": "Von je vidieť dážď. Dnu je vidieť svetlo.",
    "furniture.window.name": "Okno",
    "furniture.window_seat.desc": "Výhľad na nástupište a dážď. Niekto tu sedáva o 3:33.",
    "furniture.window_seat.name": "Lavica pri okne",
    "guest.clubbers.desc": "Mokré bundy, hlasný smiech, chcú všetko hneď. Hlavne v piatok a sobotu.",
    "guest.clubbers.name": "Ľudia z koncertu",
    "guest.drone_operators.desc": "Strážia rozvozové drony nad mokrými strechami. Ovládač nepustia ani pri káve.",
    "guest.drone_operators.name": "Dronári",
    "guest.insomniacs.desc": "Čaj, koláčik a krížovka. Najrýchlejšie sa z nich stávajú štamgasti.",
    "guest.insomniacs.name": "Nespavci",
    "guest.night_wanderer.desc": "Nikto nevie, odkiaľ prišiel. Sadá si pod lampu a necháva štedré prepitné.",
    "guest.night_wanderer.name": "Nočný pútnik",
    "guest.nurses.desc": "Prestávka je krátka, vďačnosť dlhá. Ich recenzie vážia viac.",
    "guest.nurses.name": "Zdravotníci",
    "guest.patrol.desc": "Dvaja policajti, dve kávy, jedno „všetko v poriadku?\".",
    "guest.patrol.name": "Nočná hliadka",
    "guest.shift_workers.desc": "Striedanie v logistickom depe. Chodia v skupinách, jedia veľa a zmeny majú v Shiftelle.",
    "guest.shift_workers.name": "Ľudia zo zmeny",
    "guest.students.desc": "Sedia dlho, platia málo, chcú zásuvku.",
    "guest.students.name": "Študenti",
    "guest.taxi_drivers.desc": "Poslední taxikári s volantom v ruke. Rýchlo kávu a zase idú.",
    "guest.taxi_drivers.name": "Taxikári",
    "guest.train_crew.desc": "Majú rozpis v Shiftelle a hlad po polievke.",
    "guest.train_crew.name": "Železničiari",
    "guest.travelers.desc": "Prišli, odchádzajú alebo čakajú na prípoj. Kufre zaberajú miesto.",
    "guest.travelers.name": "Cestujúci",
    "guest.truckers.desc": "Ich kamióny už jazdia samy. Oni aj tak potrebujú polievku.",
    "guest.truckers.name": "Vodiči kamiónov",
    "item.cafe_keys.desc": "Boli pod rohožkou. Samozrejme.",
    "item.cafe_keys.name": "Kľúče od kaviarne",
    "item.letter.desc": "Zalepená obálka „Jindřichovi\". Váži asi dvadsať gramov.",
    "item.letter.name": "Lídin list",
    "item.lost_umbrella.desc": "Niekto poň možno príde.",
    "item.lost_umbrella.name": "Dáždnik s monogramom",
    "item.old_coin.desc": "Československé koruny z roku 1978. Už nie sú peniazmi.",
    "item.old_coin.name": "Staré mince",
    "item.recipe_book.desc": "Mastné stránky a poznámky na okrajoch.",
    "item.recipe_book.name": "Lídina kuchárska kniha",
    "item.rn333_ticket.desc": "Spiatočný, 14. novembra 1979. Spiatočná polovica nepoužitá.",
    "item.rn333_ticket.name": "Lístok Rn 333",
    "item.timetable_1979.desc": "Pri poslednom riadku ceruzkou: „dve minúty\".",
    "item.timetable_1979.name": "Cestovný poriadok 1979",
