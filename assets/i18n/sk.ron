    "event.late_train.text": "Rýchlik uviazol na dve hodiny. Na nástupišti nevrlí cestujúci s kuframi.",
    "event.late_train.title": "Meškajúci vlak",
    "event.lonely_night.text": "Nikto. Len dážď, bzučanie chladničky a rádio. Čas na veľké upratovanie — a na reči.",
    "event.lonely_night.title": "Prázdna noc",
    "event.lost_bus.text": "Zájazdový autobus odbočil zle. Sprievodkyňa sa pýta, či máte tridsať porcií polievky.",
    "event.lost_bus.title": "Zablúdený autobus",
    "event.mirek_accident.text": "Mirkov taxík skončil v zábradlí. Nikomu sa nič vážne nestalo. Mirek už nepríde.",
    "event.mirek_accident.title": "Nehoda pri stanici",
    "event.night_blogger.text": "Natáča šálku z troch strán, než ochutná. Jeho recenzia sa počíta trikrát.",
    "event.night_blogger.title": "Nočný streamer",
    "event.open_mic.text": "Niekto ladí gitaru a sála stíchne.",
    "event.open_mic.title": "Večer pri mikrofóne",
    "event.phantom_horn.text": "Dlhé zahúkanie. Tabuľa je prázdna.",
    "event.phantom_horn.title": "Húkanie bez vlaku",
    "event.police_patrol.text": "Dvaja policajti, dve kávy, jedno „všetko v poriadku?\". Pár nocí bude pokoj.",
    "event.police_patrol.title": "Nočná hliadka",
    "event.power_outage.choice.candles": "Zapáliť sviečky (−150 Kč)",
    "event.power_outage.choice.close_kitchen": "Zavrieť kuchyňu",
    "event.power_outage.result.candles": "Sviečky horia. Hosťom sa to páči — „útulné\".",
    "event.power_outage.result.close_kitchen": "Kuchyňa zatvorená. Predávame len studené.",
    "event.power_outage.text": "Cvak — a tma. Len neón stanice cez okno. Kávovar aj sporák stoja.",
    "event.power_outage.title": "Vypadol prúd",
    "event.rain.text": "Okná v kvapkách, holo nápis sa rozpíja. Ľudia sa chodia schovať.",
    "event.rain.title": "Dážď",
    "event.roof_leak.choice.bucket": "Postaviť vedro",
    "event.roof_leak.choice.roofer": "Zavolať pokrývača (−900 Kč)",
    "event.roof_leak.result.bucket": "Vedro cinká do rytmu dažďa.",
    "event.roof_leak.result.roofer": "Strecha opravená. Toto miesto už nekvapká.",
    "event.roof_leak.text": "Kvap. Kvap. Priamo vedľa pultu.",
    "event.roof_leak.title": "Tečie strecha",
    "event.staff_birthday.choice.cake": "Kúpiť tortu (−150 Kč)",
    "event.staff_birthday.choice.sing": "Len zaspievať",
    "event.staff_birthday.result.cake": "Torta, sviečky, falošný spev. Tím drží pokope.",
    "event.staff_birthday.result.sing": "Všetko najlepšie! Aspoň zaspievali čisto. Skoro.",
    "event.staff_birthday.text": "Niekto priniesol koláčik so sviečkou.",
    "event.staff_birthday.title": "Narodeniny",
    "event.staff_inspired.text": "„Počuj, čo keby sme do hrianky dali…\"",
    "event.staff_inspired.title": "Inšpirácia",
    "event.staff_quarrel.choice.let_be": "Nechať ich, nech si to vyjasnia",
    "event.staff_quarrel.choice.talk": "Porozprávať sa s nimi",
    "event.staff_quarrel.result.let_be": "V kuchyni je dusno.",
    "event.staff_quarrel.result.talk": "Vydýchli. Nôž zostal v šuplíku.",
    "event.staff_quarrel.text": "„To je môj nôž!\" — „A toto je moja zmena!\"",
    "event.staff_quarrel.title": "Hádka v kuchyni",
    "event.staff_romance.text": "Smejú sa na jednom vtipe dlhšie ako všetci ostatní.",
    "event.staff_romance.title": "Zaľúbili sa",
    "event.staff_sick.text": "Telefón o 21:40: „Prepáčte, dnes to nezvládnem.\"",
    "event.staff_sick.title": "Niekto ochorel",
    "event.staff_walkout.text": "Zástera na háčiku, buchnutie dverí. Niekto má dosť.",
    "event.staff_walkout.title": "Odišiel zo zmeny",
    "event.station_cat.choice.feed": "Nakŕmiť (−10 Kč)",
    "event.station_cat.choice.shoo": "Odohnať",
    "event.station_cat.result.feed": "Kocúr zamňaukal. Asi „vďaka\".",
    "event.station_cat.result.shoo": "Kocúr odišiel s urazenou dôstojnosťou.",
    "event.station_cat.text": "Ryšavý, drzý, s natrhnutým uchom. Pozerá na smotanu.",
    "event.station_cat.title": "Staničný kocúr",
    "event.storm.text": "Na stanici zhasínajú lampy. Svieti len tvoje okno. Hostia zostávajú dlhšie.",
    "event.storm.title": "Búrka",
    "event.storm_blackout.text": "Svieti len tvoje okno. Kto nespí, ide za jeho svetlom.",
    "event.storm_blackout.title": "Celá štvrť v tme",
    "event.strange_order.choice.black_coffee": "Čiernu kávu",
    "event.strange_order.choice.dont_know": "„Neviem. Poviete mi?\"",
    "event.strange_order.choice.tea_two_sugars": "Čaj s citrónom, dva cukry",
    "event.strange_order.result.black_coffee": "„Nie, nie. Tú pil Mirek.\"",
    "event.strange_order.result.dont_know": "Hosť rozpráva pol hodiny. O čaji ani slovo.",
    "event.strange_order.result.tea_two_sugars": "„Presne tak.\" Hosť sa usmeje, akoby si na niečo spomenul.",
    "event.strange_order.text": "„Dajte mi to, čo pila Lida.\"",
    "event.strange_order.title": "Zvláštna objednávka",
    "event.student_party.text": "Nahlas, veselo a veľmi lepkavo.",
    "event.student_party.title": "Študenti po párty",
