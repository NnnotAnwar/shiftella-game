    "event.first_snow.title": "Перший сніг",
    "event.fog.text": "Від Влтави підіймається молоко. Видно вікно кав'ярні. І більше нічого.",
    "event.fog.title": "Туман із річки",
    "event.forgotten_item.choice.keep": "Залишити собі",
    "event.forgotten_item.choice.lost_and_found": "У бюро знахідок",
    "event.forgotten_item.result.keep": "Парасолька висить на вішаку. Чекає.",
    "event.forgotten_item.result.lost_and_found": "Наступної ночі по неї прийшла пані. Вона була зворушена.",
    "event.forgotten_item.text": "На стільці — стара парасолька з монограмою.",
    "event.forgotten_item.title": "Забута річ",
    "event.fridge_fail.text": "Гуде гучніше за радіо. А потім замовкає. Частину запасів утрачено.",
    "event.fridge_fail.title": "Холодильник загудів",
    "event.health_inspection.fine": "Штраф 2 000 Kč і репутація −10. Інспекторка мовчки йде.",
    "event.health_inspection.pass": "Інспекторка йде задоволена. Репутація +5.",
    "event.health_inspection.text": "Суворі окуляри, планшет. «Не зважайте на мене».",
    "event.health_inspection.title": "Санінспекція",
    "event.health_inspection.warning": "Попередження: «Наступного разу хотілося б бачити чистіше».",
    "event.holo_flicker.text": "Голографічна вивіска над дверима блимає то «CAFÉ NOCTURNE», то «МИ ЧЕКАЄМО». Перехожі зупиняються.",
    "event.holo_flicker.title": "Блимає вивіска",
    "event.hospital_shift.text": "Медичні костюми під куртками. Їм би супу й п'ять хвилин тиші.",
    "event.hospital_shift.title": "Перезмінка в лікарні",
    "event.late_train.text": "Експрес застряг на дві години. На пероні сердиті пасажири з валізами.",
    "event.late_train.title": "Поїзд запізнюється",
    "event.lonely_night.text": "Нікого. Лише дощ, гудіння холодильника й радіо. Час для великого прибирання — і для розмов.",
    "event.lonely_night.title": "Порожня ніч",
    "event.lost_bus.text": "Туристичний автобус звернув не туди. Екскурсоводка питає, чи є у вас тридцять порцій супу.",
    "event.lost_bus.title": "Заблукалий автобус",
    "event.mirek_accident.text": "Міркове таксі врізалося в огорожу. Ніхто серйозно не постраждав. Мірек більше не прийде.",
    "event.mirek_accident.title": "Аварія біля вокзалу",
    "event.night_blogger.text": "Знімає чашку з трьох боків, перш ніж скуштувати. Його відгук рахується втричі.",
    "event.night_blogger.title": "Нічний стример",
    "event.open_mic.text": "Хтось налаштовує гітару, і зала затихає.",
    "event.open_mic.title": "Вечір біля мікрофона",
    "event.phantom_horn.text": "Довгий гудок. Табло порожнє.",
    "event.phantom_horn.title": "Гудок без поїзда",
    "event.police_patrol.text": "Двоє поліцейських, дві кави, одне «усе гаразд?». Кілька ночей буде спокійно.",
    "event.police_patrol.title": "Нічний патруль",
    "event.power_outage.choice.candles": "Запалити свічки (−150 Kč)",
    "event.power_outage.choice.close_kitchen": "Зачинити кухню",
    "event.power_outage.result.candles": "Свічки горять. Гостям подобається — «затишно».",
    "event.power_outage.result.close_kitchen": "Кухню зачинено. Продаємо лише холодне.",
    "event.power_outage.text": "Клац — і темрява. Лише неон вокзалу крізь вікно. Кавоварка й плита стоять.",
    "event.power_outage.title": "Світло згасло",
    "event.rain.text": "Краплі на склі, голографічна вивіска розпливається. Люди заходять перечекати.",
    "event.rain.title": "Дощ",
    "event.roof_leak.choice.bucket": "Підставити відро",
    "event.roof_leak.choice.roofer": "Викликати покрівельника (−900 Kč)",
    "event.roof_leak.result.bucket": "Відро дзенькає в ритм дощу.",
    "event.roof_leak.result.roofer": "Дах полагоджено. Тут більше не капатиме.",
    "event.roof_leak.text": "Кап. Кап. Просто біля стійки.",
    "event.roof_leak.title": "Протікає дах",
    "event.staff_birthday.choice.cake": "Купити торт (−150 Kč)",
    "event.staff_birthday.choice.sing": "Просто заспівати",
    "event.staff_birthday.result.cake": "Торт, свічки, фальшивий спів. Команда тримається разом.",
    "event.staff_birthday.result.sing": "З днем народження! Хоч заспівали чисто. Майже.",
    "event.staff_birthday.text": "Хтось приніс колач зі свічкою.",
    "event.staff_birthday.title": "День народження",
    "event.staff_inspired.text": "«Слухай, а якщо в грінку додати…»",
    "event.staff_inspired.title": "Натхнення",
    "event.staff_quarrel.choice.let_be": "Хай самі розберуться",
    "event.staff_quarrel.choice.talk": "Поговорити з ними",
    "event.staff_quarrel.result.let_be": "На кухні задушливо.",
    "event.staff_quarrel.result.talk": "Видихнули. Ніж лишився в шухляді.",
    "event.staff_quarrel.text": "«Це мій ніж!» — «А це моя зміна!»",
    "event.staff_quarrel.title": "Сварка на кухні",
    "event.staff_romance.text": "Вони сміються з одного жарту довше за всіх.",
    "event.staff_romance.title": "Закохалися",
    "event.staff_sick.text": "Дзвінок о 21:40: «Вибачте, сьогодні я не зможу».",
    "event.staff_sick.title": "Хтось захворів",
    "event.staff_walkout.text": "Фартух на гачку, грюкіт дверей. Комусь досить.",
    "event.staff_walkout.title": "Пішли зі зміни",
    "event.station_cat.choice.feed": "Нагодувати (−10 Kč)",
    "event.station_cat.choice.shoo": "Прогнати",
    "event.station_cat.result.feed": "Кіт нявкнув. Мабуть, «дякую».",
    "event.station_cat.result.shoo": "Кіт пішов з ображеною гідністю.",
    "event.station_cat.text": "Рудий, нахабний, з надірваним вухом. Дивиться на вершки.",
    "event.station_cat.title": "Вокзальний кіт",
    "event.storm.text": "На вокзалі гаснуть ліхтарі. Світиться лише твоє вікно. Гості затримуються довше.",
    "event.storm.title": "Гроза",
    "event.storm_blackout.text": "Світиться тільки твоє вікно. Усі, хто не спить, ідуть на нього.",
    "event.storm_blackout.title": "Увесь район у темряві",
    "event.strange_order.choice.black_coffee": "Чорну каву",
    "event.strange_order.choice.dont_know": "«Не знаю. Розкажете?»",
    "event.strange_order.choice.tea_two_sugars": "Чай із лимоном, два цукри",
    "event.strange_order.result.black_coffee": "«Ні-ні. Це пив Мірек».",
    "event.strange_order.result.dont_know": "Гість розповідає пів години. Про чай — ані слова.",
    "event.strange_order.result.tea_two_sugars": "«Саме так». Гість усміхається, ніби щось пригадав.",
    "event.strange_order.text": "«Дайте мені те, що пила Ліда».",
    "event.strange_order.title": "Дивне замовлення",
    "event.student_party.text": "Гучно, весело й дуже липко.",
    "event.student_party.title": "Студенти після вечірки",
    "event.supplier_late.text": "Дрон із постачанням застряг у тумані. Молоко буде. Десь після другої.",
    "event.supplier_late.title": "Постачання запізнюється",
    "event.taxi_break.text": "Машини вишикувалися біля входу. Кава, швидко, і знову в дорогу. За швидкість — чайові.",
    "event.taxi_break.title": "Таксисти на перерві",
    "experiment.cat_sniffs": "The cat sniffs it, thinks about it, and walks away.",
    "experiment.close.extra": "Almost — one thing too many.",
    "experiment.close.missing": "Almost — it wants something {family}.",
    "experiment.close.swap": "So close — swap the {family} one.",
    "experiment.discovered": "Discovered! {recipe}",
    "experiment.known": "You know this one: {recipe}.",
    "experiment.nothing.1": "It's… drinkable. Kuba drank it anyway.",
    "experiment.nothing.2": "Interesting. In the way a puddle is interesting.",
    "experiment.nothing.3": "That's a flavour. Not a good one, but a flavour.",
    "experiment.nothing.4": "Grandma would have said \"brave\". Grandma was being kind.",
    "experiment.nothing.5": "Into the sink it goes. Nobody saw.",
    "experiment.nothing.6": "Not a recipe yet. Maybe a story for later.",
    "furniture.armchair.desc": "Разом із лампою поруч утворює тихий куточок.",
    "furniture.armchair.name": "Крісло",
    "furniture.bar_counter.desc": "За клітинку. Лідина була з цілого дуба.",
    "furniture.bar_counter.name": "Барна стійка",
    "furniture.bookshelf.desc": "Старі книжки, кросворди й одна кулінарна книга.",
    "furniture.bookshelf.name": "Книжкова шафа",
    "furniture.brass_bell.desc": "Ding. The sound of a coffee being ready, since 1979.",
    "furniture.brass_bell.name": "Brass espresso bell",
    "furniture.cat_bed.desc": "A round cushion by the radiator. Someone will claim it.",
    "furniture.cat_bed.name": "Cat bed",
    "furniture.chair.desc": "Звичайний, чесний, із чиєїсь дідової пивнички.",
    "furniture.chair.name": "Стілець",
    "furniture.coat_rack.desc": "Мокрим пальтам є де висіти. Гостям сидиться зручніше.",
    "furniture.coat_rack.name": "Вішак",
    "furniture.coffee_machine.desc": "Шипить, ніби образилася. Кусається.",
    "furniture.coffee_machine.name": "Кавоварка «Рапід»",
    "furniture.counter_corner.desc": "Щоб стійка могла повернути за ріг.",
    "furniture.counter_corner.name": "Кутова стійка",
    "furniture.dish_rack.desc": "Більше місця для чистого посуду.",
    "furniture.dish_rack.name": "Сушарка для посуду",
    "furniture.door.desc": "Із дзвіночком, який Ліда так і не дала замінити.",
    "furniture.door.name": "Двері",
    "furniture.drone_dock.desc": "Запаси прилітають навіть крізь туман. Постачальники більше не запізнюються.",
    "furniture.drone_dock.name": "Док для дронів",
    "furniture.enamel_sign.desc": "\"Bufet\" in white on bottle green. Rescued from an old platform.",
    "furniture.enamel_sign.name": "Enamel station sign",
    "furniture.espresso_grinder.desc": "Аромат свіжого помелу, що вабить із перону.",
    "furniture.espresso_grinder.name": "Кавомолка",
    "furniture.fairy_lights.desc": "A string of tiny warm lights. Paid for by a jar of tips.",
    "furniture.fairy_lights.name": "Fairy lights",
    "furniture.floor_carpet.desc": "За клітинку. Затишно, але бруд видно.",
    "furniture.floor_carpet.name": "Ковролін",
    "furniture.floor_lamp.desc": "Тепла бурштинова калюжа світла.",
    "furniture.floor_lamp.name": "Торшер",
    "furniture.floor_tile.desc": "За клітинку. Легко мити.",
    "furniture.floor_tile.name": "Плитка",
    "furniture.floor_wood.desc": "За клітинку. Рипить там, де треба.",
    "furniture.floor_wood.name": "Дерев'яна підлога",
    "furniture.fridge.desc": "Гуде гучніше за радіо. Канапки й медовик.",
    "furniture.fridge.name": "Холодильник",
    "furniture.grandma_photo.desc": "Ліда сміється до когось за кадром. Ніколи не продавати.",
    "furniture.grandma_photo.name": "Бабусине фото",
    "furniture.jukebox.desc": "Грає сам, коли комусь сумно.",
    "furniture.jukebox.name": "Музичний автомат",
    "furniture.lace_tablecloth.desc": "A small table under one of Lida's lace tablecloths.",
    "furniture.lace_tablecloth.name": "Table with grandma's lace",
    "furniture.lamp_brass.desc": "Curved brass and warm glass, in the Art Nouveau style.",
    "furniture.lamp_brass.name": "Brass pendant lamp",
    "furniture.led_strip.desc": "A slim column of warm indigo light.",
    "furniture.led_strip.name": "LED strip lamp",
    "furniture.menu_holo_board.desc": "Світиться фіолетовим у дощ. Шрифт можна збільшити.",
    "furniture.menu_holo_board.name": "Голодошка з меню",
    "furniture.mosaic_rug.desc": "A rug with a sage-and-gold Secession pattern.",
    "furniture.mosaic_rug.name": "Mosaic rug",
    "furniture.napkin_wall.desc": "Thank-you napkins pinned in a frame. Every one a small night.",
    "furniture.napkin_wall.name": "Napkin wall",
    "furniture.oven.desc": "Колачі з неї завжди теплі.",
    "furniture.oven.name": "Духовка",
    "furniture.pendant_lamp.desc": "Висить над столом і не заважає.",
    "furniture.pendant_lamp.name": "Підвісна лампа",
    "furniture.plant_small.desc": "Зелена цятка в ночі.",
    "furniture.plant_small.name": "Маленька рослина",
    "furniture.plant_tall.desc": "Росте швидше за борг. Майже.",
    "furniture.plant_tall.name": "Велика монстера",
    "furniture.radio.desc": "Старий ламповий приймач. Хто його полагодить, може почути більше, ніж музику.",
    "furniture.radio.name": "Лідине радіо",
    "furniture.record_shelf.desc": "A shelf for sleeves and stories. Music lovers linger by it.",
    "furniture.record_shelf.name": "Record shelf",
    "furniture.register.desc": "Приймає картки, телефони й старі добрі монети. Крім чехословацьких.",
    "furniture.register.name": "Каса",
    "furniture.rug.desc": "Глушить кроки й сварки.",
    "furniture.rug.name": "Килим",
    "furniture.sink.desc": "Без неї чашки самі не помиються. На жаль.",
    "furniture.sink.name": "Мийка",
    "furniture.sofa.desc": "М'який, як кінець зміни. Гості затримуються довше.",
    "furniture.sofa.name": "Диван",
    "furniture.stage_corner.desc": "Килим, мікрофон і сміливість. Відкриває вечори біля мікрофона.",
    "furniture.stage_corner.name": "Маленька сцена",
    "furniture.stool.desc": "Для тих, у кого є чотири хвилини.",
    "furniture.stool.name": "Барний стілець",
    "furniture.stove.desc": "Супи, грінки й усе, що зігріває.",
    "furniture.stove.name": "Плита",
    "furniture.table_round.desc": "Для двох і одного секрету.",
    "furniture.table_round.name": "Круглий столик",
    "furniture.table_socket.desc": "Студенти продадуть за нього душу. І куплять одну каву.",
    "furniture.table_socket.name": "Столик із розеткою",
    "furniture.table_square.desc": "Для компанії після зміни чи концерту.",
    "furniture.table_square.name": "Великий стіл",
    "furniture.trash_bin.desc": "Менше серветок на підлозі.",
    "furniture.trash_bin.name": "Смітник",
    "furniture.wall.desc": "Тримає дах і фотографії.",
    "furniture.wall.name": "Стіна",
    "furniture.window.desc": "Зсередини видно дощ. Ззовні — світло.",
    "furniture.window.name": "Вікно",
    "furniture.window_seat.desc": "Вид на перон і дощ. Хтось сідає тут о 3:33.",
    "furniture.window_seat.name": "Лавка біля вікна",
    "guest.clubbers.desc": "Мокрі куртки, гучний сміх, хочуть усе й одразу. Здебільшого в п'ятницю й суботу.",
    "guest.clubbers.name": "Публіка з концерту",
    "guest.drone_operators.desc": "Пильнують дронів-кур'єрів над мокрими дахами. Пульт не випускають навіть за кавою.",
    "guest.drone_operators.name": "Оператори дронів",
    "guest.insomniacs.desc": "Чай, колач і кросворд. Найшвидше стають постійними гостями.",
    "guest.insomniacs.name": "Безсонні",
    "guest.night_wanderer.desc": "Ніхто не знає, звідки він узявся. Сідає під лампою й щедро лишає чайові.",
    "guest.night_wanderer.name": "Нічний мандрівник",
    "guest.nurses.desc": "Перерва коротка, вдячність довга. Їхні відгуки важать більше.",
    "guest.nurses.name": "Медики",
    "guest.patrol.desc": "Двоє поліцейських, дві кави, одне «усе гаразд?».",
    "guest.patrol.name": "Нічний патруль",
    "guest.shift_workers.desc": "Перезмінка в логістичному депо. Ходять гуртом, їдять багато, а зміни дивляться в Shiftella.",
    "guest.shift_workers.name": "Робітники зміни",
    "guest.students.desc": "Сидять довго, платять мало, шукають розетку.",
    "guest.students.name": "Студенти",
    "guest.taxi_drivers.desc": "Останні таксисти, що ще тримають кермо. Швидко кави — і знову в дорогу.",
    "guest.taxi_drivers.name": "Таксисти",
    "guest.train_crew.desc": "Їхній розклад — у Shiftella, а апетит — на суп.",
    "guest.train_crew.name": "Залізничники",
    "guest.travelers.desc": "Прибули, від'їжджають або чекають на пересадку. Валізи займають місце.",
    "guest.travelers.name": "Пасажири",
    "guest.truckers.desc": "Їхні вантажівки вже їздять самі. А супу їм однаково хочеться.",
    "guest.truckers.name": "Далекобійники",
