    "ui.app.is_published": "Опубліковано",
    "ui.app.keep": "Залишити",
    "ui.app.leave_short": "вихідний",
    "ui.app.mode_auto": "Авто",
    "ui.app.mode_manual": "Вручну",
    "ui.app.night_hours": "НІЧНІ ГОД",
    "ui.app.night_only": "Це можна лише вночі",
    "ui.app.night_view_only": "Зміни — лише вдень",
    "ui.app.payroll_empty": "Дані для зарплати готуються наприкінці тижня.",
    "ui.app.payroll_export": "Експортувати",
    "ui.app.payroll_number": "Таб. №",
    "ui.app.pending": "очікує погодження",
    "ui.app.posted": "Опубліковано на дошці",
