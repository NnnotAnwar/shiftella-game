    "story.last_train.react.app": "5:41, друга платформа. Поставлю три будильники. Дякую!",
    "story.last_train.react.armchair": "О, це… дуже добре крісло.",
    "story.last_train.react.cake": "Дякую. З тортом чекати легше.",
    "story.last_train.text": "Останній потяг на Děčín уже пішов. Наступний — аж на світанку.",
    "story.letter.log": "{name}: лист від руки нарешті дописано.",
    "story.letter.opt.lamp": "Присунути лампу ближче",
    "story.letter.opt.paper": "Бабусин гарний папір для листів",
    "story.letter.opt.tea": "Чай від закладу",
    "story.letter.react.lamp": "Так краще. Тепер бачу, що хочу сказати.",
    "story.letter.react.paper": "Справжній папір. Тепер доведеться написати як слід.",
    "story.letter.react.tea": "Дякую. Листам потрібен чай.",
    "story.letter.text": "Пише листа від руки. Закреслює, починає знову.",
    "story.line.04_mirek": "Близько третьої тут завжди дивна тиша. Ліда казала, що то нічого.",
    "story.line.06_filip": "Добрий вечір… тут є Wi-Fi? Або хоча б розетка?",
    "story.line.07_cook": "За Ліди платежі теж вносили в неділю. Зранку. З лайкою.",
    "story.line.11_ema": "Чуєте? Поїзд. А на табло — жодного.",
    "story.line.16_kuba": "Котові тут сподобалося б. Якби він був. Просто кажу.",
    "story.line.18_filip": "Не питайте. Будь ласка.",
    "story.line.22_vera": "Ліда б пишалася. Не кажи їй… ну, нікому не кажи.",
    "story.line.22_vera_sold": "Тепер тут просто світить. Не чекає.",
    "story.line.29_radek": "На пенсії спиться жахливо. Тож я тут.",
    "story.lost_tourist.log": "{name}: нічні Голешовиці — і тепер у правильному напрямку.",
    "story.lost_tourist.opt.map": "Намалювати дорогу на серветці",
    "story.lost_tourist.opt.point": "Показати напрямок",
    "story.lost_tourist.opt.taxi": "Викликати таксі через застосунок",
    "story.lost_tourist.react.map": "Мапа на серветці! Краща за справжню.",
    "story.lost_tourist.react.point": "Ліворуч, потім праворуч… потім ліворуч? Дякую!",
    "story.lost_tourist.react.taxi": "Три хвилини? Ви чарівниця. Děkuji!",
    "story.lost_tourist.text": "Паперова мапа догори дриґом. Шукає хостел, якого нема там, де показує мапа.",
    "story.new_parent.log": "{name}: немовля вдома й тиха пів години тут.",
    "story.new_parent.opt.cake": "Шматочок торта",
    "story.new_parent.opt.easier": "Сказати, що далі буде легше",
    "story.new_parent.opt.warm": "Щось тепле без кофеїну",
    "story.new_parent.react.cake": "Цукор. Так. Цукор — це добре.",
    "story.new_parent.react.easier": "Справді? Обіцяєте? …Дякую.",
    "story.new_parent.react.warm": "Ваша правда. Кава була б жахливою ідеєю.",
    "story.new_parent.text": "Удома немовля, нарешті спить. А на власний сон уже нема сил.",
    "story.night.01.hint": "Ключ під килимком. Засвіти вікно й звари першу каву.",
    "story.night.01.title": "Приїзд",
    "story.night.02.hint": "Найми когось і склади перший розклад.",
    "story.night.02.title": "Перший колега",
    "story.night.03.hint": "О другій прийде хтось, у кого немає часу чекати.",
    "story.night.03.title": "Дощ і медсестра",
    "story.night.04.hint": "Нехай у вікні світиться. Усю ніч.",
    "story.night.04.title": "3:33",
    "story.night.05.hint": "Після півночі прийде хтось, хто знав Ліду. Хай столи будуть чисті.",
    "story.night.05.title": "Пані з кросвордом",
    "story.night.06.hint": "Субота. Близько одинадцятої закінчиться концерт у будинку культури.",
    "story.night.06.title": "Після концерту",
    "story.night.07.hint": "О шостій ранку треба віддати 15 000 Kč. Рахуй.",
    "story.night.07.title": "Перший платіж",
    "story.night.08.hint": "Зголошуються нові люди. А Мірек сьогодні якось дивно паркується.",
    "story.night.08.title": "Бордюр",
    "story.night.09.hint": "О першій зайде черговий по станції. У нього чотири хвилини.",
    "story.night.09.title": "Останній черговий",
    "story.night.10.hint": "Підготуй свічки. Про всяк випадок.",
    "story.night.10.title": "Темрява",
    "story.night.11.hint": "Іде дощ. На пероні хтось грає.",
    "story.night.11.title": "Пісня на пероні",
    "story.night.12.hint": "Крісло й лампа сьогодні можуть знадобитися.",
    "story.night.12.title": "Тихий куточок",
    "story.night.13.hint": "Санінспекція прийде близько пів на дванадцяту. Хай усе блищить.",
    "story.night.13.title": "Інспекція",
    "story.night.14.hint": "Другий платіж. А Віра сьогодні щось несе.",
    "story.night.14.title": "Кулінарна книга",
    "story.night.15.hint": "Туман. О 3:33 хтось тебе дещо спитає.",
    "story.night.15.title": "Запитання",
    "story.night.16.hint": "Ніхто не прийде. Час для прибирання — і для людей, які тут працюють.",
    "story.night.16.title": "Порожня ніч",
    "story.night.17.hint": "Приїде гість із мережі NONSTOP 24. Слухай.",
    "story.night.17.title": "NONSTOP 24",
    "story.night.18.hint": "Філіп сьогодні не відкривав ноутбук.",
    "story.night.18.title": "Перескладання",
    "story.night.19.hint": "Буде злива. Гостей удвічі більше — і бруду теж.",
    "story.night.19.title": "Злива",
    "story.night.20.hint": "Мірек сьогодні запізниться. Будь біля дверей.",
    "story.night.20.title": "За долоню",
    "story.night.21.hint": "Ще один платіж о шостій. Хтось хоче відпустку.",
    "story.night.21.title": "Третій платіж",
    "story.night.22.hint": "Сьогодні вирішиться, чия вивіска висітиме над дверима.",
    "story.night.22.title": "Рішення",
    "story.night.23.hint": "У Радека остання зміна.",
    "story.night.23.title": "Розклад",
    "story.night.24.hint": "Іде дощ. Якщо в Лорі є сцена — сьогодні її вечір.",
    "story.night.24.title": "Вечір для Лорі",
    "story.night.25.hint": "Насувається гроза. Хай вікно світиться.",
    "story.night.25.title": "Гроза",
    "story.night.26.hint": "Гана ухвалила рішення.",
    "story.night.26.title": "Дрезден",
    "story.night.27.hint": "Іде сніг. Віра хоче розповісти історію.",
    "story.night.27.title": "Перший сніг",
    "story.night.28.hint": "Четвертий платіж. А в Мірека є запитання.",
    "story.night.28.title": "Лист",
    "story.night.29.hint": "Сьогодні кожен постійний гість прийде завершити свою історію.",
    "story.night.29.title": "Прощання",
    "story.night.30.hint": "Остання ніч. 30 000 Kč о шостій. О 3:33 хай вікно світиться.",
    "story.night.30.title": "Останній поїзд",
    "story.nurse_loss.log": "{name}: важка ніч і тихе місце після неї.",
    "story.nurse_loss.opt.cake": "Шматочок торта",
    "story.nurse_loss.opt.quiet": "Принести чай і залишити в спокої",
    "story.nurse_loss.opt.record": "Щось тихе на джукбоксі",
    "story.nurse_loss.react.cake": "Дякую. Може, пізніше.",
    "story.nurse_loss.react.quiet": "…Дякую. Що не питаєте.",
    "story.nurse_loss.react.record": "Гарно. Трохи легше дихати.",
    "story.nurse_loss.text": "Після важкої зміни — цієї ночі пацієнта не стало. Дивиться в чашку.",
    "story.pay_cheque.log": "{name}: перша зарплата, відсвяткована біля стійки.",
    "story.pay_cheque.opt.medovnik": "Бабусин медовик на честь свята",
    "story.pay_cheque.opt.record": "Поставити щось веселе",
    "story.pay_cheque.opt.word": "Привітати",
    "story.pay_cheque.react.medovnik": "Мені? Це вже найкращий день місяця.",
    "story.pay_cheque.react.record": "Ха! Тепер це справжнє свято.",
    "story.pay_cheque.react.word": "Дякую! Небагато, але моє.",
    "story.pay_cheque.text": "Найперша зарплата. Знову й знову перечитує розрахунковий листок.",
    "story.ring.log": "{name}: важкий вечір, хоч трохи м'якший.",
    "story.ring.opt.ask": "Спитати, як справи",
    "story.ring.opt.cocoa": "Гарячий шоколад, без запитань",
    "story.ring.opt.record": "Щось ніжне на джукбоксі",
    "story.ring.react.ask": "Буде добре. Не сьогодні, але буде.",
    "story.ring.react.cocoa": "Без запитань. Дякую. Саме те.",
    "story.ring.react.record": "Ця пісня… усе гаразд. Вона гарна.",
    "story.ring.text": "Крутить у пальцях обручку. Уже не на пальці.",
    "story.sketch.log": "{name}: начерк кав'ярні з увімкненими лампами.",
    "story.sketch.opt.lamp": "Увімкнути лампу над столиком",
    "story.sketch.opt.peek": "Зазирнути в малюнок",
    "story.sketch.opt.pose": "Завмерти за стійкою",
    "story.sketch.react.lamp": "О, світло! Тепер тіні правильні.",
    "story.sketch.react.peek": "Ще не готово! …Гаразд. Тільки одним оком.",
    "story.sketch.react.pose": "Ідеально, не рухайтесь! …Готово. Ви схожі на цю кав'ярню.",
    "story.sketch.text": "Малює кав'ярню в маленькому скетчбуці. Стійку, лампи… і тебе.",
    "story.soaked.log": "{name}: з негоди — і знову сухо.",
    "story.soaked.opt.radiator": "Місце біля батареї",
    "story.soaked.opt.tea": "Чай від закладу",
    "story.soaked.opt.towel": "Сухий рушник",
    "story.soaked.react.radiator": "Ох, тепло… Я звідси не піду.",
    "story.soaked.react.tea": "Дякую. Гарячий чай, мокрі шкарпетки. Пів справи зроблено.",
    "story.soaked.react.towel": "Рушник! Ви свята.",
    "story.soaked.text": "Промокло все до нитки. Тихенько капає на бабусину підлогу.",
    "story.toast": "Маленька історія",
    "story.wedding.log": "{name}: завтра весілля, сьогодні тост.",
    "story.wedding.opt.medovnik": "Медовик на щастя",
