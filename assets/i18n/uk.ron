    "signature.style.milk_froth": "Зі спіненим молоком",
    "signature.style.pour_over": "Пуровер",
    "signature.style.tea_steep": "Заварений",
    "signature.sub": "У бабусі завжди був свій. Придумай наш.",
    "signature.suggest.1": "Голешовицька ніч",
    "signature.suggest.10": "Вокзальний кіт",
    "signature.suggest.11": "Платформа 3",
    "signature.suggest.12": "Нічний до Хеба",
    "signature.suggest.2": "Лідина чашка",
    "signature.suggest.3": "Дощ на коліях",
    "signature.suggest.4": "Останній трамвай",
    "signature.suggest.5": "Тепла лампа",
    "signature.suggest.6": "Бабусин секрет",
    "signature.suggest.7": "Тиха година",
    "signature.suggest.8": "Оксамитовий туман",
