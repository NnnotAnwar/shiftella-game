    "event.strange_order.text": "«Дайте мені те, що пила Ліда».",
    "event.strange_order.title": "Дивне замовлення",
    "event.student_party.text": "Гучно, весело й дуже липко.",
    "event.student_party.title": "Студенти після вечірки",
    "event.supplier_late.text": "Дрон із постачанням застряг у тумані. Молоко буде. Десь після другої.",
    "event.supplier_late.title": "Постачання запізнюється",
    "event.taxi_break.text": "Машини вишикувалися біля входу. Кава, швидко, і знову в дорогу. За швидкість — чайові.",
    "event.taxi_break.title": "Таксисти на перерві",
    "furniture.armchair.desc": "Разом із лампою поруч утворює тихий куточок.",
    "furniture.armchair.name": "Крісло",
    "furniture.bar_counter.desc": "За клітинку. Лідина була з цілого дуба.",
    "furniture.bar_counter.name": "Барна стійка",
    "furniture.bookshelf.desc": "Старі книжки, кросворди й одна кулінарна книга.",
    "furniture.bookshelf.name": "Книжкова шафа",
    "furniture.chair.desc": "Звичайний, чесний, із чиєїсь дідової пивнички.",
    "furniture.chair.name": "Стілець",
    "furniture.coat_rack.desc": "Мокрим пальтам є де висіти. Гостям сидиться зручніше.",
    "furniture.coat_rack.name": "Вішак",
    "furniture.coffee_machine.desc": "Шипить, ніби образилася. Кусається.",
    "furniture.coffee_machine.name": "Кавоварка «Рапід»",
    "furniture.counter_corner.desc": "Щоб стійка могла повернути за ріг.",
    "furniture.counter_corner.name": "Кутова стійка",
    "furniture.dish_rack.desc": "Більше місця для чистого посуду.",
    "furniture.dish_rack.name": "Сушарка для посуду",
    "furniture.door.desc": "Із дзвіночком, який Ліда так і не дала замінити.",
    "furniture.door.name": "Двері",
    "furniture.drone_dock.desc": "Запаси прилітають навіть крізь туман. Постачальники більше не запізнюються.",
    "furniture.drone_dock.name": "Док для дронів",
    "furniture.espresso_grinder.desc": "Аромат свіжого помелу, що вабить із перону.",
    "furniture.espresso_grinder.name": "Кавомолка",
    "furniture.floor_carpet.desc": "За клітинку. Затишно, але бруд видно.",
    "furniture.floor_carpet.name": "Ковролін",
    "furniture.floor_lamp.desc": "Тепла бурштинова калюжа світла.",
    "furniture.floor_lamp.name": "Торшер",
    "furniture.floor_tile.desc": "За клітинку. Легко мити.",
    "furniture.floor_tile.name": "Плитка",
    "furniture.floor_wood.desc": "За клітинку. Рипить там, де треба.",
    "furniture.floor_wood.name": "Дерев'яна підлога",
    "furniture.fridge.desc": "Гуде гучніше за радіо. Канапки й медовик.",
    "furniture.fridge.name": "Холодильник",
    "furniture.grandma_photo.desc": "Ліда сміється до когось за кадром. Ніколи не продавати.",
    "furniture.grandma_photo.name": "Бабусине фото",
    "furniture.jukebox.desc": "Грає сам, коли комусь сумно.",
    "furniture.jukebox.name": "Музичний автомат",
    "furniture.menu_holo_board.desc": "Світиться фіолетовим у дощ. Шрифт можна збільшити.",
    "furniture.menu_holo_board.name": "Голодошка з меню",
    "furniture.oven.desc": "Колачі з неї завжди теплі.",
    "furniture.oven.name": "Духовка",
    "furniture.pendant_lamp.desc": "Висить над столом і не заважає.",
    "furniture.pendant_lamp.name": "Підвісна лампа",
    "furniture.plant_small.desc": "Зелена цятка в ночі.",
    "furniture.plant_small.name": "Маленька рослина",
    "furniture.plant_tall.desc": "Росте швидше за борг. Майже.",
    "furniture.plant_tall.name": "Велика монстера",
    "furniture.radio.desc": "Старий ламповий приймач. Хто його полагодить, може почути більше, ніж музику.",
    "furniture.radio.name": "Лідине радіо",
    "furniture.register.desc": "Приймає картки, телефони й старі добрі монети. Крім чехословацьких.",
    "furniture.register.name": "Каса",
    "furniture.rug.desc": "Глушить кроки й сварки.",
    "furniture.rug.name": "Килим",
    "furniture.sink.desc": "Без неї чашки самі не помиються. На жаль.",
    "furniture.sink.name": "Мийка",
    "furniture.sofa.desc": "М'який, як кінець зміни. Гості затримуються довше.",
    "furniture.sofa.name": "Диван",
    "furniture.stage_corner.desc": "Килим, мікрофон і сміливість. Відкриває вечори біля мікрофона.",
    "furniture.stage_corner.name": "Маленька сцена",
    "furniture.stool.desc": "Для тих, у кого є чотири хвилини.",
    "furniture.stool.name": "Барний стілець",
    "furniture.stove.desc": "Супи, грінки й усе, що зігріває.",
    "furniture.stove.name": "Плита",
    "furniture.table_round.desc": "Для двох і одного секрету.",
    "furniture.table_round.name": "Круглий столик",
    "furniture.table_socket.desc": "Студенти продадуть за нього душу. І куплять одну каву.",
    "furniture.table_socket.name": "Столик із розеткою",
    "furniture.table_square.desc": "Для компанії після зміни чи концерту.",
    "furniture.table_square.name": "Великий стіл",
    "furniture.trash_bin.desc": "Менше серветок на підлозі.",
    "furniture.trash_bin.name": "Смітник",
    "furniture.wall.desc": "Тримає дах і фотографії.",
    "furniture.wall.name": "Стіна",
    "furniture.window.desc": "Зсередини видно дощ. Ззовні — світло.",
    "furniture.window.name": "Вікно",
    "furniture.window_seat.desc": "Вид на перон і дощ. Хтось сідає тут о 3:33.",
    "furniture.window_seat.name": "Лавка біля вікна",
    "guest.clubbers.desc": "Мокрі куртки, гучний сміх, хочуть усе й одразу. Здебільшого в п'ятницю й суботу.",
    "guest.clubbers.name": "Публіка з концерту",
    "guest.drone_operators.desc": "Пильнують дронів-кур'єрів над мокрими дахами. Пульт не випускають навіть за кавою.",
    "guest.drone_operators.name": "Оператори дронів",
    "guest.insomniacs.desc": "Чай, колач і кросворд. Найшвидше стають постійними гостями.",
    "guest.insomniacs.name": "Безсонні",
    "guest.night_wanderer.desc": "Ніхто не знає, звідки він узявся. Сідає під лампою й щедро лишає чайові.",
    "guest.night_wanderer.name": "Нічний мандрівник",
    "guest.nurses.desc": "Перерва коротка, вдячність довга. Їхні відгуки важать більше.",
    "guest.nurses.name": "Медики",
    "guest.patrol.desc": "Двоє поліцейських, дві кави, одне «усе гаразд?».",
    "guest.patrol.name": "Нічний патруль",
    "guest.shift_workers.desc": "Перезмінка в логістичному депо. Ходять гуртом, їдять багато, а зміни дивляться в Shiftella.",
    "guest.shift_workers.name": "Робітники зміни",
    "guest.students.desc": "Сидять довго, платять мало, шукають розетку.",
    "guest.students.name": "Студенти",
    "guest.taxi_drivers.desc": "Останні таксисти, що ще тримають кермо. Швидко кави — і знову в дорогу.",
    "guest.taxi_drivers.name": "Таксисти",
    "guest.train_crew.desc": "Їхній розклад — у Shiftella, а апетит — на суп.",
    "guest.train_crew.name": "Залізничники",
    "guest.travelers.desc": "Прибули, від'їжджають або чекають на пересадку. Валізи займають місце.",
    "guest.travelers.name": "Пасажири",
    "guest.truckers.desc": "Їхні вантажівки вже їздять самі. А супу їм однаково хочеться.",
    "guest.truckers.name": "Далекобійники",
    "item.cafe_keys.desc": "Були під килимком. Аякже.",
    "item.cafe_keys.name": "Ключі від кав'ярні",
    "item.letter.desc": "Заклеєний конверт «Їндрі». Важить грамів двадцять.",
    "item.letter.name": "Лідин лист",
    "item.lost_umbrella.desc": "Можливо, хтось по неї повернеться.",
    "item.lost_umbrella.name": "Парасолька з монограмою",
    "item.old_coin.desc": "Чехословацькі крони 1978 року. Вже не гроші.",
    "item.old_coin.name": "Старі монети",
    "item.recipe_book.desc": "Масні сторінки й нотатки на полях.",
    "item.recipe_book.name": "Лідина кулінарна книга",
    "item.rn333_ticket.desc": "Туди й назад, 14 листопада 1979. Зворотна половина не використана.",
    "item.rn333_ticket.name": "Квиток Rn 333",
    "item.timetable_1979.desc": "Біля останнього рядка олівцем: «дві хвилини».",
    "item.timetable_1979.name": "Розклад 1979 року",
