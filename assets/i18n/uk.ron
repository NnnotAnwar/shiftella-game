    "ui.app.day_off": "вихідний",
    "ui.app.decline": "Відхилити",
    "ui.app.declined": "відхилено",
    "ui.app.draft": "Чернетка",
    "ui.app.draw_hint": "Тягни — зміна · Shift + тягни — перерва · ПКМ — стерти",
    "ui.app.empty": "Поки нічого. Спокійна ніч.",
    "ui.app.fix_shorten": "Скоротити до 4 год",
    "ui.app.forecast": "Прогноз гостей",
    "ui.app.handover_saved": "Передачу збережено",
    "ui.app.handover_send": "Зберегти передачу",
