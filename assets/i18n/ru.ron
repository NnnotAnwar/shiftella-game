    "furniture.attic_piano_stool.desc": "Крутится и немного скрипит.",
    "furniture.attic_piano_stool.name": "Табурет от пианино",
    "furniture.attic_rag_rug.desc": "Пёстрый и тёплый, 2×2.",
    "furniture.attic_rag_rug.name": "Лоскутный коврик",
    "furniture.attic_reading_lamp.desc": "Тёплый свет широким кругом.",
    "furniture.attic_reading_lamp.name": "Латунная лампа для чтения",
    "furniture.attic_rubber_plant.desc": "Большие блестящие листья, растёт даже в темноте.",
    "furniture.attic_rubber_plant.name": "Бабушкин фикус",
    "furniture.attic_sewing_chair.desc": "Мягкое, чуть выцветшее. С лампой рядом — тихий уголок.",
    "furniture.attic_sewing_chair.name": "Бабушкино кресло для шитья",
    "furniture.attic_station_bench.desc": "Деревянная скамья на двоих, отполированная годами.",
    "furniture.attic_station_bench.name": "Скамья из зала ожидания",
    "furniture.attic_tram_lamp.desc": "Подвесной свет над столиком.",
    "furniture.attic_tram_lamp.name": "Трамвайная лампа",
    "furniture.attic_window_bench.desc": "Скамья на двоих — лучше всего под окном.",
    "furniture.attic_window_bench.name": "Кухонная скамья",
    "furniture.bar_counter.desc": "За клетку; соседние части соединяются в одну стойку и заворачивают за угол. У Лиды была из цельного дуба.",
    "furniture.bar_counter.name": "Барная стойка",
    "furniture.bookshelf.desc": "Старые книги, кроссворды и одна поваренная книга.",
    "furniture.bookshelf.name": "Книжный шкаф",
    "furniture.brass_bell.desc": "Дзынь. Звук готового кофе с 1979 года.",
    "furniture.brass_bell.name": "Латунный колокольчик для эспрессо",
    "furniture.cat_bed.desc": "Круглая подушка у батареи. Кто-то её займёт.",
    "furniture.cat_bed.name": "Лежанка для кота",
    "furniture.chair.desc": "Простой и честный, из чьей-то дедушкиной пивнушки.",
    "furniture.chair.name": "Стул",
    "furniture.coat_rack.desc": "Мокрым пальто есть где висеть. Гостям сидится уютнее.",
    "furniture.coat_rack.name": "Вешалка",
    "furniture.coffee_machine.desc": "Шипит, будто обиделась. Кусается.",
    "furniture.coffee_machine.name": "Кофеварка «Рапид»",
    "furniture.dish_rack.desc": "Поставь её рядом с мойкой: чашки сохнут сами, и мытьё идёт быстрее. Грязную посуду сюда не носят.",
    "furniture.dish_rack.name": "Сушка для посуды",
    "furniture.door.desc": "С колокольчиком, который Лида так и не дала заменить.",
    "furniture.door.name": "Дверь",
    "furniture.drone_dock.desc": "Запасы прилетают даже сквозь туман. Поставщики больше не опаздывают.",
    "furniture.drone_dock.name": "Док для дронов",
    "furniture.enamel_sign.desc": "«Bufet» белым по бутылочно-зелёному. Спасена со старой платформы.",
    "furniture.enamel_sign.name": "Эмалированная вокзальная табличка",
    "furniture.espresso_grinder.desc": "Поставь её рядом с кофемашиной: кофе готовится быстрее и пахнет до самого перрона.",
    "furniture.espresso_grinder.name": "Кофемолка",
    "furniture.fairy_lights.desc": "Нитка крошечных тёплых огоньков. Оплачена банкой чаевых.",
    "furniture.fairy_lights.name": "Гирлянда-огоньки",
    "furniture.floor_carpet.desc": "За клетку. Уютно, но грязь видна.",
    "furniture.floor_carpet.name": "Ковролин",
    "furniture.floor_lamp.desc": "Тёплая янтарная лужица света.",
    "furniture.floor_lamp.name": "Торшер",
    "furniture.floor_tile.desc": "За клетку. Легко мыть.",
    "furniture.floor_tile.name": "Плитка",
    "furniture.floor_wood.desc": "За клетку. Скрипит там, где надо.",
    "furniture.floor_wood.name": "Деревянный пол",
    "furniture.fridge.desc": "Гудит громче радио. Бутерброды и медовик.",
    "furniture.fridge.name": "Холодильник",
    "furniture.grandma_photo.desc": "Лида смеётся кому-то за кадром. Не продаётся никогда.",
    "furniture.grandma_photo.name": "Бабушкино фото",
    "furniture.jukebox.desc": "Играет сам, когда кому-то грустно.",
    "furniture.jukebox.name": "Музыкальный автомат",
    "furniture.lace_tablecloth.desc": "Маленький столик под одной из Лидиных кружевных скатертей.",
    "furniture.lace_tablecloth.name": "Столик с бабушкиным кружевом",
    "furniture.lamp_brass.desc": "Изогнутая латунь и тёплое стекло, в стиле модерн.",
    "furniture.lamp_brass.name": "Латунная подвесная лампа",
    "furniture.led_strip.desc": "Тонкая колонна тёплого индигового света.",
    "furniture.led_strip.name": "LED-лампа-колонна",
    "furniture.menu_holo_board.desc": "Светится фиолетовым в дождь. Шрифт можно увеличить.",
    "furniture.menu_holo_board.name": "Голодоска с меню",
    "furniture.mosaic_rug.desc": "Ковёр с узором в стиле модерн, шалфейного и золотого цвета.",
    "furniture.mosaic_rug.name": "Мозаичный ковёр",
    "furniture.napkin_wall.desc": "Салфетки-благодарности, приколотые в рамке. Каждая — маленькая ночь.",
    "furniture.napkin_wall.name": "Стена салфеток",
    "furniture.oven.desc": "Колачи из неё всегда тёплые.",
    "furniture.oven.name": "Духовка",
    "furniture.pendant_lamp.desc": "Висит над столом и не мешает.",
    "furniture.pendant_lamp.name": "Подвесная лампа",
    "furniture.plant_small.desc": "Зелёная точка в ночи.",
    "furniture.plant_small.name": "Маленькое растение",
    "furniture.plant_tall.desc": "Растёт быстрее долга. Почти.",
    "furniture.plant_tall.name": "Большая монстера",
    "furniture.radio.desc": "Старый ламповый приёмник. Кто его починит, может услышать больше, чем музыку.",
    "furniture.radio.name": "Лидино радио",
    "furniture.record_shelf.desc": "Полка для конвертов и историй. Меломаны у неё задерживаются.",
    "furniture.record_shelf.name": "Полка для пластинок",
    "furniture.register.desc": "Принимает карты, телефоны и старые добрые монеты. Кроме чехословацких.",
    "furniture.register.name": "Касса",
    "furniture.rug.desc": "Глушит шаги и ссоры.",
    "furniture.rug.name": "Ковёр",
    "furniture.sink.desc": "Сюда несут грязную посуду и здесь её моют. Без неё чашки сами не помоются. Увы.",
    "furniture.sink.name": "Мойка",
    "furniture.sofa.desc": "Мягкий, как конец смены. Гости задерживаются дольше.",
    "furniture.sofa.name": "Диван",
    "furniture.stage_corner.desc": "Ковёр, микрофон и смелость. Открывает вечера открытого микрофона.",
    "furniture.stage_corner.name": "Маленькая сцена",
    "furniture.stool.desc": "Для тех, у кого есть четыре минуты.",
    "furniture.stool.name": "Барный стул",
    "furniture.stove.desc": "Супы, тосты и всё, что согревает.",
    "furniture.stove.name": "Плита",
    "furniture.table_round.desc": "Для двоих и одного секрета.",
    "furniture.table_round.name": "Круглый столик",
    "furniture.table_socket.desc": "Студенты продадут за него душу. И купят один кофе.",
    "furniture.table_socket.name": "Столик с розеткой",
    "furniture.table_square.desc": "Для компании после смены или концерта.",
    "furniture.table_square.name": "Большой стол",
    "furniture.trash_bin.desc": "Меньше салфеток на полу. Утром его выносят к контейнерам (иногда там ждёт кот).",
    "furniture.trash_bin.name": "Мусорное ведро",
    "furniture.wall.desc": "Держит крышу и фотографии.",
    "furniture.wall.name": "Стена",
    "furniture.window.desc": "Изнутри виден дождь. Снаружи — свет.",
    "furniture.window.name": "Окно",
    "furniture.window_seat.desc": "Вид на перрон и дождь. Кто-то садится здесь в 3:33.",
    "furniture.window_seat.name": "Скамья у окна",
    "guest.clubbers.desc": "Мокрые куртки, громкий смех, хотят всё и сразу. В основном по пятницам и субботам.",
    "guest.clubbers.name": "Публика с концерта",
    "guest.clubbers.one": "С концерта",
    "guest.clubbers.role.f": "Тусовщица",
    "guest.clubbers.role.m": "Тусовщик",
    "guest.drone_operators.desc": "Следят за дронами-курьерами над мокрыми крышами. Пульт не выпускают даже за кофе.",
    "guest.drone_operators.name": "Операторы дронов",
    "guest.drone_operators.one": "Оператор дронов",
    "guest.drone_operators.role.f": "Оператор дронов",
    "guest.drone_operators.role.f.short": "Оператор",
    "guest.drone_operators.role.m": "Оператор дронов",
    "guest.drone_operators.role.m.short": "Оператор",
    "guest.insomniacs.desc": "Чай, колач и кроссворд. Быстрее всех становятся постоянными гостями.",
    "guest.insomniacs.name": "Неспящие",
    "guest.insomniacs.one": "Неспящий",
    "guest.insomniacs.role.f": "Полуночница",
    "guest.insomniacs.role.m": "Полуночник",
    "guest.night_wanderer.desc": "Никто не знает, откуда он взялся. Садится под лампой и щедро оставляет чаевые.",
    "guest.night_wanderer.name": "Ночной странник",
    "guest.night_wanderer.one": "Ночной странник",
    "guest.night_wanderer.role.f": "Прохожая",
    "guest.night_wanderer.role.m": "Прохожий",
    "guest.nurses.desc": "Перерыв короткий, благодарность долгая. Их отзывы весят больше.",
    "guest.nurses.name": "Медики",
    "guest.nurses.one": "Медик",
    "guest.nurses.role.f": "Медсестра",
    "guest.nurses.role.m": "Медбрат",
    "guest.patrol.desc": "Двое полицейских, два кофе, одно «всё в порядке?».",
    "guest.patrol.name": "Ночной патруль",
    "guest.patrol.one": "Полицейский",
    "guest.patrol.role.f": "Полицейская",
    "guest.patrol.role.f.short": "Полицейская",
    "guest.patrol.role.m": "Полицейский",
    "guest.patrol.role.m.short": "Полицейский",
    "guest.shift_workers.desc": "Пересменка в логистическом депо. Ходят гурьбой, едят много, а смены смотрят в Shiftella.",
    "guest.shift_workers.name": "Рабочие смены",
    "guest.shift_workers.one": "Рабочий смены",
    "guest.shift_workers.role.f": "Работница",
    "guest.shift_workers.role.f.short": "Работница",
    "guest.shift_workers.role.m": "Рабочий",
    "guest.shift_workers.role.m.short": "Рабочий",
    "guest.students.desc": "Сидят долго, платят мало, ищут розетку.",
    "guest.students.name": "Студенты",
    "guest.students.one": "Студент",
    "guest.students.role.f": "Студентка",
    "guest.students.role.m": "Студент",
    "guest.taxi_drivers.desc": "Последние таксисты, которые ещё сами держат руль. Быстро кофе — и снова в путь.",
    "guest.taxi_drivers.name": "Таксисты",
    "guest.taxi_drivers.one": "Таксист",
    "guest.taxi_drivers.role.f": "Таксистка",
    "guest.taxi_drivers.role.m": "Таксист",
    "guest.train_crew.desc": "Их расписание живёт в Shiftella, а аппетит — ради супа.",
    "guest.train_crew.name": "Железнодорожники",
    "guest.train_crew.one": "Проводник",
    "guest.train_crew.role.f": "Проводница",
    "guest.train_crew.role.m": "Проводник",
    "guest.travelers.desc": "Приехали, уезжают или ждут пересадки. Чемоданы занимают место.",
    "guest.travelers.name": "Пассажиры",
    "guest.travelers.one": "Путник",
    "guest.travelers.role.f": "Пассажирка",
    "guest.travelers.role.m": "Пассажир",
    "guest.truckers.desc": "Их фуры теперь ездят сами. А супа им всё равно хочется.",
    "guest.truckers.name": "Дальнобойщики",
    "guest.truckers.one": "Дальнобойщик",
    "guest.truckers.role.f": "Дальнобойщица",
    "guest.truckers.role.f.short": "Водитель",
    "guest.truckers.role.m": "Дальнобойщик",
    "guest.truckers.role.m.short": "Водитель",
    "habit.cash_up.note": "Деньги считай медленно. Кто спешит, тот ошибается, а потом не спит.",
    "habit.cash_up.perk": "касса быстрее в начале следующей ночи",
    "habit.check_stock.note": "Полки считай руками, не глазами. Глаза врут, пальцы — нет.",
    "habit.check_stock.perk": "раннее предупреждение о запасах",
    "habit.clean_machine.note": "Почисти головку машины, даже когда устала. Особенно когда устала.",
    "habit.clean_machine.perk": "машина изнашивается медленнее",
    "habit.coffee_warmup.note": "Машина как старый пёс. Погладить, подождать — и тогда она сделает всё.",
    "habit.coffee_warmup.perk": "бар быстрее первые полчаса",
    "habit.count_float.note": "Мелочь в лоток каждый вечер. Кто знает свою кассу, тот не спешит.",
    "habit.count_float.perk": "касса чуть быстрее всю ночь",
    "habit.fridge_check.note": "Холодильник закрывай, как дверь за гостем. Тихо и с благодарностью.",
    "habit.fridge_check.perk": "холодильник изнашивается медленнее",
    "habit.handover_note.note": "Утренней смене оставь хоть строчку. Даже «всё в порядке» — это письмо.",
    "habit.handover_note.perk": "следующее открытие идёт чуть быстрее",
    "habit.light_off_at_six.note": "Гаси в шесть, ни минутой раньше. Обещание держится и на рассвете.",
    "habit.light_off_at_six.perk": "следующая ночь уютнее",
    "habit.light_window.note": "Зажечь окно раньше, чем придёт первый гость. Кто идёт ночью, ищет свет, а не вывеску.",
    "habit.light_window.perk": "лампа в окне делает всю ночь уютнее",
    "habit.menu_board.note": "На доске пиши, будто пишешь письмо. Люди заказывают то, что им кто-то написал.",
    "habit.menu_board.perk": "фирменные блюда продаются чуть лучше",
    "habit.record_on.note": "Пластинку ставь раньше, чем отопрёшь дверь. Кафе должно согреться, как чашка.",
    "habit.record_on.perk": "первый час уютнее",
    "habit.wash_dishes.note": "Чашки мой в конце, а не утром. Кто придёт утром, заслуживает чистую чашку.",
    "habit.wash_dishes.perk": "зал остаётся чуть чище",
    "habit.wipe_tables.note": "Протри стол, даже если он чистый. Гость не увидит, но почувствует.",
    "habit.wipe_tables.perk": "зал начинает ночь чуть чище",
