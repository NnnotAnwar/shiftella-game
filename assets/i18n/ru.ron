    "taste.bitter": "Горькое",
    "taste.cold": "Холодное",
    "taste.comforting": "Уютное",
    "taste.fancy": "Изысканное",
    "taste.filling": "Сытное",
    "taste.fresh": "Свежее",
    "taste.mild": "Мягкое",
    "taste.quick": "Быстрое",
