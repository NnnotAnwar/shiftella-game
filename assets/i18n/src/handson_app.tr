uk {name}: «Донька захворіла. Можна мені піти о {time}?»
ru {name}: «Дочка заболела. Можно мне уйти в {time}?»

app.request.early_leave
cs {name}: „Můžu odejít v {time}?“
en {name}: "Could I go at {time}?"
uk {name}: «Можна мені піти о {time}?»
ru {name}: «Можно мне уйти в {time}?»

app.request.manage
cs {name}: „Zvládnu to.“
en {name}: "I'll manage."
