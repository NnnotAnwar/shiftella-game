cs spropitné +{n} %
en tips +{n} %
uk чайові +{n} %
ru чаевые +{n} %

purchases.perk.stay
cs delší návštěvy +{n} %
en stays +{n} %
uk довші візити +{n} %
ru визиты дольше +{n} %

purchases.perk.review
cs recenze +{n} %
en reviews +{n} %
