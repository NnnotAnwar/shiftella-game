# --- build cards: the expected effect ----------------------------------------------------------
purchases.card.seats
cs Míst v sále: {now} → {with} · asi +{n} hostů za noc
en Seats in the hall: {now} → {with} · about +{n} guests a night
uk Місць у залі: {now} → {with} · близько +{n} гостей за ніч
ru Мест в зале: {now} → {with} · около +{n} гостей за ночь

purchases.card.comfy
cs Pohodlné: pobyt +{stay} %, spropitné +{tips} %, druhá runda {round} %
en Comfy: stays +{stay} %, tips +{tips} %, a second round {round} %
uk Зручно: візит +{stay} %, чайові +{tips} %, друга порція {round} %
ru Удобно: визит +{stay} %, чаевые +{tips} %, второй заказ {round} %

purchases.card.hard
cs Tvrdé: hosté odejdou dřív a nechají o něco méně
en Hard: guests leave sooner and tip a little less
uk Тверде: гості підуть раніше й лишать трохи менше
ru Жёстко: гости уйдут раньше и оставят чуть меньше

purchases.card.parallel
cs Druhý kus: dva nápoje najednou (ty a pomocník)
en A second one: two at once (you and a helper)
uk Ще один: два напої разом (ти й помічник)
ru Ещё один: два напитка сразу (ты и помощник)

purchases.card.parallel_first
cs Bez něj se tu nic neuvaří
en Nothing gets made here without one
uk Без нього тут нічого не приготуєш
ru Без него здесь ничего не приготовишь



purchases.card.unlocks
cs Přidá do menu: {items}
en Puts on the menu: {items}
uk Додає в меню: {items}
ru Добавляет в меню: {items}

purchases.card.no_more
cs Těch už máš dost — další nic nepřidá
en You have enough of these — another adds nothing
uk Цих уже досить — ще один нічого не додасть
ru Этих уже хватает — ещё один ничего не добавит

purchases.card.cozy
cs Atmosféra {value} ({level}) · {next}
en Atmosphere {value} ({level}) · {next}
uk Атмосфера {value} ({level}) · {next}
ru Атмосфера {value} ({level}) · {next}

purchases.card.cozy_next
cs {level} od {at}: {perks}
en {level} at {at}: {perks}
uk {level} від {at}: {perks}
ru {level} от {at}: {perks}

# --- the guest's hover line --------------------------------------------------------------------
purchases.guest.comfy
cs pohodlně usazení — zůstanou déle
en comfy seat — staying a while
uk зручне місце — посидять довше
ru удобное место — посидят подольше

purchases.guest.hard
cs tvrdá stolička — dlouho nevydrží
en hard stool — won't stay long
uk твердий стілець — довго не всидять
ru жёсткий табурет — долго не усидят

# --- regulars' wishes in a hall that feels like home (wishes.ron, CozinessAtLeast 85) ------------
wish.mirek.like_home
cs „Je tu teplo jako dřív u Lidy. Dej mi něco, u čeho se dá posedět.“
en "It's warm in here like it used to be at Lida's. Give me something to sit with."
uk «Тут тепло, як колись у Ліди. Дай щось, із чим можна посидіти.»
ru «Тут тепло, как раньше у Лиды. Дай что-нибудь, с чем можно посидеть.»

wish.hana.like_home
cs „Dneska nikam nespěchám. Něco teplého a jemného, prosím.“
en "I'm in no hurry tonight. Something warm and gentle, please."
uk «Сьогодні я нікуди не поспішаю. Щось тепле й ніжне, будь ласка.»
ru «Сегодня я никуда не спешу. Что-нибудь тёплое и мягкое, пожалуйста.»

wish.vera.like_home
cs „Takhle to tu vypadalo, když byla Lida mladá. Něco sladkého k tomu, děvče.“
en "This is how it looked when Lida was young. Something sweet to go with it, dear."
uk «Так тут було, коли Ліда була молодою. Щось солоденьке до цього, дитино.»
ru «Так здесь было, когда Лида была молодой. Что-нибудь сладкое к этому, детка.»
