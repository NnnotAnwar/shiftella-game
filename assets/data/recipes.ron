// The pantry and the recipe book (design/handson.md §4). Keys: ingredient.<id>.name,
// ingredient.family.<family>, recipe.<id>.name/.desc/.lore (+ .teach for Taught recipes),
// book.hint.<source>, book.gated.<recipe>, experiment.nothing.<n>.
// A recipe rides on a menu item (base_item) for station, job, prep, price, cost and power.
// Ingredient sets are unique (an exact pantry match names exactly one recipe).
#![enable(implicit_some)]
(
    ingredients: [
        // --- bar shelf -------------------------------------------------------------------------
        (id: "espresso", family: Coffee, shelf: Bar),
        (id: "milk", family: Milk, shelf: Bar),
        (id: "oat_milk", family: Milk, shelf: Bar, unlock: When([NightAtLeast(3)])),
        (id: "cream", family: Milk, shelf: Bar),
        (id: "black_tea", family: Tea, shelf: Bar),
        // grandma's linden card arrives on night 2
        (id: "linden", family: Tea, shelf: Bar, unlock: When([NightAtLeast(2)])),
        (id: "mountain_herbs", family: Tea, shelf: Bar, unlock: When([HiredArchetype("server")]), sandbox_night: 6),
        (id: "lemon", family: Fruit, shelf: Bar),
        (id: "honey", family: Sweet, shelf: Bar),
        (id: "sugar", family: Sweet, shelf: Bar),
        (id: "spice", family: Spice, shelf: Bar, unlock: When([NightAtLeast(4)])),
        (id: "chili", family: Spice, shelf: Bar, unlock: When([ArcAtLeast("lori", 1)]), sandbox_night: 11),
        (id: "cocoa", family: Sweet, shelf: Bar, unlock: When([NightAtLeast(6)])),
        (id: "vanilla", family: Sweet, shelf: Bar, unlock: When([NightAtLeast(8)])),
        // from Oleh's parcel from Lviv (m_parcel_lviv)
        (id: "dried_fruit", family: Fruit, shelf: Bar, unlock: Granted, sandbox_night: 10),
        (id: "ice", family: Cold, shelf: Bar),
        (id: "tonic", family: Cold, shelf: Bar, unlock: When([ArcAtLeast("filip", 1)]), sandbox_night: 9),
        // the drone owner's thank-you parcel (m_drone_wrong_address)
        (id: "butterfly_pea", family: Fruit, shelf: Bar, unlock: Granted),
        (id: "red_wine", family: Fruit, shelf: Bar, unlock: When([NightAtLeast(12)])),
        // --- kitchen shelf ---------------------------------------------------------------------
        (id: "bread", family: Dough, shelf: Kitchen),
        (id: "garlic", family: Savoury, shelf: Kitchen),
        (id: "potato", family: Savoury, shelf: Kitchen),
        // with the varenyky (night 8) or Vera's kulajda card, whichever comes first
        (id: "mushroom", family: Savoury, shelf: Kitchen, unlock: When([Any([NightAtLeast(8), Flag("recipe_kulajda")])])),
        (id: "beetroot", family: Savoury, shelf: Kitchen, unlock: When([HiredArchetype("sound_tech")]), sandbox_night: 10),
        (id: "tvaroh", family: Dough, shelf: Kitchen, unlock: When([NightAtLeast(2)])),
        (id: "bryndza", family: Savoury, shelf: Kitchen, unlock: When([NightAtLeast(8)])),
        (id: "poppy_seed", family: Sweet, shelf: Kitchen, unlock: When([ArcAtLeast("vera", 1)]), sandbox_night: 7),
        (id: "plum_jam", family: Fruit, shelf: Kitchen, unlock: When([NightAtLeast(2)])),
    ],
    recipes: [
        // --- starters (known on night 1) ----------------------------------------------------------
        (id: "r_black", base_item: "black_coffee", tags: [Warm, Bitter, Strong, Quick],
         minigame: PourOver, variants: ["classic"], ingredients: ["espresso"]),
        (id: "r_cappuccino", base_item: "cappuccino", tags: [Warm, Mild, Comforting],
         minigame: MilkFroth, variants: ["cappuccino"], ingredients: ["espresso", "milk"], art_finish: true),
        (id: "r_lemon_tea", base_item: "lemon_tea", tags: [Warm, Mild, Fresh, Quick],
         minigame: TeaSteep, variants: ["lemon"], ingredients: ["black_tea", "lemon"]),
        (id: "r_topinka", base_item: "topinka", tags: [Warm, Filling, Quick],
         minigame: Plate, variants: ["topinka"], ingredients: ["bread", "garlic"]),
        (id: "r_garlic_soup", base_item: "garlic_soup", tags: [Warm, Filling, Comforting],
         minigame: SoupStir, variants: ["garlic"], fallback_minigame: Plate, fallback_variant: "soup",
         ingredients: ["garlic", "potato", "bread"]),
        (id: "r_chlebicek", base_item: "chlebicek", tags: [Cold, Quick, Fancy],
         minigame: Plate, variants: ["chlebicek"], ingredients: ["bread", "potato"]),

        // --- grandma's cards (learned when the menu item unlocks) ---------------------------------
        (id: "r_kolac", base_item: "kolac", tags: [Sweet, Quick, Comforting],
         minigame: Plate, variants: ["kolac"], ingredients: ["tvaroh", "plum_jam"], unlock: WithMenu),
        (id: "r_oat_flat_white", base_item: "oat_flat_white", tags: [Warm, Mild, Fancy],
         minigame: LatteArt, variants: ["flat_white"], ingredients: ["espresso", "oat_milk"], unlock: WithMenu),
        (id: "r_medovnik", base_item: "medovnik", tags: [Sweet, Fancy, Cold],
         minigame: Plate, variants: ["medovnik"], ingredients: ["honey", "cream"], unlock: WithMenu),
        (id: "r_chai", base_item: "chai", tags: [Warm, Sweet, Spiced, Comforting],
         minigame: TeaSteep, variants: ["chai"], ingredients: ["black_tea", "milk", "spice"], unlock: WithMenu),
        (id: "r_hot_chocolate", base_item: "hot_chocolate", tags: [Warm, Sweet, Comforting],
         minigame: MilkFroth, variants: ["chocolate"], ingredients: ["cocoa", "milk"], unlock: WithMenu,
         art_finish: true),
        (id: "r_varenyky", base_item: "varenyky", tags: [Warm, Filling, Comforting],
         minigame: Plate, variants: ["varenyky"], ingredients: ["potato", "mushroom"], unlock: WithMenu),
        (id: "r_pirohy", base_item: "bryndzove_pirohy", tags: [Warm, Filling],
         minigame: Plate, variants: ["pirohy"], ingredients: ["potato", "bryndza"], unlock: WithMenu),
        (id: "r_night_train", base_item: "night_train", tags: [Strong, Bitter, Spiced, Fancy],
         minigame: PourOver, variants: ["night_train"], ingredients: ["espresso", "cocoa", "spice"], unlock: WithMenu),
        (id: "r_svarak", base_item: "svarak", tags: [Warm, Sweet, Spiced, Fancy],
         minigame: MulledSpice, variants: ["svarak"], fallback_minigame: MilkFroth, fallback_variant: "svarak",
         ingredients: ["red_wine", "spice", "sugar"], unlock: WithMenu),

        // --- story and the people who teach --------------------------------------------------------
        (id: "r_kulajda", base_item: "grandma_kulajda", tags: [Warm, Filling, Comforting, Fancy],
         minigame: SoupStir, variants: ["kulajda"], fallback_minigame: Plate, fallback_variant: "soup",
         ingredients: ["potato", "mushroom", "cream"],
         unlock: Story(when: [Flag("recipe_kulajda")]), experimentable: false,
         hint: "book.hint.vera", gated_hint: "book.gated.r_kulajda"),
        (id: "r_turek", base_item: "black_coffee", price_add: 5, tags: [Strong, Bitter, Warm],
         minigame: PourOver, variants: ["turek"], ingredients: ["espresso", "sugar"],
         unlock: Taught(by: "mirek", when: [ArcAtLeast("mirek", 1)]), hint: "book.hint.taxi_rank"),
        (id: "r_vera_kolac", base_item: "kolac", price_add: 10, cost_add: 3, tags: [Warm, Sweet, Comforting],
         minigame: Plate, variants: ["vera_kolac"], ingredients: ["poppy_seed", "tvaroh"],
         unlock: Taught(by: "vera", when: [TrustAtLeast("vera", 40.0)]), hint: "book.hint.vera"),
        (id: "r_rn333_tea", base_item: "lemon_tea", tags: [Warm, Sweet, Mild],
         minigame: TeaSteep, variants: ["two_sugars"], ingredients: ["black_tea", "lemon", "sugar"],
         unlock: Story(when: [Any([Flag("strange_tea_two_sugars"), ArcAtLeast("guest_333", 1)])]),
         hint: "book.hint.guest_333"),
        (id: "r_lori_encore", base_item: "hot_chocolate", price_add: 10, cost_add: 2, tags: [Warm, Sweet, Spiced],
         minigame: MilkFroth, variants: ["encore"], ingredients: ["cocoa", "milk", "chili"],
         unlock: Taught(by: "lori", when: [Flag("lori_invited")]), hint: "book.hint.lori"),
        (id: "r_linden_tea", base_item: "lemon_tea", price_add: 10, cost_add: 2, tags: [Warm, Mild, Comforting, Sweet],
         minigame: TeaSteep, variants: ["linden"], ingredients: ["linden", "honey"],
         unlock: Experiment, hint: "book.hint.grandma_card", revealed: ["linden", "honey"]),
        (id: "r_moon_latte", base_item: "oat_flat_white", price_add: 20, cost_add: 6, tags: [Warm, Fancy, Mild, Sweet],
         minigame: LatteArt, variants: ["moon"], ingredients: ["oat_milk", "butterfly_pea", "honey"],
         unlock: Experiment, hint: "book.hint.pantry"),

        // --- SHOULD: the crew's recipes -------------------------------------------------------------
        (id: "r_raf", base_item: "cappuccino", price_add: 15, cost_add: 4, tags: [Sweet, Mild, Fancy, Comforting],
         minigame: MilkFroth, variants: ["raf"], ingredients: ["espresso", "cream", "vanilla"],
         unlock: Taught(by: "sound_tech", when: [ShiftsWorked("sound_tech", 2)]), hint: "book.hint.oleh",
         art_finish: true, tier: Should),
        (id: "r_borscht", base_item: "garlic_soup", price_add: 20, cost_add: 6, tags: [Warm, Filling, Comforting, Fresh],
         minigame: SoupStir, variants: ["borscht"], fallback_minigame: Plate, fallback_variant: "soup",
         ingredients: ["beetroot", "potato", "cream"],
         unlock: Taught(by: "sound_tech", when: [ShiftsWorked("sound_tech", 4)]), hint: "book.hint.oleh", tier: Should),
        (id: "r_buchty", base_item: "kolac", price_add: 10, cost_add: 3, tags: [Sweet, Comforting, Filling],
         minigame: Plate, variants: ["buchty"], ingredients: ["plum_jam", "milk"],
         unlock: Taught(by: "porter", when: [Any([ShiftsWorked("porter", 5), SharedShifts(a: "porter", b: "cook", shifts: 3)])]),
         hint: "book.hint.kuba", tier: Should),
        (id: "r_tatra_tea", base_item: "chai", price_add: 5, cost_add: 2, tags: [Warm, Spiced, Comforting, Fresh],
         minigame: TeaSteep, variants: ["tatra"], ingredients: ["mountain_herbs", "honey", "lemon"],
         unlock: Taught(by: "server", when: [ShiftsWorked("server", 2)]), hint: "book.hint.natalia", tier: Should),
        (id: "r_espresso_tonic", base_item: "black_coffee", price_add: 25, cost_add: 8, tags: [Cold, Fresh, Bitter, Fancy],
         minigame: PourOver, variants: ["tonic"], ingredients: ["espresso", "tonic", "ice"],
         unlock: Taught(by: "filip", when: [ArcAtLeast("filip", 1)]), hint: "book.hint.filip", tier: Should),
        (id: "r_uzvar", base_item: "lemon_tea", price_add: 10, cost_add: 3, tags: [Warm, Sweet, Fresh, Comforting],
         minigame: TeaSteep, variants: ["uzvar"], ingredients: ["dried_fruit", "honey"],
         unlock: Experiment, hint: "book.hint.lviv_parcel", tier: Should),
    ],
    experiment: (min: 2, max: 3, nothing_lines: 6),
)
