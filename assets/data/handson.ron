// Hands-on tuning (design/handson.md §1, §7.1, §12). Karolina = the player actor.
// Times are game minutes unless a name says _s (real seconds). Tune with `sim_headless --player-bot`.
#![enable(implicit_some)]
(
    // ×1: 0.13 real s per tick → 10.4 real minutes of sim (×2: 5.2, ×3: 3.5); with the order
    // cards and 6–14 mini-games a night at ×1 is 12–14 real minutes (T9, sim_balance).
    real_seconds_per_tick_x1: 0.13,
    // The preparation half hour (21:30–22:00, doors closed, no guests) runs a little quicker:
    // ×0.7 → ~27 real seconds at ×1 (the evening stays ~12–14 real minutes); ×2/×3 work too.
    prep_tick_scale: 0.7,
    // Sim dt × this while the order card, a mini-game, the book or a moment card is open.
    // Cozy 0.25: the room still drifts on a little, the night doesn't stretch past 14 minutes.
    overlay_scale: (cozy: 0.25, classic: 0.35),
    // T9: 1.5 (was 1.4) — her nights are mostly walking; it keeps act 1 rushes readable.
    player_walk_mul: 1.5,
    player_work_mul: 1.0,
    // Helpers: (0.5 + skill × 0.1) × helper_speed.
    helper_speed: 0.85,
    helper_quality: (base: 0.35, per_skill: 0.04, max: 0.75),
    quick_quality: 0.6,
    practised_quick_quality: 0.8,
    practised_after: 10,
    practised_min_quality: 0.7,
    by_hand_work_share: 0.3,
    by_hand_streak_max: 3,
    match_tiers: (perfect: 0.99, good: 0.6, okay: 0.3),
    // Chance a non-regular party leader orders a wish (regulars always do).
    wish_chance: [(from_night: 1, chance: 0.4), (from_night: 8, chance: 0.5)],
    sandbox_wish_chance: 0.45,
    fair_wishes: (boost_at: 0.6, boost_mul: 3.0, skip_below: 0.3),
    usual_trust: 50.0,
    hand_off_match_cap: 0.5,
    assist_wishes_after: 15,
    // Wait clock rates (§1.4).
    claimed_wait_rate: 0.5,
    cozy_rush_wait_rate: 0.67,
    cozy_forgiveness: (refill: 0.5, runs: 2, leave_satisfaction: 50.0),
    cozy_regular_patience_floor: 12.0,
    regular_announce_minutes: 2,
    greeting: (window_minutes: 5, satisfaction: 3.0, trust: 0.5),
    rush: (parties: 3, window_minutes: 10, minutes: 20, from_night: 3),
    rhythm: (window_minutes: 4, step: 0.04, max: 0.20),
    serve: (
        satisfaction_match: 10.0, satisfaction_quality: 6.0,
        trust_base: 1.0, trust_match: 3.0, trust_quality: 2.0,
        tip_base: 0.6, tip_span: 0.8,
        classic_not_quite: -2.0,
        latte_neighbour: 1.0,
    ),
    lull_minutes: 6,
    quiet_hour_lull_minutes: 15,
    // Lull director walk-in: guest rate × 2.0 for 10 minutes, story nights ≥ 3 (sandbox always).
    lull_walk_in: (2.0, 10, 3),
    moments_per_night: [
        (act: 1, range: (1, 3)),
        (act: 2, range: (2, 4)),
        (act: 3, range: (2, 4)),
        (act: 4, range: (2, 4)),
    ],
    moment_gap_minutes: 40,
    moments_max_per_night: 5,
    experiment_cost: 10,
    experiment_free_until_night: 7,
    experiment_minutes: 2,
    margin_note_every: 3,
    thanks_chance: (guest: 0.12, regular: 0.25, min_match: 0.8, min_quality: 0.7),
    // a helper holds two duties from the start (owner: "why can't they do several things?")
    capacity: (base: 2, after_nights: 3, skill_bonus_at: 7.0, trait_bonus: "hard_worker", max: 3),
    player_energy: (classic_drain_mul: 0.5, mug_below: 25.0, mug_restore: 40.0),
    quiet_hour: (
        from: "03:00", to: "04:00",
        lamp_dim: 0.15, rain_volume_mul: 1.25, guest_rate_mul: 0.5, wish_share: 0.8,
        toast: "ui.quiet_hour.toast",
    ),
    rozpis: (
        need_penalty: 25.0,
        wish_penalty: 12.0,
        nights_soft_max: 5,
        nights_penalty: 8.0,
        wish_bonus: 4.0,
        wish_bonus_max: 8.0,
        rings: [(id: "happy", min: 85.0), (id: "fine", min: 65.0), (id: "tired", min: 45.0), (id: "stretched", min: 0.0)],
        stdev_weight: 0.5,
        // fairness < 45 rain-but-cosy · < 65 cloudy · < 85 mostly sunny · else sunny (rozpis.week.1..4)
        week_icons: [45.0, 65.0, 85.0],
        mood_baseline_center: 70.0,
        mood_baseline_per: 0.15,
        energy_loss_per: 0.25,
        energy_min: 75.0,
        late_mul: (1.6, 0.5),
        sick_mul: (1.5, 0.6),
        need_violated_swap_chance: 0.5,
        need_violated_mood: -8.0,
        works_with_relationship_per_hour: 1.0,
        works_with_speed: 1.05,
        happy_week_mood: 3.0,
        autofill_wish_cost: 1.0,
        autofill_balance_cost: 0.3,
        autofill_partner_bonus: -0.5,
        autofill_min_nights_bonus: -0.4,
        autofill_need_gap: 2,
        requests: (
            approve_wellbeing: 10.0,
            approve_relationship: 5.0,
            partner_wellbeing: -3.0,
            decline_mood: -6.0,
            decline_need_late: 0.25,
            tired_after: 3,
            tired_window_nights: 14,
            no_answer_mood: -3.0,
            toil_hours: 8.0,
        ),
        pref_rules: (
            from_traits: [
                ("night_owl", Shift(Late)),
                ("early_bird", Shift(Early)),
                ("lazy", MaxNights(3)),
                ("hard_worker", MinNights(5)),
                ("loner", WeekendOff),
                ("anxious", NoBackToBack),
                ("romantic", WorksWithPartner),
            ],
            random: [DayOffRandom, WeekendOff, NoBackToBack, MaxNights(4)],
            need_chance: 0.3,
            max: 3,
        ),
        life_events: [
            // Bára's exam week (story ~night 12, a Friday): Friday off as a Need + a time-off request.
            (id: "barista_exam", staff: "barista", night: 8,
             pref: (kind: DayOff(Fri), strength: Need, quote: "staff.barista.pref.exam"),
             request: TimeOff, placeholders: ["name", "day"]),
            // Ivana's daughter is ill: "Can I go at 2?"
            (id: "cashier_daughter", staff: "cashier", night: 15, request: EarlyLeave,
             placeholders: ["name", "time"]),
        ],
    ),
    // Hands-on appliances (design/v0.2.md §B, sim::equipment): one click or one hold at the
    // machine, the stove, the oven, the fridge, the register, the bin; lamps toggle. Work is in
    // ticks at speed 1 (10 = one game minute); holding a hold chore adds hold_ticks_per_second.
    // Effects are small: a no-appliance player still finishes the story (tests_t10).
    equipment: (
        work: (warm_up: 30.0, pull_tray: 25.0, service: 40.0, clean_up: 30.0, soup_on: 25.0,
               stir: 8.0, bake: 25.0, take_out: 8.0, milk: 10.0, count_till: 30.0, trash: 25.0),
        hold_ticks_per_second: 40.0,
        service_wear: 0.5,
        sputter_every: 25,
        // "pull a tray ahead" before a train: the next 3 plain coffees are (almost) instant
        tray: (count: 3, minutes: 40, prep_mul: 0.05, items: ["black_coffee", "cappuccino", "oat_flat_white"]),
        // the milk out of the fridge in the preparation: the first lattes are quicker
        milk: (count: 5, helper_count: 3, prep_mul: 0.7, until_minute: 60,
               items: ["cappuccino", "oat_flat_white", "hot_chocolate", "chai"]),
        // a pot of soup (kulajda once grandma's recipe is known): bubbles now and then, a stir
        // makes soups quicker for a while; untouched it simply keeps warm
        soup: (items: ["garlic_soup", "grandma_kulajda"], warm_mul: 0.9, helper_warm_mul: 0.95,
               stir_mul: 0.6, stir_minutes: 30, bubble_every: 35, bubble_minutes: 12, until_minute: 120),
        // grandma's medovník: ding → take it out → slices without waiting tonight
        cake: (items: ["medovnik", "kolac"], bake_minutes: 12, slices: 8, helper_slices: 4,
               prep_mul: 0.05, helper_after: 10, until_minute: 120),
        // from 05:00: count the till, take the trash out (sometimes the station cat is there)
        closing: (from_minute: 420, trash_dirt: 0.03, cat_chance: 0.35),
    ),
)
