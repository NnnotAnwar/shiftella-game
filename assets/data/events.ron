// Night events (the narrator). Keys: event.<id>.title / .text, event.<id>.choice.<choice>,
// event.<id>.result.<choice>. trigger: Random (weights) | Auto (state-driven) | Scripted (story only).
// Choices are answered in a non-blocking toast; default_choice applies on timeout.
#![enable(implicit_some)]
[
    // ---------------------------------------------------------------- weather & town
    (id: "rain", kind: Neutral, severity: 1, weight: 50.0, cooldown: 1,
     conditions: [Raining, TimeBetween("22:00", "23:30")],
     effects: [GuestRate(mul: 1.2, minutes: None), Dirt(0.05)]),
    (id: "downpour", kind: Neutral, severity: 2, weight: 30.0, cooldown: 2,
     conditions: [Raining, TimeBetween("22:30", "03:00")],
     effects: [SetWeather(Downpour), GuestRate(mul: 2.0, minutes: 120), DirtRate(mul: 2.0, minutes: 120)]),
    (id: "fog", kind: Neutral, severity: 1, weight: 20.0, cooldown: 2,
     conditions: [Any([Season(Autumn), Season(Winter)]), TimeBetween("01:00", "05:00")],
     effects: [SetWeather(Fog), GuestRate(mul: 0.6, minutes: None), EventWeight(event: "phantom_horn", mul: 3.0, nights: 1)]),
    (id: "storm", kind: Bad, severity: 2, weight: 10.0, cooldown: 3,
     conditions: [Any([Season(Summer), Season(Autumn)])],
     effects: [SetWeather(Storm), GuestRate(mul: 1.5, minutes: None), GuestStay(30),
               Maybe(chance: 0.3, effects: [Later(minutes: 20, effects: [StartEvent("power_outage")])])]),
    (id: "first_snow", kind: Good, severity: 1, weight: 5.0, cooldown: 60, min_night: 20,
     conditions: [Any([Season(Autumn), Season(Winter)])],
     effects: [SetWeather(Snow), StaffMood(10.0), GuestSatisfaction(10.0)]),
    (id: "roof_leak", kind: Bad, severity: 1, weight: 15.0, cooldown: 3,
     conditions: [Raining, NotFlag("roof_fixed")],
     effects: [BlockTile, DirtRate(mul: 1.5, minutes: None)],
     choices: [
        (id: "bucket"),
        (id: "roofer", cost: -900, effects: [Money(-900)], set_flag: "roof_fixed"),
     ],
     default_choice: "bucket"),

    // ---------------------------------------------------------------- crowds
    (id: "concert_crowd", kind: Neutral, severity: 2, weight: 25.0, cooldown: 2,
     conditions: [Weekday([Fri, Sat]), TimeBetween("23:00", "00:30")],
     effects: [GuestRush(guest: "clubbers", count: (8, 12), within: 10, patience_mul: 0.7)]),
    (id: "late_train", kind: Neutral, severity: 2, weight: 20.0, cooldown: 2,
     conditions: [TimeBetween("00:00", "03:00")],
     effects: [GuestRush(guest: "travelers", count: (5, 8), within: 20, orders: ["topinka", "garlic_soup", "varenyky", "black_coffee"])]),
    (id: "taxi_break", kind: Neutral, severity: 1, weight: 20.0, cooldown: 1,
     conditions: [TimeBetween("03:00", "04:00"), Institution("taxi_rank")],
     effects: [GuestRush(guest: "taxi_drivers", count: (4, 6), within: 10, patience_mul: 0.6, orders: ["black_coffee"]),
               Tips(mul: 2.0, minutes: 30)]),
    (id: "hospital_shift", kind: Neutral, severity: 1, weight: 20.0, cooldown: 1,
     conditions: [TimeBetween("05:30", "06:00"), Institution("hospital")],
     effects: [GuestRush(guest: "nurses", count: (3, 5), within: 10, orders: ["garlic_soup", "cappuccino"]),
               If(conditions: [ArcAtLeast("hana", 3)], then: [GuestRush(guest: "nurses", count: (2, 2), within: 10)])]),
    (id: "depot_shift", kind: Neutral, severity: 1, weight: 15.0, cooldown: 1,
     conditions: [TimeBetween("05:20", "06:00"), Institution("depot")],
     effects: [GuestRush(guest: "shift_workers", count: (3, 6), within: 10)]),
    (id: "student_party", kind: Bad, severity: 2, weight: 15.0, cooldown: 2,
     conditions: [Weekday([Thu, Fri, Sat]), TimeBetween("01:00", "03:00"), Institution("college")],
     effects: [GuestRush(guest: "students", count: (6, 10), within: 15), DirtRate(mul: 3.0, minutes: 60),
               EventWeight(event: "dine_and_dash", mul: 2.0, nights: 1)]),
    (id: "lost_bus", kind: Neutral, severity: 3, weight: 3.0, cooldown: 10, modes: Sandbox, min_night: 10,
     effects: [GuestRush(guest: "travelers", count: (15, 15), within: 20, spend_mul: 1.5, orders: ["garlic_soup", "topinka", "black_coffee"])]),
    (id: "open_mic", kind: Good, severity: 1, weight: 10.0, cooldown: 2,
     conditions: [Weekday([Fri, Sat]), HasFurnitureTag("stage"), Any([ArcAtLeast("lori", 2), Mode(Sandbox)])],
     effects: [GuestRate(mul: 1.6, minutes: 120), GuestSatisfaction(10.0), TraitMood("music_lover", 10.0),
               WorkSpeed(job: Register, mul: 0.9, minutes: 120)]),

    // ---------------------------------------------------------------- staff
    (id: "staff_sick", kind: Bad, severity: 2, weight: 15.0, cooldown: 3,
     conditions: [TimeBetween("21:30", "22:30"), StaffOnShiftAtLeast(2)],
     effects: [StaffSick, Bot("sick_call")]),
    (id: "staff_walkout", kind: Bad, severity: 3, trigger: Auto,
     conditions: [StaffMoodBelow(15.0)],
     effects: [StaffWalkout, StaffMood(-5.0)]),
    (id: "broken_dishes", kind: Bad, severity: 1, trigger: Auto,
     effects: [Money(-30), Dirt(0.03)]),
    (id: "staff_quarrel", kind: Bad, severity: 2, weight: 15.0, cooldown: 2,
     conditions: [RelationshipBelow(-30.0)],
     effects: [PairMood(-15.0), WorkSpeed(job: None, mul: 0.8, minutes: 60)],
     choices: [
        (id: "talk", effects: [PairMood(8.0), Relationship(add: 10.0, minutes: None)]),
        (id: "let_be"),
     ],
     default_choice: "let_be"),
    (id: "staff_romance", kind: Good, severity: 1, weight: 10.0, cooldown: 5,
     conditions: [RelationshipAbove(80.0)],
     effects: [PairMood(10.0), WorkSpeed(job: None, mul: 1.1, minutes: None)]),
    (id: "staff_inspired", kind: Good, severity: 1, weight: 10.0, cooldown: 3,
     conditions: [StaffInspired(mood: 80.0, skill: 6.0)],
     effects: [SkillBoost(add: 1.0, nights: 3)]),
    (id: "staff_birthday", kind: Good, severity: 1, weight: 6.0, cooldown: 10,
     effects: [StaffMood(15.0)],
     choices: [
        (id: "cake", cost: -150, effects: [Money(-150), Relationship(add: 5.0, minutes: None)]),
        (id: "sing"),
     ],
     default_choice: "sing"),

    // ---------------------------------------------------------------- equipment & business
    (id: "power_outage", kind: Bad, severity: 2, weight: 12.0, cooldown: 3,
     effects: [PowerOutage(minutes: (30, 60))],
     choices: [
        (id: "candles", cost: -150, effects: [Money(-150), GuestSatisfaction(5.0)]),
        (id: "close_kitchen", effects: [StationDown(tag: "station:stove", minutes: 60), WorkSpeed(job: Kitchen, mul: 0.0, minutes: 60)]),
     ],
     default_choice: "candles"),
    (id: "coffee_machine", kind: Bad, severity: 1, weight: 18.0, cooldown: 2,
     conditions: [WearAtLeast("station:coffee", 0.5)],
     effects: [StationSlow(tag: "station:coffee", mul: 0.5)],
     choices: [
        (id: "fix_ourselves", effects: [StationDown(tag: "station:coffee", minutes: 20)]),
        (id: "call_service", cost: -400, effects: [Money(-400)]),
     ],
     default_choice: "fix_ourselves"),
    (id: "fridge_fail", kind: Bad, severity: 2, weight: 8.0, cooldown: 4,
     conditions: [WearAtLeast("station:fridge", 0.6)],
     effects: [LoseStock(0.3), MenuUnavailable(item: "garlic_soup", until: None), MenuUnavailable(item: "medovnik", until: None)]),
    (id: "supplier_late", kind: Bad, severity: 1, weight: 12.0, cooldown: 2,
     conditions: [TimeBetween("22:00", "22:30"), Not(HasFurnitureTag("drone"))],
     effects: [MenuUnavailable(item: "cappuccino", until: "02:00"), MenuUnavailable(item: "oat_flat_white", until: "02:00"),
               MenuUnavailable(item: "hot_chocolate", until: "02:00")]),
    (id: "health_inspection", kind: Neutral, severity: 2, weight: 6.0, cooldown: 6, min_night: 5,
     effects: [Later(minutes: 60, effects: [
        If(conditions: [Not(DirtAtLeast(0.3))],
           then: [Reputation(5.0), Toast("event.health_inspection.pass")],
           otherwise: [If(conditions: [DirtAtLeast(0.6)],
                          then: [Money(-2000), Reputation(-10.0), Toast("event.health_inspection.fine")],
                          otherwise: [Toast("event.health_inspection.warning")])]),
     ])]),
    (id: "night_blogger", kind: Neutral, severity: 1, weight: 8.0, cooldown: 4,
     conditions: [ReputationAtLeast(30.0)],
     effects: [SpawnGuest("night_wanderer"), ReviewWeight(guest: "night_wanderer", mult: 3.0, reviews: 1)]),
    (id: "dine_and_dash", kind: Bad, severity: 1, weight: 10.0, cooldown: 2,
     conditions: [QueueAtLeast(4)],
     effects: [Money(-90)]),
    (id: "big_tip", kind: Good, severity: 1, weight: 12.0, cooldown: 2,
     effects: [MoneyRange(300, 800), StaffMood(5.0)]),
    (id: "police_patrol", kind: Good, severity: 1, weight: 12.0, cooldown: 2,
     conditions: [TimeBetween("01:00", "04:00")],
     effects: [GuestRush(guest: "patrol", count: (2, 2), within: 5), EventWeight(event: "dine_and_dash", mul: 0.0, nights: 2), Reputation(1.0)]),
    (id: "drone_lost", kind: Good, severity: 1, weight: 8.0, cooldown: 4,
     conditions: [TimeBetween("23:00", "04:30")],
     choices: [
        (id: "return_it", effects: [Reputation(2.0), StaffMood(2.0)]),
        (id: "charge_it", cost: -20, effects: [Money(-20), Reputation(3.0)]),
     ],
     default_choice: "return_it"),

    // ---------------------------------------------------------------- the uncanny (quiet wonder, never fear)
    (id: "clock_333", kind: Uncanny, severity: 1, trigger: Auto,
     conditions: [TimeBetween("03:33", "03:34"), WindowLightOn],
     effects: [ClockStop(seconds: 60.0)]),
    (id: "phantom_horn", kind: Uncanny, severity: 1, weight: 10.0, cooldown: 2,
     conditions: [TimeBetween("02:00", "04:00")],
     effects: [TraitMood("light_sleeper", 5.0), TraitMood("anxious", -5.0)]),
    (id: "holo_flicker", kind: Uncanny, severity: 1, weight: 8.0, cooldown: 3,
     conditions: [TimeBetween("01:00", "04:00")],
     effects: [GuestRate(mul: 1.1, minutes: 60)]),
    (id: "station_cat", kind: Good, severity: 1, weight: 10.0, cooldown: 1,
     conditions: [NotFlag("cat_adopted")],
     choices: [
        (id: "feed", cost: -10, effects: [Money(-10), AddCounter("cat_fed_nights", 1), StaffMood(2.0)]),
        (id: "shoo"),
     ],
     default_choice: "feed"),
    (id: "cat_stays", kind: Good, severity: 1, trigger: Auto,
     conditions: [CounterAtLeast("cat_fed_nights", 3), NotFlag("cat_adopted")],
     effects: [SetFlag("cat_adopted"), StaffMood(3.0), TraitMood("kind", 3.0)]),
    (id: "forgotten_item", kind: Neutral, severity: 1, weight: 12.0, cooldown: 2,
     effects: [GiveItem("lost_umbrella")],
     choices: [
        (id: "lost_and_found", effects: [TakeItem("lost_umbrella"), Reputation(3.0)]),
        (id: "keep"),
     ],
     default_choice: "lost_and_found"),
    (id: "strange_order", kind: Uncanny, severity: 1, weight: 6.0, cooldown: 5, min_night: 8,
     choices: [
        (id: "tea_two_sugars", effects: [Reputation(5.0), StaffMood(3.0)]),
        (id: "black_coffee", effects: [GuestSatisfaction(-2.0)]),
        (id: "dont_know", effects: [GuestSatisfaction(2.0)]),
     ],
     default_choice: "dont_know"),
    (id: "lonely_night", kind: Neutral, severity: 1, trigger: Auto,
     conditions: [HardNightsInRow(2), TimeBetween("22:00", "22:10")],
     effects: [GuestRate(mul: 0.3, minutes: None), Relationship(add: 3.0, minutes: 480)]),

    // ---------------------------------------------------------------- story-only scripted events
    (id: "mirek_accident", kind: Bad, severity: 3, trigger: Scripted, modes: Story,
     effects: [ArcBad("mirek"), SetFlag("mirek_gone"), Reputation(-3.0), StaffMood(-10.0)]),
    (id: "storm_blackout", kind: Uncanny, severity: 2, trigger: Scripted, modes: Story,
     effects: [SetWeather(Storm), GuestRate(mul: 1.8, minutes: None), GuestStay(40), StaffMood(5.0)]),
]
