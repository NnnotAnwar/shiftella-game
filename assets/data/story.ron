// Story mode: 30 nights at Café Nocturne next to Praha-Holešovice station, autumn 2039.
// Night keys: story.night.NN.title / .hint. Beat times "HH:MM"; before 22:00 = day phase.
// Big moments are cutscenes (cutscenes.ron, triggered by night/time/arc/flag); beats are the small,
// non-blocking things: bubbles, hints, scripted events, notes, payments, train boards, bot messages.
// The player is Karolina, Lida's granddaughter (feminine forms are fine in cs/uk).
// calendar: night 1 = Mon 7 Nov 2039 … night 30 = Tue 6 Dec 2039 (weekdays below are validated against it).
#![enable(implicit_some)]
(
    nights_total: 30,
    debt: 90000,
    payments: [
        (night: 7, amount: 15000),
        (night: 14, amount: 15000),
        (night: 21, amount: 15000),
        (night: 28, amount: 15000),
        (night: 30, amount: 30000, is_final: true),
    ],
    acts: [
        (act: 1, nights: (1, 7)),
        (act: 2, nights: (8, 16)),
        (act: 3, nights: (17, 24)),
        (act: 4, nights: (25, 30)),
    ],
    // A night title / hint that announces a scene of a floating arc stage gets a fallback: when
    // `needs` doesn't hold (on the day screen; recorded at 22:00 for the journal), `title` /
    // `hint` replace story.night.NN.title / .hint (either may be left out). Several per night:
    // the first whose `needs` fails wins. Keys live in story_ui.tr. Keep `needs` in step with
    // the stage conditions in regulars.ron.
    night_fallbacks: [
        // mirek_curb = Mirek stage 2 (needs stage 1: fast or well-matched coffees)
        (night: 8, needs: [ArcAtLeast("mirek", 1)],
         title: "story_ui.night.08.title", hint: "story_ui.night.08.hint"),
        // hana_asleep = Hana stage 2 (needs stage 1)
        (night: 12, needs: [ArcAtLeast("hana", 1)],
         title: "story_ui.night.12.title", hint: "story_ui.night.12.hint"),
        // vera_recipe = Vera stage 2 (stage 1 + trust 25)
        (night: 14, needs: [ArcAtLeast("vera", 1), TrustAtLeast("vera", 25.0)],
         title: "story_ui.night.14.title", hint: "story_ui.night.14.hint"),
        // guest333_question = stage 2 of 333 (needs stage 1: the window table kept free)
        (night: 15, needs: [ArcAtLeast("guest_333", 1)],
         title: "story_ui.night.15.title", hint: "story_ui.night.15.hint"),
        // mirek_pedestrian = Mirek stage 3 (needs stage 2)
        (night: 20, needs: [ArcAtLeast("mirek", 2)],
         title: "story_ui.night.20.title", hint: "story_ui.night.20.hint"),
        // hana_decision = Hana stage 4 (needs stage 3)
        (night: 26, needs: [ArcAtLeast("hana", 3)],
         title: "story_ui.night.26.title", hint: "story_ui.night.26.hint"),
        // mirek_letter = Mirek stage 5 (the confession happened)
        (night: 28, needs: [ArcAtLeast("mirek", 4), VarIs("letter", "confessed")],
         title: "story_ui.night.28.title", hint: "story_ui.night.28.hint"),
    ],
    nights: [
        (night: 1, act: 1, weekday: Mon, weather: Rain, beats: [
            (at: "21:55", what: Bot("hello")),
            (at: "22:00", what: Hint("story.hint.first_order")),
            (at: "22:47", what: Train("Os 2141")),
            (at: "23:20", what: Hint("story.hint.payment")),
            (at: "05:50", what: Hint("story.hint.morning")),
        ]),
        // nights 1–2: Karolina works alone; the first helper is hired on night 3 (handson.md §0.2)
        (night: 2, act: 1, weekday: Tue, beats: [
            (at: "22:05", what: Note("note_01")),
        ]),
        (night: 3, act: 1, weekday: Wed, weather: Rain, beats: [
            (at: "21:30", what: Hint("story.hint.hire")),
            (at: "21:45", what: Hint("story.hint.schedule")),
            (at: "22:00", what: Event("rain")),
            (at: "23:30", what: Hint("story.hint.duties")),
            (at: "01:50", what: Hint("story.hint.regulars")),
            (at: "04:00", what: Hint("story.hint.build")),
        ]),
        (night: 4, act: 1, weekday: Thu, beats: [
            (at: "23:10", what: Line(speaker: "mirek", text_key: "story.line.04_mirek")),
            (at: "03:20", what: Hint("story.hint.window_light")),
        ]),
        (night: 5, act: 1, weekday: Fri, beats: [
            (at: "21:50", what: Bot("schedule_published")),
            (at: "00:15", what: Train("EN 471")),
        ]),
        (night: 6, act: 1, weekday: Sat, beats: [
            (at: "23:10", what: Event("concert_crowd")),
            (at: "23:15", what: Hint("story.hint.rush")),
            (at: "23:50", what: Line(speaker: "filip", text_key: "story.line.06_filip")),
        ]),
        (night: 7, act: 1, weekday: Sun, beats: [
            (at: "21:40", what: Bot("payment_reminder")),
            (at: "03:00", what: Line(speaker: "cook", text_key: "story.line.07_cook"),
             conditions: [StaffArchetype("cook")]),
            (at: "06:00", what: PaymentDue),
        ]),
        (night: 8, act: 2, weekday: Mon, beats: [
            (at: "21:40", what: Hint("story.hint.new_staff")),
            (at: "22:00", what: Hint("story.hint.app")),
            // 14 Nov 2039: sixty years to the night since the Rn 333 ticket (scene.guest333_ticket.01)
            (at: "23:25", what: Line(speaker: "mirek", text_key: "story.line.08_mirek"),
             conditions: [RegularPresent("mirek")]),
        ]),
        (night: 9, act: 2, weekday: Tue, beats: [
            (at: "22:10", what: Hint("story.hint.special")),
            (at: "01:52", what: Train("Nex 9002")),
        ]),
        (night: 10, act: 2, weekday: Wed, beats: [
            (at: "01:30", what: Event("power_outage")),
            (at: "01:32", what: Hint("story.hint.candles")),
        ]),
        (night: 11, act: 2, weekday: Thu, weather: Rain, beats: [
            (at: "22:30", what: Train("Os 2141")),
            (at: "02:30", what: Line(speaker: "quiet_one", text_key: "story.line.11_ema"),
             conditions: [StaffArchetype("quiet_one")]),
        ]),
        (night: 12, act: 2, weekday: Fri, beats: [
            (at: "21:45", what: Hint("story.hint.armchair")),
            (at: "23:00", what: Event("concert_crowd")),
        ]),
        (night: 13, act: 2, weekday: Sat, beats: [
            (at: "21:50", what: Hint("story.hint.inspection")),
            (at: "23:30", what: Event("health_inspection")),
        ]),
        (night: 14, act: 2, weekday: Sun, beats: [
            (at: "21:40", what: Bot("payment_reminder")),
            (at: "06:00", what: PaymentDue),
        ]),
        (night: 15, act: 2, weekday: Mon, weather: Fog, beats: [
            (at: "01:00", what: Event("fog")),
            (at: "03:20", what: Hint("story.hint.window_light")),
        ]),
        (night: 16, act: 2, weekday: Tue, beats: [
            (at: "22:00", what: Event("lonely_night")),
            (at: "02:00", what: Line(speaker: "porter", text_key: "story.line.16_kuba"),
             conditions: [StaffArchetype("porter")]),
        ]),
        (night: 17, act: 3, weekday: Wed, beats: [
            (at: "21:59", what: Apply([SetVar("offer", "pending"), SetFlag("franchise_met")])),
            (at: "00:00", what: Bot("swap_request")),
        ]),
        (night: 18, act: 3, weekday: Thu, beats: [
            (at: "23:30", what: Line(speaker: "filip", text_key: "story.line.18_filip")),
        ]),
        (night: 19, act: 3, weekday: Fri, weather: Rain, beats: [
            (at: "23:00", what: Event("downpour")),
            (at: "23:05", what: Hint("story.hint.downpour")),
        ]),
        (night: 20, act: 3, weekday: Sat, beats: [
            (at: "22:20", what: Event("concert_crowd")),
        ]),
        (night: 21, act: 3, weekday: Sun, beats: [
            (at: "21:40", what: Bot("payment_reminder")),
            (at: "04:00", what: Bot("time_off_vacation")),
            (at: "06:00", what: PaymentDue),
        ]),
        (night: 22, act: 3, weekday: Mon, beats: [
            (at: "02:00", what: Line(speaker: "vera", text_key: "story.line.22_vera"),
             conditions: [VarIs("offer", "rejected")]),
            (at: "02:00", what: Line(speaker: "vera", text_key: "story.line.22_vera_sold"),
             conditions: [VarIs("offer", "accepted")]),
        ]),
        (night: 23, act: 3, weekday: Tue, beats: [
            (at: "04:30", what: Train("R 815")),
        ]),
        (night: 24, act: 3, weekday: Wed, weather: Rain, beats: [
            (at: "22:15", what: Hint("story.hint.lori_night"), conditions: [Flag("lori_invited")]),
        ]),
        // night 25: the storm. Mirek's confession (arc stage 4) can come tonight at the earliest;
        // Lori, sent away on night 11, gets a second chance under the awning (cutscene lori_storm)
        (night: 25, act: 4, weekday: Thu, weather: Storm, beats: [
            (at: "22:30", what: Event("storm_blackout")),
            (at: "23:30", what: Event("mirek_accident"), conditions: [Flag("mirek_silence")]),
        ]),
        (night: 26, act: 4, weekday: Fri, beats: [
            (at: "21:50", what: Bot("time_off_toil")),
        ]),
        (night: 27, act: 4, weekday: Sat, weather: Snow, beats: [
            (at: "22:00", what: Event("first_snow")),
            (at: "01:00", what: Line(speaker: "vera", text_key: "story.line.27_vera_snow"),
             conditions: [RegularPresent("vera")]),
        ]),
        (night: 28, act: 4, weekday: Sun, beats: [
            (at: "21:40", what: Bot("payment_reminder")),
            (at: "06:00", what: PaymentDue),
        ]),
        (night: 29, act: 4, weekday: Mon, beats: [
            (at: "22:00", what: Hint("story.hint.farewell")),
            (at: "04:00", what: Line(speaker: "radek", text_key: "story.line.29_radek"), conditions: [Flag("arc.radek.good")]),
        ]),
        (night: 30, act: 4, weekday: Tue, weather: Clear, beats: [
            (at: "21:40", what: Bot("payment_reminder")),
            (at: "03:30", what: Train("Rn 333")),
            (at: "06:00", what: PaymentDue),
        ]),
    ],
    notes: [
        // found_when empty = only found through an effect / beat (FindNote, Beat::Note, ShowNote).
        (id: "note_01", number: 1),
        (id: "note_02", number: 2, found_when: [NightAtLeast(3), Not(DirtAtLeast(0.02)), TimeBetween("05:30", "06:00")]),
        (id: "note_03", number: 3, found_when: [Any([EventHappenedTonight("power_outage"), EventHappenedTonight("storm_blackout")])]),
        (id: "note_04", number: 4, found_when: [ArcAtLeast("hana", 2)]),
        (id: "note_05", number: 5),
        (id: "note_06", number: 6),
        (id: "note_07", number: 7, found_when: [ArcAtLeast("mirek", 2)]),
        (id: "note_08", number: 8),
        (id: "note_09", number: 9, found_when: [HasFurniture("radio"), StaffArchetype("sound_tech")]),
        (id: "note_10", number: 10, found_when: [ReputationAtLeast(70.0)]),
    ],
    endings: [
        (
            id: "last_train",
            order: 1,
            conditions: [Any([
                VarIs("offer", "accepted"),
                All([Difficulty("classic"), Any([CounterAtLeast("missed_payments", 2), Flag("final_payment_missed")])]),
                All([ReputationBelow(20.0), Not(ArcsGoodAtLeast(1))]),
            ])],
            cutscene: "ending_last_train",
            variants: [
                (id: "sold", conditions: [VarIs("offer", "accepted")]),
                (id: "farewell", conditions: [ArcsGoodAtLeast(3)]),
                (id: "closed"),
            ],
        ),
        (
            id: "light",
            order: 2,
            cutscene: "ending_light",
            variants: [
                (id: "full", conditions: [ReputationAtLeast(60.0), ArcsGoodAtLeast(3)]),
                (id: "quiet"),
            ],
        ),
    ],
    // the letter delivered is enough; eight notes add Lida's postscript inside the scene
    ending_extra: (
        id: "answer",
        conditions: [
            Any([VarIs("letter", "delivered"), VarIs("letter", "delivered_by_mirek")]),
            Not(VarIs("offer", "accepted")),
        ],
        cutscene: "answer",
    ),
    flags: [
        "tutorial_done", "recipe_kulajda", "big_font_menu",
        "lori_invited", "lori_sent_away",
        "hana_blanket", "hana_woken", "hana_quiet_corner", "hana_left", "hana_stays",
        "mirek_keys_taken", "mirek_daughter_called", "mirek_silence", "mirek_jana_keys",
        "filip_friends", "filip_talked", "filip_free_coffee", "filip_alone",
        "radek_warns_trains", "radek_walked", "vera_friends", "coins_refused",
        "franchise_met", "landlord_grumbling", "final_payment_missed",
        "roof_fixed", "cat_adopted",
        // hands-on
        "garlands_up", "strange_tea_two_sugars", "reward_decor", "attic_piece", "mug_raindrop", "mug_heart",
    ],
    vars: [
        (id: "letter", default: "hidden",
         // bench: after the sale Mirek leaves it on the platform bench (last_333_sold)
         values: ["hidden", "confessed", "with_player", "with_mirek", "burned", "persuaded", "bench", "delivered", "delivered_by_mirek"]),
        (id: "offer", default: "none", values: ["none", "pending", "accepted", "rejected"]),
        (id: "answer_333", default: "none", values: ["none", "yes", "unsure", "gone"]),
        (id: "cat_name", default: "none", values: ["none", "vlak", "kofi", "lidka"]),
    ],
    counters: ["missed_payments", "payments_made", "cat_fed_nights", "coins_collected", "filip_kicked_out", "cat_affection"],
    items: ["cafe_keys", "old_coin", "rn333_ticket", "letter", "recipe_book", "timetable_1979", "lost_umbrella"],
    calendar: (
        start: (year: 2039, month: 11, day: 7),
        days: [
            (id: "advent_1", night: 21),
            (id: "first_snow", night: 27),
            (id: "advent_2", night: 28),
            (id: "mikulas", night: 29),
            (id: "last_night", night: 30),
        ],
    ),
)
