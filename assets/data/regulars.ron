// The seven regulars with staged arcs (story mode).
// Keys: regular.<id>.name / .bio, plus each stage's `lines` (ambient speech bubbles).
// Arc counter = arc.<id>; flags arc.<id>.good / arc.<id>.bad. Cutscenes for stages use
// trigger ArcStage(regular, stage) in cutscenes.ron. See docs/CONTENT.md.
// ServedFastStreak minutes count from the order to the first item on the table.
#![enable(implicit_some)]
[
    (
        id: "mirek",
        full_name: "Miroslav Dvořák",
        age: 80,
        base: "taxi_drivers",
        first_night: 1,
        visits: [(from: "23:00", to: "00:30"), (from: "04:00", to: "04:30", chance: 0.4)],
        orders: ["black_coffee", "topinka"],
        patience_minutes: 20.0,
        pays: Exact,
        absent_if: [Flag("mirek_gone")],
        look: (body: "average", height: 0.95, skin: ["#E6C3A8"], hair: ["grey_short"], hair_colors: ["#C8C3CF"],
               outfit: "jacket", outfit_colors: ["#4A3B2E"], accessories: ["cap", "glasses"]),
        stages: [
            (stage: 0, nights: (1, 30), lines: ["regular.mirek.line.0a", "regular.mirek.line.0b"]),
            (stage: 1, nights: (2, 30),
             // fast service or Karolina's well-matched coffees, three visits in a row
             when: [Any([ServedFastStreak(regular: "mirek", minutes: 10, visits: 3),
                         WishMatchStreak(regular: "mirek", min: 0.7, visits: 3)])],
             lines: ["regular.mirek.line.1a"]),
            (stage: 2, nights: (8, 30), conditions: [NightAtLeast(8)],
             lines: ["regular.mirek.line.2a"]),
            (stage: 3, nights: (20, 30), conditions: [NightAtLeast(20)],
             lines: ["regular.mirek.line.3a"]),
            (stage: 4, nights: (20, 29),
             conditions: [Any([Flag("mirek_keys_taken"), Flag("mirek_daughter_called")]), TrustAtLeast("mirek", 60.0)],
             lines: ["regular.mirek.line.4a"],
             effects: [SetVar("letter", "confessed")]),
            (stage: 5, nights: (28, 30), conditions: [NightAtLeast(28), VarIs("letter", "confessed")],
             lines: ["regular.mirek.line.5a"]),
        ],
    ),
    (
        id: "hana",
        full_name: "Hana Janoušková",
        age: 38,
        base: "nurses",
        first_night: 3,
        visits: [(from: "02:00", to: "02:30"), (from: "04:50", to: "05:30")],
        orders: ["cappuccino", "garlic_soup"],
        patience_minutes: 6.0,
        absent_if: [Flag("hana_left")],
        look: (body: "slim", skin: ["#F1D2BE"], hair: ["bun"], hair_colors: ["#5A3A2A"],
               outfit: "scrubs", outfit_colors: ["#7C9CE0"], accessories: ["scarf"]),
        stages: [
            (stage: 0, nights: (3, 30), lines: ["regular.hana.line.0a", "regular.hana.line.0b"]),
            (stage: 1, nights: (4, 30),
             when: [Any([ServedFastStreak(regular: "hana", minutes: 9, visits: 3),
                         WishMatchStreak(regular: "hana", min: 0.7, visits: 3)])],
             lines: ["regular.hana.line.1a"]),
            (stage: 2, nights: (12, 30), conditions: [NightAtLeast(12)],
             lines: ["regular.hana.line.2a"]),
            (stage: 3, nights: (13, 30), conditions: [NightAtLeast(13)],
             lines: ["regular.hana.line.3a"]),
            // a few nights of slack: a late start of the arc must not lose the ending
            (stage: 4, nights: (26, 29), conditions: [NightAtLeast(26)],
             lines: ["regular.hana.line.4a"]),
        ],
    ),
    (
        id: "guest_333",
        full_name: "—",
        age: 0,
        base: "night_wanderer",
        first_night: 4,
        visits: [(from: "03:33", to: "04:00")],
        orders: ["lemon_tea"],
        patience_minutes: 60.0,
        pays: OldCoins,
        seat: "window_spot",
        absent_if: [Not(WindowLightOn), VarIs("offer", "accepted")],
        look: (body: "slim", height: 1.02, skin: ["#E9D6CC"], hair: ["grey_short"], hair_colors: ["#9C97A8"],
               outfit: "coat", outfit_colors: ["#5B5670"], accessories: ["old_coat"]),
        stages: [
            (stage: 0, nights: (4, 30), lines: ["regular.guest_333.line.0a"]),
            (stage: 1, nights: (5, 30),
             conditions: [SeatFreeStreak(regular: "guest_333", visits: 3)],
             lines: ["regular.guest_333.line.1a"],
             effects: [FindNote("note_06"), GiveItem("old_coin")]),
            (stage: 2, nights: (15, 30), conditions: [NightAtLeast(15)],
             lines: ["regular.guest_333.line.2a"]),
            (stage: 3, nights: (16, 29), conditions: [NotesFoundAtLeast(6)],
             lines: ["regular.guest_333.line.3a"],
             effects: [GiveItem("rn333_ticket")]),
            (stage: 4, nights: (30, 30), conditions: [NightAtLeast(30)],
             lines: ["regular.guest_333.line.4a"]),
        ],
    ),
    (
        id: "vera",
        full_name: "Vera Soukupova",
        age: 83,
        base: "insomniacs",
        first_night: 5,
        visits: [(from: "00:30", to: "03:00")],
        orders: ["lemon_tea", "kolac"],
        patience_minutes: 12.0,
        look: (body: "small", height: 0.88, skin: ["#EDD3C4"], hair: ["bun"], hair_colors: ["#E4E0EA"],
               outfit: "cardigan", outfit_colors: ["#6B4E7A"], accessories: ["crossword", "glasses"]),
        stages: [
            (stage: 0, nights: (5, 30), lines: ["regular.vera.line.0a", "regular.vera.line.0b"]),
            (stage: 1, nights: (6, 30),
             conditions: [CleanStreak(regular: "vera", clean: 0.8, visits: 3)],
             lines: ["regular.vera.line.1a"]),
            (stage: 2, nights: (14, 30), conditions: [NightAtLeast(14), TrustAtLeast("vera", 25.0)],
             lines: ["regular.vera.line.2a"],
             effects: [FindNote("note_05"), SetFlag("recipe_kulajda"), UnlockMenu("grandma_kulajda"), GiveItem("recipe_book")]),
            (stage: 3, nights: (15, 30),
             when: [Any([ServedRecipe(regular: "vera", recipe: "r_kulajda"),
                         ServedItem(regular: "vera", item: "grandma_kulajda"), NightAtLeast(22)])],
             lines: ["regular.vera.line.3a"]),
            (stage: 4, nights: (27, 30), conditions: [NightAtLeast(27), NotesFoundAtLeast(6)],
             lines: ["regular.vera.line.4a"],
             effects: [ArcGood("vera"), SetFlag("vera_friends")]),
        ],
    ),
    (
        id: "filip",
        full_name: "Filip Kadlec",
        age: 22,
        base: "students",
        first_night: 6,
        visits: [(from: "23:30", to: "05:00")],
        orders: ["black_coffee"],
        patience_minutes: 25.0,
        seat: "power_socket",
        look: (body: "slim", height: 1.06, skin: ["#F0D0BA"], hair: ["curly"], hair_colors: ["#3B2A20"],
               outfit: "hoodie", outfit_colors: ["#4F46E5"], accessories: ["laptop", "headphones"]),
        stages: [
            (stage: 0, nights: (6, 30), lines: ["regular.filip.line.0a", "regular.filip.line.0b"]),
            (stage: 1, nights: (7, 30), conditions: [HasFurnitureTag("power_socket")],
             lines: ["regular.filip.line.1a"],
             effects: [SetFlag("filip_friends")]),
            // the exam night; a few nights of slack if the socket came late
            (stage: 2, nights: (18, 23), conditions: [NightAtLeast(18)],
             lines: ["regular.filip.line.2a"]),
            (stage: 3, nights: (19, 29), conditions: [Any([Flag("filip_talked"), Flag("filip_free_coffee")])],
             lines: ["regular.filip.line.3a"]),
            (stage: 4, nights: (29, 30), conditions: [NightAtLeast(29)],
             lines: ["regular.filip.line.4a"],
             effects: [ArcGood("filip")]),
        ],
    ),
    (
        id: "radek",
        full_name: "Radek Macek",
        age: 52,
        base: "train_crew",
        first_night: 9,
        visits: [(from: "01:00", to: "01:25"), (from: "04:30", to: "04:50")],
        orders: ["black_coffee"],
        patience_minutes: 6.0,
        look: (body: "average", skin: ["#E3BFA3"], hair: ["short"], hair_colors: ["#6E6676"],
               outfit: "uniform", outfit_colors: ["#24306B"], accessories: ["badge_shiftella", "glasses"]),
        stages: [
            (stage: 0, nights: (9, 30), lines: ["regular.radek.line.0a"]),
            (stage: 1, nights: (10, 23),
             conditions: [Any([ServedFastStreak(regular: "radek", minutes: 7, visits: 4), NightAtLeast(22)])],
             lines: ["regular.radek.line.1a"],
             effects: [SetFlag("radek_warns_trains")]),
            (stage: 2, nights: (23, 23), conditions: [NightAtLeast(23)],
             lines: ["regular.radek.line.2a"],
             effects: [FindNote("note_08"), GiveItem("timetable_1979")]),
            (stage: 3, nights: (24, 30), conditions: [TrustAtLeast("radek", 50.0)],
             lines: ["regular.radek.line.3a"],
             effects: [ArcGood("radek")]),
        ],
    ),
    (
        id: "lori",
        full_name: "Loreta Benešová",
        age: 27,
        base: "night_wanderer",
        first_night: 11,
        visits: [(from: "22:30", to: "01:00")],
        weather: [Rain, Downpour, Storm],
        orders: ["hot_chocolate"],
        patience_minutes: 15.0,
        pays: Song,
        absent_if: [Flag("lori_sent_away")],
        look: (body: "slim", skin: ["#F3D7C6"], hair: ["braid"], hair_colors: ["#C9B8E8"],
               outfit: "raincoat", outfit_colors: ["#F2C14E"], accessories: ["guitar"]),
        stages: [
            (stage: 0, nights: (11, 30), lines: ["regular.lori.line.0a"]),
            (stage: 1, nights: (11, 30), conditions: [Flag("lori_invited")],
             lines: ["regular.lori.line.1a"]),
            (stage: 2, nights: (12, 30), conditions: [HasFurnitureTag("stage")],
             lines: ["regular.lori.line.2a"]),
            (stage: 3, nights: (24, 30), conditions: [NightAtLeast(24)],
             lines: ["regular.lori.line.3a"],
             effects: [ArcGood("lori"), Reputation(10.0)]),
        ],
    ),
    (
        // A quiet cameo guest (render preset `anwar`). Flavour only: no flags, effects, arc or
        // endings. Comes twice per game; hover → ambient line, "Talk" → his talk cutscene.
        id: "guest_anwar",
        full_name: "Anwar",
        age: 28,
        base: "drone_operators",
        first_night: 9,
        story_nights: [9, 24],
        sandbox_nights: [9, 24],
        look_preset: "anwar",
        visits: [(from: "23:00", to: "02:00")],
        orders: ["oat_flat_white"],
        patience_minutes: 20.0,
        seat: "power_socket",
        look: (body: "average", height: 1.04, hair: ["short"], hair_colors: ["#1F1A1C"],
               outfit: "hoodie", outfit_colors: ["#4F46E5"], accessories: ["laptop", "headphones"]),
        ambient_lines: [
            (key: "regular.guest_anwar.ambient.rain", when: [Raining]),
            (key: "regular.guest_anwar.ambient.fog", when: [Weather(Fog)]),
            (key: "regular.guest_anwar.ambient.train", when: [TrainNear(5)]),
            (key: "regular.guest_anwar.ambient.midnight", when: [TimeBetween("23:55", "00:20")]),
            (key: "regular.guest_anwar.ambient.late", when: [TimeBetween("01:20", "02:00")]),
            (key: "regular.guest_anwar.ambient.busy", when: [GuestsAtLeast(10)]),
            (key: "regular.guest_anwar.ambient.quiet", when: [Not(GuestsAtLeast(5))]),
            (key: "regular.guest_anwar.ambient.coffee"),
        ],
        stages: [
            (stage: 0, nights: (9, 30)),
        ],
    ),
]
