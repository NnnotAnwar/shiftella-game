// Difficulty presets. Keys: difficulty.<id>.name / .desc.
// Cozy (default): no game over, soft payments. Relaxed: Cozy without money pressure (the debt's
// instalments are covered). Classic: payments matter; closing is an ending, never a fail screen.
#![enable(implicit_some)]
[
    (
        id: "cozy",
        default: true,
        start_money: 15000,
        payments: Soft,
        missed_payment_effects: [Reputation(-2.0), SetFlag("landlord_grumbling"), Bot("payment_missed_soft")],
        // T9: 1.5 → 1.7 — fewer forgiven parties after trains and the concert crowd
        guest_patience_mul: 1.7,
        bad_review_mul: 0.7,
        wear_mul: 0.5,
        need_decay_mul: 0.8,
        // T9: 1.35 → 1.5 so an average player makes all five story payments with room to spare
        // (sandbox bills × sim::guests::SANDBOX_INCOME_MUL). QA 0.2.1: 1.5 → 1.6 — a party of
        // three no longer squeezes onto two chairs (a seating bug gave the hall extra room), so
        // more parties find no seat; this keeps the story's money where it was tuned.
        // purchases 0.2.1: 1.6 → 1.7 — with the bar and last call at 05:15 a non-builder ended
        // with 0.8k–20k; now ~10k–20k, and a player who buys furniture still keeps ≥ 5k.
        income_mul: 1.7,
        // sandbox only: the landlord notices a busy café
        rent_growth_percent: 5.0,
        rent_growth_every: 10,
        // QA 0.2.x: the landlord stops at 1.6 × a town that size's top starting rent (a village
        // ~3 200 Kč, a district town ~4 150) — uncapped it passed 9 000 Kč by night 300 and
        // every long game went broke
        rent_growth_max: 1.6,
    ),
    (
        // Accessibility (0.2 package J): Cozy with no money pressure — every instalment of the
        // debt is covered when it comes due (sim::economy::collect_payment), nothing can be
        // missed; everything else as on Cozy (sim::Difficulty::gentle).
        id: "relaxed",
        start_money: 15000,
        payments: Forgiven,
        guest_patience_mul: 1.7,
        bad_review_mul: 0.7,
        wear_mul: 0.5,
        need_decay_mul: 0.8,
        income_mul: 1.7,
        rent_growth_percent: 0.0,
        rent_growth_every: 0,
    ),
    (
        id: "classic",
        start_money: 8000,
        payments: Hard,
        close_after_missed: 2,
        missed_payment_effects: [Reputation(-5.0), AddCounter("missed_payments", 1), Bot("payment_missed_hard")],
        // T9: 1.0 → 1.5 and 1.25 → 1.35 — ~13 % of guests walk out instead of ~23 %, and a
        // decent player reaches «Light in the Window» about half the time (sim_balance 30
        // story classic 12); Cozy stays the gentler, richer one.
        guest_patience_mul: 1.5,
        bad_review_mul: 1.0,
        wear_mul: 1.0,
        need_decay_mul: 1.0,
        // purchases (0.2.1 bar + honest seating): 1.55 → 1.65 so about half of the bot's runs
        // make the final 30 000 again (sim_balance 30 story classic 8)
        income_mul: 1.65,
        rent_growth_percent: 5.0,
        rent_growth_every: 10,
        rent_growth_max: 1.6,
        bankrupt_after: 3,
    ),
]
