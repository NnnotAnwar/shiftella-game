// Difficulty presets. Keys: difficulty.<id>.name / .desc.
// Cozy (default): no game over, soft payments. Classic: payments matter; closing is an ending, never a fail screen.
#![enable(implicit_some)]
[
    (
        id: "cozy",
        default: true,
        start_money: 15000,
        payments: Soft,
        missed_payment_effects: [Reputation(-2.0), SetFlag("landlord_grumbling"), Bot("payment_missed_soft")],
        guest_patience_mul: 1.3,
        bad_review_mul: 0.7,
        wear_mul: 0.5,
        need_decay_mul: 0.8,
        income_mul: 1.25,
        rent_growth_percent: 0.0,
        rent_growth_every: 0,
    ),
    (
        id: "classic",
        start_money: 6000,
        payments: Hard,
        close_after_missed: 2,
        missed_payment_effects: [Reputation(-5.0), AddCounter("missed_payments", 1), Bot("payment_missed_hard")],
        guest_patience_mul: 1.0,
        bad_review_mul: 1.0,
        wear_mul: 1.0,
        need_decay_mul: 1.0,
        income_mul: 1.0,
        rent_growth_percent: 5.0,
        rent_growth_every: 10,
        bankrupt_after: 3,
    ),
]
