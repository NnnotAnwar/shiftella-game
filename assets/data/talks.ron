// Talk dialogues of the regulars: one short talk per act for each regular who comes in that act
// (Radek from night 9 and Lori from night 11 have none in act I). Loaded after cutscenes.ron and
// appended to its cutscenes (same `CutsceneDef` format, see docs/CONTENT.md §9).
//
// The player opens one with "Talk" on a present regular (bubble / lull hint); each plays once,
// only inside its act (NightBetween = story.ron acts: I 1–7, II 8–16, III 17–24, IV 25–30), so
// a talk missed in its act is gone. They carry soft hints for the hidden conditions and bits of
// Karolina's past (no NONSTOP before night 3's back-step call). Effects: a little trust only.
// Texts: assets/i18n/src/talks.tr (scene.<id>.<nn>).
#![enable(implicit_some)]
[
    // ───────────────────────── Mirek ─────────────────────────
    (
        // little Karolina at the counter; hint: his coffee fast (stage 1)
        id: "talk_mirek_1",
        trigger: Talk(regular: "mirek", night: None),
        conditions: [Mode(Story), NightBetween(1, 7)],
        steps: [
            Camera(focus: Actor("mirek"), zoom: 1.6),
            Line(speaker: "mirek", expression: Smile, text_key: "scene.talk_mirek_1.01"),
            Line(speaker: "player", expression: Thinking, text_key: "scene.talk_mirek_1.02"),
            Line(speaker: "mirek", expression: Neutral, text_key: "scene.talk_mirek_1.03"),
            Line(speaker: "mirek", expression: Thinking, text_key: "scene.talk_mirek_1.04"),
            Line(speaker: "player", expression: Smile, text_key: "scene.talk_mirek_1.05"),
            Apply(effects: [Trust("mirek", 3.0)]),
        ],
    ),
    (
        // hints: his eyes (the board), the window table kept free from half past three
        id: "talk_mirek_2",
        trigger: Talk(regular: "mirek", night: None),
        conditions: [Mode(Story), NightBetween(8, 16)],
        steps: [
            Camera(focus: Actor("mirek"), zoom: 1.6),
            Line(speaker: "mirek", expression: Neutral, text_key: "scene.talk_mirek_2.01"),
            Line(speaker: "mirek", expression: Thinking, text_key: "scene.talk_mirek_2.02"),
            Line(speaker: "player", expression: Smile, text_key: "scene.talk_mirek_2.03"),
            Line(speaker: "mirek", expression: Neutral, text_key: "scene.talk_mirek_2.04"),
            Apply(effects: [Trust("mirek", 3.0)]),
        ],
    ),
    (
        // hint: the keys, and that he'd hand them to someone he trusts (stage 3 → 4)
        id: "talk_mirek_3",
        trigger: Talk(regular: "mirek", night: None),
        conditions: [Mode(Story), NightBetween(17, 24)],
        steps: [
            Camera(focus: Actor("mirek"), zoom: 1.6),
            If(conditions: [ArcAtLeast("mirek", 3)],
               then: [Line(speaker: "mirek", expression: Sad, text_key: "scene.talk_mirek_3.05")],
               otherwise: [Line(speaker: "mirek", expression: Neutral, text_key: "scene.talk_mirek_3.01")]),
            Line(speaker: "mirek", expression: Thinking, text_key: "scene.talk_mirek_3.02"),
            Line(speaker: "player", expression: Neutral, text_key: "scene.talk_mirek_3.03"),
            Line(speaker: "mirek", expression: Smile, text_key: "scene.talk_mirek_3.04"),
            Apply(effects: [Trust("mirek", 3.0)]),
        ],
    ),
    (
        // after the storm / the sale; before or after the confession
        id: "talk_mirek_4",
        trigger: Talk(regular: "mirek", night: None),
        conditions: [Mode(Story), NightBetween(25, 30)],
        steps: [
            Camera(focus: Actor("mirek"), zoom: 1.6),
            If(conditions: [VarIs("offer", "accepted")],
               then: [Line(speaker: "mirek", expression: Sad, text_key: "scene.talk_mirek_4.05")],
               otherwise: [Line(speaker: "mirek", expression: Laugh, text_key: "scene.talk_mirek_4.01")]),
            If(conditions: [ArcAtLeast("mirek", 4)],
               then: [Line(speaker: "mirek", expression: Neutral, text_key: "scene.talk_mirek_4.06")],
               otherwise: [Line(speaker: "mirek", expression: Thinking, text_key: "scene.talk_mirek_4.02")]),
            Line(speaker: "player", expression: Smile, text_key: "scene.talk_mirek_4.03"),
            Line(speaker: "mirek", expression: Smile, text_key: "scene.talk_mirek_4.04"),
            Apply(effects: [Trust("mirek", 3.0)]),
        ],
    ),
    // ───────────────────────── Hana ─────────────────────────
    (
        // hint: her cappuccino ready fast (stage 1); Karolina "not new to nights"
        id: "talk_hana_1",
        trigger: Talk(regular: "hana", night: None),
        conditions: [Mode(Story), NightBetween(1, 7)],
        steps: [
            Camera(focus: Actor("hana"), zoom: 1.6),
            Line(speaker: "hana", expression: Tired, text_key: "scene.talk_hana_1.01"),
            Line(speaker: "player", expression: Smile, text_key: "scene.talk_hana_1.02"),
            Line(speaker: "hana", expression: Laugh, text_key: "scene.talk_hana_1.03"),
            Line(speaker: "hana", expression: Neutral, text_key: "scene.talk_hana_1.04"),
            Line(speaker: "player", expression: Thinking, text_key: "scene.talk_hana_1.05"),
            Apply(effects: [Trust("hana", 3.0)]),
        ],
    ),
    (
        // hint: an armchair with a floor lamp (the quiet corner of hana_asleep)
        id: "talk_hana_2",
        trigger: Talk(regular: "hana", night: None),
        conditions: [Mode(Story), NightBetween(8, 16)],
        steps: [
            Camera(focus: Actor("hana"), zoom: 1.6),
            Line(speaker: "hana", expression: Tired, text_key: "scene.talk_hana_2.01"),
            Line(speaker: "player", expression: Neutral, text_key: "scene.talk_hana_2.02"),
            Line(speaker: "hana", expression: Smile, text_key: "scene.talk_hana_2.03"),
            If(conditions: [HasFurniture("armchair"), HasFurniture("floor_lamp")],
               then: [Line(speaker: "hana", expression: Laugh, text_key: "scene.talk_hana_2.06")],
               otherwise: [Line(speaker: "hana", expression: Thinking, text_key: "scene.talk_hana_2.04"),
                           Line(speaker: "player", expression: Smile, text_key: "scene.talk_hana_2.05")]),
            Apply(effects: [Trust("hana", 3.0)]),
        ],
    ),
    (
        // Dresden; Karolina's Brno; a small choice (both just trust)
        id: "talk_hana_3",
        trigger: Talk(regular: "hana", night: None),
        conditions: [Mode(Story), NightBetween(17, 24)],
        steps: [
            Camera(focus: Actor("hana"), zoom: 1.6),
            If(conditions: [ArcAtLeast("hana", 3)],
               then: [Line(speaker: "hana", expression: Thinking, text_key: "scene.talk_hana_3.01")],
               otherwise: [Line(speaker: "hana", expression: Surprised, text_key: "scene.talk_hana_3.06")]),
            Line(speaker: "hana", expression: Neutral, text_key: "scene.talk_hana_3.02"),
            Line(speaker: "player", expression: Neutral, text_key: "scene.talk_hana_3.03"),
            Choice(options: [
                (label_key: "scene.talk_hana_3.04", effects: [Trust("hana", 3.0)]),
                (label_key: "scene.talk_hana_3.05", effects: [Trust("hana", 3.0)]),
            ]),
            Line(speaker: "hana", expression: Smile, text_key: "scene.talk_hana_3.07"),
        ],
    ),
    (
        // before or after her decision (she is gone if she left)
        id: "talk_hana_4",
        trigger: Talk(regular: "hana", night: None),
        conditions: [Mode(Story), NightBetween(25, 30)],
        steps: [
            Camera(focus: Actor("hana"), zoom: 1.6),
            If(conditions: [Flag("hana_stays")],
               then: [Line(speaker: "hana", expression: Smile, text_key: "scene.talk_hana_4.05")],
               otherwise: [Line(speaker: "hana", expression: Thinking, text_key: "scene.talk_hana_4.01")]),
            Line(speaker: "hana", expression: Tired, text_key: "scene.talk_hana_4.02"),
            Line(speaker: "player", expression: Smile, text_key: "scene.talk_hana_4.03"),
            Line(speaker: "hana", expression: Laugh, text_key: "scene.talk_hana_4.04"),
            Apply(effects: [Trust("hana", 3.0)]),
        ],
    ),
