// Sandbox setup. Keys: sandbox.character.<id>.name / .desc, sandbox.institution.<id>.
// Town and café names are proper nouns (never translated).
(
    characters: [
        (id: "quiet", base_rate: 0.003, max_tension: 40.0, good_share: 0.45, breath_minutes: 90, max_bad_in_row: 1,
         uncanny_mul: 1.0, lonely_valve_after: Some(2), poverty_help: true, staff_events_cap: Some(1), events_per_night: (1, 3)),
        (id: "calm", base_rate: 0.004, max_tension: 50.0, good_share: 0.4, breath_minutes: 60, max_bad_in_row: 1,
         uncanny_mul: 1.0, lonely_valve_after: Some(2), poverty_help: true, staff_events_cap: Some(1), events_per_night: (2, 4)),
        (id: "changeable", base_rate: 0.0055, max_tension: 70.0, good_share: 0.3, breath_minutes: 40, max_bad_in_row: 2,
         uncanny_mul: 1.2, lonely_valve_after: Some(3), poverty_help: true, staff_events_cap: Some(2), events_per_night: (3, 5)),
        (id: "stormy", base_rate: 0.007, max_tension: 85.0, good_share: 0.25, breath_minutes: 25, max_bad_in_row: 2,
         uncanny_mul: 1.4, lonely_valve_after: None, poverty_help: false, staff_events_cap: Some(3), events_per_night: (4, 6)),
        (id: "chaotic", base_rate: 0.009, max_tension: 100.0, good_share: 0.2, breath_minutes: 15, max_bad_in_row: 3,
         uncanny_mul: 1.5, lonely_valve_after: None, poverty_help: false, staff_events_cap: None, events_per_night: (5, 8)),
    ],
    default_character: "calm",
    start_money_options: [10000, 25000, 50000],
    default_start_money: 25000,
    town_names: (
        // Sandbox towns are real places with a Czech note (picked from `places`); the
        // prefix/root/suffix generator below is only a fallback when `places` is empty.
        // `roots` also seed the menu's random seed words.
        places: ["Praha-Holešovice", "Praha-Smíchov", "Praha-Karlín", "Praha-Vršovice", "Brno", "Ostrava",
                 "Plzeň", "Olomouc", "Bratislava", "Košice", "Vienna", "Linz", "Kraków", "Wrocław", "Dresden", "Lviv"],
        prefixes: ["Horní", "Dolní", "Nová", "Stará", "Malá", "Velká"],
        prefix_chance: 0.35,
        roots: ["Praha", "Brno", "Vienna", "Krakow", "Linz", "Dresden", "Lviv", "Olomouc", "Smichov", "Karlin"],
        suffixes: ["ov", "ice", "any", "ín", "ná Lhota", "ovec", "ín u Lesa"],
        rivers: ["Vltavou", "Labem", "Dunajem", "Odrou"],
        river_chance: 0.25,
        stoplist: ["Kosice", "Košice", "Borovany", "Lipany", "Borovec", "Vranov", "Lipov", "Kosov", "Hrušov", "Sovín"],
    ),
    institutions: [
        (id: "taxi_rank", weight: 1.0),
        (id: "hospital", weight: 0.8),
        (id: "college", weight: 0.8),
        (id: "drone_hub", weight: 0.6),
        (id: "depot", weight: 0.7),
        (id: "culture_house", weight: 0.7),
        (id: "police", weight: 0.6),
        (id: "highway", weight: 0.6),
    ],
    institutions_per_town: (2, 4),
    cafe_names: ["Café Nocturne", "Kavárna u nádraží", "Night Platform", "Café Perón", "The Lantern", "Signal Box", "Last Tram", "Café Semafor"],
    // nightly rent by town size (T9: 800–2500 → 1800–2800 — a big town no longer pays double
    // for a café that's full either way)
    rent: (1800, 2800),
    options: {
        "rain_every_night": true,
        "pause_on_events": false,
        "allow_debt": true,
    },
    // The «Challenge» mode (setup: Endless / Challenge; town option "challenge"). Every
    // season (30 nights) money, rivals and the nights get harder; two missed season goals in
    // a row (or deep debt) close the café. Endless never reads this. See sim::challenge.
    // Balance (sim::tests_challenge::curve, player-bot, 10 seeds): Cozy closes after ~126
    // nights (90–150, ≈ 4 seasons), Classic ~81 (60–120); money peaks in season 3, reputation
    // in season 2 (docs/SIM.md §15).
    challenge: (
        season_nights: 30,
        rent_inflation: 25.0,
        supply_inflation: 20.0,
        wage_inflation: 20.0,
        goal_per_night: 6500.0,
        goal_size_weight: 0.25,
        goal_growth: 18.0,
        goal_mul: {"cozy": 1.0, "relaxed": 0.9, "classic": 1.2},
        strikes_to_close: 2,
        debt_limit_rents: 10.0,
        debt_nights: 3,
        competitor_from_season: 2,
        competitors_max: 3,
        competitor_share: 0.10,
        counter_cut: 0.15,
        counter_coziness_level: 4,
        counter_reputation: 80.0,
        counter_regulars: 3,
        counter_regular_trust: 40.0,
        rival_reputation_drain: 1.0,
        event_rate: 15.0,
        bad_weight: 25.0,
        good_share_cut: 8.0,
        tension_add: 8.0,
        bad_in_row_every: 2,
        breath_cut: 12.0,
        wear: 15.0,
        // not Bad, but harder all the same: weighted like the Bad events
        scaled_events: ["health_inspection"],
        // rival cafés by town (proper nouns, never translated); "*" for any other town
        competitor_names: {
            "*": ["Café Kompas", "Espresso Express", "Kavárna Mlýnek", "Bean Station", "Café Plechovka", "Night Owl Coffee"],
            "Praha-Holešovice": ["Kavárna Tržnice", "Café Vltava Loft", "Holešky Roasters"],
            "Praha-Smíchov": ["Smíchovská pražírna", "Café Anděl", "Bistro Na Knížecí"],
            "Praha-Karlín": ["Karlín Coffee Lab", "Café Invalidovna", "Kavárna Pobřežní"],
            "Praha-Vršovice": ["Café Kodaňská", "Vršovický koutek", "Kavárna Čechovka"],
            "Brno": ["Café Špilberk", "Brněnská pražírna", "Kavárna Zelňák"],
            "Ostrava": ["Café Stodolní", "Ostravská kávovarna", "Kafe Vítkovice"],
            "Plzeň": ["Café Na Spilce", "Plzeňský šálek", "Kavárna Radbuza"],
            "Olomouc": ["Café Horní náměstí", "Olomoucký tvarůžek", "Kavárna Morava"],
            "Bratislava": ["Kaviareň Dunaj", "Café Hrad", "Kaviareň Obchodná"],
            "Košice": ["Kaviareň Hlavná", "Café Dóm", "Košická kávovňa"],
            "Vienna": ["Café Westbahnhof", "Kaffeehaus Gürtel", "Café Donaukanal"],
            "Linz": ["Café Lentos", "Linzer Kaffeebar", "Café Hauptplatz"],
            "Kraków": ["Kawiarnia Rynek", "Café Kazimierz", "Kawiarnia Wawel"],
            "Wrocław": ["Kawiarnia Odra", "Café Nadodrze", "Kawiarnia Ratusz"],
            "Dresden": ["Café Elbufer", "Kaffeehaus Neustadt", "Café Altmarkt"],
            "Lviv": ["Kaviarnia Rynok", "Café Opera", "Lvivska Kava"],
        },
    ),
)
