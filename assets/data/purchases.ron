// What buying things gives (package `purchases`, `sim::purchases`). Compiled into the sim
// (`include_str!`), parsed once. Every effect hangs on a furniture *tag* or a number from
// `furniture.ron` (seats, comfort), never on a piece id. Grandma's café is the neutral point:
// a player who never builds plays exactly the old numbers.
#![enable(implicit_some)]
(
    seats: (
        // hall seats in grandma's café: walk-ins × 1.0 here
        base: 16,
        // walk-ins × (hall seats / base) ^ exponent, clamped — more seats, more guests, with
        // diminishing returns (24 seats ≈ ×1.30, 32 ≈ ×1.5)
        exponent: 0.65,
        min_draw: 0.7,
        max_draw: 1.5,
        // "No free seat — they went on": at most one toast per this many minutes
        toast_gap: 40,
    ),
    // A party's mean seat comfort → their stay ×, tips ×, the chance of a second round and a
    // satisfaction add once served. Linear between the points; chairs (2) are neutral.
    comfort: [
        (at: 1.0, stay: 0.85, tips: 0.92, round: 0.0, satisfaction: -3.0),
        (at: 2.0, stay: 1.0, tips: 1.0, round: 0.0, satisfaction: 0.0),
        (at: 4.5, stay: 1.25, tips: 1.1, round: 0.4, satisfaction: 3.0),
        (at: 7.0, stay: 1.4, tips: 1.18, round: 0.55, satisfaction: 5.0),
    ],
    // the hover card: "comfy" from this comfort, "hard" below that
    comfy_at: 4.0,
    hard_below: 1.5,
    // a second round: they stay this many more minutes once it is served; none after 05:00
    round_stay: (8, 16),
    round_until: 420,
    // Coziness tiers = the meter's five levels (decor.ron `levels`: 30 / 50 / 70 / 85;
    // grandma's own hall ≈ 64, Pleasant).
    // Fractions are added on top of the smooth coziness effects; `rare` adds arrival weight
    // to an archetype; `wishes` = regulars may ask for the tier's special wishes (wishes.ron
    // `CozinessAtLeast`).
    tiers: [
        (level: 1),
        (level: 2),
        (level: 3, tips: 0.03),
        (level: 4, tips: 0.08, stay: 0.1, review: 0.15),
        (level: 5, tips: 0.14, stay: 0.2, review: 0.3, round: 0.08,
         rare: [("night_wanderer", 0.6)], wishes: true),
    ],
    // Appliance roles by tag. `free` = pieces grandma's café already has (the effect counts
    // the ones beyond), `max` = extra pieces that still add. (The grinder and the drying rack
    // beside their stations are `sim::companions`' — not repeated here.)
    appliances: [
        // two at once: Karolina and a barista, or her quick brew on the free machine
        (tag: "station:coffee", role: Parallel, free: 1, max: 2),
        (tag: "station:stove", role: Parallel, free: 1, max: 1),
        // the oven: cakes are on the menu at all
        (tag: "station:oven", role: Unlocks, free: 0, max: 1),
    ],
    // lines in the morning's "What the café gave you tonight"
    summary_max: 5,
    // The fridge keeps the stock (sim::fridge). `fresh_share` of the supplies (Kč) is fresh —
    // milk, cream, the cake, the chlebíček's fillings — and needs the fridge. Each piece with
    // `tag` holds `per_piece` Kč of it × its condition (1 − wear_loss × wear, ≥ min_condition;
    // the morning after `fail_event` the most worn one × failed_mul). At 06:00 `spoil` of the
    // fresh stock beyond the room goes off, × check_mul when the closing `check_item` was done.
    // Grandma's one fridge in good repair holds a usual morning's stock (the 3 000 Kč
    // auto-restock less a night's use, × 0.4): it bites when it's worn, failed or overfull.
    fridge: (
        tag: "station:fridge",
        fresh_share: 0.4,
        per_piece: 1100.0,
        wear_loss: 0.8,
        min_condition: 0.3,
        failed_mul: 0.5,
        fail_event: "fridge_fail",
        spoil: 0.5,
        check_mul: 0.6,
        check_item: "fridge_check",
        // from this wear a fridge counts as worn (the morning line blames it, the planning card
        // says so) — the appliances' service_wear, when it can be defrosted
        worn_at: 0.5,
        // "3 l of milk went off": Kč of fresh stock per litre
        litre: 25.0,
    ),
)
