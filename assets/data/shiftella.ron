// The in-game Shiftella app (phone/tablet). Mirrors the real app: rozpis (schedule), swaps,
// time off (dovolená, náhradní volno), late alerts, handover notes (předávka), announcements,
// checklists, the night digest and the weekly payroll basis (podklady pro mzdy).
// Keys: app.announcement.<id>.title/.body, app.checklist.<id>, app.bot.<id>(.action.<a>),
// app.digest.<id>, app.payroll.<id>, app.handover.<id>.
// The bot NEVER does clock-in / clock-out (validation rejects actions with "clock" in the id).
// Hands-on (handson.md §13): checklist items have an owner / anchor / gesture and real effects
// (`done`/`missed` = core effects the sim runs today; `extra_done`/`extra_missed` = hands-on Fx;
// Opening `extra_missed` applies at the ritual deadline, Closing at 06:00); bot buttons carry a
// `handler` that acts in the world; handover suggestions, insights and the payroll decision.
// Keys: app.ritual.<list>, app.handover.option.<id>, app.insight.<id>, app.payroll.split.<id>.
#![enable(implicit_some)]
(
    bot_handle: "@shiftella_bot",
    announcements: [
        (id: "grandma_rules", author: "grandma", night: 1),
        (id: "welcome_crew", author: "player", night: 2),
        (id: "new_dishes", author: "player", night: 8),
        (id: "inspection_soon", author: "player", night: 12),
        (id: "visitor_nonstop", author: "player", night: 17),
        (id: "storm_tonight", author: "player", night: 25),
        (id: "last_night", author: "player", night: 30),
        (id: "swap_board", author: "player", placeholders: ["name", "night"], effects: [SwapBoard]),
        (id: "thank_you", author: "player", placeholders: ["name"], effects: [TargetStaffMood(6.0)]),
        (id: "new_item", author: "player", placeholders: ["item"], effects: [ItemSpotlight(prep_mul: 0.9)]),
    ],
    checklists: [
        (id: "light_window", list: Opening, minutes: 1, missed: [Reputation(-1.0)],
         owner: Karolina, anchor: "window", gesture: Click),
        (id: "coffee_warmup", list: Opening, job: Bar, minutes: 5,
         done: [WorkSpeed(job: Bar, mul: 1.25, minutes: 60)],
         owner: Either(Bar), anchor: "station:coffee", gesture: Hold(1.0),
         extra_done: [QuickQuality(add: 0.05, minutes: 60)],
         extra_missed: [SlowFirstItems(job: Bar, count: 3, mul: 1.3)]),
        (id: "check_stock", list: Opening, job: Kitchen, minutes: 5,
         owner: Either(Kitchen), anchor: "station:fridge", gesture: Click,
         extra_done: [StockChecked], extra_missed: [StockoutRisk(chance: 0.15, minutes: 30)]),
        (id: "wipe_tables", list: Opening, job: Cleaning, minutes: 10, done: [Dirt(-0.05)],
         owner: Either(Floor), anchor: "table", gesture: Swipe),
        (id: "count_float", list: Opening, job: Register, minutes: 3,
         done: [WorkSpeed(job: Register, mul: 1.2, minutes: 120)],
         owner: Either(Register), anchor: "register", gesture: Click),
        // the specials chalkboard (§6.8): tonight's two specials
        (id: "menu_board", list: Opening, job: Serving, minutes: 2,
         owner: Karolina, anchor: "counter", gesture: Pick),
        (id: "record_on", list: Opening, minutes: 1, owner: Karolina, anchor: "music", gesture: Pick),
        (id: "wash_dishes", list: Closing, job: Cleaning, minutes: 15, missed: [Dirt(0.1)],
         owner: Either(Dishes), anchor: "sink", gesture: Hold(2.0)),
        (id: "clean_machine", list: Closing, job: Bar, minutes: 10,
         owner: Either(Bar), anchor: "station:coffee", gesture: Hold(2.0),
         extra_done: [Wear(tag: "station:coffee", add: -0.02)], extra_missed: [Wear(tag: "station:coffee", add: 0.02)]),
        (id: "cash_up", list: Closing, job: Register, minutes: 10,
         owner: Either(Register), anchor: "register", gesture: Click, extra_done: [CashUp]),
        (id: "fridge_check", list: Closing, job: Kitchen, minutes: 5,
         owner: Either(Kitchen), anchor: "station:fridge", gesture: Click,
         extra_done: [Wear(tag: "station:fridge", add: -0.01)]),
        (id: "handover_note", list: Closing, minutes: 2, owner: Karolina, anchor: "counter", gesture: Pick),
        (id: "light_off_at_six", list: Closing, minutes: 1, owner: Karolina, anchor: "window", gesture: Click),
    ],
    rituals: [
        // `perfect`: a tiny extra for a list done with ≥ rituals.perfect_min perfect gestures
        // of Karolina's (handson.ron → rituals; never needed for progress)
        (list: Opening, by: "22:30", effects: [StaffMood(2.0), Coziness(add: 2.0, minutes: None)],
         perfect: [Coziness(add: 1.0, minutes: None)]),
        (list: Closing, effects: [NextNight([ChecklistSpeed(list: Opening, mul: 0.5)])],
         perfect: [StaffMood(1.5)]),
    ],
    bot: [
        (id: "hello", kind: Story),
        (id: "schedule_published", kind: SchedulePublished, placeholders: ["week"]),
        (id: "late_alert", kind: LateAlert, placeholders: ["name", "minutes"],
         actions: [(id: "noted"), (id: "cover", handler: CoverSelf), (id: "ask_other", handler: CoverOther)]),
        (id: "swap_request", kind: SwapRequest, placeholders: ["name", "other", "shift"],
         actions: [(id: "approve"), (id: "decline")]),
        (id: "time_off_vacation", kind: TimeOffRequest, placeholders: ["name", "dates"],
         actions: [(id: "approve"), (id: "decline")]),
        (id: "time_off_toil", kind: TimeOffRequest, placeholders: ["name", "hours"],
         actions: [(id: "approve"), (id: "decline")]),
        (id: "sick_call", kind: SickCall, placeholders: ["name"],
         actions: [(id: "get_well"), (id: "call_in", handler: CallIn), (id: "manage", effects: [StaffMood(1.0)])]),
        (id: "handover_ready", kind: Handover, placeholders: ["name"]),
        (id: "night_digest", kind: NightDigest, placeholders: ["night", "guests", "revenue"]),
        (id: "payroll_ready", kind: PayrollSummary, placeholders: ["week", "hours", "total"]),
        (id: "payment_reminder", kind: PaymentReminder, placeholders: ["amount", "night"],
         actions: [(id: "open_money", handler: Open(Money))]),
        (id: "payment_done", kind: PaymentReminder, placeholders: ["amount", "debt"]),
        (id: "payment_missed_soft", kind: PaymentReminder),
        (id: "payment_missed_hard", kind: PaymentReminder),
        // sandbox «Challenge» (sim::challenge): a new season, a rival, the season goal, debt
        (id: "challenge_start", kind: PaymentReminder, placeholders: ["goal", "nights", "max"]),
        (id: "challenge_season", kind: PaymentReminder, placeholders: ["season", "goal", "amount", "percent"]),
        (id: "challenge_rival", kind: Story, placeholders: ["name"]),
        (id: "challenge_goal_met", kind: PaymentReminder, placeholders: ["season", "money", "goal"]),
        (id: "challenge_goal_missed", kind: PaymentReminder, placeholders: ["season", "money", "goal", "strikes", "max"]),
        (id: "challenge_debt", kind: PaymentReminder, placeholders: ["amount", "nights"]),
        (id: "announcement_posted", kind: Announcement, placeholders: ["title"]),
        (id: "train_delay", kind: Story, placeholders: ["train", "minutes"],
         actions: [(id: "get_ready", handler: ApplyMoment("m_delay_board")), (id: "noted")]),
        // hands-on: every message has a button that does something now
        (id: "regular_tonight", kind: Story, placeholders: ["name", "time"],
         actions: [(id: "reserve", handler: ReserveSeat), (id: "noted")]),
        (id: "regular_to_go", kind: Story, placeholders: ["name", "time"],
         actions: [(id: "remind", handler: RemindBefore(5)), (id: "noted")]),
        (id: "low_stock", kind: Story, placeholders: ["item", "n"],
         actions: [(id: "drone", handler: OrderDrone(minutes: 30)), (id: "menu_off", handler: MenuOff)]),
        (id: "weather_alert", kind: Story, placeholders: ["time"],
         actions: [(id: "umbrellas", handler: ApplyMoment("m_umbrellas")), (id: "noted")]),
        (id: "cat_waiting", kind: Story, actions: [(id: "look", handler: Camera(Door))]),
        (id: "rozpis_happy", kind: SchedulePublished, actions: [(id: "thanks", effects: [StaffMood(1.0)])]),
        (id: "looks_tired", kind: Story, placeholders: ["name"], actions: [(id: "noted")]),
        // "Can I go at 2?" (a life event; the sim links the request)
        (id: "early_leave", kind: Story, placeholders: ["name", "time"],
         actions: [(id: "approve"), (id: "decline")]),
        (id: "manage_alone", kind: Story, placeholders: ["name"]),
        // 0.2 H: the snowstorm closes the line (sim::storm)
        (id: "storm_cancel", kind: Story, actions: [(id: "noted")]),
    ],
    digest: [
        (id: "title", placeholders: ["night"]),
        (id: "guests", placeholders: ["served", "left"]),
        (id: "revenue", placeholders: ["revenue"]),
        (id: "tips", placeholders: ["tips"]),
        (id: "best_seller", placeholders: ["item"]),
        (id: "rating", placeholders: ["stars"]),
        (id: "star_of_night", placeholders: ["name"]),
        (id: "quiet", placeholders: []),
        // morning credit for helpers, one per duty (§1.3)
        (id: "helper_dishes", placeholders: ["name", "n"]),
        (id: "helper_floor", placeholders: ["name", "n"]),
        (id: "helper_register", placeholders: ["name", "n"]),
        (id: "helper_bar", placeholders: ["name", "n"]),
        (id: "helper_kitchen", placeholders: ["name", "n"]),
        (id: "helper_serving", placeholders: ["name", "n"]),
    ],
    payroll: [
        (id: "title", placeholders: ["week"]),
        (id: "row", placeholders: ["number", "name", "hours", "wage"]),
        (id: "night_bonus", placeholders: ["hours"]),
        (id: "tips", placeholders: ["tips"]),
        (id: "total", placeholders: ["hours", "total"]),
        (id: "footer", placeholders: []),
    ],
    handover: [
        (id: "quiet", placeholders: []),
        (id: "busy", placeholders: ["item"]),
        (id: "broken", placeholders: ["thing"]),
        (id: "regular", placeholders: ["name"]),
        (id: "signature", placeholders: ["name"]),
    ],
    // one tap each, at most 2 a night; effects apply when the next night starts
    handover_options: [
        (id: "low_stock", subject: LowItem, next_night: [RestockFirst, StockChecked], placeholders: ["item"]),
        (id: "machine_odd", subject: Machine, when: [WearAtLeast("station:coffee", 0.5)],
         next_night: [Wear(tag: "station:coffee", add: -0.05)]),
        (id: "regular_tired", subject: Regular, next_night: [RememberRegular(trust: 1.0)], placeholders: ["name"]),
        (id: "busy_after_train", subject: Train, next_night: [HelpersReady(minutes: 5)], placeholders: ["time"]),
        (id: "thank_crew", subject: Crew, when: [StaffOnShiftAtLeast(1)], next_night: [StaffMood(3.0)]),
        (id: "table_wobbles", subject: Table, when: [WearAtLeast("table", 0.3)], next_night: [FixTable(beauty: 1.0)]),
    ],
    insights: [
        (id: "busiest_hour", link: Rozpis, placeholders: ["time", "weekday"]),
        (id: "wishes", link: RecipeBook, placeholders: ["n", "perfect"]),
        (id: "wish_loved", link: RecipeBook, placeholders: ["name", "recipe"]),
        (id: "unmet_taste", link: Pantry, placeholders: ["n", "taste"]),
        (id: "coziness", link: Build, placeholders: ["level", "weakest"]),
        (id: "helpers", link: Duties, placeholders: ["summary"]),
        (id: "tips", link: Money, placeholders: ["tips", "streak"]),
        (id: "trust", link: Journal, placeholders: ["name"]),
    ],
    payroll_rules: (
        splits: [
            (split: Cafe, crew_share: 0.0, crew_mood: 0.0, crew_wellbeing: 0.0),
            (split: Half, crew_share: 0.5, crew_mood: 4.0, crew_wellbeing: 0.0, default: true),
            (split: Crew, crew_share: 1.0, crew_mood: 8.0, crew_wellbeing: 5.0),
        ],
        star_bonus: 200,
        star_mood: 10.0,
        toil_grant_wellbeing: 10.0,
    ),
)
