                Camera(focus: Overview, zoom: 1.0),
                If(conditions: [ArcsGoodAtLeast(3)], then: [Narration(text_key: "scene.ending_last_train.06"), If(conditions: [Flag("arc.vera.good")], then: [ActorEnter(actor: "vera", to_tile: Spot("bar_front")), Line(speaker: "vera", expression: Neutral, text_key: "scene.ending_last_train.07")]), If(conditions: [Flag("arc.mirek.good")], then: [ActorEnter(actor: "mirek", to_tile: Spot("entrance")), Line(speaker: "mirek", expression: Smile, text_key: "scene.ending_last_train.08")]), If(conditions: [Flag("arc.hana.good")], then: [ActorEnter(actor: "hana", to_tile: Spot("center")), Line(speaker: "hana", expression: Smile, text_key: "scene.ending_last_train.09")]), If(conditions: [Flag("arc.lori.good")], then: [ActorEnter(actor: "lori", to_tile: Spot("stage")), Line(speaker: "lori", expression: Smile, text_key: "scene.ending_last_train.10")]), If(conditions: [Flag("arc.filip.good")], then: [ActorEnter(actor: "filip", to_tile: Spot("corner_table")), Line(speaker: "filip", expression: Neutral, text_key: "scene.ending_last_train.11")]), If(conditions: [Flag("arc.radek.good")], then: [ActorEnter(actor: "radek", to_tile: Spot("bar_front")), Line(speaker: "radek", expression: Neutral, text_key: "scene.ending_last_train.12")])], otherwise: [Narration(text_key: "scene.ending_last_train.13")]),
                If(conditions: [Any([VarIs("letter", "delivered"), VarIs("letter", "delivered_by_mirek")]), NotesFoundAtLeast(8), Not(VarIs("offer", "accepted"))], then: [Call(cutscene: "answer")]),
                Narration(text_key: "scene.ending_last_train.14"),
                Line(speaker: "player", expression: Sad, text_key: "scene.ending_last_train.15"),
                Line(speaker: "grandma", expression: Smile, text_key: "scene.ending_last_train.16"),
                TrainPass,
                Camera(focus: Spot("platform"), zoom: 1.4),
                Narration(text_key: "scene.ending_last_train.17"),
                Narration(text_key: "scene.ending_last_train.18"),
                Line(speaker: "player", expression: Thinking, text_key: "scene.ending_last_train.19"),
                Fade(to_black: true, seconds: 3.0),
                Letterbox(on: false),
            ],
        ),
        (
            id: "answer",
            trigger: Manual,
            skippable: false,
            steps: [
                Music(track: None),
                Camera(focus: Spot("window_table"), zoom: 1.7),
                Narration(text_key: "scene.answer.01"),
                Narration(text_key: "scene.answer.02"),
                Line(speaker: "guest_333", expression: Smile, text_key: "scene.answer.03"),
                Line(speaker: "guest_333", expression: Neutral, text_key: "scene.answer.04"),
