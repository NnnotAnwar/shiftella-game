        (
            id: "mirek_letter",
            trigger: ArcStage(regular: "mirek", stage: 5),
            skippable: false,
            steps: [
                Letterbox(on: true),
                Camera(focus: Actor("mirek"), zoom: 1.7),
                Line(speaker: "mirek", expression: Thinking, text_key: "scene.mirek_letter.01"),
                Choice(options: [
                (label_key: "scene.mirek_letter.02", effects: [SetVar("letter", "with_player"), GiveItem("letter")]),
                (label_key: "scene.mirek_letter.03", effects: [SetVar("letter", "with_mirek")]),
                (label_key: "scene.mirek_letter.04", effects: [SetVar("letter", "burned")]),
                (label_key: "scene.mirek_letter.05", effects: [SetVar("letter", "persuaded"), Trust("mirek", 10.0)]),
            ]),
                If(conditions: [VarIs("letter", "persuaded")], then: [Line(speaker: "mirek", expression: Surprised, text_key: "scene.mirek_letter.06"), Line(speaker: "player", expression: Neutral, text_key: "scene.mirek_letter.07")]),
                If(conditions: [VarIs("letter", "burned")], then: [Narration(text_key: "scene.mirek_letter.08"), Line(speaker: "mirek", expression: Sad, text_key: "scene.mirek_letter.09")]),
                If(conditions: [Any([Flag("mirek_keys_taken"), Flag("mirek_daughter_called")]), Not(VarIs("letter", "burned"))], then: [Apply(effects: [ArcGood("mirek")])]),
                Letterbox(on: false),
            ],
        ),
        (
            id: "payment_4",
            trigger: NightEnd(28),
