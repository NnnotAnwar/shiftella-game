        (
            id: "last_333",
            trigger: At(night: 30, time: "03:33"),
            conditions: [Not(VarIs("offer", "accepted")), WindowLightOn],
            skippable: false,
            steps: [
                Letterbox(on: true),
                Music(track: None),
                Camera(focus: Spot("platform"), zoom: 1.3),
