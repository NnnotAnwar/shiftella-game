                Narration(text_key: "scene.last_333.01"),
                ActorEnter(actor: "guest_333", to_tile: Spot("window_chair")),
                Camera(focus: Actor("guest_333"), zoom: 1.7),
                Line(speaker: "guest_333", expression: Smile, text_key: "scene.last_333.02"),
                If(conditions: [VarIs("letter", "with_player")], then: [Choice(options: [
                (label_key: "scene.last_333.03", effects: [SetVar("letter", "delivered"), TakeItem("letter")]),
                (label_key: "scene.last_333.04", effects: []),
            ])]),
                If(conditions: [VarIs("letter", "persuaded")], then: [Sfx(id: "sfx_door_bell"), ActorEnter(actor: "mirek", to_tile: Spot("window_table")), Line(speaker: "mirek", expression: Sad, text_key: "scene.last_333.05"), Line(speaker: "guest_333", expression: Surprised, text_key: "scene.last_333.06"), Line(speaker: "mirek", expression: Neutral, text_key: "scene.last_333.07"), Narration(text_key: "scene.last_333.08"), Apply(effects: [SetVar("letter", "delivered_by_mirek")])]),
                If(conditions: [Any([VarIs("letter", "delivered"), VarIs("letter", "delivered_by_mirek")])], then: [Narration(text_key: "scene.last_333.09"), Line(speaker: "guest_333", expression: Neutral, text_key: "scene.last_333.10")], otherwise: [Line(speaker: "guest_333", expression: Sad, text_key: "scene.last_333.11"), ActorExit(actor: "guest_333", to_tile: Spot("platform")), TrainPass, Narration(text_key: "scene.last_333.12")]),
                Music(track: Some("mus_night_calm_loop")),
                Letterbox(on: false),
            ],
        ),
        (
            id: "ending_light",
            trigger: Ending("light"),
            steps: [
                Letterbox(on: true),
                Music(track: Some("mus_night_calm_loop")),
                Camera(focus: Spot("register"), zoom: 1.3),
                Narration(text_key: "scene.ending_light.01"),
                ActorEnter(actor: "landlord", to_tile: Spot("bar_front")),
                If(conditions: [AllPaymentsMade], then: [Line(speaker: "landlord", expression: Surprised, text_key: "scene.ending_light.02")], otherwise: [Line(speaker: "landlord", expression: Thinking, text_key: "scene.ending_light.03")]),
                Line(speaker: "landlord", expression: Smile, text_key: "scene.ending_light.04"),
                ActorExit(actor: "landlord", to_tile: Spot("door")),
                Camera(focus: Overview, zoom: 1.0),
                If(conditions: [Flag("arc.mirek.good")], then: [ActorEnter(actor: "mirek", to_tile: Spot("bar_front")), Line(speaker: "mirek", expression: Smile, text_key: "scene.ending_light.05")]),
                If(conditions: [Flag("arc.hana.good")], then: [ActorEnter(actor: "hana", to_tile: Spot("quiet_corner")), Line(speaker: "hana", expression: Smile, text_key: "scene.ending_light.06")]),
                If(conditions: [Flag("arc.vera.good")], then: [ActorEnter(actor: "vera", to_tile: Spot("corner_table")), Line(speaker: "vera", expression: Laugh, text_key: "scene.ending_light.07")]),
                If(conditions: [Flag("arc.filip.good")], then: [ActorEnter(actor: "filip", to_tile: Spot("corner_table")), Line(speaker: "filip", expression: Smile, text_key: "scene.ending_light.08")]),
                If(conditions: [Flag("arc.radek.good")], then: [ActorEnter(actor: "radek", to_tile: Spot("bar_front")), Line(speaker: "radek", expression: Laugh, text_key: "scene.ending_light.09")]),
                If(conditions: [Flag("arc.lori.good")], then: [ActorEnter(actor: "lori", to_tile: Spot("stage")), Line(speaker: "lori", expression: Smile, text_key: "scene.ending_light.10")]),
                If(conditions: [StaffArchetype("cook")], then: [Line(speaker: "cook", expression: Thinking, text_key: "scene.ending_light.11")]),
                If(conditions: [Any([VarIs("letter", "delivered"), VarIs("letter", "delivered_by_mirek")]), NotesFoundAtLeast(8), Not(VarIs("offer", "accepted"))], then: [Call(cutscene: "answer")]),
                If(conditions: [ReputationAtLeast(60.0), ArcsGoodAtLeast(3)], then: [Narration(text_key: "scene.ending_light.12")], otherwise: [Narration(text_key: "scene.ending_light.13")]),
                Camera(focus: Spot("outside_window"), zoom: 1.3),
                Narration(text_key: "scene.ending_light.14"),
                Line(speaker: "grandma", expression: Smile, text_key: "scene.ending_light.15"),
                Line(speaker: "player", expression: Smile, text_key: "scene.ending_light.16"),
                Narration(text_key: "scene.ending_light.17"),
                Fade(to_black: true, seconds: 3.0),
                Letterbox(on: false),
            ],
        ),
        (
            id: "ending_last_train",
