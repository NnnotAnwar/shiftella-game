                If(conditions: [VarIs("letter", "delivered_by_mirek")], then: [Line(speaker: "guest_333", expression: Neutral, text_key: "scene.answer.06"), Line(speaker: "mirek", expression: Sad, text_key: "scene.answer.07"), Line(speaker: "guest_333", expression: Smile, text_key: "scene.answer.08")]),
                Line(speaker: "guest_333", expression: Smile, text_key: "scene.answer.09"),
                ActorExit(actor: "guest_333", to_tile: Spot("platform")),
